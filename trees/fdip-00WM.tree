\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Proposition}
\title{An invariant sum has an invariant value}
\date{2026-11-17}

\p{The weighted value of an equivariant
\vocabk{module-valued observable}{fdip-00WK} belongs to
#{E^H}. A normalized value has the same property whenever
its partition coefficient is a unit.

For the \vocabk{coupled finite coefficient functional}{fdip-00TU},
let #{E} be a #{k[G^X]}-module. If
#{Q_U\in E\otimes_k\mathcal A(\mathcal V)} satisfies
##{Q_{U^g}=(\rho_E(g)\otimes R_g)Q_U,}
then its componentwise coupled coefficient belongs to
#{E^{G^X}}.}

\proof{
\p{For #{h\in H}, linearity and equivariance give
##{\begin{aligned}
 \rho_E(h)\mathcal A_w(f)
 &=\sum_yw(y)f(hy)\\
 &=\sum_yw(hy)f(hy)=\mathcal A_w(f).
\end{aligned}}
The last equality reindexes a finite sum by the permutation
#{y\mapsto hy}. Division by an invariant scalar unit
preserves this equality.}

\p{For the coupled assertion, put
##{q_U=(\bbI_E\otimes\mathcal I_{\mathcal V})
 \bigl(Q_U\extexp(\theta_{K_U})\bigr).}
Here multiplication by the exponential acts on the second
tensor factor. The fixed-background identity in
\ref{fdip-00TW} gives
#{q_{U^g}=\rho_E(g)q_U}.
Apply the first part with #{H=G^X},
#{\mathcal Y=\mathcal U} and the given invariant weight.
This argument uses no inverse of #{|G|} or #{|G^X|}.}
}
