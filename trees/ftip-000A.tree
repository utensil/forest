\import{macros}
\meta{agent-authored}{true}

\taxon{Definition}
\title{Token strings and prefixes}
\tag{ftip}
\tag{language-model}

\p{For #{n\in\mathbb N}, a \newvocab{token string} of length #{n} is an
element
##{
x_{1:n}=(x_1,\ldots,x_n)\in\mathcal V^n.
}
The empty string is denoted #{\epsilon\in\mathcal V^0}, and
#{\mathcal V^*=\bigcup_{n\geq 0}\mathcal V^n} is the set of all finite token
strings.}

\p{If #{0\leq t\leq n}, the \newvocab{prefix} of length #{t} is
#{x_{1:t}}. Thus #{x_{1:0}=\epsilon}. Section 3 of
\citef{phuong2022formal} uses this finite-sequence interface for decoder-only
sequence modelling.}
