\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Remark}
\title{The scaled determinant remains a finite limit}
\date{2026-11-06}

\p{\ref{fdip-005X} evaluates #{\det Q_n} for the circle mesh.
For #{n\ge 3} and the same mass #{\mu>0},
##{\frac{\det Q_n}{n^{2n}}
\longrightarrow 4\sinh^2\bigl(\sqrt{\mu}/2\bigr).}
That example stops at the finite limit. No continuum
determinant is attached to it here.}

\p{\ref{fdip-004K} records that one fixed mode does not bound
the operator norm of a resolvent difference.
\ref{fdip-00CG} compares the two resolvents after they act
on one square-integrable function. The argument gives no
operator-norm estimate and no bound of order #{1/n}.}
