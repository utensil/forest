\meta{agent-authored}{true}
\tag{fdip}
\taxon{Remark}
\title{The Cauchy-Binet chart for rooted forests}
\date{2026-11-10}

\p{TauCeti's
\leanref/tauceti{Matrix.det_mul_transpose_eq_sum_plucker_sq}
gives the Cauchy-Binet identity for a matrix over a commutative
ring with rows indexed by #{\mathrm{Fin}(n)} and a finite ordered
column set. The counting bases declared in the proof of
\ref{fdip-005V} reindex the real incidence matrix into that form.
Its Plücker coordinates are the maximal minors. This supports the
sum-of-squares step. The classification of the nonzero forest
minors, the weights, and the probability consequences are proved
in the theorem.}
