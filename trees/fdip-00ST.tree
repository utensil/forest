\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Theorem}
\title{The two squares differ by the curvature terms}
\date{2026-11-17}

\p{For the \vocabk{two first-order operators}{fdip-00SR},
##{\extD_U^2+\covsq_U
=2\bigl(\extd_U^2+(\extdag_U)^2\bigr).}
Represented flatness implies #{\extD_U^2=-\covsq_U} over every
coefficient ring. Conversely, if multiplication by #{2} is
injective on #{F}, that equality implies represented flatness.}

\proof{
\p{Expanding the two squares cancels their mixed terms and
doubles the two pure terms. Under flatness, \ref{fdip-00SL}
gives #{\extd_U^2=0}; taking adjoints gives
#{(\extdag_U)^2=0}. For the converse, act on degree-zero
cochains. The lowering square is zero there, so equality of
the two squares gives #{2\extd_U^2=0}. Injectivity of #{2}
on the coefficients implies #{\extd_U^2=0} on degree zero.
The degree-zero argument in \ref{fdip-00SL} then proves
represented flatness.}
}
