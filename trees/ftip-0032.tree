\import{macros}
\meta{agent-authored}{true}

\tag{ftip}
\tag{reinforcement-learning}
\tag{advantage}

\refdeft{Advantage function}{Section 2}{schulman2016gae}{
\p{For a policy #{\pi}, its \newvocab{advantage function} is}

##{
 A^\pi(h,a)=Q^\pi(h,a)-V^\pi(h).
}

\p{The advantage compares an action with the policy's average continuation
value at the same information state. Policy-gradient implementations replace
it by an estimator #{\widehat A_t}; the estimator and the mathematical
advantage are not interchangeable without assumptions on bias and variance.}
}
