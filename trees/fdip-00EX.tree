\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Theorem}
\title{The planar coding is post-critically finite}
\date{2026-11-07}

\p{Let #{\pi}, #{K}, and #{F_i} be as in \ref{fdip-00EO}.
Each #{F_i} is a continuous injection, and
#{F_i(\pi(\omega))=\pi(i\omega)}. In the sense of
\citet{Definition 3.1}{kigami1996kokyuroku}, the triple
#{(K,\{1,2,3\},\{F_i\})} is a self-similar structure. Distinct
first-level cells meet at one point. The post-critical set
has three elements, the constant words, so the structure is
post-critically finite and its boundary is the corner set of
the gasket graph.}

\proof{
\p{Each #{F_i} multiplies Euclidean distances by #{\frac{1}{2}},
so it is injective. The identity #{F_i(\pi(\omega))=\pi(i\omega)}
is the definition of #{\pi}. Continuity and surjectivity of
#{\pi} are in \ref{fdip-00EO}. These are the conditions of
the cited definition.}

\p{By \ref{fdip-00EO}, #{K_i\cap K_j} is the single point
#{F_i(p_j)=F_j(p_i)} when #{i\ne j}. A word sent to that
point is #{i} followed by the constant letter #{j}, or #{j}
followed by the constant letter #{i}. The critical set
therefore consists of those #{6} words. Shifting any of them
reaches a constant word, and shifting a constant word stays
there. The post-critical set is the three constant words, so
\citet{Definition 3.2}{kigami1996kokyuroku} applies. The
boundary in \citet{Definition 3.3}{kigami1996kokyuroku} is
#{\pi} of that set, namely #{\{p_1,p_2,p_3\}}.}
}
