\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Definition}
\title{Distance between compact metric spaces}
\date{2026-11-06}

\p{Let #{A} and #{B} be nonempty subsets of a metric space.
The \newvocab{Hausdorff distance} #{d_H(A,B)} is the larger
of the two numbers
#{\sup_{a\in A}\operatorname{dist}(a,B)} and
#{\sup_{b\in B}\operatorname{dist}(b,A)}.}

\p{Let #{X} and #{Y} be nonempty compact metric spaces. Their
\newvocab{Gromov–Hausdorff distance} is the infimum of
#{d_H(\Phi(X),\Psi(Y))} over all metric spaces #{Z} and all
isometric embeddings #{\Phi:X\to Z} and #{\Psi:Y\to Z}. The
infimum is at most the Hausdorff distance coming from any
one such pair.}
