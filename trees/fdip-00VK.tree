\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Definition}
\title{Constant geometric and internal right actions}
\date{2026-11-17}

\p{Let #{k} be a commutative ring, #{n\ge1}, #{N\ge1}, and
#{X=(\mathbb Z/N\mathbb Z)^n}. Use the
\vocabk{based cochains}{fdip-00SH} with a finite free
coefficient representation #{F}:
##{C^\bullet(X;F)=k^X\otimes_k\Lambda(k^n)\otimes_k F.}
Give the middle factor the Clifford product of
\ref{fdip-00OS}, for #{q(\sum_i x_i e_i)=\sum_i x_i^2}.
For #{c\in\operatorname{Cl}(q)}, the
\newvocab{geometric right action} is
##{R_c^{\mathrm{geom}}(f\otimes v\otimes z)
       =f\otimes(vc)\otimes z.}
It is constant in the vertex and preserves each vertex's
full exterior-coefficient space.}

\p{For the \vocabk{integral Hurwitz fiber}{fdip-00V2},
#{F=\mathcal O_k=\mathcal O\otimes_{\mathbb Z}k}, with the
left #{2T} action, the \newvocab{internal right action} is
##{R_a^{\mathrm{int}}(f\otimes v\otimes z)
       =f\otimes v\otimes(za),\qquad a\in\mathcal O_k.}
Let #{\mathcal R} be the subalgebra of
#{\operatorname{End}_k C^\bullet(X;\mathcal O_k)}
generated by these two families.}

\p{The \newvocab{universal right-action commutant} is
##{\{A\in\mathcal R:
 [A,\extD_U]=0\text{ for every }U,\quad
 [A,\mathcal G_g]=0\text{ for every }g\}.}
Here #{[A,B]=AB-BA}, #{\extD_U} is the
\vocabk{cochain operator}{fdip-00SR}, and #{\mathcal G_g}
is the \vocabk{vertex gauge action}{fdip-00SH}.
Links and gauges range independently over their full
#{2T}-valued sets. Restricting to #{R_c^{\mathrm{geom}}}
gives the geometric part of this commutant.}
