\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Example}
\title{An arc of length three}
\date{2026-11-12}

\p{On the cycle of length #{4}, let #{f(0)=1}, #{f(1)=3},
#{f(2)=0}, and #{f(3)=4}. The forward differences along the arc
from #{0} to #{3} are #{2}, #{-3}, and #{4}. Their sum is #{3},
and #{f(3)-f(0)=3}.}

\p{The forward differences from #{0} are #{2} and #{-3}. Their
difference is #{-5}. Then
##{1+2\cdot 2+(-5)=0,}
which is #{f(2)}.}
