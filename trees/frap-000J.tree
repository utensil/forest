\import{macros}
\meta{agent-authored}{true}
\tag{frap}

\taxon{Lemma}
\title{Extending a symmetry of one facet}

\p{Let #{H} be a facet of a \vocabk{regular}{frap-000G} abstract polytope
#{P} of rank #{n\geq2}. Restriction gives an isomorphism}
##{\operatorname{Stab}_{\Gamma(P)}(H)\cong\Gamma(H/F_{-1}).}
\p{In particular the facet is regular, and each of its automorphisms has
a unique extension fixing #{H}. This is a consequence of the flag action
in \citet{Section 2 and Lemma 2.1}{schulte2017regular}; the argument follows.}

\proof{
  \p{Extend a flag of the \vocabk{facet section}{frap-000E} by the greatest face
  of #{P}. A stabilizer element restricting to the identity fixes this
  whole flag and is the identity by [flag freeness](frap-000H).
  Restriction is therefore injective.}
  \p{Given a facet automorphism #{\alpha}, regularity supplies an
  automorphism of #{P} taking the extended flag to the extension of its
  image under #{\alpha}. It fixes #{H}. Its restriction agrees with
  #{\alpha} on the chosen facet flag, so flag freeness in the facet makes
  these restrictions equal. This proves surjectivity. The same use of
  regularity with any two facet flags shows that the facet is regular.}
}
