\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\title{Elimination and retained observables}
\date{2026-10-20}

\p{Eliminating selected real field values produces both a
[new quadratic action and a normalization factor](fdip-000D).
The retained law must agree with the original expectation on
[observables pulled back from the retained variables](fdip-000E).
Alternate vertices of the [four-cycle](fdip-000F) make both requirements
explicit. The [conditional kernel](fdip-003A) distinguishes fixing
variables from averaging them, while [singular eliminated directions](fdip-0039)
explain when the reference space itself must change.}

\transclude{fdip-000D}
\transclude{fdip-000E}
\transclude{fdip-003A}
\transclude{fdip-0039}
\transclude{fdip-000F}
