\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Definition}
\title{The finite exterior exponential}
\date{2026-11-17}

\p{Let #{k} be a commutative unital ring and let #{M} be a
finite free #{k}-module with an ordered basis #{z_1,\ldots,z_s}.
In #{\Lambda_k M}, write #{z_I=z_{i_1}\cdots z_{i_t}} for
#{I=\{i_1<\cdots<i_t\}}. For a positive even element
#{a=\sum_{I\ne\varnothing,\ |I|\text{ even}}a_Iz_I}, define
the \newvocab{finite exterior exponential} by
##{\extexp(a)=
 \prod_{\substack{I\ne\varnothing\\|I|\text{ even}}}
 (1+a_Iz_I).}
The factors are even and commute. Define its
\newvocab{divided coefficients} by the finite polynomial identity
##{\extexp(ta)=\sum_{j=0}^{\lfloor s/2\rfloor}t^j\divcoef{a}{j}
 \quad\text{in }\Lambda_{k[t]}(M\otimes_k k[t]).}
Only finitely many coefficients occur. For quadratic #{a},
#{\divcoef{a}{j}} has exterior degree #{2j}. Basis independence
and compatibility with odd substitutions are asserted in
\ref{fdip-00TH}.}
