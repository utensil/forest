\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Definition}
\title{The finite exterior exponential}
\date{2026-11-17}

\p{Let #{M} be finite free of rank #{s} over a commutative
unital ring #{k}. The \newvocab{finite exterior exponential}
on the positive even part of #{\Lambda_k M} is the unique
map to #{\Lambda_k M} satisfying
##{\extexp(a+b)=\extexp(a)\extexp(b),\qquad
   \extexp(uv)=1+uv}
for positive even #{a,b} and odd #{u,v}. In particular
#{\extexp(0)=1}. Over #{k[t]}, its
\newvocab{divided coefficients} are given by
##{\extexp(ta)=\sum_{j=0}^{\lfloor s/2\rfloor}t^j\divcoef{a}{j}.}
For quadratic #{a}, the coefficient #{\divcoef{a}{j}} has
exterior degree #{2j}. The construction and its naturality under
odd substitutions are proved in \ref{fdip-00TH}.}
