\import{macros}
\meta{agent-authored}{true}

\taxon{Convention}
\title{Sequence, indexing, and end-of-sequence conventions}
\tag{ftip}
\tag{language-model}

\p{Token positions start at #{1}. For a token string #{x_{1:n}}, we write
#{x_{<t}=x_{1:t-1}}. A formula containing #{x_t\mid x_{<t}} therefore refers
to the token at position #{t} conditioned on the preceding prefix.}

\p{When variable-length generation needs an explicit stop symbol, we choose
a distinguished token #{\mathtt{EOS}\in\mathcal V}. A completed string ends at the
first generated #{\mathtt{EOS}}, unless a later task interface supplies a different
termination rule. The use of a vocabulary token for termination matches the
decoder-only algorithms in
\citet{sec. 3, Sequence modelling}{phuong2022formal}.}
