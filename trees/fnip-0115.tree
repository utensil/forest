\import{fnip-macros}
\meta{agent-authored}{true}
\tag{fnip}
\taxon{Example}
\title{One line and one nullcline}
\date{2026-11-27}

\p{With #{h=0.89-1.1n} and #{m=m_{\infty}(V)}, the voltage
equation and the equation for #{n} are a planar system.
\citet{Fig. 5.21, p. 150}{izhikevich2007dynamical} draws an
N-shaped #{V}-nullcline. It meets #{n=n_{\infty}(V)} once,
so there is one equilibrium. At #{I=0} that equilibrium is
stable. The same figure at #{I=12} has a limit cycle.}

\p{\citet{Fig. 5.19, p. 149}{izhikevich2007dynamical} draws
the orbit in the #{(n,h)} plane near #{h=0.89-1.1n}.
\citet{Fig. 3.11, p. 67}{ermentrout2010mathematical} draws
the same projection at three currents, and the line moves
with the current.}

% scripts/fnip/figures/hh_planar.py

\texfig{\begin{tikzpicture}[line cap=round,font=\small]
