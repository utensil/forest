    \draw[->] (0,0) -- (3.4,0) node[right] {$n$};
    \draw[->] (0,0) -- (0,2.5) node[above] {$h$};
    \draw[thick] (0.64,1.47) -- (2.24,0.26);
    \draw[thick] (0.72,1.58) .. controls (1.35,1.05) and (1.55,0.85) .. (2.15,0.42)
      .. controls (1.45,0.62) and (1.15,1.15) .. (0.72,1.58);
    \node[above] at (1.3,1.7) {$h=0.89-1.1n$};
  \end{scope}
  \begin{scope}[xshift=4.4cm]
    \draw[->] (0,0) -- (3.6,0) node[right] {$V$};
    \draw[->] (0,0) -- (0,2.5) node[above] {$n$};
    \draw[thick] (0.3,1.9) .. controls (0.8,1.9) and (1.05,0.35) .. (1.55,0.4)
      .. controls (2.15,0.48) and (2.25,1.85) .. (2.85,1.9)
      .. controls (3.2,1.92) and (3.35,1.15) .. (3.45,0.55);
    \draw[thick] (0.25,0.3) .. controls (1.15,0.35) and (1.35,1.55) .. (3.3,2.05);
    \fill (0.95,0.95) circle (1.2pt);
  \end{scope}
