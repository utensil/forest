\import{macros}
\meta{agent-authored}{true}

\taxon{Definition}
\title{Clipped policy objective}
\tag{ftip}
\tag{policy-optimization}
\tag{clipping}

\p{For #{\epsilon\in(0,1)}, write
#{\operatorname{clip}_\epsilon(u)=\min(1+\epsilon,\max(1-\epsilon,u))}.
For group member #{i}, let #{\rho_{i,t}} be its token ratio from
\ref{ftip-001O}. Given response advantages #{\widehat A_i}, a
token-normalized \strong{clipped policy objective} is}

##{
  J_{\mathrm{clip}}(\theta)
  =\frac{1}{\sum_i |y^{(i)}|}
   \sum_i\sum_{t=1}^{|y^{(i)}|}
   \min\left(
      \rho_{i,t}(\theta)\widehat A_i,
      \operatorname{clip}_\epsilon(\rho_{i,t}(\theta))\widehat A_i
   \right).
}

\p{The clipped surrogate originates in
\citet{Section 3}{schulman2017proximal}. DAPO studies asymmetric clipping and
token-level normalization in \citet{Sections 3.1 and 3.3}{yu2025dapo}. The
displayed objective fixes one convention; it is not the definition of every
GRPO implementation.}
