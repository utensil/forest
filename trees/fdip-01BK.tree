\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Proposition}
\title{Finite thickness preserves the sign}
\date{2026-11-27}

\p{Let #{T} be a fixed strictly positive
\vocabk{normal transfer}{fdip-01BF}. For any integer
#{m\ge1} the positive, negative and zero subspaces of
##{(\bbI -T^m)(\bbI+T^m)^{-1}}
are those of #{\bbI -T}.}

\proof{
\p{The finite product identity
#{\bbI -T^m=(\bbI -T)\sum_{j=0}^{m-1}T^j}
holds by telescoping. On each spectral subspace of #{T}
both #{\sum_{j=0}^{m-1}T^j} and #{\bbI+T^m} act by strictly
positive scalars. Multiplication by their ratio preserves the
three sign spaces. Stationary slice data give the power #{T^m}
in the recurrence of \ref{fdip-01BH}.}
}

\p{Kikukawa and Noguchi express their finite-flavor truncated
overlap operator using a function of the normal step
\citet{v2, Eqs. (1.5)-(1.6), printed p. 3}{kikukawa1999low}.
Their spacing in the extra direction is #{a_s} and their
transverse Wilson term enters the slice coefficient in
\citet{v2, Eq. (2.3), printed p. 6}{kikukawa1999low}.
The relative signs of the hops here follow from
\ref{fdip-01BH}.}
