\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Theorem}
\title{Pointwise covariance and finite-site adjoints}
\date{2026-11-17}

\p{For any subgroup #{H} carrying the
\vocabk{exterior rotational action}{fdip-00YI}, the
\vocabk{rotation-only matter operators}{fdip-00YO} obey
##{\extd_{R'}\mathcal G_S=\mathcal G_S\extd_R,
\qquad \extdag_{R'}\mathcal G_S=\mathcal G_S\extdag_R,
\qquad \extD_{R'}\mathcal G_S=\mathcal G_S\extD_R.}
The counting pairing is perfect,
#{(T_i^R)^\dagger=(T_i^R)^{-1}},
#{(\extd_R)^\dagger=\extdag_R}, and
#{(\extD_R)^\dagger=\extD_R}. Here #{\dagger} denotes the
adjoint for that pairing. No average over #{H} is involved.}

\proof{
\p{At the source #{x}, the edge law and the representation law
of \ref{fdip-00YK} give
##{\begin{aligned}
(T_i^{R'}\mathcal G_S f)_I(x)
 &=A(S_x)A(R_i(x))^{-1}
   A(S_{x+\varepsilon_i})^{-1}A(S_{x+\varepsilon_i})
   f_I(x+\varepsilon_i)\\
 &=(\mathcal G_S T_i^Rf)_I(x).
\end{aligned}}
Cubical insertion and deletion commute with the internal action.
Taking inverse transports in this identity gives covariance for
both sums, and then for their sum.}

\p{There are finitely many pairs #{(x,I)}, and each copy of
#{E} has the perfect symmetric form of \ref{fdip-00YG}.
The counting pairing is consequently perfect and symmetric.
For each coefficient, invariance of #{B} and the substitution
#{y=x+\varepsilon_i} yield
##{\begin{aligned}
&\sum_xB(A(R_i(x))^{-1}f_I(x+\varepsilon_i),h_I(x))\\
&\qquad=\sum_yB(f_I(y),A(R_i(y-\varepsilon_i))h_I(y-\varepsilon_i)).
\end{aligned}}
This is the inverse transport in the second argument. Signed
insertion and deletion on the cubical monomial basis are adjoint,
and these maps commute with transport. The adjoint of the first
sum is therefore the second sum. Symmetry and perfection imply
that taking adjoints twice returns the initial operator, so their
sum is self-adjoint. Every #{\mathcal G_S} is an isometry by
\ref{fdip-00YK}. All arguments use only a finite sum over sites,
not finiteness of #{H}.}
}
