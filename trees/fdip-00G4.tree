\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Remark}
\title{The weighted integral is separate}
\date{2026-11-07}

\p{The comparison for #{J(t)} uses the same splitting point
#{\delta=t^{-1/4}} and the same quadratic bounds on
#{\ell}. \ref{fdip-00G3} estimates #{I(t)-G(t)} in absolute
value. The weighted integral is estimated from
#{ye^{-y}} directly. In \ref{fdip-00G2} the summand
#{k=0} contributes #{1} to #{Z_N} and #{0} to #{W_N}.}
