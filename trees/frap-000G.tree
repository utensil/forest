\import{macros}
\meta{agent-authored}{true}
\tag{frap}

\import{lean-macros}

\refcardt{Definition}{Automorphisms and regularity}{Section 2}{schulte2017regular}{
  \p{An \newvocab{automorphism} of an [abstract polytope](frap-000D)
  #{P} is a bijection #{a:P\to P} satisfying
  #{F\leq G\iff a(F)\leq a(G)}. Automorphisms form a group
  #{\Gamma(P)} under composition; in #{ab}, the map #{b} acts first.
  They preserve ranks and act on flags face by face.}
  \p{The polytope is \newvocab{regular} if this action is transitive on
  flags. The tetrahedron is regular: a permutation of its four vertices
  sends any flag to any other.}
  \p{The underlying order automorphism is represented by
  \leanref{OrderIso} with equal source and target. This declaration does
  not impose the polytope axioms or assert regularity.}
}
