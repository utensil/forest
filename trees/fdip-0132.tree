\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Proposition}
\title{Nonnegative kernels have nonnegative entries}
\date{2026-11-21}

\p{Let #{B} and #{\mathcal K} take nonnegative values in an
ordered field, and let #{\transferop} be the
\vocabk{one-edge operator}{fdip-012C}. In the basis of group
elements, the matrix entry from #{h} to #{g} is nonnegative.}

\proof{
\p{The function that equals #{1} at #{h} and #{0} elsewhere is
sent to the function whose value at #{g} is
#{B(g)\mathcal K(gh^{-1})B(h)}. Each factor is nonnegative, so
the product is nonnegative. An entry in a double-coset indicator
basis is a sum of such products, hence nonnegative as well.}
}
