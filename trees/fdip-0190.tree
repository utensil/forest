\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Proposition}
\title{A simultaneous real basis and the square of a symmetry}
\date{2026-11-26}

\p{Let #{A,B} be Hermitian endomorphisms of a finite-dimensional
complex Hermitian space #{E}. The square of any commuting
antiunitary #{j} is a unitary commuting with #{A,B}. There
is a common orthonormal basis in which both operators have
real entries exactly when there exists such an antiunitary
with #{j^2=\bbI}.}

\proof{
\p{Composition of two antiunitaries is linear and unitary.
Applying commutation twice gives #{j^2 A=A j^2} and likewise
for #{B}. In a common basis with real entries for both operators,
conjugating the
coefficients gives a commuting antiunitary of square one.
Conversely suppose #{j^2=\bbI}. Each #{v} has the decomposition
##{v=\frac{v+jv}{2}+\ui\,\frac{v-jv}{2\ui}.}
Both summands before multiplication by #{\ui} are fixed by
#{j}. A fixed vector whose imaginary multiple is fixed must
be zero. The fixed subspace is thus a real form of #{E}, and
its inner products are real by antiunitarity. Real
orthonormalization gives a complex orthonormal basis of #{E}.
Since #{A,B} commute with #{j}, they preserve the fixed
subspace and have real coordinates in this basis.
The symmetry obtained in \ref{fdip-018Y} has its particular
square in the joint commutant. A real basis requires the
choice with square one.}
}
