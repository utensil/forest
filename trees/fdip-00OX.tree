\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Theorem}
\title{Stokes and the square of the coboundary are natural}
\date{2026-11-12}

\p{Let #{s} and #{s^*} be the subdivision maps of
\ref{fdip-00OW}. Then #{s^*\covwedge^2=\covwedge^2 s^*}. For a chain #{c}
whose degree is one greater than the degree of a cochain
#{\omega}, the Stokes pairing of #{\covwedge\omega} on #{sc} equals
the Stokes pairing of #{\covwedge s^*\omega} on #{c}.}

\proof{
\p{\ref{fdip-00OW} gives #{s^*\covwedge=\covwedge s^*}. Right composition with
#{\covwedge} gives #{s^*\covwedge^2=\covwedge s^*\covwedge}. Replace the inner #{s^*\covwedge} by
#{\covwedge s^*} to get #{s^*\covwedge^2=\covwedge^2 s^*}.
\ref{fdip-00OK} gives #{\covwedge^2=0} on each torus, so both sides are
the zero map.}

\p{The same pairing identity gives
#{\langle \covwedge\omega,sc\rangle=\langle\omega,\partial sc\rangle}.
Since #{s} is a chain map,
#{\partial sc=s\partial c}, and the definition of #{s^*}
replaces #{\langle\omega,s\partial c\rangle} by
#{\langle s^*\omega,\partial c\rangle}.
\ref{fdip-00OK} again replaces that number by
#{\langle \covwedge s^*\omega,c\rangle}.}
}
