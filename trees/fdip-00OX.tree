\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Theorem}
\title{Stokes and the square of the coboundary are natural}
\date{2026-11-12}

\p{Let #{s} and #{s^*} be the subdivision maps of
\ref{fdip-00OW}. Then #{s^*d^2=d^2s^*}. For a chain #{c} and a
cochain #{\omega} of the same degree, the Stokes pairing of
#{d\omega} on #{sc} equals the Stokes pairing of #{ds^*\omega}
on #{c}.}

\proof{
\p{\ref{fdip-00OW} gives #{s^*d=ds^*}. Right composition with
#{d} gives #{s^*d^2=ds^*d}. Replace the inner #{s^*d} by
#{ds^*} to get #{s^*d^2=d^2s^*}.
\ref{fdip-00OK} gives #{d^2=0} on each torus, so both sides are
the zero map.}

\p{The same pairing identity gives
#{\langle d\omega,sc\rangle=\langle\omega,\partial sc\rangle}.
Since #{s} is a chain map,
#{\partial sc=s\partial c}, and the definition of #{s^*}
replaces #{\langle\omega,s\partial c\rangle} by
#{\langle s^*\omega,\partial c\rangle}.
\ref{fdip-00OK} again replaces that number by
#{\langle ds^*\omega,c\rangle}.}
}
