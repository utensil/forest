\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Remark}
\title{Cylinders force points to be null}
\date{2026-11-07}

\p{Each infinite word is the intersection of the cylinders
that name its prefixes. The cylinder of length #{m} about
a fixed word has mass at most
#{\bigl(\max_i\mu_i\bigr)^m} under \ref{fdip-00EV}, and
this bound tends to zero. Every singleton is therefore
null, and so is every finite set of words.}
