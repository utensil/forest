\import{macros}
\meta{agent-authored}{true}

\tag{ftip}
\tag{outcome-supervision}
\tag{reward-model}

\refdeft{Outcome-supervised reward model}{Section 2.5, ``Outcome-supervised reward models''}{lightman2023verify}{
\p{An \newvocab{outcome-supervised reward model} assigns a score to a complete
response and is trained from labels attached to the final outcome. For a
prompt #{x} and completed response #{y}, write its score as}

##{
 r_{\mathrm{out},\phi}(x,y)\in\mathbb R.
}

\p{The training label states whether the completed solution reaches the
declared outcome. It need not identify the first invalid step or distinguish a
sound derivation from an answer reached for an unsound reason.}
}
