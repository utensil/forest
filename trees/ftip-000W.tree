\import{macros}
\meta{agent-authored}{true}

\refdeft{Positionwise feed-forward sublayer}{sec. 3.3, equation (2)}{vaswani2017attention}{
\p{With widths #{d} and #{d_{\mathrm{ff}}} from \ref{ftip-000L}, a
\newvocab{positionwise feed-forward sublayer} is a map
#{F:\mathbb R^d\to\mathbb R^d} of the form
##{
F(z)=\phi(zW_1+b_1)W_2+b_2,
}
where #{W_1\in\mathbb R^{d\times d_{\mathrm{ff}}}},
#{W_2\in\mathbb R^{d_{\mathrm{ff}}\times d}}, the vectors #{b_1,b_2} have
the corresponding widths, and #{\phi} is applied coordinatewise. The same map
is applied independently at each token position.}
}

\tag{ftip}
\tag{architecture}
