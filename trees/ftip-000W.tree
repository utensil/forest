\import{macros}
\meta{agent-authored}{true}

\taxon{Definition}
\title{Pretraining corpus law}
\tag{ftip}
\tag{pretraining}

\p{A \newvocab{pretraining corpus law} #{\mathcal D_{\rm pre}} is a
probability distribution on finite token strings. A sampled string may carry
metadata used for filtering or weighting, but the next-token objective sees
the resulting token sequence.}

\p{Section 2.3 of \citef{kaplan2020scaling} describes a dataset and sampling
mixture. Appendix A of \citef{hoffmann2022training} gives another training-data
composition and preprocessing pipeline. The probability-law presentation is a
mathematical abstraction of such pipelines. It does not make unreported
deduplication, filtering, or mixture weights known.}
