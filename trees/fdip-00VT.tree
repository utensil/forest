\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Proposition}
\title{The rational Hurwitz fiber is simple}
\date{2026-11-17}

\p{Over #{k=\mathbb Q}, the left #{2T}-module
#{\mathcal O_{\mathbb Q}} is simple of dimension #{4}.
Under the global diagonal #{2T} action, its cochains
are #{r=2^n|X|} copies of this simple representation.
Their fixed-background operator need not commute with
that global action.}

\proof{
\p{In the rational Hamilton algebra, the norm of
#{a+b\qi+c\qj+d\qk} is #{a^2+b^2+c^2+d^2}.
It is positive for every nonzero element, so
#{x^{-1}=\bar x/N(x)} exists. Thus
#{\mathcal O_{\mathbb Q}} is a division algebra.
A subspace invariant under #{2T} is invariant under
its linear span, which is the whole algebra because
it contains the basis in \ref{fdip-00V1}.
It is a left ideal. If it contains #{x\ne0}, left
multiplication by #{x^{-1}} gives #{1}, and then
every element. The module is simple. The cell basis
in \ref{fdip-00VR} gives the stated direct sum.}

\p{For a concrete fixed-background failure, take one site
with #{U_1=\qi} and all other links trivial. The
formula in \ref{fdip-00VN} gives, for the global
left action of #{\qj},
##{[\extD_U,\mathcal G_{\qj}]
       =-2(e_1\wedge-e_1\cdot)\otimes L_{\qk}.}
Its value at #{1\otimes1} is
#{-2e_1\otimes\qk\ne0}. Gauge covariance changes
the background as well, as in \ref{fdip-00SS}.}
}
