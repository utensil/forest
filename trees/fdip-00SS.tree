\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Lemma}
\title{The adjoint uses inverse transport}
\date{2026-11-17}

\p{For the \vocabk{invariant pairings and operators}{fdip-00SR},
#{(T_i^U)^\dagger=(T_i^U)^{-1}} and
#{\extdag_U=(\extd_U)^\dagger}. The operators #{\extD_U}
and #{\cov_U} are respectively self-adjoint and skew-adjoint.
All 4 operators are covariant under vertex gauges.}

\proof{
\p{On coefficient functions, invariance and the substitution
#{y=x+\varepsilon_i} give
##{\begin{aligned}
&\sum_x b(\rho(U_i(x))^{-1}f(x+\varepsilon_i),h(x))\\
&\qquad=\sum_y b(f(y),\rho(U_i(y-\varepsilon_i))h(y-\varepsilon_i)).
\end{aligned}}
The second argument is #{((T_i^U)^{-1}h)(y)}. Signed insertion
and deletion on the exterior monomial basis show that the
adjoint of #{e_i\wedge} is #{(e_i\cdot)}. The two factors commute,
so the adjoint of each summand of #{\extd_U} is the corresponding
summand of #{\extdag_U}. Perfectness makes this adjoint unique.}

\p{Taking the adjoint twice returns the original map for each
of the stated pairing symmetries. The two sums therefore have
the claimed adjoint signs. The maps #{\mathcal G_g} preserve
the pairing, by its #{G}-invariance. Taking adjoints in
\ref{fdip-00SI} gives covariance of #{\extdag_U}; addition and
subtraction give covariance of the other operators.}
}
