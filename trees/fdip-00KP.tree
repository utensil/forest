\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Remark}
\title{Real determinants of positive multiplicity blocks}
\date{2026-11-10}

\p{In the scalar-column basis of the proof of \ref{fdip-0050},
#{H_\Xi} is identified with #{r_\Xi} columns in #{D_\Xi^{m_\Xi}},
where #{r_\Xi=\dim_{D_\Xi}W_\Xi}. Left multiplication by the
multiplicity matrix #{Q_\Xi} acts on every column, and
##{\det_{\mathbb R}(Q|_{H_\Xi})
=\det_{\mathbb R}(Q_\Xi)^{r_\Xi}.}
If the positive Hermitian eigenvalues are
#{\lambda_1,\ldots,\lambda_m}, the real determinant of that left
multiplication is #{\prod_j\lambda_j^{d_D}}, with
#{d_D=\dim_{\mathbb R}D}. A complex eigenvalue is therefore squared,
and a quaternionic Hermitian eigenvalue is raised to the fourth power,
before the exponent #{r_\Xi}. This is the ordinary real determinant.
It is not a determinant taking values in #{\mathbb H}.}
