\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Proposition}
\title{Coarser means are averages of finer means}
\date{2026-11-06}

\p{Let #{r\ge 1} divide #{B}. Use the common fine mesh of
\ref{fdip-00BL}, so #{n=BM\ge 3}. The mean of #{r} consecutive
\vocabk{block averages}{fdip-00BL} is the block average for the coarser partition
into #{B/r} blocks. At every finite #{M} with #{n=BM\ge 3}, pushforward under
that averaging map sends the level-#{B} law to the
level-#{B/r} law.}

\proof{
\p{A coarse block contains #{rM} vertices and is the union of
#{r} fine blocks of #{M} vertices. The mean of its mesh
values is therefore the mean of the #{r} fine block
averages. The coarser coordinate vector is the image of the
finer one under this linear map, at every #{M} with
#{n=BM\ge 3}.}
}
