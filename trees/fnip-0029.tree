\import{fnip-macros}
\meta{agent-authored}{true}
\tag{fnip}
\taxon{Theorem}
\title{Local existence and uniqueness}
\date{2026-11-26}

\p{Let #{U\subseteq\mathbb{R}^{n}} be open, let
#{f:U\to\mathbb{R}^{n}} be continuously differentiable, and let
#{x_{0}\in U}. Then there is a constant #{c>0} and a unique solution
#{\varphi(x_{0},\cdot):(-c,c)\to U} of #{\dot x=f(x)} with
#{x(0)=x_{0}}.}

\p{\citet{Theorem 1.0.1, §1.0, p. 3}{guckenheimer1983nonlinear}
states this for a continuously differentiable map, and the same page
records that a locally Lipschitz map is enough: on a neighborhood of
each point, #{|f(y)-f(x)|\le K|x-y|} for some finite #{K}.
\citet{Theorem 1.4, §1.4, pp. 21–22}{kuznetsov2004elements}
adds that, when #{f} is smooth, the solution depends smoothly on
#{(t,x_{0})} and the interval may be chosen to depend on #{x_{0}}.}
