\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Proposition}
\title{The three channels are gauge invariant}
\date{2026-11-21}

\p{The \vocabk{vector channel}{fdip-012V}, the
\vocabk{orbit-label channel}{fdip-012V}, and the
\vocabk{plaquette channel}{fdip-012V} are unchanged by a vertex
gauge.
A \vocabk{one-edge operator}{fdip-012C} is defined on the reduced links
of one \vocabk{sector labeling}{fdip-0121}, so the direct sum of
the sector operators has no matrix entry between two sectors.}

\proof{
\p{\ref{fdip-011C} gives gauge invariance of the
[scalar path pairing](fdip-011B), and it gives the
conjugation of a face word. A class function is unchanged by
that conjugation. A vertex gauge acts inside each scalar orbit,
so it preserves the sector of every configuration. The
orbit-label function is therefore unchanged.}
}
