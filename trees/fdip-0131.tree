\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Proposition}
\title{The three channels are gauge invariant}
\date{2026-11-21}

\p{The \vocabk{vector channel}{fdip-012V}, the
\vocabk{orbit-label channel}{fdip-012V}, and the
\vocabk{plaquette channel}{fdip-012V} are unchanged by a vertex
gauge.}

\proof{
\p{\ref{fdip-011C} gives gauge invariance of the
[scalar path pairing](fdip-011B). The same tree sends a bare
plaquette holonomy based at #{x} to #{a_x U_f a_x^{-1}}. A
class function is unchanged by that conjugation, so the value
on the face transport is unchanged. A vertex gauge acts inside
each scalar orbit, so it preserves the sector of every
configuration. The orbit-label function is therefore unchanged.}
}
