\import{macros}
\meta{agent-authored}{true}

\taxon{Remark}
\title{Training masks change more than attention cost}
\tag{ftip}
\tag{transfer-limit}

\p{If a retained-context rule is used during training, it can change the
attention inputs, sampled continuation, loss support, and gradient estimator at
once. A lower value of \ref{ftip-00DJ} is therefore not an isolated compute
intervention unless the training estimator and all other coordinates are
matched explicitly.}
