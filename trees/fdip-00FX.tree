\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Proposition}
\title{Real algebraic numbers are real-closed and metrically incomplete}
\date{2026-11-07}

\p{Let #{A} be the set of real algebraic numbers, with the
metric inherited from the line. Every positive element of
#{A} has its positive square root in #{A}. Every polynomial
of odd degree with coefficients in #{A} has a root in #{A}.
There is a Cauchy sequence in #{A} with no limit in #{A}.}

\proof{
\p{Suppose #{\alpha>0} lies in #{A}, and let #{p} be a nonzero
polynomial with rational coefficients and #{p(\alpha)=0}. The
polynomial #{p(x^2)} has rational coefficients and vanishes at
the positive square root of #{\alpha}. That square root is
therefore real algebraic.}

\p{Let #{f} be a polynomial of odd degree with coefficients in
#{A}. For all sufficiently large positive #{T} the value
#{f(T)} is positive, and for all sufficiently negative #{T}
the value #{f(T)} is negative. The intermediate value theorem
supplies a real root #{\rho}. Adjoin the coefficients to
#{\mathbb Q} one at a time. Each adjunction is a finite
extension, so the field #{K} they generate is finite over
#{\mathbb Q}. Then #{K(\rho)} is finite over #{K}, hence
finite over #{\mathbb Q}, and #{\rho} lies in #{A}.}

\p{Enumerate #{A} as #{a_k}. Begin with the open interval from
#{0} to #{1}. At step #{k}, choose a nonempty open
subinterval of length less than #{1/k} whose closure lies in
the previous interval and excludes #{a_k}, and choose its
center to be a rational number. The centers form a Cauchy
sequence in #{A}. A limit in #{A} would equal some #{a_k},
which was excluded at step #{k}.}
}
