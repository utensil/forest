\import{macros}
\meta{agent-authored}{true}

\taxon{Lemma}
\title{Matched protocols isolate a conditional policy contrast}
\tag{ftip}
\tag{finite-result}

\p{Let #{m\in\mathbb N_{\geq1}} and let #{Y_{1j},Y_{2j}\in\mathbb R} for
#{j=1,\ldots,m} be the paired scalar evaluator outcomes generated by the
protocol of \ref{ftip-00DU}. Then the finite paired contrast}

##{
\widehat\Delta=\frac1m\sum_{j=1}^{m}(Y_{1j}-Y_{2j})
}

\p{is a statistic of the declared policy contrast under that common protocol.
It is not an unconditional capability effect and does not identify what would
happen after changing any held-fixed coordinate.}
