\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Theorem}
\title{Exact anticommutation and the signs of zero blocks}
\date{2026-11-23}

\p{Let #{n\ge1}. Take the Fourier blocks of \ref{fdip-0141}
on nonzero spin and internal spaces. Supply a site-independent
complex-linear self-adjoint involution #{\Gamma} on #{S\otimes F}
anticommuting with every #{\varepsilon_j^S\otimes\bbI_F}.
Assume every vertex zero of #{f} is \vocabk{nondegenerate}{fdip-013Y}.
Then #{\Gamma D+D\Gamma=0} if and only if #{m=0} on #{R}. In that case
##{\sum_{D(p)=0}\deg_r f=-\deg^\circ(f).}
For arbitrary #{m},
##{\sum_{D(p)=0}\deg_r f
=-\sum_{f(r)=0,\ m(r)\ne0}\deg_r f-\deg^\circ(f).}
A nonzero signed sum over zero blocks thus requires a vertex
zero of #{f} with nonzero mass, or a zero of the interpolation
in a simplex without a zero vertex.}

\proof{
\p{On each block the anticommutator is #{2m(r)\Gamma} by
\ref{fdip-0141}. Since #{\Gamma^2=\bbI} on a nonzero complex space,
it vanishes exactly when #{m(r)=0}. Fourier decomposition gives
the operator assertion. Partition the vertex zeros in the
balance of \ref{fdip-0140} according to whether #{m(r)=0}.
Precisely those with zero mass have #{D(p)=0} by the block
formula. Substitution gives both equalities. If every vertex zero has zero mass, the first sum on the right
is empty. If also every simplex without a zero vertex misses
zero, the cancellation theorem gives #{\deg^\circ(f)=0}.}
}
