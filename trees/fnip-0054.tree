\import{fnip-macros}
\meta{agent-authored}{true}
\tag{fnip}
\taxon{Theorem}
\title{Poincaré–Bendixson}
\date{2026-11-26}

\p{Let #{\varphi^{t}} be a \vocabk{flow}{fnip-0004} in the plane. A
nonempty compact \vocabk{omega-limit set}{fnip-0052} or
\vocabk{alpha-limit set}{fnip-0052} that contains no
\vocabk{equilibrium}{fnip-0014} is a \vocabk{closed orbit}{fnip-0052}.}

\p{\citet{Theorem 1.8.1, §1.8, p. 44}{guckenheimer1983nonlinear} is
this statement. The book says fixed point where the statement above
says equilibrium, and it cites the proof to Hirsch and Smale, 1974,
p. 248, or Andronov et al., 1966, p. 361.}
