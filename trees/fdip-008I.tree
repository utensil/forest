\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Definition}
\title{The Pfaffian records signed pairings}
\date{2026-11-01}

\p{Let #{V} be a #{2m}-dimensional vector space over #{\mathbb R}
or #{\mathbb C}, and let #{b} be an alternating bilinear form on
#{V}. Write #{\Omega} for its image in #{\Lambda^2(V^*)}. The
\newvocab{Pfaffian} element is #{\Omega^m/m!} in the top line
#{\Lambda^{2m}(V^*)}. Given a nonzero top volume #{\omega}, the
scalar #{\operatorname{Pf}_\omega(b)} is the coefficient of
#{\omega} in that element. The empty Pfaffian, #{m=0}, is #{1}.
The scalar depends on the chosen volume. A coordinate matrix of
#{b} is the matrix of this alternating form in an ordered basis.
That matrix satisfies #{A^T=-A}; it is not a self-adjoint
endomorphism. \ref{fdip-00MD} records the matching formula, the
deletion recursion, and the values in dimensions two and #{4}.}

\transclude{fdip-00MD}
