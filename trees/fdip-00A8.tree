\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Theorem}
\title{Handle convolution computes the homomorphism count}
\date{2026-11-03}

\p{Let #{G} be a finite group, and choose one unitary representative
of each irreducible complex representation, as in the
\vocabk{surface data}{fdip-006V}. Write #{\dim\rho} for its dimension and
#{\chi_\rho} for its character. For an integer #{g\ge 0}, let
#{\Pi_g} be the group presented by generators
#{x_1,y_1,\ldots,x_g,y_g} and the single relation that the product
of the commutators #{x_iy_ix_i^{-1}y_i^{-1}} is the identity. The
case #{g=0} is the trivial group. Write a commutator as
#{[a,b]=aba^{-1}b^{-1}}, and write #{(\psi*\phi)(h)} for the
convolution #{\sum_{x\in G}\psi(x)\phi(x^{-1}h)}. Let #{\psi_g(h)}
be the number of #{2g}-tuples in #{G} whose product of commutators
equals #{h}, with the empty product equal to the identity. Then
each #{\psi_g} is a [class function](fgap-001M),
#{\psi_{g+1}=\psi_g*\psi_1}, and
##{\psi_g(h)=\sum_{\rho\in\widehat G}|G|^{2g-1}(\dim\rho)^{1-2g}\chi_\rho(h).}
The number of homomorphisms satisfies
##{\frac{|\operatorname{Hom}(\Pi_g,G)|}{|G|}
 =\sum_{\rho\in\widehat G}
 \left(\frac{|G|}{\dim\rho}\right)^{2g-2}.}}

\p{Let #{f} be the class function with #{f(1)=|G|} and with value
#{0} at every other group element. For every surface admitted by
the [finite surface character formula](fdip-006W), including the
exceptional one-vertex sphere,
##{Z_\Sigma(f)=\frac{\psi_g(1)}{|G|^{2g-1}}.}
Thus the normalized flat partition function depends on the
cellulation only through the genus, and it is the identity value
of the #{g}-fold handle convolution divided by #{|G|^{2g-1}}.}

\p{Attaching one handle is convolution with #{\psi_1}, and closing
the remaining boundary is evaluation at the identity. The papers
that identify this composition with the two-dimensional theory of
the center of the group algebra have not been read, and this note
does not state their result. Nothing proved here identifies the
\vocabk{pure-gauge transfer operator}{fdip-007Z} with this convolution.}

\proof{
\p{If #{\prod_i[a_i,b_i]=h}, replacing every entry by its
conjugate by a fixed element replaces the product by the conjugate
of #{h}. That replacement is a bijection of tuples, so #{\psi_g} is
a class function. Splitting off the last commutator gives
#{\psi_{g+1}(h)=\sum_x\psi_g(x)\psi_1(x^{-1}h)} for #{g\ge 0}. The
identity #{\psi_0(h)=1} when #{h=1}, and #{0} otherwise, is the
empty tuple.}

\p{Choose an orthonormal basis of each chosen unitary
representative, and write #{\rho(h)_{ij}} for the matrix
entries in that basis. The matrix orthogonality in \ref{fdip-006W} says
##{\frac1{|G|}\sum_{h\in G}
 \rho(h)_{ij}\tau(h^{-1})_{ab}
 =\begin{cases}
 (\dim\rho)^{-1}\delta_{ib}\delta_{ja},&\rho=\tau,\\
 0,&\rho\ne\tau.
 \end{cases}}
Unitarity gives #{\tau(h^{-1})_{ab}=\overline{\tau(h)_{ba}}}.
Relabelling the indices therefore gives
##{\frac1{|G|}\sum_{h\in G}
 \rho(h)_{ij}\overline{\tau(h)_{kl}}
 =\begin{cases}
 (\dim\rho)^{-1}\delta_{ik}\delta_{jl},&\rho=\tau,\\
 0,&\rho\ne\tau.
 \end{cases}}
Sum #{\rho(h)_{ii}\overline{\tau(h)_{kk}}} over the diagonal
indices #{i} and #{k}. The identity supplies a factor
#{(\dim\rho)^{-1}} only when #{i=k}, and there are #{\dim\rho} such
indices, so
##{\frac1{|G|}\sum_{h\in G}
 \chi_\rho(h)\overline{\chi_\tau(h)}=\begin{cases}
 1,&\rho=\tau,\\
 0,&\rho\ne\tau.
 \end{cases}}
In particular #{\sum_h|\chi_\rho(h)|^2=|G|}. The trace of
the unitary identity #{\tau(h^{-1})=\tau(h)^{\dagger}} gives
#{\chi_\tau(h^{-1})=\overline{\chi_\tau(h)}}.}

\p{Let #{f(h)=\sum_\rho \dim\rho\chi_\rho(h)}. The
[character expansion](fdip-006V) gives #{f} the coefficient
##{c_\tau=\frac1{|G|}\sum_h f(h)\overline{\chi_\tau(h)}=\dim\tau}
against #{\chi_\tau}. The class function #{|G|} at the identity
and #{0} elsewhere has the same coefficients, so
#{\sum_\rho \dim\rho\chi_\rho(h)} equals #{|G|} at the identity and
equals #{0} elsewhere. Thus
#{\psi_0=\sum_\rho(\dim\rho\,|G|^{-1})\chi_\rho}, and evaluating at the
identity gives #{\sum_\rho (\dim\rho)^2=|G|}.}

\p{For a linear map #{A} on the space of #{\rho}, the average
##{S(A)=\frac1{|G|}\sum_{g\in G}\rho(g)A\rho(g)^{-1}}
commutes with every #{\rho(h)}. Over #{\mathbb C} the
endomorphism #{S(A)} has an eigenvalue. Its eigenspace is
invariant, and irreducibility forces the eigenspace to be the
whole space, so #{S(A)} is scalar. Its trace equals
#{\trace A}, hence
#{S(A)=(\trace A/\dim\rho)\bbI}. Taking #{A=\rho(b)} gives
##{\sum_{a\in G}\rho(a)\rho(b)\rho(a)^{-1}
 =\frac{|G|}{\dim\rho}\chi_\rho(b)\,\bbI.}
Multiply by #{\rho(b)^{-1}} and sum over #{b}. The left side is
#{\sum_{a,b}\rho([a,b])}. The right side is
#{(|G|/\dim\rho)\sum_b\chi_\rho(b)\rho(b)^{-1}}.}

\p{Set #{C=\sum_b\overline{\chi_\rho(b)}\rho(b)}. Then
#{\rho(h)C\rho(h)^{-1}=C}, because #{\chi_\rho} is a class
function, so the same scalar argument gives
#{C=(|G|/\dim\rho)\bbI}. The trace computation uses
#{\sum_b|\chi_\rho(b)|^2=|G|}. The change of variable
#{b\mapsto b^{-1}} and
#{\chi_\rho(b)=\overline{\chi_\rho(b^{-1})}} identify
#{\sum_b\chi_\rho(b)\rho(b)^{-1}} with #{C}. Therefore
##{\sum_{a,b\in G}\rho([a,b])
 =\left(\frac{|G|}{\dim\rho}\right)^2 \bbI.}
Taking traces gives
#{\sum_{a,b}\chi_\rho([a,b])=|G|^2/\dim\rho}. Inverting a
commutator swaps the two summation variables, so the same sum
with #{\overline{\chi_\rho}} is equal. The coefficient in the
[character expansion](fdip-006V) is that sum divided by #{|G|},
hence #{|G|/\dim\rho}:
##{\psi_1=\sum_{\rho\in\widehat G}
 \frac{|G|}{\dim\rho}\chi_\rho.}}

\p{Expand the character convolution and insert a matrix product
for the second character:
##{(\chi_\rho*\chi_\tau)(z)
 =\sum_x\sum_{i,k,l}
 \rho(x)_{ii}\tau(x^{-1})_{kl}\tau(z)_{lk}.}
The matrix identity already displayed sums the variable #{x}:
the sum over #{x} of #{\rho(x)_{ii}\tau(x^{-1})_{kl}} equals
#{|G|(\dim\rho)^{-1}} when #{\rho=\tau}, #{i=l} and #{i=k}, and
equals zero otherwise. Multiplying by #{\tau(z)_{lk}} and
summing those indices leaves the trace of #{\tau(z)}, so
##{(\chi_\rho*\chi_\tau)(z)
 =\begin{cases}
 (|G|/\dim\rho)\chi_\rho(z),&\rho=\tau,\\
 0,&\rho\ne\tau.
 \end{cases}}
Consequently, if #{\alpha_\rho} and #{\beta_\rho} are the
character coefficients of two class functions, the coefficient of
#{\chi_\rho} in their convolution is
#{\alpha_\rho\beta_\rho(|G|/\dim\rho)}. Convolution against
#{\psi_1} multiplies the coefficient #{\alpha_\rho} by
#{|G|^2/(\dim\rho)^2}. Starting from #{\psi_0} and applying this
multiplication #{g} times gives the displayed formula for
#{\psi_g}.}

\p{A homomorphism #{{\Pi_g}\to G} is exactly a #{2g}-tuple whose
product of commutators is the identity, so
#{|\operatorname{Hom}(\Pi_g,G)|=\psi_g(1)}. The displayed
expansion at the identity is
#{|G|^{2g-1}\sum_\rho (\dim\rho)^{2-2g}}. Dividing by #{|G|} gives
the homomorphism formula.}

\p{For the stated face weight, the character expansion in
the [finite surface gauge data](fdip-006V) has #{c_\rho=\dim\rho}. Every ratio #{c_\rho/\dim\rho}
equals #{1}, so \ref{fdip-006W} gives
#{Z_\Sigma(f)=\sum_\rho (\dim\rho)^{2-2g}}. The evaluation of
#{\psi_g} at the identity is #{|G|^{2g-1}} times that sum.}
}
