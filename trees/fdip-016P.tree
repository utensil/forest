\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Definition}
\title{Lifts of reflections and quarter-turns}
\date{2026-11-26}

\p{Let #{n\ge1} with positive periods #{N_j}, and take the group
#{B_\Lambda} of \vocabk{period-preserving signed permutations}{fdip-0164}.
Let #{S} be a nonzero finite-dimensional complex Hermitian space.
For each direction choose a self-adjoint operator #{\varepsilon_j} on
#{S}. Supply a self-adjoint involution #{\Gamma} on #{S} with
##{\begin{gathered}
\varepsilon_i\varepsilon_j+\varepsilon_j\varepsilon_i
 =2\delta_{ij}\bbI_S,\\
\Gamma\varepsilon_j=-\varepsilon_j\Gamma .
\end{gathered}}
Thus the operators representing directions multiply by the Clifford
relations. Their products encode changes of several directions in
one operator.}

\p{Set
##{f_j=\Gamma\varepsilon_j,\qquad
u_{jk}=\frac{\bbI_S+\varepsilon_j\varepsilon_k}{\sqrt{2}}
\quad(j\ne k,\ N_j=N_k).}
The \newvocab{lift of the signed coordinate group},
written #{\operatorname{Pin}(B_\Lambda;\Gamma)}, is the group of
operators on #{S} generated by the #{f_j} and these #{u_{jk}}.
The grading #{\Gamma} and all represented directions are part of
the supplied data. The carriers in \ref{fdip-00IO} realize
these relations in both even and odd dimension.}
