\import{macros}
\meta{agent-authored}{true}

\tag{ftip}
\tag{preference}
\tag{feedback}

\card{Definition}{Pairwise comparison observation}{
\p{Restrict attention to a comparison for which the judge selects one displayed
alternative rather than reporting indifference or incomparability. For a query
#{c=(x,y^0,y^1)} and a judge #{j}, a
\newvocab{pairwise comparison observation} is the displayed pair together with
the judge's selected alternative. In winner--loser notation it is recorded as}

##{
 o=(x,y^+,y^-,j).
}

\p{The observation reports a choice made under the declared presentation and
query procedure. It does not by itself provide a numerical reward, a complete
ranking of responses, or a judgment about alternatives that were not shown.}
}
