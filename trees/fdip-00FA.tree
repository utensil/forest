\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Theorem}
\title{Cell densities of the ball assignment}
\date{2026-11-07}

\p{Fix an integer #{p\ge 2}, a depth #{k\ge 1}, and real
numbers #{\lambda>0} and #{m>0}. Let #{x_k} have the centered
Gaussian law of the
\vocabk{fixed-ratio precision}{fdip-00BY}, and let #{M_k} and
#{T_k} be the coordinate formula and rescaled class mean in
that definition. Set
##{F_k(r)=(p\lambda)^{k/2}x_k(r).}
Then #{F_k(r)=p^k M_k(r)}. Let #{A} be the class-mean map of
\ref{fdip-009A}. On every coherent sequence from
\ref{fdip-00C3},
##{(AF_k)(r)=F_{k-1}(r).}}

\proof{
\p{The coordinate formula gives
#{M_k(r)=\bigl(\frac{\lambda}{p}\bigr)^{k/2}x_k(r)}. Multiplication by the
number of residues produces
##{p^k M_k(r)=p^k\lambda^{k/2}p^{-k/2}x_k(r)=(p\lambda)^{k/2}x_k(r).}
The two expressions for #{F_k(r)} agree.}

\p{By the definition of #{T_k},
#{T_k=\sqrt{p\lambda}\,A}. Therefore
##{(AF_k)(r)=(p\lambda)^{k/2}(Ax_k)(r) =(p\lambda)^{(k-1)/2}(T_kx_k)(r).}
On a coherent sequence, \ref{fdip-00C3} gives
#{T_kx_k=x_{k-1}}. The right-hand side equals
#{F_{k-1}(r)}.}
}
