\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Definition}
\title{The insertion of an exterior covector}
\date{2026-11-17}

\p{Use the cochain module #{\mathcal V}, the vertex
projection #{\pr_x}, and the paired algebra
#{\mathcal A(\mathcal V)=\bigwedge(\mathcal V^*\oplus\mathcal V)}
of the \vocabk{dressed pair}{fdip-00WD}.
Let #{\iota_\psi:\mathcal V^*\to\mathcal V^*\oplus\mathcal V}
include the unbarred summand. For
#{\beta\in\bigwedge^s F_x^*}, define its
\newvocab{exterior insertion} by
##{P_{\beta,x}=
 \bigwedge\nolimits^s(\iota_\psi\circ\pr_x^*)(\beta)
 \in\mathcal A(\mathcal V).}
An \newvocab{exterior singlet} is such an insertion from a
covector fixed by the induced dual action of #{G}.}
