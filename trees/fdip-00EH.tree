\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Lemma}
\title{The nonnegative Laplacian reverses the source sign}
\date{2026-11-07}

\p{Let #{(V_n,L_n,E_n)} be a
\vocabk{compatible resistance sequence}{fdip-00EG}. Then
#{-L_n} satisfies the three Laplacian conditions of
\citet{Definition 3.7}{kigami2010resistance}, the pair
#{(E_n,\ell(V_n))} is a resistance form by
\citet{Proposition 3.8}{kigami2010resistance}, and the
sequence of operators #{-L_n} is compatible in the sense of
\citet{Definition 3.12}{kigami2010resistance}. For that
operator the cited energy is #{E_n}.}

\proof{
\p{The form #{E_n(u)=(u,L_nu)} equals the edge sum, because
each edge #{xy} contributes
#{c_{xy}\bigl(u(x)-u(y)\bigr)^2} once the cross terms are
collected. Thus #{L_n} is symmetric and nonnegative. The
operator #{-L_n} is nonpositive. Its off-diagonal entry from
#{x} to #{y} is the conductance #{c_{xy}\ge 0}. Its kernel
is the constants, because that is the kernel of #{L_n}.
These are the three conditions. Proposition 3.8 of the cited
exposition therefore makes #{(E_n,\ell(V_n))} a resistance
form, since
##{E_n(u)=-\bigl(u,(-L_n)u\bigr).}
The trace identity in the definition is the compatibility
condition of Definition 3.12 for the operators #{-L_n}.}
}
