\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Proposition}
\title{Continuity at zero external field}
\date{2026-11-19}

\p{Consider a real \vocabk{orbit weight}{fdip-00ZW} with fixed finite
configuration set. Let its site and edge factors depend on a real
parameter #{\eta}, with every factor continuous at #{0} for each
choice of its arguments. If #{Z(0)\ne0}, the normalized mean of
any fixed finite-dimensional real vector-valued observable #{f} is
defined near #{0} and tends to its value at #{0}. In particular, a
weight invariant at #{0} with #{F^G=0} gives
#{\lim_{\eta\to0}\langle\phi_x\rangle_\eta=0} for a finite-dimensional
real field module #{F}.}

\proof{
\p{Every configuration weight is a finite product of continuous-at-zero
functions. Its partition and its weighted observable value are finite
sums of such terms, hence continuous at zero. Continuity and
#{Z(0)\ne0} keep the denominator nonzero in a neighborhood of zero.
Dividing gives the asserted limit. For the field evaluation the
zero-field value follows from \ref{fdip-00ZY}, or directly by
equivariant reindexing whenever the weight itself is invariant.}
}

\p{For a real inner product and a supplied field vector #{u}, multiply
the site factors by #{\ue^{\eta\langle u,\phi_x\rangle}}. These positive
continuous factors can distinguish two points on the same orbit;
at #{\eta=0} they all equal #{1}.}
