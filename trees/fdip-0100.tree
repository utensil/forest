\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Proposition}
\title{The normalized mean at zero external field}
\date{2026-11-19}

\p{Consider a real \vocabk{orbit weight}{fdip-00ZW} with a fixed finite
configuration set. Let its site and edge factors depend on a real
parameter #{\eta}. At #{\eta=0} the partition and the weighted value
of a fixed finite-dimensional real observable are the finite sums of
the configuration weights at zero. If #{Z(0)\ne0}, the normalized mean
equals that zero-field value. In particular, a weight invariant at
#{0} with #{F^G=0} gives #{\langle\phi_x\rangle_{\eta=0}=0} for a
finite-dimensional real field module #{F}.}

\proof{
\p{At #{\eta=0} every configuration weight is the product of its site
and edge factors at zero. The partition and the weighted value are
finite sums of these products. Division by the nonzero value #{Z(0)}
is the normalized mean. For the field evaluation, the zero-field value
is zero by \ref{fdip-00ZY}, or directly by equivariant reindexing when
the weight itself is invariant.}
}

\p{For a real inner product and a supplied field vector #{u}, multiply
the site factors by #{\ue^{\eta\langle u,\phi_x\rangle}}. These factors
equal #{1} at #{\eta=0}. A noninvariant site factor specifies explicit
breaking.}
