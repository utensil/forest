\import{macros}
\meta{agent-authored}{true}

\taxon{Definition}
\title{Costed post-training potential}
\tag{ftip}
\tag{post-training}
\tag{scaling-law}

\p{Fix a base artifact #{M_0}, evaluation law #{\mathcal Q_{\mathrm{ev}}},
evaluation protocol #{D}, inference budget #{b}, lifecycle budget vector #{B},
and admissible class #{\mathfrak P}. The \strong{costed post-training
potential} is the FTIP proposal}

##{
  \Phi(M_0,\mathcal Q_{\mathrm{ev}},D,b,B,\mathfrak P)
  =\sup\left\{\Delta_{\mathrm{ev}}(P;D,b):
    P\in\mathfrak P,\ \mathbb E[C(P)]\leq B,
    \operatorname{Trust}(P)\right\},
}

\p{where the budget inequality is componentwise. The supremum ranges over
protocols, not over unconstrained parameter vectors. It is conditional on the
declared base artifact and evaluation.}

\p{No cited paper defines this quantity or proves that it follows a power law.
It packages the research question so candidate upper bounds, lower bounds, and
counterexamples can name the same inputs.}
