\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Remark}
\title{The declared form is the derived form, assumed}
\date{2026-11-12}

\p{Every row of \ref{fdip-00O5} holds when the quadratic form is
the derived form #{q_x} of \ref{fdip-00PB}. The form declared in
that proposition is the special case in which this derived form
is assumed. The bilinear form used there may be taken to be the
diagonal form #{B_x}, which satisfies #{B_x(v,v)=q_x(v)} with
no division by #{2}.}
