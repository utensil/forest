\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Lemma}
\title{The inverse on the vertex coefficient}
\date{2026-11-17}

\p{In the \vocabk{one-vertex Hurwitz model}{fdip-00ZA},
let #{\iota_0:F\to\mathcal V} and
#{\pr_0:\mathcal V\to F} be the degree-zero inclusion
and projection of the \vocabk{dressed pair}{fdip-00WD}.
Use #{s,t} from \ref{fdip-00ZD}. If #{m\ne0} and
#{(m^2-s)^2-t\ne0}, then #{K_{U,V}(m)} is invertible, and its inverse
has degree-zero block
##{\pr_0K_{U,V}(m)^{-1}\iota_0
=\frac{m(m^2-s)}{(m^2-s)^2-t}\bbI_F.}}

\proof{
\p{By \ref{fdip-00ZD}, #{K} is invertible.
Solve #{K(v,w)=(f,0)} in even/odd order. The odd equation gives
#{w=-m^{-1}Av}. Substituting in the even equation gives
#{(m^2\bbI -A^\dagger A)v=mf}. The identity #{B^2=t\bbI}
there implies
##{\bigl((m^2-s)\bbI -B\bigr)^{-1}
=\frac{(m^2-s)\bbI+B}{(m^2-s)^2-t}.}
Thus the even-to-even block of #{K^{-1}} is #{m} times
this inverse. The two diagonal blocks of #{B} are zero.
Projecting onto the degree-zero slot gives the formula.}
}
