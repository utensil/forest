\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Lemma}
\title{Yukawa covariance on every based cell}
\date{2026-11-19}

\p{For the \vocabk{onsite Yukawa operator}{fdip-011M}, let
#{\mathcal G_g} act on each cochain fibre by the vertex gauge
#{g} at its base corner. Then on all cochain degrees
##{\begin{aligned}
 Y_{\phi^g}&=\mathcal G_gY_\phi\mathcal G_g^{-1},\\
 K_{U^g,\phi^g}&=\mathcal G_gK_{U,\phi}\mathcal G_g^{-1}.
\end{aligned}}}

\proof{
\p{On a cell based at #{x}, conjugating the onsite term acts on
its fibre by
#{\rho_\psi(g_x)Y(\phi_x)\rho_\psi(g_x)^{-1}=Y(g_x\phi_x)}.
The exterior direction is unchanged. This calculation uses only
the cell's base label, so it applies across a periodic seam and
to the cells of a period-one direction. The mass term commutes
with every gauge and the cochain term is covariant by
\ref{fdip-00SS}. Adding the three terms proves the kernel identity.}
}
