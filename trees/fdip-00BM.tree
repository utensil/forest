\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Remark}
\title{The mean matches a normalized integral}
\date{2026-11-06}

\p{Each block occupies an interval of length #{1/B}. The mean
of the mesh values on that block is the counterpart of #{B}
times the integral of a continuum field over the interval.
The factor #{B} turns the integral into a mean. The
comparison uses this normalization of the field in
\ref{fdip-004I}, with no further factor #{\sqrt{n}}.}
