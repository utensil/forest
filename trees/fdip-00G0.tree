\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Theorem}
\title{Converging coefficients share one mass}
\date{2026-11-07}

\p{Fix an integer #{R\ge 1}. For each integer #{N>2R}, let
#{c_{r,N}=c_{-r,N}} be real numbers for #{1\le |r|\le R},
and let #{\mu_N>0}. Write
##{\alpha_N(\theta)
=\sum_{1\le |r|\le R}c_{r,N}\bigl(1-\cos(r\theta)\bigr),}
and suppose #{c_{r,N}\to c_r} and #{\mu_N\to\mu>0}. Let
#{\alpha} be the symbol formed with the coefficients #{c_r},
and assume #{\alpha(\theta)>0} whenever #{\theta} is not an
integer multiple of #{2\pi}, together with
#{\kappa=\sum_{r=1}^{R}c_r r^2>0}. Define #{A_N} by
##{(A_Nx)(j)
=\sum_{1\le |r|\le R}c_{r,N}\bigl(x(j)-x(j+r)\bigr)}
on the residues modulo #{N}, and set
#{Q_N=\mu_N I+N^2A_N}. For every sufficiently large #{N},
#{Q_N} is a \vocabk{positive precision parameter}{fdip-0004}.
If #{c_{r,N}=c_r} and #{\mu_N=\mu} for every #{N}, then
#{Q_N} is the
\vocabk{finite-range circle precision}{fdip-00C8} and the
moment below is the moment of \ref{fdip-00CC}.}

\p{Let #{x} be a field with the centered
\vocabk{Gaussian probability law}{fdip-0005} of precision
#{Q_N}, and set #{\varphi=\sqrt{\kappa N}\,x}, where
#{\kappa} is the limiting coefficient. For
#{N>2R} large enough that #{Q_N} is positive, and for an
integer #{k},
##{a_{N,k}=N^{-1}\sum_{j=0}^{N-1}
\ue^{-2\pi \ui kj/N}\,\varphi(j)}
satisfies
##{\mathbb E|a_{N,k}|^2
=\frac{\kappa}{\mu_N+N^2\alpha_N(2\pi k/N)}.}
Frequencies distinct modulo #{N} are uncorrelated. For any
finite set of integers #{k}, the joint law of these modes
converges as #{N\to\infty}. The limit is the centered
Gaussian law on those modes whose second moments are
#{1/(m^2+4\pi^2k^2)} with #{m^2=\frac{\mu}{\kappa}}, and whose
cross moment #{E(a_ka_\ell)} equals that variance when
#{\ell=-k} and equals #{0} for every other pair in the set.
The field is real, so both moments are kept: the conjugate
covariance #{\mathbb E(a_{N,k}\overline{a_{N,\ell}})} vanishes
when #{k\not\equiv\ell\pmod{N}}, and the unconjugated moment
is the cross moment just stated, including #{\ell=-k}.
Positivity of #{Q_N} is eventual, not claimed for every #{N}.}

\proof{
\p{Let #{h} be the complexified counting Hermitian product,
conjugate-linear in its first argument. On real functions it
is the counting inner product. Reindexing as in \ref{fdip-00CB}, and the equality
#{c_{r,N}=c_{-r,N}}, make #{A_N} and #{Q_N} self-adjoint.
The same computation gives
eigenvalue #{\alpha_N(2\pi k/N)} for #{A_N} on the Fourier
vector with entries #{\ue^{2\pi \ui kj/N}}, and eigenvalue
#{\mu_N+N^2\alpha_N(2\pi k/N)} for #{Q_N}.}

\p{The identity #{1-\cos u=2\sin^2(u/2)} gives, for
#{0<\theta\le\pi},
##{\frac{\alpha(\theta)}{\theta^2}
=\sum_{r=1}^{R}c_r r^2
\Bigl(\frac{\sin\frac{r\theta}{2}}{\frac{r\theta}{2}}\Bigr)^2.}
For #{u\ne 0},
#{\frac{\sin u}{u}=\frac{1}{u}\int_0^u\cos t\,dt} tends to #{1}
as #{u\to 0}, so #{\frac{\alpha(\theta)}{\theta^2}} tends to
#{\kappa}. Extend it by #{\kappa} at
#{0}. The extension is continuous and positive on the
interval from #{0} to #{\pi}, so its minimum #{c_0} is
positive. Since #{\alpha} is even,
#{\alpha(\theta)\ge c_0\theta^2} whenever #{|\theta|\le\pi}.}

\p{For every real #{v},
#{|\sin v|=\bigl|\int_0^v\cos t\,dt\bigr|\le |v|}, so
#{1-\cos(r\theta)\le r^2\theta^2/2}. Therefore
##{\bigl|\alpha_N(\theta)-\alpha(\theta)\bigr|
\le\theta^2\sum_{r=1}^{R}r^2|c_{r,N}-c_r|}
whenever #{|\theta|\le\pi}. For every sufficiently large
#{N}, the sum on the right is at most #{c_0/2} and
#{\mu_N\ge\frac{\mu}{2}}. Then
#{\alpha_N(\theta)\ge(c_0/2)\theta^2} on that interval. The
zero Fourier mode has eigenvalue #{\mu_N>0}. Every other
mode has angle outside #{2\pi\mathbb Z}, so its eigenvalue
is positive. Hence #{h(x,Q_Nx)>0} for #{x\ne 0}.}

\p{Declare the counting basis of site indicators. In that basis
#{h(f,g)=\sum_j\overline{f(j)}g(j)}, and a column product
#{v^*Mv} equals #{h(v,Mv)}. Let #{v_k} be the Fourier vector
above, so
#{v_k^*v_k=h(v_k,v_k)=N} and #{Q_Nv_k=\lambda_k v_k} with
#{\lambda_k=\mu_N+N^2\alpha_N(2\pi k/N)}. By \ref{fdip-000B}, scaling the covariance #{Q_N^{-1}} of
#{x} by #{\kappa N} gives the counting covariance of
#{\varphi}. Thus
##{\mathbb E|a_{N,k}|^2
=N^{-2}v_k^*(\kappa NQ_N^{-1})v_k
=N^{-2}h\bigl(v_k,(\kappa N Q_N^{-1})v_k\bigr)
=\kappa\lambda_k^{-1}.}
If #{k\not\equiv\ell\pmod{N}}, the vectors are orthogonal
and the conjugate covariance #{\mathbb E(a_{N,k}\overline{a_{N,\ell}})}
vanishes. The unconjugated product moment pairs that covariance with
#{v_k} and #{v_{-\ell}}. Those vectors are orthogonal unless
#{\ell\equiv -k\pmod{N}}, in which case the moment equals
#{\frac{\kappa}{\lambda_k}}. Large #{N} separates a fixed finite
set modulo #{N}. Those moment limits determine the centered
Gaussian law.}

\p{If #{k=0}, then #{\alpha_N(0)=0} and the moment equals
#{\frac{\kappa}{\mu_N}}, which tends to #{1/m^2}. If #{k\ne 0},
fix #{N>2R|k|}. Then
##{N^2\alpha_N(2\pi k/N)
=\sum_{r=1}^{R}4c_{r,N}
\Bigl(N\sin\frac{\pi rk}{N}\Bigr)^2.}
The sine quotient gives #{N\sin(\pi rk/N)\to r\pi k}, so
#{N^2\alpha_N(2\pi k/N)\to 4\pi^2k^2\kappa}, and
##{\frac{\kappa}{\lambda_k}\to
\frac{\kappa}{\mu+4\pi^2\kappa k^2}
=\frac{1}{m^2+4\pi^2k^2}.}
}
}
