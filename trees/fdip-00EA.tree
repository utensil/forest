\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Remark}
\title{Selection fixes a nearest-neighbor shape}
\date{2026-11-07}

\p{\ref{fdip-00AY} characterizes the shapes #{t_N>1} that
obey #{T_q(t_{qN})=t_N} for every integer #{q\ge 2} and whose
difference #{t_N-1} is asymptotic to #{c/(2N^2)} with
#{c>0}. The shape is #{\cosh(m/N)} with #{c=m^2}. The
relation is a relation among nearest-neighbor cycle
precisions. A [finite-range circle precision](fdip-00C8)
may have range greater than #{1}, and it may have a negative
coefficient #{c_r}. The characterization does not remove
those models from the definition.}
