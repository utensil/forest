\import{macros}
\meta{agent-authored}{true}

\taxon{Theorem}
\title{Zero-hit likelihood under iid evaluation}
\tag{ftip}
\tag{probability}
\tag{statistics}

\p{Let #{m\in\mathbb N_{\geq1}}. Assume the hit indicators from
\ref{ftip-009Y} are independent Bernoulli variables with a common success
probability #{p}. Then
#{K_m} has the binomial law and}

##{
 \Pr_p(K_m=0)=(1-p)^m.
}

\proof{
\p{The event #{K_m=0} is
#{\bigcap_{j=1}^m\{I_j^\star=0\}}. Independence and
#{\Pr_p(I_j^\star=0)=1-p} give the displayed product.}}

\p{This finite statement follows from the displayed hypotheses. Applying it to a source table
requires the additional iid and stationary-success assumptions stated above.}
