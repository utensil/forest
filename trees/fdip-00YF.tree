\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Example}
\title{The integral exterior plane}
\date{2026-11-17}

\p{Take #{V=\mathbb Z^2} with basis #{e_1,e_2},
#{b(e_i,e_j)=\delta_{ij}}, and #{q(v)=b(v,v)}. The ordered
basis
##{1,\quad e_1,\quad e_2,\quad e_1\wedge e_2}
of the [internal exterior module](fdip-00YE) has Gram
matrix #{\bbI_4}: the last diagonal entry is
#{\det\left(\begin{smallmatrix}1&0\\0&1\end{smallmatrix}\right)=1},
and all cross-degree pairings vanish. Thus #{E} is free of rank
#{4} with a perfect integral pairing. Extension to #{\mathbb Q}
gives a positive definite pairing.}
