\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Example}
\title{Trivial links}
\date{2026-11-26}

\p{Let #{U_j(x)=\bbI_F} at every link. Each block of #{\Gamma K_U} on a momentum
#{r\in R} has the eigenvalues #{b(r)} and #{-b(r)} in equal numbers by \ref{fdip-014F}, and
#{b(r)>0}. Then #{U} is regular and #{\operatorname{ind}(U)=0}.}
