\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Definition}
\title{Measurable observables and maps}
\date{2026-10-25}

\p{A \newvocab{measurable map} #{f:(X,\Sigma)\to(Y,\mathcal T)}
satisfies #{f^{-1}(B)\in\Sigma} for every #{B\in\mathcal T}.
A \newvocab{Borel observable} on #{X_V} is a measurable real-valued
function for #{\mathcal B(X_V)} and #{\mathcal B(\mathbb R)}.
This is the preimage convention of
\citet{Definition 1.4.32 and Remark 1.4.33, pp. 95-96, preliminary version}{tao2011measure}.}
\p{Compositions of measurable maps are measurable because
#{(g\circ f)^{-1}(B)=f^{-1}(g^{-1}(B))}. The
[coordinate criterion](fdip-002G) supplies the maps
used for real fields. Measurability does not imply integrability.
The [integrable-observable space](fdip-0006) is a vector space, whereas
[polynomial functions](fdip-002A) form a separate observable algebra;
finite #{V} does not make the configuration set #{X_V} finite.}
