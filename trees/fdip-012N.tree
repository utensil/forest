\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Example}
\title{The pairing of the residual vector}
\date{2026-11-21}

\p{Let #{v} and #{\Gew} be as in \ref{fdip-0126}, and use the Hermitian
product of \ref{fdip-0127}. The normalized pairing below is the
one that \ref{fdip-012F} turns into a double-coset kernel. For a Hurwitz unit
#{u=a+b\qi+c\qj+d\qk} and the matrix #{M(u)} of \ref{fdip-00M6},
##{\frac{\langle v,M(u)v\rangle}{\langle v,v\rangle}
 =a-\ui(b+c+d)\frac{\sqrt{3}}{3}.}
For the class #{\,[u,m]\,}, the normalized pairing equals the real
part of #{\gamma^{-m}} times this value.}

\proof{
\p{Let #{\beta=(\sqrt{3}-1)/2} and #{\alpha=\beta(1+\ui)}, as in
\ref{fdip-0126}, so #{v=(1,\alpha)}. Then
#{|\alpha|^2=2\beta^2}. From
#{\beta^2=(2-\sqrt{3})/2} one gets #{2\beta^2=2-\sqrt{3}} and
##{\langle v,v\rangle=1+2\beta^2=3-\sqrt{3}.}
Write #{z=a+b\ui} and #{w=c+d\ui}. The product
#{(c+d\ui)(1+\ui)=(c-d)+\ui(c+d)} gives
##{w\alpha=\beta\bigl((c-d)+\ui(c+d)\bigr).}
The same expansion of #{(a-b\ui)(1+\ui)} gives the second
coordinate of the image. Thus #{M(u)v} has coordinates
##{a+\beta(c-d)+\ui\bigl(b+\beta(c+d)\bigr)}
and
##{-c+\beta(a+b)+\ui\bigl(d+\beta(a-b)\bigr).}
Conjugation of the first coordinate contributes its real part
#{a+\beta(c-d)}. Multiplication of the conjugated second coordinate
by #{\alpha=\beta(1+\ui)} contributes
#{\beta} times the sum of that coordinate's real and imaginary
parts. Those parts sum to #{d-c+2a\beta}, so the real part of the
product is
##{a+\beta(c-d)+\beta(d-c+2a\beta)=a+2a\beta^2
 =a\langle v,v\rangle.}
The imaginary part receives the negative of
#{b+\beta(c+d)} and #{\beta} times the difference of the second
coordinate's real and imaginary parts. That difference is
#{-(c+d)+2b\beta}, and the imaginary part simplifies to
##{-b-2\beta(c+d)+2b\beta^2=(b+c+d)(2\beta^2-1),}
where the cross term uses #{-2\beta=1-\sqrt{3}=2\beta^2-1}. Thus
the imaginary part equals #{(b+c+d)(1-\sqrt{3})}. Dividing by
#{3-\sqrt{3}} leaves the real part #{a}. The imaginary quotient is
##{(b+c+d)\frac{1-\sqrt{3}}{3-\sqrt{3}}
 =-(b+c+d)\frac{\sqrt{3}}{3},}
because
#{(1-\sqrt{3})(3+\sqrt{3})=-2\sqrt{3}} and the denominator
#{(3-\sqrt{3})(3+\sqrt{3})} equals #{6}. Scalar multiplication by
#{\gamma^m} pulls out #{\gamma^{-m}}, since the product is
conjugate-linear in its second argument and
#{\overline{\gamma}=\gamma^{-1}}. The normalized real pairing is
the real part of #{\gamma^{-m}} times the displayed value.}
}
