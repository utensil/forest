\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Example}
\title{The pairing of the residual vector}
\date{2026-11-21}

\p{Let #{v} and #{\Gew} be as in \ref{fdip-0126}, and use the Hermitian
product of \ref{fdip-0127}. The normalized pairing below is the
one that \ref{fdip-012F} turns into a double-coset kernel. For a Hurwitz unit
#{u=a+b\qi+c\qj+d\qk} and the matrix #{M(u)} of \ref{fdip-00M6},
##{\frac{\langle v,M(u)v\rangle}{\langle v,v\rangle}
 =a-\ui(b+c+d)\frac{\sqrt{3}}{3}.}
For the class #{\,[u,m]\,}, the normalized pairing equals the real
part of #{\gamma^{-m}} times this value.}

\proof{
\p{The displayed quotient is the normalized pairing of the
residual vector of \ref{fdip-0126}. \ref{fdip-012F} turns that
pairing into a double-coset kernel. For the class
#{\,[u,m]\,}, scalar multiplication by #{\gamma^m} pulls out
#{\gamma^{-m}}, because the Hermitian product of
\ref{fdip-0127} is conjugate-linear in its second argument and
#{\overline{\gamma}=\gamma^{-1}}. The normalized real pairing
is the real part of #{\gamma^{-m}} times the displayed value.}
}
