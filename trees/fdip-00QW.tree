\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Remark}
\title{The upright imaginary unit}
\date{2026-11-13}

\p{A complex scalar that belongs to a supplied algebra is the upright
#{\ui}, distinct from an index #{i}. Physics writes an italic #{i}.
Geometric algebra uses a unit bivector, or the pseudoscalar, for a
square root of #{-1}. At #{z=\ui} the scalar is part of the algebra
that was given.}
