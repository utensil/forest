\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Remark}
\title{The complex unit}
\date{2026-11-13}

\p{A complex scalar that belongs to a supplied algebra is #{\ui},
distinct from an index #{i}. Physics writes #{i}. Geometric algebra
uses a unit bivector, or the pseudoscalar, for a square root of
#{-1}. At #{z=\ui} the scalar is part of the algebra that was given.}
