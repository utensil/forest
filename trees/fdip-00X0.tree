\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Proposition}
\title{Invariant tensors contract transported fields}
\date{2026-11-17}

\p{If #{t\in(F_x^*)^{\otimes s}} is invariant under
the diagonal dual action of #{G}, the
\vocabk{tensor contraction}{fdip-00WY} is a
\vocabk{gauge-invariant family}{fdip-00TU}.}

\proof{
\p{Write #{G_v=\rho(g(v))}. The endpoint formula in
\ref{fdip-00WF} gives
#{h_j(U^g)=G_xh_j(U)G_{y_j}^{-1}}.
Invariance of #{t} means
#{t(G_xv_1,\ldots,G_xv_s)=t(v_1,\ldots,v_s)}
as a multilinear identity. Consequently
##{P_{t,\boldsymbol\gamma}(U^g)
 =t\bigl(h_1(U)G_{y_1}^{-1}\psi_{y_1},
          \ldots,h_s(U)G_{y_s}^{-1}\psi_{y_s}\bigr)
 =R_gP_{t,\boldsymbol\gamma}(U).}
The notation #{t(\cdots)} denotes the ordered
contraction of the definition. Expansion in a fiber
basis extends the multilinear invariance identity to
these algebra-valued arguments; no permutation of
odd factors occurs.}
}
