\import{macros}
\meta{agent-authored}{true}

\taxon{Definition}
\title{Finite vocabulary}
\tag{ftip}
\tag{language-model}

\p{A \newvocab{vocabulary} is a finite, nonempty set #{\mathcal V}. Its
elements are called \newvocab{tokens}. We write #{|\mathcal V|} for the
number of tokens and use token identifiers only as names for elements of
#{\mathcal V}.}

\p{The separation between a vocabulary and the text it represents follows
the treatment of tokenization in \citet{sec. 4}{phuong2022formal}. Finiteness
lets the next-token output be a finite probability vector. It does not require
tokens to be words or characters.}
