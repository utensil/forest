\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Example}
\title{The two-path area contraction}
\date{2026-11-17}

\p{For the area tensor
#{t=e^1\otimes e^2-e^2\otimes e^1} on #{k^2},
let #{a=h_1(U)\psi_{y_1}} and
#{b=h_2(U)\psi_{y_2}}. The
[tensor contraction](fdip-00WY) is
#{a_1b_2-a_2b_1}. If the fiber action has determinant
one, this tensor is invariant.}

\p{If both vertices equal #{x} and both paths are empty,
the same formula is #{2\psi_{x,1}\psi_{x,2}}, as in
\ref{fdip-00WV}. It is not the exterior insertion
#{\psi_{x,1}\psi_{x,2}} itself. With separated vertices
the 4 generators belong to their specified slots;
no identification of the two transported fields is made.}
