\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Theorem}
\title{The index of a Ginsparg–Wilson operator}
\date{2026-11-23}

\p{For a \vocabk{Ginsparg–Wilson operator}{fdip-0148} #{D}
with grading #{\Gamma}, its ordinary kernel has
\vocabk{index}{fdip-013N}
##{\begin{aligned}
\sdim\ker D
 &=\dim\mathcal H_{++}-\dim\mathcal H_{--}\\
 &=\tfrac12\trace(\Gamma+\Gamma')
 =\trace\Gamma-\tfrac a2\trace(\Gamma D).
\end{aligned}}
The index of #{\ker(D-2a^{-1}\bbI)} is
#{\dim\mathcal H_{+-}-\dim\mathcal H_{-+}}. The two indices
sum to #{\trace\Gamma}. In particular they are opposite for a
balanced grading.}

\proof{
\p{In the decomposition of \ref{fdip-014A}, the two gradings
agree on the kernel and are opposites on the #{2a^{-1}}
eigenspace. Each has trace zero on the remaining summand. Thus
the trace of their half-sum is the difference of the dimensions of the two grading
spaces in the kernel. Substituting #{\Gamma'=\Gamma-a\Gamma D} gives the
second trace expression. The trace of #{\Gamma} alone adds the
differences on the two real eigenspaces.}
}
