\import{fnip-macros}
\meta{agent-authored}{true}
\tag{fnip}
\taxon{Definition}
\title{Trajectory of a vector field}
\date{2026-11-25}

\p{A \newvocab{vector field} on an open set #{U\subseteq\mathbb{R}^{k}}
is a map #{f: U\to\mathbb{R}^{k}}. A \newvocab{trajectory} of #{f}
through a point #{x_{0}\in U} is a differentiable map #{x} from an open
interval #{I}, with #{0\in I}, into #{U}, satisfying
#{x(0)=x_{0}} and #{\dot x(t)=f(x(t))} for every #{t\in I}.}

\p{Write #{\varphi^{t}(x_{0})} for the point #{x(t)}.
Along this trajectory, #{x(t+s)} equals the time-#{t} point of the
trajectory that starts at #{x(s)}, whenever #{s}, #{t} and #{t+s}
lie in #{I}. That is the second identity of the
\vocabk{flow}{fnip-0004}, read at the initial point #{x(s)}.}

\p{\citet{Theorem 1.0.1, §1.0, p. 3}{guckenheimer1983nonlinear}
supplies one trajectory on an interval #{(-c,c)} when #{f} is
continuously differentiable.
\citet{§1.2, p. 10}{guckenheimer1983nonlinear}
gives #{e^{tA}} as the flow of the linear field #{x\mapsto Ax}.}
