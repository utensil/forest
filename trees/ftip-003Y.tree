\import{macros}
\meta{agent-authored}{true}

\tag{ftip}
\tag{process-supervision}
\tag{credit-assignment}

\refcardt{Remark}{Terminal and intermediate supervision}{Sections 2.5--2.6}{lightman2023verify}{
\p{Outcome supervision uses one completed-response label, whereas process
supervision supplies labels at declared intermediate steps. The latter can
localize feedback, but it also requires a segmentation, a step-labeling
criterion, and additional annotations.}

\p{Neither label type is automatically causal credit. A process label may be
assigned after a reviewer has seen the whole response, and a terminal outcome
may be predicted reliably from an early prefix without identifying which
action should change.}
}
