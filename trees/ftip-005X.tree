\import{macros}
\meta{agent-authored}{true}

\taxon{Definition}
\title{Uniform task-family acquisition witness}
\tag{ftip}
\tag{acquisition}

\p{Fix a finite, independently selected family
#{G\subseteq\mathcal X_{\mathsf T_{\rm ev}}}, thresholds
#{0\leq\alpha<\beta\leq1}, and the common evaluation interface of
\ref{ftip-005D}. Protocols #{P_0} and #{P_1} have a
\strong{uniform task-family acquisition witness} on #{G} when}

##{
 p_{P_0}(x)\leq\alpha
 \quad\hbox{and}\quad
 p_{P_1}(x)\geq\beta
 \qquad\text{for every }x\in G.
}

\p{For each #{x}, the successful event in \ref{ftip-005U} supplies the
fixed-budget transfer event in \ref{ftip-0007}. The displayed inequalities
specialize that earlier acquisition witness with
#{\varepsilon_0=\alpha} and #{\varepsilon_1=\beta}, then require the
specialization uniformly over #{G}.}
