\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Theorem}
\title{The finite inverse-Jacobian identity}
\date{2026-11-17}

\p{For the \vocabk{paired degree scaling}{fdip-00UD}
and every endomorphism #{K_0} odd in cell degree,
##{\alpha_u(\theta_{K_0})=\theta_{K_0},\qquad
 \alpha_u(\Omega_V)=u^{2\chi(Y)r}\Omega_V.}
As an identity of linear functionals on the entire paired
algebra,
##{\mathcal I_V\circ\alpha_u^{-1}
 =u^{-2\chi(Y)r}\mathcal I_V.}
The coefficient functional is invariant under this pullback
if and only if #{u^{2\chi(Y)r}=1}.}

\proof{
\p{A nonzero matrix entry of #{K_0} joins cell degrees
#{p,q} of opposite parity. The corresponding quadratic
term acquires the factor
#{u^{(-1)^p+(-1)^q}=1}. This proves invariance of the
massless bilinear, and \ref{fdip-00TH} also gives invariance
of its finite exterior exponential.}

\p{The top word contains both paired generators for every
fiber coordinate of every cell. Its factor is
##{\prod_p u^{2(-1)^pc_pr}=u^{2\chi(Y)r}.}
The scaling preserves exterior degree. Lower-degree words
still have coefficient zero, while the top word acquires
the reciprocal factor under #{\alpha_u^{-1}}. This proves
the functional identity. If the factor is one, invariance
follows; conversely, evaluate invariance on #{\Omega_V},
whose coefficient is one. This proves the equivalence even
when a particular massless partition coefficient vanishes.}
}
