\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Example}
\title{Twisted spins and four-dimensional gauge duality}
\date{2026-11-11}

\p{In dimension #{d=3}, \ref{fdip-00NO} has #{r=1}.
The dual variable #{\alpha\in C^0(K^*;A)} is a cyclic
spin at each dual vertex. On an oriented dual edge #{e^*},
#{(\delta\alpha)_{e^*}=\alpha(h(e^*))-\alpha(s(e^*))}.
Each plaquette weight is therefore a difference weight
on the transverse dual edge, shifted by #{h_s}.
There are #{N^3} twisted sectors, redundancy #{N}, and
normalized dual-average prefactor #{N^{n_0^*-1}}.
The usual cosine clock weight is the specialization
##{\widehat w_p(x)=c_p\exp(\kappa_p\cos(2\pi x/N))}
over #{\mathbb C} with #{c_p>0} and #{\kappa_p\in\mathbb R}. General
Fourier weights need not have this form or be positive,
as \ref{fdip-00NK} demonstrates.}

\p{In dimension #{d=4}, #{r=2} and
#{\alpha\in C^1(K^*;A)} is again a link field.
The dual partition sum uses plaquette weights #{\widehat w_p},
redundancy #{N^{n_0^*+3}}, prefactor
#{N^{n_1^*-n_0^*-3}}, and #{N^6} flux sectors.
This is self-duality of the field's form degree.
Equality of the original and transformed weight families,
including their constants, is an additional property.
These degree changes agree with
\citet{Section 6, pp. 12–13}{wegner2014duality}.}

\p{Two explicit weights check the sector normalization.
If every #{w_p=1}, Fourier orthogonality gives
#{\widehat w_p(m)=\mathbf1_{m=0}}. Only the zero dual
cocycle contributes; it has exactly #{|Z^{r-1}|}
parameter preimages, giving #{Z=1}. If instead
#{w_p(x)=N\mathbf1_{x=0}}, every #{\widehat w_p=1}.
The cycle sum is #{|Z_2|}, while the normalized dual form is
##{|B^r|\,|H^r|=|Z^r|=|Z_2|.}
A sector average without a compensating sector factor
would fail this second equality. Both calculations use
\ref{fdip-00NJ} and \ref{fdip-00NO} and apply also to
composite #{N}.}
