\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Example}
\title{Parallel, perpendicular and half-integer components}
\date{2026-11-17}

\p{For #{U=V=\qi}, the imaginary components in
\ref{fdip-00ZI} coincide. Thus #{s=4} and #{t=0}.
For #{U=\qi}, #{V=\qj}, they are perpendicular unit
vectors, giving #{s=4}, #{t=4} as in \ref{fdip-00ZE}.}

\p{For #{U=\qi} and #{V=h=(1+\qi+\qj+\qk)/2},
the two individual norm differences are #{2} and #{1}.
The imaginary squared lengths are #{1} and #{3/4},
and the squared dot product is #{1/4}. Hence
#{s=3} and #{t=4(3/4-1/4)=2}.}
