\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Remark}
\title{The unitary matrix chart of a Wilson representation}
\date{2026-11-10}

\p{Let #{F} and #{\rho:G\to U(F)} be the representation of
\ref{fdip-006N}, with #{d=\dim_{\mathbb C}F}. An ordered
orthonormal basis of #{F} is a unitary identification
#{u:\mathbb C^d\to F}. It carries #{\rho(g)} to the matrix
#{u^{-1}\rho(g)u\in U(d)}. The unnormalized trace equals the
matrix trace of that array. Rightmost-first path order, reversal,
and complex conjugation of the Wilson loop are unchanged by this
chart.}
