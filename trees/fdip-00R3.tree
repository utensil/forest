\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Remark}
\title{Reversion and the pseudoscalar}
\date{2026-11-15}

\p{Reversion is the anti-automorphism #{\tilde A} that fixes #{V_x}
and reverses products. When the ground ring is a noetherian
domain, the module is projective of finite rank, and the
value module is invertible, the reversal of
\citet{22.2.10, p. 347}{voight2021quaternionv107u}
is this reversion on the even Clifford algebra, and it is an
involution linear over that ground ring. Outside those
hypotheses, the reversion defined in this paragraph stands.}

\p{Under the same hypotheses, the full Clifford functor is the
isometry functor of
\citet{Remark 22.2.13, p. 347}{voight2021quaternionv107u},
and the even Clifford functor is the similarity functor of
\citet{Theorem 22.2.11, p. 347}{voight2021quaternionv107u}.
The two functors are not the same. Outside those hypotheses,
the reversion and the pseudoscalar in this remark stand.}

\p{The pseudoscalar is the chosen generator #{\psI} of the top
exterior power.}

\p{Creation and annihilation are #{e_i\wedge} and #{e_i\cdot}.
Exterior-algebra texts write them #{\epsilon_i} and #{\iota_i}, and their sum #{\epsilon_i+\iota_i} is the Clifford generator #{e_i\wedge+e_i\cdot}.}

\p{In dimension #{4},
\citet{(A.10), p. 235}{sharatchandrathunweisz1981susskind}
write #{\gamma_5} as #{\gamma_1\gamma_2\gamma_3\gamma_4},
self-adjoint of square #{1}, which corresponds to #{\psI}
with #{\psI^2=1}. In dimension #{2},
\citet{(A.3), p. 234}{sharatchandrathunweisz1981susskind}
write #{\gamma_5=-\ui\gamma_1\gamma_2}, which is not #{\psI}.}
