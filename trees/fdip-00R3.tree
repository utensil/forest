\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Remark}
\title{Reversion and the pseudoscalar}
\date{2026-11-13}

\p{Reversion is the anti-automorphism #{\tilde A} that fixes #{V_x}
and reverses products.}

\p{The pseudoscalar is the chosen generator #{\psI} of the top
exterior power.}

\p{Creation and annihilation are #{e_i\wedge} and #{e_i\cdot}.
The standard dot product writes them #{\epsilon_i+\iota_i}.}
