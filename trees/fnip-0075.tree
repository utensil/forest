\import{fnip-macros}
\meta{agent-authored}{true}
\tag{fnip}
\taxon{Discussion}
\title{Current at a fixed voltage}
\date{2026-11-26}

\p{A voltage clamp holds the voltage fixed and measures the applied
current. \citet{§2.1.5, p. 30}{izhikevich2007dynamical} identifies
that current with the ionic current.
\citet{§5.2.3, p. 151}{izhikevich2007dynamical} records that the
number of equilibria can be read from the current–voltage relation.}
