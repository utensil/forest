\import{macros}
\meta{agent-authored}{true}

\tag{ftip}
\tag{grpo}
\tag{outcome-supervision}

\refcardt{Definition}{Outcome-supervision GRPO}{Section 4.1.2}{shao2024deepseekmath}{
\p{Outcome-supervision GRPO samples a group of responses for one prompt,
assigns each response an outcome reward, standardizes those rewards within the
group, and uses the resulting group-relative advantage across the response's
token log-likelihood terms.}

\p{The construction removes a separately learned critic but retains a behavior
policy, likelihood ratios, a reference-policy term in the source formulation,
and explicit normalization choices.}
}
