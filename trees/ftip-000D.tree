\import{macros}
\meta{agent-authored}{true}

\taxon{Definition}
\title{Probability distributions on a finite set}
\tag{ftip}
\tag{probability}

\p{For a finite nonempty set #{A}, its \newvocab{probability simplex} is
##{
\Delta(A)=
\left\{p:A\to[0,1]\;\middle|\;\sum_{a\in A}p(a)=1\right\}.
}
An element #{p\in\Delta(A)} is a probability distribution on #{A}. For
#{a\in A}, the number #{p(a)} is the probability assigned to #{a}.}

\p{This finite-distribution convention is the one needed by the categorical
next-token distributions in the sequence model of
\citet{sec. 3}{phuong2022formal}. The symbol #{\Delta} will not be used for a
set of logits or unnormalized scores.}
