\import{macros}
\meta{agent-authored}{true}

\taxon{Remark}
\title{Retained context is not weight learning}
\tag{ftip}
\tag{transfer-limit}

\p{Changing #{\kappa_t} changes the information supplied to a fixed decoder;
it does not update represented weights. A successful continuation can therefore
be an elicitation effect, a context effect, or both. Weights, optimizer and
feedback, inference state, and evaluation remain
distinct intervention coordinates, as in \ref{ftip-0001}.}
