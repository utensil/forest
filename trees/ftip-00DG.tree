\import{macros}
\meta{agent-authored}{true}

\taxon{Remark}
\title{Retained context is not weight learning}
\tag{ftip}
\tag{transfer-limit}

\p{Changing #{\kappa_t} changes the information supplied to a fixed decoder;
it does not update represented weights. A successful continuation can therefore
be an elicitation effect, a context effect, or both. The four evidence lanes
in the root boundary remain separate.}
