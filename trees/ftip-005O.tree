\import{macros}
\meta{agent-authored}{true}

\refdeft{feasible objective set}{Section 4.7.4}{boyd2004convex}{
\p{For a multi-objective optimization problem with vector objective #{f(x)},
the feasible objective set is the collection of vectors #{f(x)} attained by
feasible choices #{x}.}

\p{In a post-training application, the feasible choice is a trusted,
budget-feasible protocol and the objective vector contains independently
declared evaluation outcomes.}
}
