\import{macros}
\meta{agent-authored}{true}

\refdeft{Residual connection}{sec. 3.1}{vaswani2017attention}{
\p{Using the sequence and residual dimensions of \ref{ftip-000L}, let
#{F:\mathbb R^{T\times d}\to\mathbb R^{T\times d}} be a sublayer
whose input and output have the same shape. A \newvocab{residual connection}
forms
##{
R_F(X)=X+F(X).
}
The addition is coordinatewise. Shape equality is part of the construction;
the residual path is not a concatenation of features.}
}

\tag{ftip}
\tag{architecture}
