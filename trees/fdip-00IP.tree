\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Proposition}
\title{Accretivity, determinant sign and the connection marginal}
\date{2026-11-09}

\p{For the \vocabk{massive graded Wilson data}{fdip-00IN} and every allowed link field,
##{D_{a,U}^*=-D_{a,U},\qquad -L_{a,U}\geq0,\qquad K_U^*=\Gamma K_U\Gamma.}}

\p{Moreover
##{\|K_Uv\|\geq m\|v\|,\qquad \|K_U^{-1}\|\leq m^{-1},\qquad \det K_U>0.}}

\p{Writing #{M=m+d/a+4dc_W/a^2}, one has
##{m^n\leq\det K_U\leq M^n.}}

\p{Consequently
##{0<Z=\int w_g(U)\det K_U\,d\lambda(U)<\infty,\qquad
 d\nu(U)=Z^{-1}w_g(U)\det K_U\,d\lambda(U)}}

\p{defines a positive normalized connection law.}

\proof{
\p{For every positive period, #{x\mapsto x+e_j} is a permutation of #{\Lambda}. Therefore
##{\sum_x\|U_j(x)^{-q}\psi(x+e_j)\|^2=\sum_x\|\psi(x)\|^2.}}

\p{Substitution verifies the displayed inverse even when #{N_j=1} or #{2}. Thus each #{T_j} is unitary and commutes with each spin endomorphism, extending the supplied shift argument to all the declared periods and Clifford modules. Consequently #{D^*=-D} and #{-a^2L=\sum_j(I-T_j)^*(I-T_j)}. The grading anticommutes with #{D} and commutes with #{L}, proving the adjoint relation. For every #{v},
##{\operatorname{Re}\langle v,K_Uv\rangle=m\|v\|^2-c_W\langle v,L_{a,U}v\rangle\geq m\|v\|^2.}}

\p{Cauchy–Schwarz gives the lower norm bound. Injectivity in finite dimension gives invertibility and the inverse bound. Apply the same argument to #{K_{U,s}=mI+s(D_{a,U}-c_WL_{a,U})}, #{0\leq s\leq1}. The grading relation gives
##{\overline{\det K_{U,s}}=\det K_{U,s}^*=\det(\Gamma K_{U,s}\Gamma)=\det K_{U,s}.}}

\p{This continuous real determinant never vanishes and starts at #{m^n>0}, so it is positive throughout the homotopy. All singular values are at least #{m}. Also #{\|D\|\leq d/a} and #{\|L\|\leq4d/a^2}, so every singular value is at most #{M}. Their product is #{|\det K|=\det K}, giving the bounds. The operator and its determinant depend continuously on the links. Since #{w_g>0} everywhere and #{\lambda} is a probability measure, its weighted determinant integral is positive and finite.}

\p{This extends the unitary-shift argument of \ref{fdip-009P} to every positive period. In a chosen basis, \leanref{Matrix.det_units_conj} and \leanref{Matrix.det_conjTranspose} support the two determinant identities used in the reality step; neither asserts positivity by this homotopy.}
}
