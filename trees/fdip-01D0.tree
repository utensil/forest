\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Example}
\title{Three ratios}
\date{2026-11-28}

\p{Set #{\lambda=1/4}, so #{L=2} in
\ref{fdip-01CZ}. The eigenvalue in \ref{fdip-01CY} gives three
different classifications as the branching number changes.}

\ul{
\li{For #{p=4}, one has #{d_h=2} and #{p\lambda=1}.
The eigenvalue is #{4} at every Wick degree, so all these polynomial
directions are relevant.}
\li{For #{p=8}, one has #{d_h=3} and #{p\lambda=2}.
The eigenvalue is #{8\cdot2^{-n/2}}: degrees below #{6} are relevant,
degree #{6} is marginal, and degrees above #{6} are irrelevant.}
\li{For #{p=16}, one has #{d_h=4} and #{p\lambda=4}.
The eigenvalue is #{16\cdot4^{-n/2}}: degrees below #{4} are relevant,
degree #{4} is marginal, and degrees above #{4} are irrelevant.}
}

\p{These values concern the specified polynomial directions at the
Gaussian reference. They give no non-Gaussian fixed point.}
