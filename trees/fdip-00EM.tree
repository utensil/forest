\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Theorem}
\title{Cells shrink in the resistance metric}
\date{2026-11-07}

\p{Let #{R} be the resistance metric of
\ref{fdip-00EI} for the sequence in \ref{fdip-00EL}. If
#{x} and #{y} are vertices of one #{n}-cell, then
##{R(x,y)\le 4\Bigl(\frac{3}{5}\Bigr)^n.}}

\proof{
\p{The trace in the definition of a
[compatible resistance sequence](fdip-00EG) gives
#{E_k(u|_{V_k})\le E_{k+1}(u|_{V_{k+1}})} for a function
#{u} on #{V_*}, so
#{E_*(u)\ge E_k(u|_{V_k})}. An edge #{ab} of #{H_k} contributes
#{\bigl(\frac{5}{3}\bigr)^k\bigl(u(a)-u(b)\bigr)^2} to that
energy. Thus
##{R(a,b)\le\Bigl(\frac{3}{5}\Bigr)^k.}
\citet{Proposition 3.3}{kigami2010resistance} makes #{R} a
metric.}

\p{Take #{m\ge n} large enough that #{x,y\in V_m}, and start
from #{y}. While the current vertex lies in
#{V_k\setminus V_{k-1}} with #{k>n}, the
[gasket graph](fdip-00DP) makes it
the midpoint of an edge of #{G_{k-1}} inside the same
#{n}-cell. One endpoint of that edge lies in the cell and in
#{V_{k-1}}, and the connecting edge belongs to #{G_k}, so
the move costs at most #{\bigl(\frac{3}{5}\bigr)^k}. The walk
reaches #{V_n}. The only vertices of #{V_n} in the cell are
its three corners, so the walk ends at a corner #{z}, and
##{R(y,z)\le\sum_{k=n+1}^{m}\Bigl(\frac{3}{5}\Bigr)^k
\le\sum_{k=n+1}^{\infty}\Bigl(\frac{3}{5}\Bigr)^k
=\Bigl(\frac{3}{5}\Bigr)^{n+1}\Bigl(1-\frac{3}{5}\Bigr)^{-1}
=\frac{3}{2}\Bigl(\frac{3}{5}\Bigr)^n.}
The same bound carries #{x} to a corner #{z'}. Either
#{z=z'}, or the two corners are adjacent in #{G_n} and
#{R(z,z')\le\bigl(\frac{3}{5}\bigr)^n}. Therefore
##{R(x,y)\le\Bigl(\frac{3}{2}+1+\frac{3}{2}\Bigr)
\Bigl(\frac{3}{5}\Bigr)^n
=4\Bigl(\frac{3}{5}\Bigr)^n.}
}
}
