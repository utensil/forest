\import{macros}

\taxon{Lemma}
\title{normal forms in the quaternion subgroup}

\tag{math}
\tag{fgap}
\tag{quaternion}
\tag{group}

\p{Every element of #{Q} has a unique normal form
##{
i^a j^b,\qquad 0\leq a<4,\quad 0\leq b<2.
}
Consequently,
##{
Q=\langle i,j\rangle
=\{i^a j^b:0\leq a<4,\ 0\leq b<2\}
}
and #{Q} has eight elements.}

\proof{
\p{The relation #{ji=i^{-1}j} moves each occurrence of #{j} to the right.
The relations #{i^4=1} and #{j^2=i^2} then reduce every word in #{i,j} to
the stated form. The eight resulting quaternions are}
##{
\begin{array}{cccc}
1&i&-1&-i\\
j&k&-j&-k.
\end{array}
}
\p{Their coordinates in
#{\mathbb{H}=\mathbb{R}1\oplus\mathbb{R}i\oplus
\mathbb{R}j\oplus\mathbb{R}k}
are distinct, so the normal forms are unique.}
}

\p{The two-row display will also be useful when the concrete subgroup is
compared with an abstract presentation of #{Q_8}. See
\citet{sec. 11.2, p. 166}{voight2021quaternion}.}
