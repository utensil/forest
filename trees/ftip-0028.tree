\import{macros}
\meta{agent-authored}{true}

\taxon{Definition}
\title{Credit-assignment rule}
\tag{ftip}
\tag{credit-assignment}

\p{A \strong{credit-assignment rule} maps a rollout record and its feedback
to indexed training targets}

##{
  \Gamma(\mathsf R,Z)=(G_0,\ldots,G_{T-1}),
}

\p{where #{G_t} is the signal assigned to action #{A_t}. A terminal outcome
rule may assign one return to every action. A process rule may produce
different targets at different prefixes.}

\p{This is an FTIP synthesis of the return construction in
\citet{Section 3.3}{sutton2018reinforcement} and the named outcome- and
process-supervision subsections of \citef{lightman2023verify}. The
definition does not assume that #{G_t} is unbiased or that action-level credit
is identifiable from terminal evidence.}
