\import{macros}
\meta{agent-authored}{true}

\refdeft{worst-group risk}{Section 2}{sagawa2020distributionally}{
\p{Given predefined groups with risks #{L_g}, the worst-group risk is
#{\max_g L_g}. For utilities, the corresponding robust score is
#{\min_g J_g}.}

\p{A post-training comparison must declare the groups and their evaluation
laws before using this score. It is different from an average and from Pareto
dominance.}
}
