\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Definition}
\title{The coupled finite coefficient functional}
\date{2026-11-17}

\p{Use the \vocabk{coefficient connection}{fdip-00SH}
for a finite group #{G}, now with a finite free fiber #{F}.
Let #{\mathcal V=C^\bullet(X;F)} and let #{\mathcal U=G^E}
be the finite set of assignments to the labeled positive edges.
Choose endomorphisms #{K_U} with
#{K_{U^g}=\mathcal G_gK_U\mathcal G_g^{-1}}, and a weight
#{w:\mathcal U\to k} satisfying #{w(U^g)=w(U)}.
The primary choice, with the
\vocabk{invariant cochain pairing}{fdip-00SR}, is
#{K_U=m\bbI+\extD_U}.}

\p{For a family #{P=(P_U)_{U\in\mathcal U}} with
#{P_U\in\mathcal A(\mathcal V)}, define the
\newvocab{coupled finite coefficient functional} and its
\newvocab{partition coefficient} by
##{\begin{aligned}
 \Phi(P)&=\sum_{U\in\mathcal U}w(U)
   \mathcal I_{\mathcal V}\bigl(P_U\extexp(\theta_{K_U})\bigr),\\
 Z&=\Phi(1)=\sum_{U\in\mathcal U}w(U)\det K_U.
\end{aligned}}
This is unnormalized counting. When #{Z\in k^\times}, the
\newvocab{normalized coefficient} is
#{\langle P\rangle=Z^{-1}\Phi(P)}.}

\p{For a gauge transformation #{g}, let #{R_g} be the
exterior-algebra map induced by
#{(\mathcal G_g^{-1})^*\oplus\mathcal G_g} on
#{\mathcal V^*\oplus\mathcal V}.
The action on families is specified by
#{(gP)_{U^g}=R_gP_U}. A family is
\newvocab{gauge invariant} when #{P_{U^g}=R_gP_U}
for every #{g,U}. Scalar observables use the constant degree-zero
part of this algebra.}
