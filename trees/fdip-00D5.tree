\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Definition}
\title{Content and dimension of a cover}
\date{2026-11-06}

\p{Let #{(X,\rho)} be a metric space and let #{A\subset X}. For
a real number #{s\ge 0}, cover #{A} by countably many nonempty
sets #{U_i}. Write #{\operatorname{diam}(U_i)} for the
supremum of #{\rho} over pairs of points of #{U_i}. The
\newvocab{Hausdorff content} of #{A} of order #{s} is the
infimum of
##{\sum_i\operatorname{diam}(U_i)^s}
over all such covers. When #{s=0}, take the power to be #{1}
on every nonempty set.}

\p{The \newvocab{Hausdorff dimension} of #{A} is the infimum of
those #{s} for which the content of order #{s} equals #{0}.
If the content stays positive for every finite #{s}, the
dimension is infinite.}
