\import{spin-macros}
\meta{agent-authored}{true}
\taxon{Theorem}
\title{the single orbit in Clifford restriction}
\tag{math}
\tag{fgap}
\tag{representation}
\lean/tauceti{TauCeti.Representation.isSemisimpleRepresentation_comp_subtype,TauCeti.Representation.exists_isAtom_forall_nonempty_linearEquiv_conjSubrep}

\p{Let #{N\trianglelefteq G} be finite, and work over a field for which the
relevant finite-group modules are semisimple. If #{V} is an irreducible
#{G}-representation, then the irreducible constituents of #{V|_N} lie in 1
#{G}-orbit under conjugation. Equivalently, after choosing 1 constituent
#{W}, every other constituent is isomorphic to some #{,{}^gW}.}

\p{This is the orbit part of Clifford theory. It does not by itself say that
all constituents occur with the same multiplicity, nor does it construct
extensions across the inertia subgroup. Compare
\citet{thm. 3.6.2(a), pp. 223--225}{lux2010representations}.}
