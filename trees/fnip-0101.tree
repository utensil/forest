  \draw[->] (0,0) -- (6.35,0) node[right] {$I_{\mathrm{app}}$};
  \draw[->] (0,0) -- (0,3.15) node[above] {$V$};
  \draw (1.55,0) -- (1.55,-0.06) node[below] {$88.3$};
  \draw (1.85,0) -- (1.85,-0.06) node[below] {$94$};
  \draw (4.55,0) -- (4.55,-0.06) node[below] {$212$};
  \draw (4.85,0) -- (4.85,-0.06) node[below] {$217$};
  \draw[thick] (0.35,0.55) -- (1.85,0.85);
  \draw[thick,dashed] (1.85,0.85) -- (4.55,1.85);
  \draw[thick] (4.55,1.85) -- (6.05,2.35);
  \draw[thick,dashed] (1.55,0.72) .. controls (1.15,1.15) and (1.15,0.35) .. (1.55,0.78);
  \draw[thick] (1.55,0.45) .. controls (3.2,2.85) and (3.2,0.15) .. (4.85,2.15);
  \draw[thick] (1.55,1.05) .. controls (3.2,2.95) and (3.2,1.35) .. (4.85,1.55);
  \draw[thick,dashed] (4.85,1.95) .. controls (5.25,2.35) and (5.25,1.55) .. (4.85,1.72);
