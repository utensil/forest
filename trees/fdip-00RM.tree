\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Notation}
\title{Notation for lattice fermions}
\date{2026-11-13}

\p{The Berezin integral is #{\int\extd\bar\psi\,\extd\psi}
(\ref{fdip-008F}, \ref{fdip-00RN}).}

\p{The paired generator is #{\bar\psi}
(\ref{fdip-008H}, \ref{fdip-00RO}).}

\p{The spinor factor carries #{\varepsilon_j^{S}}, with
#{\bbI_F} on the internal factor
(\ref{fdip-009O}, \ref{fdip-00RP}).}

\p{Chirality is #{\psI}, or the degree involution #{(-1)^{\deg}}
(\ref{fdip-009X}, \ref{fdip-00RQ}).}

\p{Grassmann integration is written like ordinary integration,
#{\int\extd\bar\psi\,\extd\psi}, sharing the measure #{\extd} of
Part II to mean top-degree extraction. The paired generator
#{\bar\psi} keeps the bar because it is the image of #{\psi}
under the declared reflection, the involution of Part II, with
no matrix entering. Gamma matrices do not appear: the spinor
factor carries the represented generators
#{\varepsilon_j^{S}} of Part V, the grid step keeps
#{e_j}, and chirality is #{\psI} or the degree involution
#{(-1)^{\deg}}.}
