\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Definition}
\title{An equivariant exchange of sign spaces}
\date{2026-11-26}

\p{Let #{G} act by linear automorphisms on a module
#{V=V_+\oplus V_-}, preserving both summands. Write
#{\rho_\pm(g)} for the restricted actions. An
\newvocab{equivariant sector exchange} is an additive bijection
#{u:V\to V} which takes each summand onto the other and satisfies
#{u\rho(g)=\rho(g)u} for all #{g\in G}, with the scalar action
of #{u} specified. A linear exchange preserves scalar
multiplication. A conjugate-linear exchange over the complex
numbers satisfies #{u(zv)=\bar z\,u(v)}.}

\p{For two actions on #{V} and #{V'=V'_+\oplus V'_-}
and a given homomorphism #{\alpha:G\to G'} between their
groups, equivariance of an exchange #{u:V\to V'} means
#{u\rho(g)=\rho'(\alpha(g))u}. Denote its restrictions by
#{u_+:V_+\to V'_-} and #{u_-:V_-\to V'_+}.
A \vocabk{grading}{fdip-013N} #{\Gamma} can specify the
summands as its two eigenspaces whenever these split #{V}.}
