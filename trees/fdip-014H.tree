\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Remark}
\title{Sources for Ginsparg–Wilson operators}
\date{2026-11-23}

\p{Wingate gives the quadratic relation under the name
Ginsparg–Wilson
\citet{Section 9.6, Eq. (9.27), p. 24}{wingate2025lattice}.
Lüscher puts the half-shift on both infinitesimal field
variations and obtains a traced measure variation in the
flavor-singlet Ward identity
\citet{Sections 3–4, Eqs. (3.1), (4.1), (4.3), printed pp. 2–3}{luscher1998exact}.
His contour formula at zero is a resolvent spectral
projection \citet{Eqs. (4.6)–(4.7), printed p. 4}{luscher1998exact}.
For a Jordan block at zero, that projector includes the
generalized zero modes. For the normal operator of
\ref{fdip-014A} the ordinary and generalized kernels coincide.}

\p{Hasenfratz, Laliena and Niedermayer identify the left-minus-right
zero-mode count of their fixed-point operator with a trace
involving its blocking kernel and with their fixed-point
topological charge
\citet{Eqs. (2)–(3), (8)–(12), pp. 3–4}{hasenfratz1998index}.
With right chirality positive, the kernel index in \ref{fdip-014B}
has the opposite convention. Its balanced-grading expression is
#{-\tfrac a2\trace(\Gamma D)}.}

\p{Neuberger proposes a determinant built from the polar factor
of a negative-mass Wilson operator, expressing that factor
through the sign of a Hermitian kernel
\citet{Abstract, p. 1; Eqs. (8)–(9), (11)–(12), pp. 3–4}{neuberger1998exactly}.
For invertible #{K} in \ref{fdip-014D} this factor is
#{K(K^\dagger K)^{-1/2}=\Gamma\Gamma_K}, because
#{K^\dagger K=(\Gamma K)^2}. That theorem constructs the sign
by interpolation on the finite spectrum. Kaplan obtains
a chiral mode localized by a sign-changing mass in an extra
dimension and uses a Wilson term in its lattice realization
\citet{Eqs. (3)–(6), p. 3; (7)–(13), pp. 4–5; (16)–(17), p. 5}{kaplan1992method}.}
