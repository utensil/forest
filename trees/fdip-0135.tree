\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Example}
\title{The determinant and diagonal bound on the sign edge}
\date{2026-11-21}

\p{The sign matrix of \ref{fdip-012H} is the update of
\ref{fdip-013I} for that edge. The determinant and the
diagonal bound are the quantities given by \ref{fdip-013I}.}

\proof{
\p{The indicator matrix computed in \ref{fdip-012H} is the
update named in \ref{fdip-013I}, so that proposition gives
the determinant and the diagonal bound. \ref{fdip-012X}
supplies the Rayleigh inequality for this edge.}
}
