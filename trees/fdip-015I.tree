\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Definition}
\title{A resolved symbol}
\date{2026-11-26}

\p{Let #{f:R\to k^n} on the \vocabk{simplicial momentum grid}{fdip-013X} over an ordered field
#{k}. The interpolated map #{\tilde f} is \newvocab{resolved} when every zero of
#{\tilde f} is a grid vertex.}
