\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Theorem}
\title{The counting square is the Laplacian}
\date{2026-11-12}

\p{Keep the torus and the coboundary of \ref{fdip-00OK}. The
counting pairing is the sum #{\langle\alpha,\beta\rangle
=\sum_c\alpha(c)\beta(c)} over all cubes. There is a unique
linear map #{d^\dagger}, of degree #{-1}, such that
#{\langle d\alpha,\beta\rangle=\langle\alpha,d^\dagger\beta\rangle}
for every cochain. Set #{\Delta=dd^\dagger+d^\dagger d} and
#{D=d+d^\dagger}. Then #{D^2=\Delta}.}

\proof{
\p{The module of cochains is finite and free on the cubes. Take
those cubes as an ordered basis. The counting pairing is the dot
product of the coordinates, so a cochain orthogonal to every
cochain is zero, and the adjoint of #{d} is the transpose of its
matrix. The transpose of #{d^2} is #{(d^\dagger)^2}.
\ref{fdip-00OK} gives #{d^2=0}, hence #{(d^\dagger)^2=0}. The
cross terms in #{D^2} are #{dd^\dagger+d^\dagger d}.}
}
