\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Example}
\title{One axis and the factor two}
\date{2026-11-12}

\p{Take #{d=1} and weight #{1} in both directions. The odd vector
#{v=e_+-e_-} has #{q(v)=2}, and the even vector
#{w=e_++e_-} has #{q(w)=2}. An affine function with difference
#{a} gives #{e_x\,df=a v}. Over #{\mathbb Z} the combinations
#{v} and #{w} do not include the single edge #{e_+}, because
that edge would be #{\tfrac12(w+v)}. The square of the
commutator in \ref{fdip-00PL} is multiplication by #{-a^2},
which is #{-\bar q} on the coefficient of #{v}, with no
division.}
