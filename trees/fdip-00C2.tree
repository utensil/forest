\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Theorem}
\title{One coefficient pair returns at every depth}
\date{2026-11-06}

\p{Fix an integer #{p\ge 2} and real numbers #{\lambda>0} and
#{m>0}. Let #{Q_k} be the
\vocabk{fixed-ratio precision}{fdip-00BY} at depth #{k}, with
centered Gaussian law #{\nu_k} and rescaled class mean #{T_k}
for #{k\ge 1}. Then the pushforward of #{\nu_k} by #{T_k}
equals #{\nu_{k-1}}.}

\proof{
\p{The coefficients of #{Q_k} are #{\lambda^j} for #{j<k} and
#{m\lambda^k} at the top. \ref{fdip-00C1} sends a coefficient
#{c_i} to #{\frac{c_{i+1}}{\lambda}}. For #{i<k-1} this value
is #{\lambda^i}. The new top coefficient is
#{\frac{m\lambda^k}{\lambda}=m\lambda^{k-1}}. Those are the
coefficients of #{Q_{k-1}}.}
}
