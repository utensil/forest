\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Example}
\title{A transfer norm greater than one}
\date{2026-11-01}

\p{Take #{w=3/2} and #{m^2=4/5} in
\ref{fdip-007U}. Then
##{\begin{aligned}
\cosh\omega&=\frac{19}{15},&
s&=\frac{\sqrt{34}}5,\\
q&=\frac{19-2\sqrt{34}}{15},&
\lambda_0&=\sqrt{\frac{4\pi q}{3}}.
\end{aligned}}
Numerically #{\omega\approx0.714971} and
#{\lambda_0\approx1.431497}. In particular
#{\|T\|=\lambda_0>1}. This inequality does not depend on rounding:
#{\sqrt{34}<6} gives #{q>7/15}, and #{\pi>3} gives
#{\lambda_0^2>28/15>1}.}

\p{All eigenvalues are nevertheless positive:
#{\lambda_n=\lambda_0q^n}. Dividing by the leading eigenvalue
gives #{\widehat T h_n^s=q^nh_n^s} and
#{\|\widehat T\|=1}. The lowest mode label #{n=0} refers to
the Gaussian function #{h_0^s}, not to a constant function on
#{\mathbb R}; the latter does not belong to Lebesgue #{L^2}.
Thus the normalization is a genuine scalar factor in the
operator, fixed by the chosen reference measure.}
