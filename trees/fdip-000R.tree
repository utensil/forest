\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Definition}
\title{A centered Dirac operator on a finite periodic grid}
\date{2026-10-17}

\p{To couple Clifford multiplication to spatial differences, fix an
integer #{d\ge1} and periods #{N_j\ge3} for #{1\le j\le d}.
The \newvocab{periodic grid} and its scalar fields are
##{\begin{aligned}
\Lambda&=\prod_{j=1}^d\mathbb Z/N_j\mathbb Z,\\
M&=\prod_{j=1}^d N_j,\qquad H=\mathbb C^\Lambda.
\end{aligned}}
Write #{e_j\in\Lambda} for the unit step in coordinate #{j}.
Addition is periodic and the lattice spacing is one. Extend the
\vocabk{counting pairing}{fdip-0007} to the Hermitian inner product
##{\langle f,g\rangle_H
=\sum_{x\in\Lambda}\overline{f(x)}g(x),}
conjugate-linear in the first slot.}

\p{The spatial \vocabk{quadratic form}{ca-0004} is
##{q_{\mathrm{sp}}(z)=\sum_{j=1}^d z_j^2
\qquad(z\in\mathbb C^d).}
It is distinct from the Hermitian norm squared #{\sum_j|z_j|^2}
and from the real four-field [configuration form](fdip-000O).
The comparison #{q_{\mathrm{sp}}(i\varepsilon_1)=-1} against
Hermitian norm squared #{1} is \ref{fdip-00LB}. The grid steps
#{e_j}, these complex
coordinate vectors, and the 4 configuration coordinates have
different carriers.}

\p{Choose #{S=(\mathbb C^2)^{\otimes d}} with its product Hermitian
inner product. Fix the ordered basis #{(e_0,e_1)} of each factor.
The \newvocab{flip} of that factor exchanges the two basis vectors,
and the \newvocab{sign} of that factor fixes #{e_0} and sends
#{e_1} to #{-e_1}. For #{1\le j\le d}, the operator #{\gamma_j}
applies the sign to each factor before #{j}, the flip to factor
#{j}, and the identity to each later factor. An empty collection
of factors contributes the scalar identity. The Pauli arrays of
these operators are \ref{fdip-00LB}. \ref{fdip-00L8} proves that
the operators are self-adjoint and represent #{q_{\mathrm{sp}}},
and \ref{fdip-00L9} proves that #{S} is a reducible Clifford module
of complex dimension #{2^d}.}

\p{Extend the \vocabk{cyclic shift}{fdip-0009} coordinatewise by
##{(T_j f)(x)=f(x+e_j).}
Its inverse shifts by #{-e_j}. The \newvocab{centered differences}
are the endomorphisms
##{\cov_j=(T_j-T_j^{-1})/2.}
Their source and target are both #{H}, unlike a general
vertex-to-edge \vocabk{incidence map}{fdip-0002}. \ref{fdip-00LA} proves
that the shifts commute and are unitary, and that each centered
difference is skew-adjoint.}

\p{Set #{K=S\otimes_{\mathbb C}H}, with
#{\langle s\otimes f,t\otimes g\rangle_K
=\langle s,t\rangle_S\langle f,g\rangle_H}.
Identify #{s\otimes f} with the field #{x\mapsto f(x)s}.
The \newvocab{centered Dirac operator} is
##{D=\sum_{j=1}^d\gamma_j\otimes\cov_j.}
Equivalently,
##{\begin{aligned}
(D\psi)(x)
&=\frac12\sum_{j=1}^d\gamma_j\psi(x+e_j)\\
&\quad-\frac12\sum_{j=1}^d\gamma_j\psi(x-e_j).
\end{aligned}}
For #{d=1}, #{\gamma_1} is the flip of the single factor, applied
to the ordinary centered difference of a two-component field.
Wingate's gauge-covariant centered difference reduces to this
difference when all links are one and the spacing is one
\citet{Section 9.1, Equation (9.2), p. 19}{wingate2025lattice}.
The finite grid and tensor module here are specified directly;
this construction introduces no Grassmann integration or gauge
field. The [Lorentz-sign gamma algebra](fcap-002U) is a
different choice of form, scalar field and representation.}
