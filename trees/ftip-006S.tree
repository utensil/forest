\import{macros}
\meta{agent-authored}{true}

\title{Alignment training}
\tag{ftip}
\tag{alignment}
\tag{post-training}

\p{Alignment training describes a declared role for a parameter-changing
procedure: it is intended to alter behavior relative to a stated criterion.
The criterion and the evidence used during training must be named before the
claim can be evaluated.}

