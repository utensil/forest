\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Proposition}
\title{Covariance uses only the group action}
\date{2026-11-17}

\p{For the \vocabk{coefficient connection}{fdip-00SH} over
#{k}, every \vocabk{vertex gauge}{fdip-00SH} satisfies
##{T_i^{U^g}\mathcal G_g=\mathcal G_g T_i^U,\qquad
\extd_{U^g}\mathcal G_g=\mathcal G_g\extd_U.}
Connections as objects and vertex gauges as arrows form the
action groupoid of #{G^X}. The cochain maps
#{\mathcal G_g} respect its composition.}

\proof{
\p{The inverse of the transformed link acts as
#{\rho(g(x))\rho(U_i(x))^{-1}\rho(g(x+\varepsilon_i))^{-1}}.
Consequently
##{\begin{aligned}
(T_i^{U^g}\mathcal G_g f)(x)
&=\rho(g(x))\rho(U_i(x))^{-1}f(x+\varepsilon_i)\\
&=(\mathcal G_g T_i^U f)(x).
\end{aligned}}
Exterior multiplication acts on a different tensor factor and
commutes with #{\mathcal G_g}. Summing gives the differential
identity.}

\p{The identity vertex function fixes every link. Substitution
gives #{(U^{g_1})^{g_2}=U^{g_2g_1}} and
#{\mathcal G_{g_2g_1}=\mathcal G_{g_2}\mathcal G_{g_1}}.
The inverse arrow is the pointwise inverse gauge. These are the
identity, composition and inverse laws of the action groupoid.}
}

\p{This is the algebraic transport calculation in
\ref{fdip-006E}, now for based cochains over #{k}. A coefficient
pairing enters only when an adjoint is defined.}
