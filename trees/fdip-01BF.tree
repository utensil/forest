\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Definition}
\title{The normal transfer}
\date{2026-11-27}

\p{On a \vocabk{slab}{fdip-01AE} with normal axis #{s},
keep transverse spacing #{a>0} and give the normal axis its
own spacing #{t=a_s>0}. Take a real mass #{M\in\mathbb R}. The respective Wilson coefficients are
#{a/2} and #{t/2}. Identify the layers with the bottom one by
inverse normal transport. In the link convention of
\vocabk{covariant shifts}{fdip-009O}, the fiber gauges obey
#{g_1(x)=\bbI_F} and #{g_{l+1}(x)=g_l(x)U_s(x,l)^{-1}}.
The normal links in this frame are identities. Denote the
transverse shift on layer #{l} by #{T_{j,l}^U}.}

\p{The transverse field space #{W=W_+\oplus W_-} is split by
#{P_\pm=(\bbI\pm E_s)/2}, #{W_\pm=\im P_\pm}. Here
#{E_j=\varepsilon_j^S\otimes\bbI_F}.
Write the transverse Wilson term, the centered term and the mass-shifted Wilson term as
##{\begin{aligned}
W_l^{\rm W}&=a^{-1}\sum_{j\ne s}\left(\bbI -\tfrac12
(T_{j,l}^U+(T_{j,l}^U)^\dagger)\right),\\
D_l&=(2a)^{-1}\sum_{j\ne s}E_j(T_{j,l}^U-(T_{j,l}^U)^\dagger),\\
A_l&=W_l^{\rm W}-M\bbI .
\end{aligned}}
The \newvocab{graded slice kernel} is #{H'_l=E_sK'_l}, with
#{K'_l=A_l+D_l}. Put #{A_{\pm,l}=A_l|_{W_\pm}},
#{B_{\pm,l}=\bbI_\pm+tA_{\pm,l}} and
#{E_l=P_+D_l|_{W_-}:W_-\to W_+}.}

\p{When #{B_{+,l}} is invertible, the \newvocab{normal transfer}
#{T_l:W\to W} sends #{(u,v)} to #{(u',v')} by
##{u'=B_{+,l}^{-1}(u-tE_lv),\qquad
v'=B_{-,l}v-tE_l^\dagger u'.}
A strictly positive self-adjoint step repeated in the same frame
gives the normal direction its one-slice meaning as a
\newvocab{time direction}. Its \newvocab{energy sign} is the
sign of #{\bbI -T_l}, vanishing on the fixed space of the step.}
