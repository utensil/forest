\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Example}
\title{The matter determinant breaks the sign twist}
\date{2026-11-17}

\p{Take the rational sign model of \ref{fdip-00UA}:
#{m=5}, #{w=1}, and the counting cochain pairing.
The trivial representative and its
central twist from \ref{fdip-00X5} have
##{\begin{aligned}
 \det K_{(1,1,1,1,1)}&=35128130625,\\
 \det K_{(-1,1,1,-1,1)}&=36469158961.
\end{aligned}}
These are obtained by the two substitutions into
the determinant polynomial of \ref{fdip-00U9}.
They are unequal. Thus the scalar connection density
#{w(U)\det K_U} in the coupled functional is not
twist invariant, although #{w=1} is.}

\p{The pure uniform mean of the sign Polyakov trace
is zero by \ref{fdip-00X6}, since #{1-(-1)=2}
is invertible over #{\mathbb Q}. Its coupled mean is
#{-330765108/35803094657} by \ref{fdip-00UA}.
This nonzero value is consistent with the failed
hypothesis on the coupled density; gauge invariance
of that density remains valid.}
