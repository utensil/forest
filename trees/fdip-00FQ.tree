\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Theorem}
\title{Reflection-invariant marginals keep positivity}
\date{2026-11-07}

\p{Keep the hypotheses and the reflection of \ref{fdip-00FP}.
Let #{S'\subset S} also be invariant under #{x\mapsto -x}, and
let its positive set be the intersection of #{S'} with the
positive set of #{S}. Every bounded measurable function of
that smaller positive set satisfies the inequality of
\ref{fdip-00FP} under the marginal law #{\nu_{S'}}.}

\proof{
\p{Such a function is a bounded measurable function of the
positive coordinates of #{S}. \ref{fdip-00BA} identifies the
marginal of #{\nu_S} on #{S'} with #{\nu_{S'}}, so the
expectation under #{\nu_{S'}} equals the expectation under
#{\nu_S}. The latter is nonnegative by \ref{fdip-00FP}.}
}
