\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Theorem}
\title{Reflection-invariant marginals keep positivity}
\date{2026-11-07}

\p{Keep the hypotheses and the reflection of \ref{fdip-00FP}.
Let #{S'\subset S} also be invariant under #{x\mapsto -x}, and
let its positive set be the intersection of #{S'} with the
positive set of #{S}. Every bounded measurable function of
that smaller positive set satisfies the inequality of
\ref{fdip-00FP} under the marginal of #{\nu_S} on #{S'}.}

\proof{
\p{Such a function is a bounded measurable function of the
positive coordinates of #{S}, so \ref{fdip-00FP} makes its
expectation under #{\nu_S} nonnegative. That expectation
equals the marginal expectation. If #{|S'|\ge 2},
\ref{fdip-00BA} identifies the marginal law with #{\nu_{S'}}.
If #{|S'|=1}, invariance forces the point to be fixed, and
\ref{fdip-00BA} names the marginal as the centered Gaussian
of precision #{2m\tanh(m/2)}. Both sides then use that
coordinate, and the integrand is a square.}
}
