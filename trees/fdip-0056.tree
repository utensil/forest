\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Theorem}
\title{Equivariant elimination within each sector}
\date{2026-11-01}

\p{Let #{H=X\mathbin\perp Y} be a finite-dimensional orthogonal
real representation of a finite group #{G}, with both summands
#{G}-stable. Let the positive self-adjoint equivariant precision be
##{Q=\begin{pmatrix}A&B\\B^*&C\end{pmatrix},
\qquad B:Y\to X.}
Then #{C>0}, and the retained precision
#{S=A-BC^{-1}B^*:X\to X} is positive, self-adjoint and
#{G}-equivariant. For every real irreducible type #{\Xi}, set
#{X_\Xi=E_\Xi X} and #{Y_\Xi=E_\Xi Y}.
All block maps restrict to the indicated source and target sectors,
and
##{S|_{X_\Xi}
 =A|_{X_\Xi}-B_\Xi(C|_{Y_\Xi})^{-1}B_\Xi^*.}
In common [multiplicity coordinates](fdip-004Z), the same formula is
##{S_\Xi=A_\Xi-B_\Xi C_\Xi^{-1}B_\Xi^*,}
where #{B_\Xi} is an #{m_{X,\Xi}\times m_{Y,\Xi}} matrix over
#{D_\Xi}, and the products retain their displayed order.}

\proof{
\p{Let #{\rho_X,\rho_Y} denote the actions on the two summands.
Equivariance of #{Q} gives
#{A\rho_X(g)=\rho_X(g)A},
#{B\rho_Y(g)=\rho_X(g)B}, and
#{C\rho_Y(g)=\rho_Y(g)C}, together with the adjoint identity
for #{B^*}. Positivity on #{(0,y)} makes #{C} positive and
invertible. Its inverse commutes with #{\rho_Y(g)} by multiplying
the commuting identity by #{C^{-1}} on both sides. Hence the
composite #{BC^{-1}B^*:X\to X} and #{S} commute with
#{\rho_X(g)}. The same relations hold for the projectors, since
they are real linear combinations of group actions.}

\p{Consequently #{B^*} takes #{X_\Xi} to #{Y_\Xi},
#{C^{-1}} preserves #{Y_\Xi}, and #{B} takes #{Y_\Xi} back to
#{X_\Xi}. The restriction of #{C^{-1}} is the inverse of the
restriction of #{C}, by restricting both inverse identities.
This proves the typed formula, extending \ref{fdip-003Q}.
Choose isometric copies of the same real irreducible in #{X_\Xi}
and #{Y_\Xi}. Intertwiners then become rectangular matrices over
#{D_\Xi} and composition becomes ordered matrix multiplication,
with adjunction given by conjugate transpose. This proves the
multiplicity formula also over #{\mathbb H}; no scalar factors
have been commuted. An absent #{Y_\Xi} contributes a zero composite.}

\p{Completing the real square gives
##{\begin{aligned}
\langle(x,y),Q(x,y)\rangle
 &=\langle x,Sx\rangle\\
 &\quad+\langle y+C^{-1}B^*x,
 C(y+C^{-1}B^*x)\rangle.
\end{aligned}}
Testing at #{y=-C^{-1}B^*x} proves #{S>0}; its self-adjointness
follows by adjointing the composite. This uses the real inner
product, regardless of the scalar algebra of a multiplicity matrix.}
}

\p{Use induced Euclidean volumes and let #{\pi:H\to X} be the
orthogonal projection. For every fixed #{x}, translation in #{Y}
and the completed square give
##{\int_Y e^{-\langle(x,y),Q(x,y)\rangle/2}\,d\lambda_Y(y)
 =Z_Ce^{-\langle x,Sx\rangle/2}.}
Nonnegative Tonelli and normalization therefore give
#{Z_Q=Z_CZ_S} and #{\pi_*\mu_Q=\mu_S}, as in
[positive elimination](fdip-000D). Applying the same argument in
#{X_\Xi\mathbin\perp Y_\Xi}, and then the
[sector product law](fdip-0055), gives
##{\begin{aligned}
(\mathcal D_X)_*\pi_*\mu_Q
 &=\bigotimes_\Xi\mu_{S|_{X_\Xi}},\\
(\pi_\Xi)_*\mu_{Q|_{H_\Xi}}
 &=\mu_{S|_{X_\Xi}},\qquad
Z_C=\prod_\Xi Z_{C|_{Y_\Xi}}.
\end{aligned}}
Here #{\pi_\Xi:H_\Xi\to X_\Xi}; the identity
#{\pi E_\Xi=E_\Xi\pi} shows that decomposing and projecting
commute as maps. Product measures then give the same commuting
square as in \ref{fdip-003R}, with all real isotypic sectors in
place of the two sign sectors.}

\p{For vertex fields, the hypothesis holds when the retained set
#{R} is #{G}-stable: take #{X=\mathbb R^R} and
#{Y=\mathbb R^{V\setminus R}}. It asserts equivariance of the
induced marginal law. It does not assert that #{S=A}, the
compressed precision. The [cycle decimation](fdip-0057) gives a
#{G}-stable retained set with a nonzero Schur correction.}
