\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Theorem}
\title{A uniform spectral gap leaves no positive plateau}
\date{2026-11-06}

\p{Fix an integer #{\Delta\ge 1} and a real number #{c>0}.
Let #{G_k} be connected graphs whose number of vertices
tends to infinity, whose maximum degree is at most
#{\Delta}, and whose smallest positive combinatorial
eigenvalue is at least #{c}. The sequence has no
\vocabk{plateau}{fdip-00CO} at any #{n>0}.}

\proof{
\p{Apply \ref{fdip-00CU} to #{G_k}, and write #{\tau_k} for
the time at which the removed heat trace equals #{1}. The
lower bound on #{\tau_k} tends to infinity with the number
of vertices. Suppose there is a plateau at #{n>0} on
windows from #{a_k} to #{b_k}. For every large #{k}, the
spectral dimension stays between #{n/2} and #{3n/2} on that
window. The lemma also gives #{c\le 2\Delta}.}

\p{Consider times #{t\le\tau_k} at which the spectral
dimension lies between #{n/2} and #{3n/2}. The lemma
supplies #{ct\le d_s(t)\le 4\Delta t}, so
##{\frac{n}{8\Delta}\le t\le\frac{3n}{2c}.}
The quotient of the endpoints of this interval is
#{\frac{12\Delta}{c}}. A subwindow lying in #{t\le\tau_k}
and having endpoint quotient larger than
#{\frac{12\Delta}{c}} is impossible.}

\p{Consider times #{t\ge\tau_k} at which
#{d_s(t)\ge n/2}. The lemma supplies
#{d_s(t)\le 4\Delta t\,\ue^{-c(t-\tau_k)}}, hence
##{t-\tau_k\le\frac1c\log\frac{8\Delta t}{n}.}
Let #{\beta} be the right endpoint of such a window and set
#{s=\beta-\tau_k}. Then
#{\ue^{cs}\le 8\Delta(\tau_k+s)/n}. If #{s\ge\tau_k}, then
#{\ue^{cs}/s\le\frac{16\Delta}{n}}. The quotient
#{\ue^{cs}/s} tends to infinity with #{s}, so this bound
forbids #{s\ge\tau_k} once #{\tau_k} is large. Thus
#{s<\tau_k} and
#{s\le\frac{1}{c}\log(16\Delta\tau_k/n)}. The quotient
#{\frac{\beta}{\tau_k}} tends to #{1}. A subwindow in the region
#{t\ge\tau_k} whose endpoint quotient tends to infinity is
impossible.}

\p{The original quotient #{b_k/a_k} tends to infinity. If
#{b_k\le\tau_k}, or if #{a_k\ge\tau_k}, the window is one
of the two subwindows just excluded. If #{a_k<\tau_k<b_k},
the product of #{\tau_k/a_k} and #{b_k/\tau_k} equals
#{b_k/a_k}, so the larger factor is at least the square
root and still tends to infinity. That factor is the
endpoint quotient of one of the two subwindows.}
}
