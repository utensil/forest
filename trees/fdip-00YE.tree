\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Definition}
\title{The internal exterior pairing}
\date{2026-11-17}

\p{Let #{k} be a commutative unital ring and #{V} a finite
projective #{k}-module. Fix a quadratic form #{q} and a separately
declared perfect symmetric bilinear form #{b} such that
#{q(v)=b(v,v)}. Perfect means that
#{v\mapsto b(v,-)} is an isomorphism #{V\to V^*}, where
#{V^*=\operatorname{Hom}_k(V,k)}. Fix a finite bound #{N}
such that #{V} is a direct summand of #{k^N}. The
\newvocab{internal exterior module} is
#{E=\bigoplus_{p=0}^N\Lambda^pV}. Its
\newvocab{exterior pairing} #{B} makes different degrees orthogonal
and is given on equal degrees by
##{B(v_1\wedge\cdots\wedge v_p,w_1\wedge\cdots\wedge w_p)
 =\det\bigl(b(v_i,w_j)\bigr)_{1\leq i,j\leq p}.}
On degree zero, #{B(a,c)=ac} for #{a,c\in k}.}
