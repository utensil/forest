\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Definition}
\title{An ordered tensor contraction along chosen paths}
\date{2026-11-17}

\p{Choose a common vertex #{x}, vertices
#{y_1,\ldots,y_s}, and paths #{\gamma_j:y_j\to x}
with represented transports #{h_j(U)} as in the
\vocabk{dressed pair}{fdip-00WD}.
For #{t\in(F_x^*)^{\otimes s}}, define the
\newvocab{tensor contraction}
#{P_{t,\boldsymbol\gamma}(U)} by extending linearly
the rule
##{P_{\lambda_1\otimes\cdots\otimes\lambda_s,
       \boldsymbol\gamma}(U)
  =\lambda_1(h_1(U)\psi_{y_1})\cdots
    \lambda_s(h_s(U)\psi_{y_s}).}
The product is in the displayed order in the
paired exterior algebra. Multilinearity in the
#{\lambda_j} makes the rule a well-defined map from
the tensor product. The paths and their order are
part of the observable.}
