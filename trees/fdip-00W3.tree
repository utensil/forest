\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Proposition}
\title{The algebra generated by translations and right actions}
\date{2026-11-17}

\p{On #{C^\bullet(X;\mathcal O_k)}, the
\vocabk{cochain translations}{fdip-00W0}
and constant \vocabk{internal right actions}{fdip-00VK}
generate a faithfully represented algebra
##{k[X]\otimes_k\mathcal O_k^{\mathrm{op}}.}
If all constant geometric right actions are also
included, the generated algebra is
##{k[X]\otimes_k\operatorname{Cl}(q)^{\mathrm{op}}
            \otimes_k\mathcal O_k^{\mathrm{op}}.}
Here #{k[X]} is the group algebra of the finite
additive vertex group.}

\proof{
\p{Translations commute with both constant right
actions, and the two right actions commute with
each other. Their composition rules are
##{\tau_a\tau_b=\tau_{a+b},\qquad
       R_cR_d=R_{dc}}
in the respective right-action factor.
Thus the tensor algebras have homomorphisms onto
the stated generated operation algebras.}

\p{For the first homomorphism, write a putative
relation as #{\sum_a\tau_a R_{b_a}^{\mathrm{int}}=0}.
Apply it to the degree-zero cochain
#{\delta_0\otimes1\otimes1}. The term indexed by
#{a} is supported at #{-a} and has coefficient
#{b_a}. The supports are distinct, so every
#{b_a=0}. This proves injectivity.}

\p{For the larger algebra, write a tensor as
#{\sum_{a,I}\,[a]\otimes e_I\otimes b_{a,I}}
in the group and Clifford bases. The same input
has output
##{\sum_{a,I}\delta_{-a}\otimes e_I\otimes b_{a,I}.}
Distinct supports and the exterior monomial
basis make every #{b_{a,I}} zero if this output
vanishes. This proves faithfulness without any
semisimplicity assumption.}
}
