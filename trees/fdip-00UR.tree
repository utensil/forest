\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Definition}
\title{The ring Pfaffian relative to a volume}
\date{2026-11-17}

\p{Let #{E} be finite free of rank #{2s} over a commutative
ring #{k}, and let #{b:E\times E\to k} be alternating.
Under the determinant pairing, an exterior product of two
dual vectors acts by
##{(\lambda\wedge\mu)(x,y)
 =\lambda(x)\mu(y)-\lambda(y)\mu(x).}
Let #{a_b\in\Lambda^2(E^*)} be the element corresponding
to #{b} through this finite-free identification.}

\p{Choose a basis generator #{\omega} of the free top line
#{\Lambda^{2s}(E^*)}. The \newvocab{ring Pfaffian}
relative to #{\omega} is the unique scalar satisfying
##{\divcoef{a_b}{s}=\pfaffian_\omega(b)\,\omega,}
using the \vocabk{divided coefficients}{fdip-00TF}.
In rank zero the volume is fixed to #{1}, giving the value one.
This extends the real or complex \vocabk{Pfaffian}{fdip-008I};
\ref{fdip-00UT} gives its finite matching formula.}
