\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\title{Spatial Dirac operators}
\date{2026-10-20}

\p{A periodic spatial grid carries a different Clifford-module
problem from the configuration space. With the declared complex
Hermitian pairing, centered differences give a
[skew-adjoint finite Dirac operator](fdip-000S) #{D} and positive square
#{-D^2=D^*D}. Its [Fourier blocks](fdip-000S),
[zero modes and nearest-neighbor mismatch](fdip-000T) can be calculated
exactly. These are finite statements, without a continuum identification.}

\transclude{fdip-000R}
\transclude{fdip-000S}
\transclude{fdip-000T}
