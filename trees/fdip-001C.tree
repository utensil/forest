\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\title{Spatial Dirac operators}
\date{2026-10-20}

\p{A periodic spatial grid carries a different Clifford-module
problem from the configuration space. A separately chosen complex
Clifford module couples to [centered differences](fdip-000R).
The [square and Fourier blocks](fdip-000S) of the resulting Dirac
operator can be calculated exactly. Its
[zero modes and comparison with nearest-neighbor differences](fdip-000T)
show why a Clifford construction alone does not determine the desired
kinetic operator or a continuum limit.}

\transclude{fdip-000R}
\transclude{fdip-000S}
\transclude{fdip-000T}
