\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Example}
\title{The first two gasket graphs}
\date{2026-11-06}

\p{#{G_0} has three vertices and three edges. The refinement
adds three midpoints, so #{G_1} has 6 vertices. Its three
cells are the triangles on #{\{A,b,c\}}, on #{\{B,a,c\}}, and
on #{\{C,a,b\}}. Each cell contributes three edges, and
#{G_1} has 9 edges.}
