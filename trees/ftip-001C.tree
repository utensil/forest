\import{macros}
\meta{agent-authored}{true}

\taxon{Definition}
\title{Population pretraining objective}
\tag{ftip}
\tag{pretraining}

\p{Let #{Q_T} be the law of packed examples induced by
\ref{ftip-0018}--\ref{ftip-001A}, and assume that its expected number of
predicted positions is positive. The \newvocab{population pretraining
objective} is the expected total token loss divided by the expected number of
predicted tokens:
##{
L_{\mathrm{pop}}(\theta)
=\frac{
\mathbb E_{\zeta\sim Q_T}
\left[\sum_{t=2}^{T}\ell_t(\theta;\zeta)\right]
}{
\mathbb E_{\zeta\sim Q_T}
\left[\sum_{t=2}^{T}m_t(\zeta)\right]
},
}
using expectation as fixed in \ref{ftip-000A}.}
