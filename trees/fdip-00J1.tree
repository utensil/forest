\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Proposition}
\title{Gauge covariance and physical pullback}
\date{2026-11-09}

\p{For the \vocabk{massive graded Wilson data}{fdip-00IN}, write #{G=G_g}. Then
##{K_{U^g}=GK_UG^{-1}.}
For an invertible endomorphism #{G} of any complex #{V}, let #{G^\vee:V^*\to V^*} be the complex-linear dual #{\ell\mapsto\ell\circ G}. The physical action #{(v,\bar v)\mapsto(Gv,\bar v\circ G^{-1})} induces the exterior-algebra pullback
##{\alpha_G=\Lambda(G^\vee\oplus G^{-1}):\mathcal A(V)\to\mathcal A(V).}
It satisfies
##{\alpha_G\psi=G\psi,\qquad \alpha_G\bar\psi=\bar\psi G^{-1},\qquad
J_V\alpha_G=J_V,\qquad \alpha_G\alpha_H=\alpha_{HG}.}
Thus pullback is a right action; #{G\mapsto\alpha_{G^{-1}}} is a left representation. Applying the same transformation to the independent source algebra gives
##{\mathscr Z_{K_{U^g}}(\bar\eta G^{-1},G\eta)=\mathscr Z_{K_U}(\bar\eta,\eta),\qquad
\mathcal Z(\bar\eta G^{-1},G\eta)=\mathcal Z(\bar\eta,\eta).}
The coupled quadratic action, source contraction and coefficient integral are invariant under the simultaneous physical transformations.}

\proof{
\p{Substitution of the inverse transformed link gives #{T_j^{U^g}G=GT_j^U} for every positive period. This intertwines #{D,L,K}, as in \ref{fdip-009P}.}

\p{For the general linear pullback, the coevaluation identities give #{\alpha_G\psi=G\psi} and #{\alpha_G\bar\psi=\bar\psi G^{-1}}. These use the algebraic dual, not a Hermitian adjoint. Hence #{\alpha_G\theta_K=\theta_{G^{-1}KG}} and #{\alpha_G\theta=\theta}, so #{\alpha_G\Omega_V=\Omega_V}. The top exterior multiplier is also #{\det(G^\vee)\det(G^{-1})=1}, proving invariance of #{J_V}. On the two generator summands, composition gives #{G^\vee H^\vee=(HG)^\vee} and #{G^{-1}H^{-1}=(HG)^{-1}}, proving the right-action rule even for noncommuting #{G,H}.}

\p{Substituting the transformed fields and sources cancels each adjacent #{G^{-1}G} in the contractions. Since #{K_{U^g}=GK_UG^{-1}}, this proves the fixed-connection source identity. Product Haar measure is invariant under the linkwise translations #{U\mapsto U^g}, and #{w_g} and #{\det K_U} are invariant. A change of connection variables gives the averaged identity. The same argument proves invariance of the coupled functional with transformed insertions.}
}

\texfig{\begin{tikzcd}[column sep=large,row sep=large]
\mathcal V \arrow[r,"K_U"] \arrow[d,"G"'] & \mathcal V \arrow[d,"G"] \\
\mathcal V \arrow[r,"K_{U^g}"'] & \mathcal V
\end{tikzcd}}

\p{The square expresses covariance of the field operator. The polynomial action induced by this physical transformation is the right pullback #{\alpha_G}.}
