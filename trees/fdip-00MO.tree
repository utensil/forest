\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Definition}
\title{Path maps between link configurations}
\date{2026-11-11}

\p{Let #{G} be a compact Hausdorff group. Take
\vocabk{finite incidence presentations}{fdip-0002}
##{\begin{aligned}
 \Gamma_f&=(V_f,E_f,s_f,t_f),\\
 \Gamma_c&=(V_c,E_c,s_c,t_c).
 \end{aligned}}
Choose an injection #{\iota:V_c\to V_f}. For every #{a\in E_c}
choose a fine oriented path #{p_a} from #{\iota(s_c(a))} to
#{\iota(t_c(a))}. Write its successive traversals as
#{e_1^{\epsilon_1},\ldots,e_\ell^{\epsilon_\ell}}, with
#{\epsilon_j\in\{1,-1\}}; an exponent #{-1} means that the edge
is traversed against its orientation. Repeated edges,
backtracking and loops are allowed. A path of length zero is
allowed only when its endpoints coincide.}

\p{On the configuration spaces #{X_f=G^{E_f}} and
#{X_c=G^{E_c}}, the \newvocab{coarse path map} is
##{(\mathcal B U)_a
 =U_{e_\ell}^{\epsilon_\ell}\cdots U_{e_1}^{\epsilon_1}.}
The empty product is #{e}. This is the rightmost-first
[holonomy convention](fdip-006F). Equip the spaces with their
Borel sigma-algebras and normalized Haar probabilities
#{\nu_f,\nu_c} on the product groups. For compact Hausdorff
groups, these are the regular Borel product probabilities of
\ref{fdip-007B}. When #{G} is metrizable, the Borel sigma-algebras
are also the finite product sigma-algebras.}

\p{The vertex groups #{K_f=G^{V_f}} and #{K_c=G^{V_c}} act by
the [gauge convention](fdip-006E),
##{(g\cdot U)_e=g_{t(e)}U_eg_{s(e)}^{-1}.}
The restriction homomorphism is #{r(g)_v=g_{\iota(v)}}.
On functions use inverse pullback,
#{R_gF(U)=F(g^{-1}\cdot U)}.
For the reference law of retained paths, write
##{\rho=\mathcal B_*\nu_f.}
This image measure is part of the retained data. It is not
defined to equal #{\nu_c}.}
