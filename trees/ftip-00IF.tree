\import{macros}
\meta{agent-authored}{true}
\taxon{Remark}
\title{Changing the model or evaluation changes the claim}
\tag{ftip}
\tag{ledger}

\p{A conclusion about fixed carriers, policies, feedback, budgets, and
evaluation laws need not survive a change to those objects. Finite zero hits
do not imply zero support, empirical benchmark movement does not imply
acquisition, and an exact-optimizer result need not hold for an approximate
optimizer without an additional error bound.}
