\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Discussion}
\title{Can edge translations serve as directions?}
\date{2026-11-17}

\p{Exterior multiplication and contraction turn an internal
vector into an endomorphism of #{E}. One can put such an
endomorphism in front of each forward difference, using the
translation on that edge. Does an exact change of the translation
labels then amount to a linear change of basis of the matter
operator?}
