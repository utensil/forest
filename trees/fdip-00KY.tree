\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Theorem}
\title{Scalar functionals intertwined by elimination}
\date{2026-11-10}

\p{Keep the algebras, maps, weight #{w} and marginal units #{z,t} of \ref{fdip-00KX}. Let #{\lambda:C\to k} be linear, and even if the grading is retained. Suppose #{\kappa=\lambda(t)} is a unit of #{k}. The scalar functionals
##{\begin{aligned}
\omega_A(a)&=\kappa^{-1}\lambda(D(aw)),\\
\omega_B(b)&=\kappa^{-1}\lambda(Q(bz)),\\
\omega_C(c)&=\kappa^{-1}\lambda(ct)
\end{aligned}}
then satisfy #{\omega_C(1)=\omega_B(1)=\omega_A(1)=1} and
##{\omega_A=\omega_B\circ E_{A,B}^{w}=\omega_C\circ E_{A,C}^{w},
\qquad \omega_B=\omega_C\circ E_{B,C}^{z}.}}

\proof{
\p{Centrality of #{t} gives #{\lambda(E_{B,C}^{z}(b)\,t)=\lambda(Q(bz))}, so #{\omega_C\circ E_{B,C}^{z}=\omega_B}. The same cancellation with #{z} gives #{\omega_B\circ E_{A,B}^{w}=\omega_A}. Substituting the direct formula for #{E_{A,C}^{w}} gives the remaining identity. On #{B},
##{\omega_A(b)=\kappa^{-1}\lambda(D(bw))=\kappa^{-1}\lambda(Q(bz))=\omega_B(b),}
and likewise #{\omega_B} agrees with #{\omega_C} on #{C}.}
}
