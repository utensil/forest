\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Theorem}
\title{Adjugates and complementary source minors}
\date{2026-11-17}

\p{For #{K,B\in\operatorname{End}_k(V)} on a finite free
#{k}-module #{V}, the
\vocabk{ring paired coefficient}{fdip-00TJ} satisfies
##{\begin{aligned}
 \mathcal I_V\bigl((\psi\otimes\bar\psi)
       \extexp(\theta_K)\bigr)&=\adjugate K,\\
 \mathcal I_V\bigl(\bar\psi(B\psi)
       \extexp(\theta_K)\bigr)&=-\trace(B\adjugate K).
\end{aligned}}
The first insertion is unbarred first.}

\p{For #{0\le s\le N=\operatorname{rank}V}, the perfect wedge
pairing into #{\Lambda^NV} determines an endomorphism
#{\adjugate_s K} of #{\Lambda^sV} by
##{((\adjugate_s K)u)\wedge v
   =u\wedge(\Lambda^{N-s}K)v}
for #{u\in\Lambda^sV} and #{v\in\Lambda^{N-s}V}. In the
\vocabk{ring source polynomial}{fdip-00TN}, put the barred
sources first. The component of barred and unbarred degrees
#{(s,s)} then belongs to #{\Lambda^sV\otimes(\Lambda^sV)^*}.
Under its identification with #{\operatorname{End}_k(\Lambda^sV)}
this component equals #{(-1)^{s(s-1)/2}\adjugate_s K}.
Components of unequal source degrees vanish. These identities
hold for every #{K} over the commutative ring #{k}.}

\proof{
\p{Perturb a single entry of #{K} by a scalar indeterminate
#{t}. Since
#{\theta_{K+tE_{ab}}=\theta_K+t\psi_b\bar\psi_a},
\ref{fdip-00TH} gives
##{\extexp(\theta_{K+tE_{ab}})
 =\extexp(\theta_K)(1+t\psi_b\bar\psi_a).}
Compare the #{t}-coefficients after applying \ref{fdip-00TL}.
The determinant coefficient is the cofactor
#{\operatorname{cof}_{ab}K=(\adjugate K)_{ba}}.
This proves every matrix entry of the first insertion identity.
The left side is intrinsically an endomorphism, so the coordinate
identities assemble. Reversing the two odd generators changes
the sign; contracting with #{B} gives the trace formula.}

\p{Factor the finite source polynomial before integration as
##{\extexp(\theta_K)
 \prod_i(1+\bar\eta_i\psi_i)
 \prod_j(1+\bar\psi_j\eta_j).}
In a basis indexed by #{1,\ldots,N}, select increasing
source sets #{I,J} for the word #{\bar\eta_I\eta_J}. This
leaves unbarred field indices
#{I^c} and barred indices #{J^c}. Their cardinalities must be
equal, so put #{s=|I|=|J|}. By \ref{fdip-00TL}, the remaining grouped field
coefficient is
#{(-1)^{p(p-1)/2}\det K_{J^c,I^c}}, with #{p=N-s}.}

\p{Moving sources first, then grouping and sorting field words
and comparing with #{\Omega_V} gives the total exponent
##{\begin{aligned}
 &\frac{s(s-1)}2+\frac{s(s+1)}2+s^2+sp
       +\left(\sum I-\frac{s(s+1)}2\right)\\
 &+\left(\sum J-\frac{s(s+1)}2\right)
       +\frac{p(p-1)}2+\frac{N(N-1)}2\\
 &\qquad\equiv\frac{s(s-1)}2+\sum I+\sum J\pmod2.
\end{aligned}}
The equality #{N=p+s} gives the last reduction. The coefficient
of #{\bar\eta_I\eta_J} is therefore
##{(-1)^{s(s-1)/2+\sum I+\sum J}\det K_{J^c,I^c},}
with empty minors and words equal to one.}

\p{Each exterior basis wedge pairs with its complementary wedge
to give a signed generator of #{\Lambda^NV}, and with every
other wedge of complementary degree to give zero. This proves
perfection and hence existence and uniqueness of #{\adjugate_s K}.
In its defining identity take #{u=e_J} and #{v=e_{I^c}}.
On the left only the #{e_I} coefficient survives. On the right
the coefficient of #{e_{J^c}} in #{(\Lambda^{N-s}K)e_{I^c}}
is #{\det K_{J^c,I^c}}. The signs of #{e_I\wedge e_{I^c}}
and #{e_J\wedge e_{J^c}} differ by #{(-1)^{\sum I+\sum J}}.
Thus the source coefficient is #{(-1)^{s(s-1)/2}} times the
#{(I,J)} entry of #{\adjugate_s K}, over #{k} itself, including
characteristic #{2}.}
}
