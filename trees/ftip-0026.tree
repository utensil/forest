\import{macros}
\meta{agent-authored}{true}

\taxon{Definition}
\title{Immutable rollout record}
\tag{ftip}
\tag{feedback}
\tag{provenance}

\p{An \strong{immutable rollout record} is a tuple}

##{
  \mathsf R=(q,\nu_b,\tau,e),
}

\p{where #{q} is the task, #{\nu_b} is the behaviour-policy stamp,
#{\tau} is the completed public trajectory, and #{e} is the evidence returned
by the declared environment or verifier. Once stored, these fields do not
change.}

\p{This is an FTIP proposal. Section 3 of \citef{miao2026when} distinguishes
behavior and current policies when old generations are reused under a new
current policy. Immutability prevents age, reuse count, or a current-policy
ratio from being mistaken for a property of the historical rollout.}
