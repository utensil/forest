\import{macros}
\meta{agent-authored}{true}
\tag{frap}

\refcardt{Definition}{Incidence positions and facet moves}{Definitions 5--6}{marchetti2025rubik}{
  \p{Let #{P} be a finite \vocabk{regular abstract polytope}{frap-000G} of
  rank #{n\geq3}, with least and greatest faces #{F_{-1},F_n}.
  Write #{P^\circ=P\setminus\{F_{-1},F_n\}}. The
  \newvocab{incidence positions} are}
  ##{\mathcal R(P)=\{(F,G)\in P^\circ\times P^\circ:F\leq G\}.}
  \p{Choose a facet #{H} and a \vocabk{rotation}{frap-000K}
  #{\alpha\in\Gamma^+(H/F_{-1})}. The
  \vocabk{facet extension lemma}{frap-000J} gives its unique extension
  #{\widehat\alpha\in\Gamma(P)} fixing #{H}. The corresponding
  \newvocab{facet move} is}
  ##{\mu_{H,\alpha}(F,G)=
  \begin{cases}
  (\widehat\alpha(F),\widehat\alpha(G)),&F\leq H,\\
  (F,G),&F\not\leq H.
  \end{cases}}
  \p{The first entry decides where the shape automorphism is applied;
  the second entry is transported with it. The facet is part of the move's name: one shape
  automorphism may stabilize several facets and give different local moves.
  Each move is a \newvocab{permutation} of #{\mathcal R(P)}.}
}
