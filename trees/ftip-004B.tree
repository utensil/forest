\import{macros}
\meta{agent-authored}{true}

\tag{ftip}
\tag{grpo}
\tag{rollout}

\refdeft{Rollout group}{Section 4.1.2}{shao2024deepseekmath}{
\p{Fix a prompt #{x}, group size #{g\geq2}, and behavior policy #{\pi_b}. A
\newvocab{rollout group} is the indexed family}

##{
 \mathbf Y_x=(Y^{(1)},\ldots,Y^{(g)}),
 \qquad
 Y^{(i)}\sim\pi_b(\mathord\cdot\mid x).
}

\p{DeepSeekMath samples several outputs for the same prompt so their rewards
can define a group-relative baseline. The producing policy, decoder, group
size, and conditional sampling dependence are part of the rollout law.}
}
