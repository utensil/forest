\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Remark}
\title{Commutants already computed for the tetrahedral group}
\date{2026-11-12}

\p{The direction algebra of \ref{fdip-00QJ} is the group algebra of
#{2T}. Over #{\mathbb R}, \ref{fdip-004Z} classifies the commutant
of an irreducible orthogonal representation as #{\mathbb R},
#{\mathbb C} or #{\mathbb H}. \ref{fdip-00MK} records one
irreducible real representation of each Frobenius-Schur type, and
\ref{fdip-0051} converts the indicator into that commutant. Over
#{\mathbb F_3}, \ref{fdip-00MK} realizes the group as
#{\operatorname{SL}(2,\mathbb F_3)} on a module of rank #{2}, with
image equal to the matrix algebra, so the commutant of that module
is #{\mathbb F_3}. The rational division algebras inside
#{\mathbb Q[2T]}, and the group algebra over a prime other than
#{3}, are left open.}
