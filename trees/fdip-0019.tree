\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\title{Backgrounds and symmetry}
\date{2026-10-20}

\p{Comparing theories requires specifying what a
[background map](fdip-000G) preserves. Relabelings and signed incidence
symmetries transport fields, pairings and Gaussian states; a retained
partition adds a [compatibility condition](fdip-000K).
A [trace ratio](fdip-000I) separates weighted backgrounds even when
positive scaling and relabeling are allowed.}

\transclude{fdip-000G}
\transclude{fdip-000H}
\transclude{fdip-000I}
\transclude{fdip-000J}
\transclude{fdip-000K}
