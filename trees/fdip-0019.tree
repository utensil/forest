\tag{fdip}
\title{Backgrounds and symmetry}
\date{2026-10-20}

\texfig{\begin{tikzpicture}[x=1cm,y=1cm,font=\sffamily,
  box/.style={draw=black,line width=0.5pt,rounded corners=2pt,align=center,execute at begin node={\hyphenpenalty=10000\exhyphenpenalty=10000},
