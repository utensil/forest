\node[ext=6.4cm] (II) at (7,7.05) {Part II: Gaussian laws};
\node[box=7.4cm] (a) at (7,5.2) {Backgrounds and symmetry};
\node[box=7.4cm] (b) at (7,3.8) {Group-algebra sectors};
\node[ext=4.8cm] (IV) at (3.5,0.0) {Part IV: Finite-group symmetry};
\node[ext=5.6cm] (V) at (10.5,0.0) {Part V: Clifford algebras and Dirac operators};
\draw[arr] (II) -- node[lab,midway,right=1mm] {what can be exchanged in a discrete world\\ while the physics stays the same?} (a);
