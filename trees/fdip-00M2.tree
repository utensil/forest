\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Remark}
\title{Entrywise recovery of a matrix-valued Wilson expectation}
\date{2026-11-10}

\p{In the ordered orthonormal basis of \ref{fdip-00M1}, an
#{\operatorname{End}(F)}-valued observable of \ref{fdip-006O}
becomes a #{d\times d} matrix-valued function. Each entry is a
scalar observable. The expectation of the matrix is the matrix
of those entry expectations, because the finite sum acts entrywise
after that basis map.}
