\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Definition}
\title{The fine-site map of based cells}
\date{2026-11-23}

\p{Let #{X=\prod_{i=1}^n\mathbb Z/N_i\mathbb Z} be the torus
of [based cochains](fdip-00SH), with #{n\ge1} and
#{N_i\ge3}. Orient the directions of each cell #{c_I(x)} in
increasing order. Let #{\varepsilon_i} be its coordinate
step and put #{\tilde X=\prod_i\mathbb Z/(2N_i)\mathbb Z}.
The \newvocab{fine-site map} sends #{c_I(x)} to the site
##{s=2x+\sum_{i\in I}\varepsilon_i\quad\text{in }\tilde X.}
In each coordinate #{2x_i} is read modulo #{2N_i}.}
