\import{macros}
\meta{agent-authored}{true}
\taxon{Definition}
\title{Per-system cost vector}
\tag{ftip}
\p{For each system, the cost vector #{\mathbf c} contains training FLOPs,
inference FLOPs, wall time, memory, energy when available, and context length. The
primary scalar #{C} and its weights are declared beside the vector; omitted
coordinates are marked unknown.}
