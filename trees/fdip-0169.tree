\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Example}
\title{Axis, diagonal and self-opposite labels}
\date{2026-11-26}

\p{Consider #{m\ge1} coordinates of the same period #{N}. Let
#{v\in\mathbb Z/N\mathbb Z} satisfy #{2v\ne0}. For an axis label
#{(v,0,\ldots,0)}, \ref{fdip-0168} allows every sign and permutation
of the zero coordinates. The nonzero coordinate must stay in place
with its positive sign. Its orbit has #{2m} labels: the nonzero
entry can occupy any one coordinate and can have either value
#{v} or #{-v}. For the diagonal label #{(v,\ldots,v)} all
#{m!} permutations fix it and all their signs must be positive.
Its orbit consists of the #{2^m} independent sign choices.}

\p{At zero the whole group fixes the label. For even #{N}, put
#{N/2} in #{a} of the #{m} coordinates and zero in the others,
where #{0\le a\le m}. Both residues equal their negatives, so
every sign fixes them. Permutations fix the label precisely when
they preserve the two sets of positions. Its orbit has
#{\binom{m}{a}} points, one for each placement of the half-period
entries. Each count agrees with \ref{fdip-0167}; for different
periods the counts multiply, since the coordinate changes on
the period blocks are independent.}
