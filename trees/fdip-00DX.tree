\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Theorem}
\title{The circle covariance is a two-exponential kernel}
\date{2026-11-06}

\p{Fix #{m>0}. For a shorter arc #{\delta} with
#{0\le\delta\le 1/2}, the function #{G} of \ref{fdip-00BG}
equals
##{K(\delta)=\frac{\ue^{-m\delta}+\ue^{-m(1-\delta)}}{2m\bigl(1-\ue^{-m}\bigr)}.}
}

\proof{
\p{The denominator #{2m\bigl(1-\ue^{-m}\bigr)} is positive.
\ref{fdip-00BG} gives
##{G(\delta)=\frac{\cosh\bigl(m\bigl(\frac{1}{2}-\delta\bigr)\bigr)}{2m\sinh\bigl(\frac{m}{2}\bigr)}.}
Write #{u=m\bigl(\frac{1}{2}-\delta\bigr)} and #{v=\frac{m}{2}}.
The addition formulas are
##{\cosh u=\frac{\ue^{u}+\ue^{-u}}{2},
\qquad
\sinh v=\frac{\ue^{v}-\ue^{-v}}{2},}
so
##{G(\delta)=\frac{\ue^{u}+\ue^{-u}}{2m\bigl(\ue^{v}-\ue^{-v}\bigr)}.}
Multiply the numerator and the denominator by #{\ue^{v}}.
The exponents simplify by #{u+v=m(1-\delta)} and
#{v-u=m\delta}, and #{2v=m}, so
##{G(\delta)=\frac{\ue^{m(1-\delta)}+\ue^{m\delta}}{2m\bigl(\ue^{m}-1\bigr)}.}
Multiplying the numerator and the denominator of #{K(\delta)}
by #{\ue^{m}} uses
#{\ue^{m}\bigl(\ue^{-m\delta}+\ue^{-m(1-\delta)}\bigr)
=\ue^{m(1-\delta)}+\ue^{m\delta}}
and #{\ue^{m}\bigl(1-\ue^{-m}\bigr)=\ue^{m}-1}. The numerators
agree, and the denominators agree.}
}
