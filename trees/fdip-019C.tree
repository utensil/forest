\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Definition}
\title{Inversion with a spin grading}
\date{2026-11-26}

\p{On a finite periodic grid
#{\Lambda=\prod_{j=1}^{n}\mathbb Z/N_j\mathbb Z}, with
#{n\ge1} and positive periods, put #{b(x)=-x}. Let fields
take values in #{S\otimes F}, for nonzero finite-dimensional
complex Hermitian spaces #{S,F}. Take self-adjoint directions
#{\varepsilon_j} on #{S} with
#{\varepsilon_i\varepsilon_j+\varepsilon_j\varepsilon_i
=2\delta_{ij}\bbI_S}. Supply a self-adjoint
\vocabk{grading}{fdip-013N} #{\Gamma} on #{S} anticommuting
with every direction. The \newvocab{graded total inversion}
of a field is
##{(U_-\psi)(x)=(\Gamma\otimes\bbI_F)\psi(-x).}
For #{n=2m} the canonical choice is the even volume grading
#{C=\ui^m\psI} of \ref{fdip-009X}, where #{\psI} is the
ordered product of the directions.}
