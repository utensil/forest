\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Remark}
\title{Continuity of the mean as the external field tends to zero}
\date{2026-11-21}

\p{Keep the fixed finite configuration set of \ref{fdip-0100}, and assume
that each site factor and each edge factor is continuous at #{\eta=0}.
Every configuration weight is a finite product of continuous functions,
so the partition and the weighted value are continuous at zero. If
#{Z(0)\ne0}, the normalized mean is defined for every #{\eta} sufficiently
near zero and tends to the zero-field value of \ref{fdip-0100}. Under
the invariance hypotheses of that proposition,
#{\lim_{\eta\to0}\langle\phi_x\rangle_\eta=0}.}

\p{For a real inner product and a supplied field vector #{u}, the factors
#{\ue^{\eta\langle u,\phi_x\rangle}} are continuous and equal #{1} at
#{\eta=0}. When #{\eta\ne0} they can distinguish two points of one
orbit.}
