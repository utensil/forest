\import{macros}
\meta{agent-authored}{true}
\tag{frap}
\title{Transfer and the effect of dimension}

\p{The \vocabk{total-orientation character}{frap-000S} detects one conservation law, but it does not
explain how to compare frames chosen at different positions. The motivating
question is how to transport that comparison through a transitive action.
\vocabk{Transfer}{frap-000W} uses the same cancellation as the
\vocabk{total-orientation character}{frap-000S} for coset representatives
\citet{Sections 3.1--3.3}{mayer2015artin}. The first section identifies
the connection through an actual transitive action and its
\vocabk{stabilizer}{frap-000Y}; the second computes how the
\vocabk{local rotation groups}{frap-000Z} of simplices and cubes change
with dimension, following \citet{Sections 4--5}{marchetti2025rubik}.}

\transclude{frap-0012}
\transclude{frap-0013}
