\import{macros}
\meta{agent-authored}{true}
\tag{frap}
\title{Transfer and the effect of dimension}

\p{The \vocabk{total-orientation character}{frap-000S} cancels changes of local
frames. \vocabk{Transfer}{frap-000W} uses the same cancellation for coset
representatives \citet{Sections 3.1--3.3}{mayer2015artin}.
The first section identifies the connection through an actual
transitive action and its \vocabk{stabilizer}{frap-000Y}. The second
computes how the \vocabk{local rotation groups}{frap-000Z} of simplices
and cubes change with dimension,
following \citet{Sections 4--5}{marchetti2025rubik}.}

\transclude{frap-0012}
\transclude{frap-0013}
