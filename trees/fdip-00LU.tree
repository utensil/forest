\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Remark}
\title{Principal submatrices of a local Gaussian}
\date{2026-11-10}

\p{Order a vertex set #{T} and use the counting basis. For
#{S\subseteq T}, the compressed covariance
#{\pi_{S,T}G\pi_{S,T}^*} of \ref{fdip-0064} is the principal
submatrix #{G_{SS}}. The marginal precision is
##{(G_{SS})^{-1}
 =Q_{SS}-Q_{S,S^c}Q_{S^c,S^c}^{-1}Q_{S^c,S},}
where #{S^c=T\setminus S}. Two local laws are compatible exactly
when these principal submatrices agree on each overlap. The
operators in the definition do not depend on the ordering.}
