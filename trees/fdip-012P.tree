\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Example}
\title{The characteristic polynomial on the residual edge}
\date{2026-11-21}

\p{On the group of \ref{fdip-0126}, let #{B} be the pairing
kernel of \ref{fdip-012F} for the vector of that example, and
let #{\mathcal K} equal #{2} at the identity and #{1} at every
other element. In the indicator basis of the #{12} double
cosets of \ref{fdip-012I}, the
[one-edge operator](fdip-012C) has the matrix of
\ref{fdip-013H}. Its characteristic polynomial is the
polynomial determined there.}

\proof{
\p{The kernel is the class function named in \ref{fdip-013H}.
\ref{fdip-012I} supplies the #{12} double cosets, and
\ref{fdip-012O} supplies the values of the normalized pairing.
Adding #{2}, as in \ref{fdip-012F}, gives the values of #{B}.}
}
