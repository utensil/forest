\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Example}
\title{The characteristic polynomial on the residual edge}
\date{2026-11-21}

\p{On the group of \ref{fdip-0126}, let #{B} be the pairing
kernel of \ref{fdip-012F} for the vector of that example, and
let #{\mathcal K} be a declared
[class-function kernel](fdip-012C). In the indicator basis
of the double cosets, the
[one-edge operator](fdip-012C) has the matrix of
\ref{fdip-013H}. Its characteristic polynomial is the
polynomial determined there.}

\proof{
\p{\ref{fdip-012F} supplies the double-coset kernel.
\ref{fdip-013H} determines the matrix, and the characteristic
polynomial, from the declared values of both kernels and from
the double-coset sizes.}
}
