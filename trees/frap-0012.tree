\import{macros}
\meta{agent-authored}{true}
\tag{frap}
\title{Transfer and local orientation}

\p{Left multiplication permutes the cosets of a finite-index
subgroup. Representatives record the motion between cosets, leaving
one residual subgroup element at each position. Abelianizing their
product gives transfer
\citet{Sections 3.1--3.3}{mayer2015artin}. Transported frames then
identify its local image with the orientation character of an action.}

\transclude{frap-000W}
\transclude{frap-000X}
\transclude{frap-000Y}
