\import{macros}
\meta{agent-authored}{true}

\title{Outcome and process feedback}
\tag{ftip}
\tag{process-supervision}
\tag{reward-model}

\p{A completed response can receive one terminal judgment, while its
intermediate steps can receive separate judgments. These feedback structures
support different credit assignments. They must also be distinguished from
signals that are actually available online before later steps are observed.}

