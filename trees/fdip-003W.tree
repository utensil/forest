\tag{fdip}
\title{Discrete induction and its open interfaces}
\date{2026-10-30}

\p{How can algebra and geometry organize induction and background
variation? [Gaussian elimination](fdip-000F) gives a finite example;
the [synthesis conjecture](fdip-003X) and
[finite interfaces](fdip-003Y) distinguish this result from the
further maps required.}

\transclude{fdip-003X}
\transclude{fdip-003Y}
