\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Remark}
\title{Dimension and the edge letter}
\date{2026-11-13}

\p{The dimension of a grid is #{n}. Physics writes #{d} for that
dimension, and geometric calculus writes #{n}. The letter #{d} and the
mark #{\extd} then mean only the derivative. The letter #{e} is one
meaning: the basis element on an oriented edge or direction, as in
#{e_{xy}} and #{e_i(x)}. Euler's number is the upright #{\ue}.}
