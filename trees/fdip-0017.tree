\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\title{Real actions and Gaussian states}
\date{2026-10-20}

\p{Positive real edge energy and a mass term define a
[finite quadratic action](fdip-0004). Its normalized Gaussian law
turns integrable observables into expectations and supplies a
[state on polynomial functions](fdip-002A), with
[inverse precision as covariance](fdip-000B). The [massless case](fdip-000C)
shows why constant modes and the chosen constraint cannot be ignored;
these probability statements use real measure and positivity.}

\transclude{fdip-0004}
