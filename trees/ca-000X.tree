\refdeft{module}{Definition 1.3, p. 3}{jadczyk2019notes}{

\p{
    \label{Module}
    \leanok
    \lean{Module}
    \uses{Group,Ring}

    Let #{R} be a commutative \vocabk{ring}{ca-000U} with identity #{1_R}. A \newvocab{module} over #{R}, called an \vocab{#{R}-module}, is a pair #{(M, \bu)}, satisfying:

    \ol{
      \li{#{M} is an \vocabk{abelian}{ca-000R} group under #{+}.}
    
      \li{#{\bu : R \to M \to M} is called \newvocab{scalar multiplication}, acting on the left. For every #{a, b \in R}, #{x, y \in M}, we have
      
        \ol{
            \li{#{a \bu (x + y) = a \bu x + a \bu y}}
            \li{#{(a + b) \bu x = a \bu x + b \bu x}}
            \li{#{a \bu (b \bu x)=(a * b) \bu x}}
            \li{#{1_R \bu x = x}}
        }
      }
    }
}

}
