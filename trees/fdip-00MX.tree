\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Definition}
\title{Effective gauge weights and their reference measures}
\date{2026-11-11}

\p{For a \vocabk{coarse path map}{fdip-00MO} and a nonnegative
integrable fine weight, the \newvocab{effective gauge weight}
is the pair #{(\rho,f)} supplied by \ref{fdip-00MQ}, together
with its mass
##{\rho=\mathcal B_*\nu_f,\qquad
 f\rho=\mathcal B_*(w\nu_f),\qquad Z=\int f\,d\rho.}
Pairs differing only by a #{\rho}-null change in #{f} represent
the same retained weight. For #{Z>0}, their probability
law is #{Z^{-1}f\rho}.}

\p{Choose a finite nonnegative Borel representative of #{f}.
Its \newvocab{effective action} relative to #{\rho} is the
extended-valued function
##{S_{\mathrm{eff}}(u)=
 \begin{cases}-\log f(u),&f(u)>0,\\
 +\infty,&f(u)=0.
 \end{cases}}
It satisfies #{\ue^{-S_{\mathrm{eff}}}=f}.
If #{G} is compact metrizable and the fine weight is
gauge invariant as an #{L^1(\nu_f)} class, an everywhere
gauge-invariant representative may be chosen as in
\ref{fdip-00MQ}. Continuity or finiteness of this action at
every point is an additional property.}

\p{For a subsequent measurable map #{C}, composition sends
#{(\rho,f)} to #{(\sigma,h)}, where
##{\sigma=C_*\rho,\qquad h\sigma=C_*(f\rho).}
The tower theorem \ref{fdip-00MQ} identifies this pair with
the direct image under #{C\circ\mathcal B} and preserves
#{Z}. The reference is updated along with the weight.
The general result gives #{f\in L^1(\rho)}; it does not
assert a one-parameter Wilson form, centrality on one group,
or membership in #{L^2(\rho)}.}
