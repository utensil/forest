\import{spin-macros}
\meta{agent-authored}{true}
\taxon{Theorem}
\title{Maschke averaging}
\tag{math}
\tag{fgap}
\tag{group-algebra}
\tag{representation}
\lean{MonoidAlgebra.Submodule.exists_isCompl}

\p{Let #{G} be finite and #{k} a field in which #{|G|} is invertible. Every
subrepresentation #{W\subseteq V} has a #{G}-stable complement. Consequently
every finite-dimensional #{k[G]}-module, and #{k[G]} itself, is semisimple.}

\proof{
\p{Choose a #{k}-linear projection #{P:V\to W} and average its conjugates:
##{
P_G=\frac1{|G|}\sum_{g\in G}\rho(g)P\rho(g)^{-1}.
}
Then #{P_G} remains the identity on #{W} and commutes with #{G}. Its kernel is
a #{G}-stable complement. Division by #{|G|} requires the stated
invertibility hypothesis. This is Maschke's theorem as proved in
\citet{thm. 3.5.1, pp. 44--46}{sengupta2010representations}.}
}
