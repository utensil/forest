\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Theorem}
\title{A finite determinant formula and closed-walk remainder}
\date{2026-11-01}

\p{Let the vertices be
#{X=\prod_{j=1}^n\mathbb Z/L_j\mathbb Z}, with #{L_j\ge3}.
Give each edge #{(x,j):x\to x+e_j} weight one and a unitary or
orthogonal transport #{U_{x,j}} on a fixed fiber. For the
\vocabk{determinant action}{fdip-0070} with #{m>0}, let #{H_U}
be the covariant adjacency operator. Then
##{Q_U=(2n+m^2)\bbI -H_U,\qquad \|H_U\|\le2n<2n+m^2,}
and the determinant has the finite expansion
##{\det Q_U=\sum_{j=0}^N(-1)^j(2n+m^2)^{N-j}
                 \trace_{\mathbb K}(\Lambda^jH_U).}
Here #{N=\dim_{\mathbb K}\mathcal H} includes the fiber dimension,
and #{\cW(U)=\kappa\log\det Q_U}.}

\p{Put #{A=H_U/(2n+m^2)} and #{r=2n/(2n+m^2)<1}. For every integer #{K\ge0},
##{\cW(U)=\kappa N\log(2n+m^2)-
 \kappa\sum_{j=1}^K\frac{\trace_{\mathbb K}(A^j)}j+R_K(U),}
where the exact remainder and its uniform bound are
##{\begin{aligned}
R_K(U)&=-\kappa\int_0^1t^K
 \trace_{\mathbb K}\bigl(A^{K+1}(\bbI -tA)^{-1}\bigr)\,\extd t,\\
|R_K(U)|&\le\frac{\kappa N}{K+1}\frac{r^{K+1}}{1-r}.
\end{aligned}}
For each finite #{j}, #{\trace(H_U^j)} is the sum of fiber
holonomy traces over all based oriented closed nearest-neighbor
walks of length #{j}.}

\proof{
\p{Define the covariant shift
##{(T_j\phi)(x)=U_{x-e_j,j}\phi(x-e_j).}
A permutation of sites and the unitary fiber maps preserve the norm,
so #{T_j} is unitary. Expanding the difference energy gives
##{H_U=\sum_{j=1}^n(T_j+T_j^{\dagger}),\qquad Q_U=(2n+m^2)\bbI -H_U.}
Thus #{H_U} is self-adjoint and #{\|H_U\|\le2n}. In particular
#{Q_U\ge m^2\bbI} and its determinant is positive.}

\p{In the determinant of #{(2n+m^2)\bbI -H_U}, choose the scalar
#{2n+m^2} on the complement of a subset of #{j} coordinate indices.
The remaining signed permutation sum is the corresponding principal
#{j}-minor of #{H_U}, with factor #{(-1)^j(2n+m^2)^{N-j}}. These
minors are the diagonal coefficients of #{\Lambda^jH_U};
their sum is its trace. Summing over #{j=0,\ldots,N} proves
the finite determinant formula.}

\p{For #{0\le t\le1},
#{\bbI -tA\ge(1-r)\bbI}, so its inverse exists and has
norm at most #{(1-r)^{-1}}. Differentiating the finite determinant
by its rows gives the adjugate derivative formula. Dividing by its
positive determinant yields
##{\frac{\extd}{\extd t}\log\det(\bbI -tA)
 =-\trace((\bbI -tA)^{-1}A).}
Multiplication verifies the finite identity
##{A(\bbI -tA)^{-1}
 =\sum_{j=1}^Kt^{j-1}A^j
   +t^KA^{K+1}(\bbI -tA)^{-1}.}
Integrate its trace from #{0} to #{1}. The finite sum integrates
term by term and gives the displayed formula for #{R_K}.
Finally
##{\bigl|\trace(A^{K+1}(\bbI -tA)^{-1})\bigr|
 \le\frac{Nr^{K+1}}{1-r},}
and #{\int_0^1t^K\extd t=1/(K+1)} proves the uniform bound.}

\p{Choose an ordered orthonormal basis of the fixed fiber. In
that basis and the vertex decomposition, the block of #{H_U}
from #{s(e)} to #{h(e)} is #{U_e}; the reverse block is
#{U_e^{\dagger}}. Multiplication of #{j} blocks follows an
oriented walk, and a diagonal block closes it. The ordered
product agrees with the [transport convention](fdip-006N).
Taking fiber traces proves the walk formula. Reverse walks pair
adjoint products, so the total is real for a complex fiber.}
}

\p{The numerical bound #{2n} and scalar diagonal #{2n+m^2} use this
regular lattice and its unit edge weights. For arbitrary weights or
degrees, the diagonal decomposition and norm estimate must be
recomputed.}
