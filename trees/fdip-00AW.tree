\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Definition}
\title{Uniform cycle precision and its kept sublattice}
\date{2026-11-06}

\p{Let #{n\ge 3} be an integer. On
#{\mathbb R^{\mathbb Z/n\mathbb Z}} with its
\vocabk{counting inner products}{fdip-0002}, the
\newvocab{uniform cycle precision} with diagonal value #{a} and
neighbor value #{b} is the symmetric matrix #{Q} given by
#{Q_{ii}=a} and #{Q_{i,i\pm 1}=-b}, indices being read modulo
#{n}. When #{b\neq 0}, its \newvocab{shape} is
#{t=a/(2b)}.}

\p{Let #{q\ge 2} and #{N\ge 3} be integers, and take this precision
on #{\mathbb Z/(qN)\mathbb Z}. The kept set is the subgroup
#{q\mathbb Z/(qN)\mathbb Z}, identified with
#{\mathbb Z/N\mathbb Z} by #{qj\mapsto j}. The complementary
vertices are eliminated, and \newvocab{decimation} by the factor
#{q} is passage to the marginal law on the kept coordinates. For a
\vocabk{Gaussian probability law}{fdip-0005} this marginal is the
\vocabk{retained marginal law}{fdip-000E}, whose precision is the
\vocabk{Schur complement}{fdip-000D} of the eliminated block.}
