\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Definition}
\title{Uniform cycle precision and its kept sublattice}
\date{2026-11-06}

\p{Let #{n\ge 3} be an integer. On
#{\mathbb R^{\mathbb Z/n\mathbb Z}} with its
\vocabk{counting inner products}{fdip-0002}, let #{T} be the
cyclic shift #{(Tf)(i)=f(i-1)}, with indices read modulo #{n}.
For real coefficients #{a} and #{b}, define
##{Q=aI-b(T+T^{-1})}
The counting adjoint satisfies #{T^{\dagger}=T^{-1}}, so #{Q} is
self-adjoint. This operator is the
\newvocab{uniform cycle precision}.
When #{b\neq 0}, its \newvocab{shape} is
#{t=a/(2b)}. The \newvocab{unit-coupling cycle operator}
of that shape is
##{P_t=2t\,\bbI -(T+T^{-1}).}
Whenever #{b\neq 0}, the precision is the scalar multiple
#{Q=b\,P_t}.}

\p{Remark. In the counting basis of site indicators, the only
nonzero entries are #{Q_{ii}=a} and #{Q_{i,i\pm 1}=-b}.}

\p{Let #{q\ge 2} and #{N\ge 3} be integers, and take this precision
on #{\mathbb Z/(qN)\mathbb Z}. The kept set is the canonical
subgroup #{q\mathbb Z/(qN)\mathbb Z}, identified with
#{\mathbb Z/N\mathbb Z} by #{qj\mapsto j}. The complementary
vertices are eliminated. \newvocab{Decimation} by the factor
#{q} is the pushforward of a law along restriction of fields
to that subgroup. For a
\vocabk{Gaussian probability law}{fdip-0005} the pushed law is the
\vocabk{retained marginal law}{fdip-000E}, whose precision is the
\vocabk{Schur complement}{fdip-000D} of the eliminated compression.}
