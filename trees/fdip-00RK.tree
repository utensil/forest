\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Remark}
\title{Analytic continuation in time}
\date{2026-11-13}

\p{Real time continues to Euclidean time by #{t=\ui\tau}: on the
half-plane #{\operatorname{Im}t>0} for the ground state, and on the
strip #{0<\operatorname{Im}t<\beta} at inverse temperature #{\beta}. Mathematical physics writes
#{t=i\tau}. That factor of #{\ui} is the one in the continuation #{t=\ui\tau}.}
