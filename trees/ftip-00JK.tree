\import{macros}
\meta{agent-authored}{true}
\taxon{Remark}
\title{Architecture-neutral projection and gradual complexity}
\tag{ftip}
\p{A statement that depends only on the model/interface map is invariant
under changes to architecture #{A}, optimizer #{O}, or systems #{S} that
leave that map fixed. A conclusion about one of those fields instead requires
assumptions that distinguish its possible values.}
