\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Definition}
\title{The period-two cellular sign model}
\date{2026-11-17}

\p{The \newvocab{period-two cellular sign model} has vertices
#{v_0,v_1} and distinct oriented edges
#{e_0:v_0\to v_1}, #{e_1:v_1\to v_0}.
The gauge group is #{C_2=\{1,-1\}}, acting on the
one-dimensional fiber #{F=k}, where #{k=\mathbb R} or
#{\mathbb C}. A connection is
#{U=(u_0,u_1)\in\Omega=\{1,-1\}^2}.
The reflection #{\vartheta:t\mapsto1-t} on the circle of
period #{2} exchanges the vertices and fixes each unoriented
edge while reversing its orientation. It sends each link to
its inverse, hence fixes every #{U\in\Omega}.}

\p{All vertex and edge fields are periodic. Give the cochain
space #{V=C^0\oplus C^1} its orthonormal cell basis, with
vertices before edges. The source-based differential is
##{(\extd_U f)(e_0)=u_0f(v_1)-f(v_0),\qquad
   (\extd_U f)(e_1)=u_1f(v_0)-f(v_1).}
Set #{\extD_U=\extd_U+\extdag_U} and
#{K_U=5\bbI_V+\extD_U}. Here #{\extdag_U} is the adjoint
for the declared cell pairing. The pure-gauge weight is #{1},
and connection summation is counting over #{\Omega}. The
paired field algebra at each connection is the
\vocabk{ring paired coefficient}{fdip-00TJ} construction
#{\mathcal A(V)=\Lambda_k(V^*\oplus V)}.}
