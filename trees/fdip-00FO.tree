\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Theorem}
\title{Positive kernel of the circle covariance}
\date{2026-11-07}

\p{Fix #{m>0}. For #{0\le s\le 1} set
##{r(s)=\frac{\ue^{-ms}+\ue^{-m(1-s)}}{2m\bigl(1-\ue^{-m}\bigr)}.}
For #{0\le s\le 1/2} this is the function #{K} of
\ref{fdip-00DX}, hence the shorter-arc covariance of
\ref{fdip-00BG}. For every integer #{n\ge 1}, every
#{t_1,\ldots,t_n} with #{0\le t_j\le 1/2}, and every complex
#{c_1,\ldots,c_n},
##{\sum_{i,j=1}^{n}\overline{c_i}c_j\,r(t_i+t_j)\ge 0.}}

\proof{
\p{The prefactor
#{C=1/\bigl(2m(1-\ue^{-m})\bigr)} is positive. For
#{s=t_i+t_j}, which satisfies #{0\le s\le 1},
##{r(s)=C \ue^{-m(t_i+t_j)}+C \ue^{-m}\ue^{m(t_i+t_j)}.}
Summing against #{\overline{c_i}c_j} separates the two terms:
##{\sum_{i,j}\overline{c_i}c_j \ue^{-m(t_i+t_j)}=\Bigl\lvert\sum_{j=1}^{n}c_j \ue^{-m t_j}\Bigr\rvert^2,}
and the second exponential produces
#{\bigl\lvert\sum_j c_j \ue^{m t_j}\bigr\rvert^2}. Therefore the
full sum equals
##{C\Bigl\lvert\sum_j c_j \ue^{-m t_j}\Bigr\rvert^2+C \ue^{-m}\Bigl\lvert\sum_j c_j \ue^{m t_j}\Bigr\rvert^2,}
which is nonnegative. This is condition (iii) of
\citet{Proposition 2.1}{klein1981periodic}.}
}
