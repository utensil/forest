\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Proposition}
\title{Gauge translates of a joint observable}
\date{2026-11-19}

\p{Take the \vocabk{orbit gauge–Higgs weight}{fdip-010A} over a
commutative unital ring #{k}. Let #{f} be a function from joint
configurations to a #{k}-module. For #{g\in G^X} let #{R_g f}
evaluate #{f} after the inverse vertex gauge #{g^{-1}}. Its
\vocabk{weighted value}{fdip-00WK} satisfies
##{\mathcal A_\Xi(R_g f)=\mathcal A_\Xi(f).}
If #{|G|} is a unit in #{k}, the projection #{P_{G^X}} onto
gauge-invariant functions also satisfies
##{\mathcal A_\Xi(P_{G^X}f)=\mathcal A_\Xi(f).}
When the partition #{Z} is a unit, each applicable identity holds
for the \vocabk{normalized functional}{fdip-010E}.}

\proof{
\p{The joint-weight invariance in \ref{fdip-010C} makes the inverse
gauge a weight-preserving permutation. Reindex the sum by this
permutation. For the second identity, #{|G^X|=|G|^{|X|}} is a unit,
so \ref{fdip-00WP} applies to the function module with action
#{g\mapsto R_g}. Every translate in the projection has the same
weighted value. Their sum divided by #{|G^X|} has this value too.
Dividing either identity by #{Z} gives its normalized version.}
}
