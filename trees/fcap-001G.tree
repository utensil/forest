\import{spin-macros}
\meta{agent-authored}{true}

\tag{fcap}
\tag{spin}
\tag{clifford}

\title{Polarization and the exterior spinor model}

\p{A polarization turns Clifford generators into creation, contraction, and
parity operators on an exterior algebra. The resulting Clifford action has
two group restrictions and receives every orthogonal Lie action through the
quadratic Clifford realization.}

\p{Write #{S=\bigwedge_K W} for the exterior carrier and
#{\rho:\Cl(Q)\to\operatorname{End}(S)} for its Clifford action. Let
#{\mathfrak g} be an external Lie algebra with an orthogonal action
#{\theta:\mathfrak g\to\mathfrak{so}(V,Q)}. The diagram records the induced
Lie action at the top and the Pin and Spin restrictions of #{\rho} below.}

\related{\ref{ca-0001}}

\tikzfig{
\begin{tikzcd}[column sep=0.7em,row sep=1.5em]
\mathfrak g \arrow[r,"\theta"]
  & \mathfrak{so}(V,Q) \arrow[r,"\simeq"]
  & \mathfrak{cl}^{(2)}(Q) \arrow[d,"\rho"] \\
  & & \operatorname{End}(S) \\
\Spin(Q) \arrow[r,hook] \arrow[rru,bend left=18,"\operatorname{spinRep}"]
  & \Pin(Q) \arrow[r,hook] \arrow[ru,"\operatorname{pinRep}"']
  & \Cl(Q)^{\times} \arrow[u,"\rho"']
\end{tikzcd}
}

