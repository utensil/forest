\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Corollary}
\title{The first dimension admitting a nonreal word trace}
\date{2026-11-26}

\p{Among \vocabk{ordered Gram pairs}{fdip-018P} on a supplied
complex Hermitian space #{E}, a pair with a nonreal word trace
exists if and only if #{\dim E\ge3}. Precisely in those dimensions there is
a pair without any commuting antiunitary.}

\proof{
\p{In dimensions at most two all word traces are real by
\ref{fdip-0191}. In dimension three \ref{fdip-0194} gives the
two maps explicitly. For greater dimension choose an
orthogonal three-dimensional summand and extend both maps
by zero on its complement. The two products and every
nonempty word then restrict to the old values on the summand
and vanish on its complement. The displayed nonreal trace
therefore persists. The equivalence with the symmetry
condition follows from \ref{fdip-018Y}. Pairs such as
#{A=B=\bbI_E} have a real form in every dimension.}
}
