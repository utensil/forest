\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Remark}
\title{Division by the length leaves the quotient}
\date{2026-11-07}

\p{Dividing #{Z_N} and #{W_N} by #{N} leaves the quotient
#{2W_N/Z_N} unchanged. For #{t\ge 1} the main terms are
#{G(t)} and #{G(t)/2} from \ref{fdip-00G3}. The passage from
those integrals to the [spectral dimension](fdip-00CO) is
the quotient of #{W_N} by #{Z_N}.}
