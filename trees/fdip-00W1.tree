\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Example}
\title{A two-link sign pattern changes the operator}
\date{2026-11-17}

\p{Take #{n=1}, #{N=2}, and Hurwitz coefficients over
#{\mathbb Q} or an odd prime field. Set
#{U_1(0)=-1}, #{U_1(1)=1}. The nontrivial
[link translation](fdip-00W0) exchanges these signs.
For the degree-zero cochain #{f(0)=0}, #{f(1)=1},
the forward formula gives
##{(\extd_U f)(0)=-e_1\otimes1,\qquad
       (\extd_{\tau_1 U}f)(0)=e_1\otimes1.}
Their difference is nonzero. The translated
background therefore has a different cochain
operator.}
