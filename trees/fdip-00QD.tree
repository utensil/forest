\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Lemma}
\title{A module map induces an exterior map}
\date{2026-11-12}

\p{Let #{f:V\to W} be a map of modules over a commutative ring.
There is a unique unital algebra map
#{\bigwedge f:\bigwedge V\to\bigwedge W} with
#{\bigwedge f(v)=f(v)} on vectors, and
##{(\bigwedge f)(a\wedge b)
 =(\bigwedge f)(a)\wedge(\bigwedge f)(b).}}

\proof{
\p{The tensor algebra is free on the module. The two-sided ideal
generated by pure squares #{v\otimes v} is preserved by
#{T(f)}, because #{T(f)(v\otimes v)=f(v)\otimes f(v)}. The
induced map of quotients is #{\bigwedge f}, and it preserves
products by construction.}
}
