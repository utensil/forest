\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Theorem}
\title{The product rule records the order of paths}
\date{2026-11-17}

\p{For homogeneous #{\alpha\in C^p(X;F)} and
#{\beta\in C^s(X;F')}, use the
\vocabk{transported product}{fdip-00SJ} and write
##{\mathcal L(\alpha,\beta)=
\extd_{F\otimes F'}(\alpha\smile_U\beta)
-(\extd_F\alpha)\smile_U\beta
-(-1)^p\alpha\smile_U(\extd_{F'}\beta).}
For each triple #{(l,I,J)} with #{|I|=p}, #{|J|=s} and
#{\{l\},I,J} pairwise disjoint, put #{K=I\cup\{l\}} and
##{\begin{aligned}
R_{l,I,J}={}&(T_l^F\alpha_I)\otimes
  (T_l^{F'}T_I^{F'}-T_K^{F'})\beta_J\\
&+\alpha_I\otimes
  (T_K^{F'}-T_I^{F'}T_l^{F'})\beta_J.
\end{aligned}}
Then the full defect is the sum
##{\mathcal L(\alpha,\beta)=
\sum_{(l,I,J)}(e_l\wedge e_I\wedge e_J)\otimes R_{l,I,J}.}
Thus commuting coefficient pullbacks imply the graded product
rule. When #{p=0}, the product rule holds without commutativity.}

\proof{
\p{Fix one triple and express all exterior factors in the order
#{e_l\wedge e_I\wedge e_J}. The three terms in the defect give,
respectively,
##{\begin{aligned}
&(T_l^F\alpha_I)\otimes T_l^{F'}T_I^{F'}\beta_J
   -\alpha_I\otimes T_I^{F'}\beta_J,\\
&-(T_l^F\alpha_I-\alpha_I)\otimes T_K^{F'}\beta_J,\\
&-\alpha_I\otimes T_I^{F'}(T_l^{F'}-\bbI)\beta_J.
\end{aligned}}
The last sign follows by moving #{e_l} past the #{p} factors
of #{e_I}. The first equality uses the tensor-product action
on coefficients. Cancellation leaves #{R_{l,I,J}}. Summing
over the triples gives the formula; several triples can
contribute to the same exterior monomial. If all relevant
pullbacks commute, both differences in #{R} vanish. For
#{I=\varnothing}, both are zero without this hypothesis.}
}

\p{In particular, for a scalar vertex function #{f} and a
coefficient vertex function #{\psi}, the degree-one identity is
##{\begin{aligned}
T_i^U(f\psi)-f\psi
={}&(f(x+\varepsilon_i)-f(x))T_i^U\psi\\
&+f(x)(T_i^U\psi-\psi).
\end{aligned}}
Curvature therefore does not add a term to this degree-zero
module rule. The higher-degree defect compares different paths.}
