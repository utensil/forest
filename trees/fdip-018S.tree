\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Proposition}
\title{Two multiplicity factors in an onsite family}
\date{2026-11-26}

\p{Let a \vocabk{Yukawa map}{fdip-011M}
#{Y_0:F\to\operatorname{End}(F_\psi)} be given on finite-dimensional
complex representations of a finite group #{G}, with
#{Y_0(gv)=\rho_\psi(g)Y_0(v)\rho_\psi(g)^{-1}}. Give the
finite-dimensional complex Hermitian space #{E} the trivial
#{G}-action. For any endomorphisms #{Y_1,Y_2} of #{E}, each
map #{v\mapsto Y_0(v)\otimes Y_j} is an equivariant linear
family on #{F_\psi\otimes E}. With the diagonal action on
#{F\oplus F}, the two terms also give one equivariant family
##{(v_1,v_2)\longmapsto
 Y_0(v_1)\otimes Y_1+Y_0(v_2)\otimes Y_2.}
The separately labeled multiplicity products are
#{A=Y_1Y_1^\dagger} and #{B=Y_2Y_2^\dagger}.}

\proof{
\p{The action on the enlarged fiber is
#{\rho_\psi(g)\otimes\bbI_E}. Conjugation by it sends each
#{Y_0(v)\otimes Y_j} to #{Y_0(gv)\otimes Y_j}. Linearity
gives the stated identity on the direct sum of scalar modules.
Each based cell retains the identity on its exterior directions
in the onsite construction.}
}
