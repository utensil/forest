\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Proposition}
\title{Real forms in dimensions at most two}
\date{2026-11-26}

\p{Every ordered pair of Hermitian endomorphisms #{A,B} on a
complex Hermitian space of dimension at most two admits a
commuting antiunitary of square #{\bbI}. All of its word
traces are real.}

\proof{
\p{In dimension zero the assertion is empty. In dimension
one both scalars are real. In dimension two choose an
orthonormal eigenbasis for #{A}. If its eigenvalues agree,
any orthonormal basis serves. The diagonal entries of #{B}
are real by self-adjointness. Write #{b} for its upper
off-diagonal entry. When #{b\ne0}, multiplying the second
basis vector by #{\bar b/|b|} changes this entry to #{|b|}.
The lower entry is its conjugate and changes to the same real
number. If #{b=0} keep the basis. This phase choice preserves
the diagonal form of #{A}. Apply \ref{fdip-0190}. Every word
now has a real matrix and hence real trace.}
}
