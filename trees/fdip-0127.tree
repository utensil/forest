\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Example}
\title{Free orbits of the binary polyhedral groups}
\date{2026-11-21}

\p{Let #{2T} be the group of #{24} Hurwitz units in
\ref{fdip-0053}, with the special-unitary matrix #{M} of
\ref{fdip-00M6}. Let #{e_1=(1,0)} in #{\mathbb C^2}. If
#{M(u)e_1=e_1}, the first column of \ref{fdip-00M6} gives
#{(a+b\ui,-c+d\ui)=(1,0)}. Thus #{c=d=0} and #{a+b\ui=1}. The
Hurwitz units are the #{8} units #{\pm1,\pm\qi,\pm\qj,\pm\qk} and
the #{16} units with all #{4} coordinates in #{\{\pm1/2\}}, by
\ref{fgap-000K}. The second family has nonzero third or fourth
coordinate. The first family with vanishing third and fourth
coordinates is #{\{\pm1,\pm\qi\}}. Only #{u=1} has
#{a+b\ui=1}. The stabilizer of #{e_1} is trivial, so the #{24}
group elements send #{e_1} to distinct vectors.}

\p{The same matrix realizes #{2I} as a subgroup of #{SU(2)} of
order #{120}, by \ref{fdip-007G}. Let #{U\in SU(2)} fix a nonzero
vector #{v=(v_1,v_2)}. Use the Hermitian product linear in its
first argument,
#{\langle x,y\rangle=x_1\overline{y_1}+x_2\overline{y_2}}. The
vector #{w=(-\overline{v_2},\overline{v_1})} satisfies
#{\langle v,w\rangle=0} and #{|w|=|v|}. The ordered columns
#{v/|v|} and #{w/|v|} form an orthonormal basis, and the matrix
with those columns has determinant #{1}. In this basis the first
column of #{U} is #{(1,0)}. Orthonormality of the columns puts
the second column at #{(0,b)} with #{|b|=1}. The determinant in
this oriented basis is #{b}, so #{b=1} and #{U} is the identity.
Every nonzero vector has trivial stabilizer under #{2T} and under
#{2I}. The #{120} elements of #{2I} therefore send #{e_1=(1,0)}
to distinct vectors.}
