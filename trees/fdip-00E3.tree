\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Remark}
\title{Finite traces of cycles and gasket graphs}
\date{2026-11-06}

\p{A path of #{q} unit edges has conductance #{1/q}
(\ref{fdip-00DL}). On the unit cycle, the conductance
between vertices separated by #{\ell} edges is
#{N/(\ell(N-\ell))}, the reciprocal of the resistance in
\ref{fdip-00DB} (\ref{fdip-00DM}).}

\p{One cell of a gasket graph, traced to its three corners,
keeps the factor #{3/5}. For edge weight #{w} the eliminated
block has determinant #{50 w^3} (\ref{fdip-00DS}). Give
level #{n} the edge weight #{\bigl(\frac{5}{3}\bigr)^n}.
The kept form of a later level, restricted to the vertices
of an earlier level, equals the energy of that earlier
level (\ref{fdip-00DT}). These identities are the finite
traces.}
