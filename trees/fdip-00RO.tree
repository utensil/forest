\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Remark}
\title{The paired generator}
\date{2026-11-13}

\p{The paired generator #{\bar\psi} is an independent Grassmann
generator, the image of #{\psi} under the declared antilinear
reflection. Its bar is the involution of \ref{fdip-00QP}.
Mathematical physics writes the Dirac adjoint
#{\bar\psi=\psi^{\dagger}\gamma^0}. Geometric calculus forms
that adjoint by reversion. This generator involves no
#{\gamma^0} and no matrix.}
