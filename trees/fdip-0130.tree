\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Example}
\title{Pairing values are constant on double cosets}
\date{2026-11-21}

\p{On the group of \ref{fdip-0126}, each value taken by the
normalized pairing of \ref{fdip-012O} is constant on double
cosets.}

\proof{
\p{\ref{fdip-012F} shows that the pairing kernel is constant on
double cosets. \ref{fdip-012O} lists the values of the
normalized pairing on this group, and the kernel adds #{2} to
each of them.}
}
