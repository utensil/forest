\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Example}
\title{Pairing values are constant on double cosets}
\date{2026-11-21}

\p{On the group of \ref{fdip-0126}, the pairing kernel of
\ref{fdip-012F} is constant on double cosets.}

\proof{
\p{\ref{fdip-012F} shows that this kernel is constant on
double cosets, and that its maximizing set is the identity
double coset.}
}
