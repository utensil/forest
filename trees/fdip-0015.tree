\node[ext=6.4cm] (R) at (6,7.85) {Purpose};
\node[box=6.4cm] (a) at (6,6.2) {Finite fields and operator products};
\node[box=6.4cm] (b) at (6,4.85) {Reference pairings, adjoints and parity};
