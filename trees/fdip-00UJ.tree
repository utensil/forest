\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\title{Algebraic duals and chosen self-duality}
\date{2026-11-17}

\p{The [ring paired coefficient](fdip-00TJ) already places a
module beside its dual. Changing which module is regarded as
the matter fiber exchanges those two slots. The induced action
on transports and the sign of that exchange determine what
the fixed-background coefficient preserves.}

\transclude{fdip-00UK}
