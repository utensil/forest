\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Proposition}
\title{Background weights and their denominators}
\date{2026-11-19}

\p{For the finite joint configurations and
\vocabk{ring paired coefficient}{fdip-00TJ} of \ref{fdip-011P}, set
#{\Xi_Y(U,\phi)=\Xi(U,\phi)\det K_{U,\phi}} and
#{Z_Y=\sum_{U,\phi} \Xi_Y(U,\phi)}. For families of exterior
insertions #{P_{U,\phi}} put
##{\Phi_Y(P)=\sum_{U,\phi}\Xi(U,\phi)\,
 \mathcal I_{\mathcal V}
 \big(P_{U,\phi}\extexp(\theta_{K_{U,\phi}})\big).}
This functional is gauge invariant under the simultaneous action
on backgrounds and insertions. It takes the unit insertion to
#{Z_Y}. A unit #{Z_Y} defines the normalized functional
#{Z_Y^{-1}\Phi_Y} and normalized background weights
#{\Xi_Y(U,\phi)/Z_Y}. At one fixed background the odd coefficient
instead normalizes by #{\det K_{U,\phi}} whenever that element
is a unit.}

\proof{
\p{The exterior map induced by a vertex gauge on insertions is
#{(\mathcal G_g^{-1})^*\oplus\mathcal G_g} on the generators,
as for the \vocabk{coupled finite coefficient functional}{fdip-00TU}.
It preserves the coefficient and sends the
quadratic element to the corresponding element on the transformed
background by \ref{fdip-00TW}. Reindexing the joint finite sum
by this bijection gives invariance. At insertion one the
fixed-background coefficient is #{\det K_{U,\phi}} by
\ref{fdip-011P}, giving each normalization at its stated unit.}

\p{Conditioning the background weight on fixed links divides by
#{\sum_\phi \Xi_Y(U,\phi)} when that marginal is a unit. At fixed
scalars the denominator is #{\sum_U \Xi_Y(U,\phi)}, with its own
unit condition, as for the \vocabk{scalar marginal weight}{fdip-010E}.
Each quotient sends the
constant one to one by summation. Over the reals, nonnegative
background weights and #{Z_Y>0} yield a probability law on
joint backgrounds. A global unit alone does not imply these
inequalities or invertibility of a particular kernel.}
}
