\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Theorem}
\title{Scaled gasket graphs agree on earlier vertices}
\date{2026-11-06}

\p{For each integer #{n\ge 0}, let #{H_n} be the
\vocabk{gasket graph}{fdip-00DP} #{G_n} with every edge weight
equal to #{\bigl(\frac{5}{3}\bigr)^n}. For integers
#{m\ge n\ge 0}, the \vocabk{kept form}{fdip-00DF} of #{H_m}
on #{V_n} equals the energy of #{H_n}.}

\proof{
\p{Proceed by induction on #{m-n}. If #{m=n}, no vertex is
eliminated, so the kept form is the energy of #{H_n}. If
#{m=n+1}, apply \ref{fdip-00DS} with
#{w=\bigl(\frac{5}{3}\bigr)^{n+1}}. The kept form equals
#{\frac{3}{5}} times the energy of #{G_n} at this weight, and
##{\frac{3}{5}\Bigl(\frac{5}{3}\Bigr)^{n+1}
=\Bigl(\frac{5}{3}\Bigr)^n.}
That is the edge weight of #{H_n}.}

\p{Suppose #{m\ge n+2} and the claim is known for every smaller
positive difference of levels. The difference #{m-(n+1)} is
smaller than #{m-n}, so the kept form of #{H_m} on #{V_{n+1}}
equals the energy of #{H_{n+1}}. \ref{fdip-00DI} equates the
kept form of #{H_m} on #{V_n} with the minimum of that
quadratic form over extensions from #{V_n} to #{V_{n+1}}.
The difference of levels for #{H_{n+1}} and #{V_n} is #{1},
so the minimum equals the energy of #{H_n}.}
}
