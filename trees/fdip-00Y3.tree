\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Lemma}
\title{The obstruction to an odd exterior substitution}
\date{2026-11-17}

\p{Let #{k} be a nonzero field of characteristic different
from #{2}, and let #{E} be a finite-dimensional #{k}-space.
Every odd element of #{\Lambda_k(E)} squares to zero.
Consequently, if an algebra contains an element #{c} with
#{c^2=1}, no unital algebra homomorphism from it to
#{\Lambda_k(E)} can send #{c} to an odd element.
Reversal on an exterior monomial of degree #{p} multiplies
it by #{(-1)^{p(p-1)/2}}; in particular reversal need not
act trivially on the even subalgebra.}

\proof{
\p{Two odd exterior monomials anticommute: disjoint
monomials acquire the sign #{-1}, and a repeated generator
makes both products zero. Expanding in monomials gives
#{ab=-ba} for odd #{a,b}. For #{a=b}, invertibility of
#{2} implies #{a^2=0}. A unital homomorphism would then
send #{c^2=1} to both #{0} and #{1}, which is impossible.}

\p{Reversing a length-#{p} word uses #{p(p-1)/2}
transpositions. Each transposition of distinct exterior
generators contributes a minus sign. For two independent
generators #{u,v}, their nonzero product #{uv} is even,
but reversal gives #{vu=-uv}.}
}
