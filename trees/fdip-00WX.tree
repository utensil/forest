\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Proposition}
\title{The integral Hurwitz two-field singlet}
\date{2026-11-17}

\p{Let #{F=\mathcal O\otimes_{\mathbb Z}k} be the
Hurwitz fiber, with the ordered basis of \ref{fdip-00V1}.
The following degree-two element is a gauge-invariant
insertion at any vertex #{x}:
##{P_x=-\psi_{x,1}\psi_{x,2}
       -\psi_{x,1}\psi_{x,3}
       -\psi_{x,1}\psi_{x,4}
       +\psi_{x,3}\psi_{x,4}.}
It is nonzero for every nonzero commutative ring #{k},
including in characteristics two and three.}

\proof{
\p{The integral alternating matrix in \ref{fdip-00V3}
corresponds to
##{\beta=-e^1\wedge e^2-e^1\wedge e^3
          -e^1\wedge e^4+e^3\wedge e^4.}
The identification of alternating bilinear forms with
#{\bigwedge^2 F^*} for a finite free module sends the
coefficient of #{e^i\wedge e^j}, #{i<j}, to the
#{(i,j)} matrix entry. This identification is
equivariant: evaluate on two transformed vectors.
Thus invariance of the form in \ref{fdip-00V4} makes
#{\beta} invariant. The result in \ref{fdip-00WW}
proves the gauge assertion and its compatibility with
every scalar extension. The coefficient of
#{\psi_{x,1}\psi_{x,2}} is the unit #{-1}; exterior
basis independence proves nonvanishing when #{k\ne0}.}
}
