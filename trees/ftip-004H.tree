\tag{ftip}
\tag{dapo}
\tag{clipping}

\refcardt{Definition}{DAPO clip-higher}{Section 3.1}{yu2025dapo}{
\p{Clip-higher replaces the symmetric upper and lower PPO clipping widths by
separate constants. It permits a larger upward likelihood-ratio movement for
tokens with positive advantage while retaining a smaller lower-side interval.}

\p{The change alters which sampled terms are saturated by the surrogate. It
does not impose a policy-wide trust region or guarantee preservation of
low-probability actions.}
}
