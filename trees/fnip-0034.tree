\import{fnip-macros}
\meta{agent-authored}{true}
\tag{fnip}
\taxon{Definition}
\title{Jacobian}
\date{2026-11-26}

\p{Let #{U\subseteq\mathbb{R}^{n}} be open and let
#{f:U\to\mathbb{R}^{n}} be continuously differentiable. Let
#{x_{*}\in U} be an \vocabk{equilibrium}{fnip-0014}, so that
#{f(x_{*})=0}. The \newvocab{Jacobian} of #{f} at #{x_{*}} is the
matrix #{Df(x_{*})} of first partial derivatives. The linearization
at #{x_{*}} is
##{\dot y=Df(x_{*})y.}
The equilibrium is \newvocab{hyperbolic} when no eigenvalue of
#{Df(x_{*})} has real part #{0}.}

\p{\citet{(1.3.2), §1.3, p. 12}{guckenheimer1983nonlinear}
writes this linearization as #{\dot\xi=Df(x)\xi} at a fixed point
#{x}, and calls #{Df} the Jacobian matrix of first partial
derivatives. The equation is a linear system of the form
\citet{(1.1.1), §1.1, p. 8}{guckenheimer1983nonlinear}.
\citet{Definition 2.7, §2.2.1, p. 46}{kuznetsov2004elements}
calls the equilibrium hyperbolic when no eigenvalue lies on the
imaginary axis.}
