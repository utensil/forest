\import{macros}
\meta{agent-authored}{true}

\tag{ftip}
\tag{preference}
\tag{probability}

\card{Definition}{Preference data law}{
\p{A \newvocab{preference data law} #{\mathcal D_{\mathrm{pref}}} is a
probability law on pairwise comparison observations
#{o=(x,y^+,y^-,j)} from \ref{ftip-002L}. It includes the randomness of prompt
selection, response generation, pair selection, judge selection, and the
judge's reported label.}

\p{A finite training multiset
#{D_{\mathrm{pref}}=(o_1,\ldots,o_N)} is sampled or adaptively collected under
that law and its acquisition history. When queries are adaptive, the records
need not be independent or identically distributed.}
}
