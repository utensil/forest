\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Proposition}
\title{Two pairings give the same cochain operator}
\date{2026-11-17}

\p{For the \vocabk{one-vertex Hurwitz model}{fdip-00ZA},
the positive norm pairing and the rational extension of
the \vocabk{integral alternating Hurwitz form}{fdip-00V2}
give the same maps #{\extdag_{U,V}}, #{\extD_{U,V}} and
#{K_{U,V}(m)}. In particular the determinant-square
identity of \ref{fdip-00V6} applies to this kernel.}

\proof{
\p{For every quaternion #{z}, conjugation gives
##{\langle zx,y\rangle_0
=\operatorname{Re}(\bar x\bar z y)
=\langle x,\bar z y\rangle_0.}
Thus #{L_z^\dagger=L_{\bar z}} for the norm pairing.
Each unit #{u\in G} has #{\bar u=u^{-1}}, by
\ref{fdip-00V1}. The alternating pairing has the same
inverse-unit adjoints by \ref{fdip-00V4}. Consequently
#{(L_{u^{-1}}-\bbI)^\dagger=L_u-\bbI} for both
pairings.}

\p{Signed insertion and deletion on the ordered cell
monomials are adjoint for either direct-sum pairing,
as proved in \ref{fdip-00SS}. The cell operations commute
with coefficient multiplication. Taking the adjoint of
each summand of #{\extd_{U,V}} therefore gives exactly
the displayed #{\extdag_{U,V}} in either case. Addition
and then addition of #{m\bbI} give the asserted equality
of operators. The alternating pairing is perfect by
\ref{fdip-00V4}, so the hypotheses of \ref{fdip-00V6}
apply to these same maps.}
}

\p{The norm pairing is orthonormal in the rational basis
#{(1,\qi,\qj,\qk)}. Its Gram matrix in the ordered
Hurwitz basis is instead the matrix of \ref{fdip-00V3}.
An adjoint below always refers to the declared norm
pairing, independently of those coordinates.}
