\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Lemma}
\title{Counting adjoints on an indexed cycle}
\date{2026-10-20}

\p{Let #{R} be a commutative unital ring. Take the
\vocabk{cyclic shift}{fdip-0009} on
#{\mathcal F_R(\mathbb Z/n\mathbb Z)}, #{n\ge1}, with its
\vocabk{perfect counting duality}{fdip-001F} #{b}.
For the \vocabk{counting adjoint}{fdip-0007}, write #{A^*=A^\dagger}.
Then
##{T^*=T^{-1},\qquad (\varepsilon\cdot\cov)^*=T^{-1}-I.}
The backward difference is #{(-\varepsilon\cdot\cov)=T^{-1}-I}, so
##{(\varepsilon\cdot\cov)^*(\varepsilon\cdot\cov)=(-\varepsilon\cdot\cov)(\varepsilon\cdot\cov)=2I-T-T^{-1}.}
Here #{2=1+1}; its invertibility is not required. For the real difference
and kinetic signs, see
\citet{Section 4, Equations (4.3) and (4.5), p. 3}{wingate2025lattice},
with lattice spacing one. The finite periodic ring identities follow
by reindexing, independently of the product rule.}

\proof{
\p{The substitution #{j=i+1} permutes the finite index set, so
##{\begin{aligned}
b(Tf,g)&=\sum_i f(i+1)g(i)\\
 &=\sum_j f(j)g(j-1)=b(f,T^{-1}g).
\end{aligned}}
Uniqueness of the counting adjoint gives #{T^*=T^{-1}}.
Subtracting #{b(f,g)} gives
#{b(\varepsilon\cdot\cov f,g)=b(f,(T^{-1}-I)g)}, so
#{(\varepsilon\cdot\cov)^*=T^{-1}-I}. Multiplication gives
##{(T^{-1}-I)(T-I)=2I-T-T^{-1}=(-\varepsilon\cdot\cov)(\varepsilon\cdot\cov).}
Consequently #{b(f,(\varepsilon\cdot\cov)^*(\varepsilon\cdot\cov)f)=b(\varepsilon\cdot\cov f,\varepsilon\cdot\cov f)}.
Over #{\mathbb R} this counting form is the
\vocabk{counting inner product}{fdip-0002}, and the last expression is
#{\sum_i(\varepsilon\cdot\cov f(i))^2\ge0}.}
}

\p{For the indexed cycle #{e_i:i\to i+1}, the edge-label isomorphism
#{j(a)(i)=a(e_i)} of the
[cyclic shift and edge-label identification](fdip-0009)
preserves counting pairings:
#{b_V(ja,jc)=\sum_i a(e_i)c(e_i)=b_E(a,c)}.
Taking #{c=j^{-1}f} shows that #{j^*=j^{-1}}, hence #{j^*j=I}.
Thus #{\varepsilon\cdot\cov=j\extd_{R}} and
##{(\varepsilon\cdot\cov)^*(\varepsilon\cdot\cov)=\extd_{R}^\dagger j^*j\extd_{R}=\extd_{R}^\dagger\extd_{R},}
which is the negative of the unit-weight \vocabk{graph Laplacian}{fdip-0007}.
At #{n=2}, the two oppositely oriented edges give
#{b(f,\extd_{R}^\dagger \extd_{R}f)=2(f(1)-f(0))^2}; they are not one simple
edge. At #{n=1}, there is one loop, #{T=I}, and both incidence and
kinetic maps vanish. An arbitrary incidence map still has distinct
vertex and edge carriers; this factorization does not assert that
#{\varepsilon\cdot\cov} is skew-adjoint or square-zero.}
