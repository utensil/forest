\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Definition}
\title{Finite-range circle precisions}
\date{2026-11-06}

\p{Fix an integer #{R\ge 1} and real coefficients #{c_r=c_{-r}}
for #{1\le |r|\le R}. Their symbol and second-order
coefficient are
##{\alpha(\theta)=\sum_{1\le |r|\le R}c_r\bigl(1-\cos(r\theta)\bigr),
\qquad
\kappa=\sum_{r=1}^{R}c_r r^2.}
The standing assumptions are #{\kappa>0} and
#{\alpha(\theta)>0} whenever #{\theta} is not an integer
multiple of #{2\pi}.}

\p{Fix #{\mu>0}. For an integer #{N>2R}, the sites are the
residues modulo #{N}. The \newvocab{finite-range circle precision}
at that size is
##{Q_N=\mu \bbI+N^2 A_N,}
where
##{(A_Nx)(j)=\sum_{1\le |r|\le R}c_r\bigl(x(j)-x(j+r)\bigr)}
and the indices are read modulo #{N}. The hypothesis
#{N>2R} makes the offsets #{\pm 1,\ldots,\pm R} distinct.}
