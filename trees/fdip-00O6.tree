\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Example}
\title{Two bilinear forms on the integral hyperbolic plane}
\date{2026-11-12}

\p{Let #{V=\mathbb Z e_1\oplus\mathbb Z e_2} and let
#{q(xe_1+ye_2)=xy}. Then #{q(e_1)=q(e_2)=0} and
#{q(e_1+e_2)=1}, so the polar form of \ref{fdip-000P} has
#{B_q(e_1,e_2)=1}. There is no symmetric bilinear form
#{b:V\times V\to\mathbb Z} with #{2b=B_q}, because that would
require #{2b(e_1,e_2)=1} in #{\mathbb Z}.}

\p{The two bilinear forms determined on the basis by
##{B_+(e_1,e_2)=1,\quad B_+(e_2,e_1)=0}
and
##{B_-(e_1,e_2)=0,\quad B_-(e_2,e_1)=1,}
with both diagonal values zero, satisfy #{B(v,v)=q(v)}. In the
Clifford algebra the relation #{(e_1+e_2)^2=1} becomes
#{e_1 e_2+e_2 e_1=1}, while #{e_1^2=e_2^2=0}. The ordered set
#{1,e_1,e_2,e_1 e_2} is a #{\mathbb Z}-basis: the relations reduce
every word to a combination of that ordered set, and the representation
##{e_1\mapsto\begin{pmatrix}0&1\\0&0\end{pmatrix},\qquad
e_2\mapsto\begin{pmatrix}0&0\\1&0\end{pmatrix}}
sends #{a+be_1+ce_2+d\,e_1 e_2} to the matrix
##{\begin{pmatrix}a+d&b\\c&a\end{pmatrix},}
which vanishes only when every coefficient is zero. For either
choice of #{B}, define the linear map #{\Phi} on the exterior basis
by #{\Phi(1)=1}, #{\Phi(e_1)=e_1}, #{\Phi(e_2)=e_2}, and
##{\Phi(e_1\wedge e_2)=e_1 e_2-B(e_1,e_2)\,1.}
Then #{e_1 e_2=B(e_1,e_2)\,1+\Phi(e_1\wedge e_2)}. For #{B_+} the
scalar coefficient of #{e_1 e_2} is #{1}. For #{B_-} it is #{0}.
For #{v=xe_1+ye_2},
#{B_+(v,v)=xy\,B_+(e_1,e_2)=xy=q(v)}, and likewise for #{B_-}.}
