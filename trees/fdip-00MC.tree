\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Remark}
\title{The interleaved paired-word chart}
\date{2026-11-10}

\p{For #{n} complex pairs, take #{2n} independent generators
#{\psi_1,\bar\psi_1,\ldots,\psi_n,\bar\psi_n} and the linear
functional
##{\int\extd\bar\psi\,\extd\psi\;(f)=\text{coefficient of }
  \psi_1\bar\psi_1\cdots\psi_n\bar\psi_n
  \text{ in }f.}
The bars label independent generators, not complex conjugates.
The basis comparison in \ref{fdip-00IV} shows that the
coevaluation top element is this interleaved word, so #{\int\extd\bar\psi\,\extd\psi}
agrees with the [intrinsic paired coefficient](fdip-00IS).}
