\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Proposition}
\title{When a character forces a value to vanish}
\date{2026-11-17}

\p{Suppose #{H} acts on a #{k}-module #{E} through a
character #{\chi:H\to k^\times}. An invariant vector
#{v\in E^H} satisfies
##{(1-\chi(h))v=0\qquad(h\in H).}
If multiplication by #{1-\chi(h)} is injective on #{E}
for some #{h}, then #{v=0}. In particular this applies
to the invariant weighted values in \ref{fdip-00WM}.}

\proof{
\p{The defining equality
#{\chi(h)v=v} gives the displayed annihilation.
Injectivity then implies #{v=0}.
For #{E=k}, the injectivity condition says precisely that
#{1-\chi(h)} is a non-zero-divisor on #{k}.}
}

\p{Nontriviality of the character alone is insufficient
over a ring. For example, over #{k=\mathbb Z/4\mathbb Z}
the nontrivial sign character of #{C_2} fixes the nonzero
vector #{2}: #{(-1)2=2}. Here #{1-(-1)=2} is a zero
divisor.}
