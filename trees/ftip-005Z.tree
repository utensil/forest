\import{macros}
\meta{agent-authored}{true}

\taxon{Definition}
\title{Verifier error rates}
\tag{ftip}
\tag{verifier}

\p{Let #{S\in\{0,1\}} be an independently defined success label and
#{A\in\{0,1\}} the verifier's accept decision on the same outcome. The
\strong{false-accept} and \strong{false-reject} rates are}

##{
 \eta_+=\Pr(A=1\mid S=0),
 \qquad
 \eta_-=\Pr(A=0\mid S=1).
}

\p{Both rates are conditional on the task and outcome distribution used for
the audit. They are undefined when the conditioning event has probability
zero.}
