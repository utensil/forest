\import{macros}
\meta{agent-authored}{true}
\tag{frap}

\refcardt{Lemma}{A flag determines an automorphism}{Section 2, p. 4}{schulte2017regular}{
  \p{An \vocabk{automorphism}{frap-000G} of an \vocabk{abstract polytope}{frap-000D}
  fixing every face of one \vocabk{flag}{frap-000D} is the identity. Consequently the
  automorphism group of a regular polytope acts freely and transitively
  on its flags.}
  \p{The cited paragraph preceding Lemma 2.1 states simple transitivity
  for regular polytopes. The elementary argument below also proves
  freeness without assuming regularity.}
  \proof{
    \p{For a \vocabk{flag}{frap-000D} adjacent to a pointwise fixed flag, only one rank has
    changed. The unchanged neighboring ranks bound a diamond with two
    possible faces. One is fixed, so the other is fixed too. The adjacent
    flag is therefore fixed pointwise. Propagating along the connected
    flag graph fixes every flag. Every face belongs to a flag, so every
    face is fixed. Transitivity is the definition of regularity.}
  }
}
