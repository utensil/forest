\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Proposition}
\title{A class-function kernel preserves class functions}
\date{2026-11-21}

\p{Let #{\mathcal K} and #{f} be class functions on a finite group
#{G}, with values in the commutative unital ring #{k}. Then
#{C_{\mathcal K}f} is a class function. If #{B} is also a class
function, the one-edge operator of \ref{fdip-012C} preserves the
class functions.}

\proof{
\p{Let #{h,g\in G}. Conjugation by #{h} is a bijection of #{G}.
Substitute #{x=hyh^{-1}} as #{y} runs through #{G}. Then
##{hgh^{-1}x^{-1}=h(gy^{-1})h^{-1},}
so the class-function identity for #{\mathcal K} and for #{f}
gives
##{(C_{\mathcal K}f)(hgh^{-1})
 =\sum_y\mathcal K(gy^{-1})f(y)
 =(C_{\mathcal K}f)(g).}
A product of class functions is a class function, so
#{M_B} preserves them whenever #{B} is a class function. The
composite #{\transferop} therefore preserves them as well.}
}
