\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Definition}
\title{Distance read from increments}
\date{2026-11-06}

\p{Let #{f} be a field, indexed by a set #{X}, with
#{\mathbb E\lvert f_x\rvert^2} finite at every point. The
\newvocab{increment metric} is
##{d(x,y)=\bigl(\mathbb E\lvert f_x-f_y\rvert^2\bigr)^{1/2}.}
It need not separate points. Until that separation is known,
this distance is an increment pseudometric; \ref{fdip-00D0}
records the distinction. The vocabulary name remains the
increment metric.}
