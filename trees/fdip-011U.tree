\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Proposition}
\title{A Pfaffian square for the full kernel}
\date{2026-11-19}

\p{Let the finite free total cochain module have even rank and
carry a chosen perfect alternating #{k}-bilinear form #{B}.
If #{B(v,K_{U,\phi}v)=0} for every cochain #{v}, then the
determinant of the full Yukawa kernel is the square of its
relative Pfaffian #{p_B(K_{U,\phi})}. In particular it is
nonnegative over an ordered field. If the cochain and mass
kernel already has alternating \vocabk{kernel form}{fdip-00UV},
the onsite addition preserves this condition precisely when
#{B(v,Y_\phi v)=0} for every #{v}.}

\proof{
\p{The bilinear form #{(u,v)\mapsto B(u,K_{U,\phi}v)} is
alternating by the stated diagonal condition. Apply
\ref{fdip-00UX}. For a top volume generator #{\omega},
the relative Pfaffian is
##{p_B(K)=\pfaffian_\omega(B(\cdot,K\cdot))
                    \pfaffian_\omega(B)^{-1},}
where #{K=K_{U,\phi}} and #{\pfaffian_\omega(B)} is a unit.
Its square is the determinant independently of the generator. Squares are nonnegative over an ordered field.
Subtracting #{B(v,(m\bbI+\extD_U)v)=0} from the full diagonal
condition gives exactly the asserted test for the onsite
addition, also in characteristic two. A self-adjoint kernel
for a positive real pairing may still give the negative value
in \ref{fdip-011T}. A real commutant type alone supplies no
chosen alternating form with this property.}
}
