\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Definition}
\title{A kernel complement and the transported boundary form}
\date{2026-11-17}

\p{Use the pairing and self-adjoint #{\extD_U} of
the \vocabk{invariant coefficient pairing}{fdip-00SR}. For a set #{M} of
labeled cells, let #{P_M} be coefficient projection, set
#{\langle v,w\rangle_M=\langle P_Mv,w\rangle}, and define
the \newvocab{transported boundary form} by
##{\mathcal B_M(v,w)=
\langle\extD_Uv,w\rangle_M-\langle v,\extD_Uw\rangle_M.}
Its \newvocab{boundary support} is the set of cells occurring
as a source or target of a nonzero coefficient block in
#{P_M\extD_UP_{M^c}} or #{P_{M^c}\extD_UP_M}. Nonzero means
nonzero as a coefficient-module map.}

\p{A \newvocab{kernel complement} for this construction is a
declared decomposition
##{C^*(X;F)=\ker\extD_U\oplus W}
with #{W} invariant under #{\extD_U} and
#{\extD_U|_W:W\to W} an isomorphism. Let #{H_U} be projection
onto the kernel along #{W}, and let #{E_U} be zero on the kernel
and equal to #{(\extD_U|_W)^{-1}} on #{W}. These are finite
module maps; no inverse of a separate Laplacian is intended.}
