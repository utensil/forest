\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Proposition}
\title{The parity index is the Euler rank difference}
\date{2026-11-17}

\p{For the \vocabk{based cochains}{fdip-00SH} with a free
coefficient module of rank #{r},
##{\operatorname{rank}C^{\mathrm{even}}-
\operatorname{rank}C^{\mathrm{odd}}
=|X|r(1-1)^n=0.}
More generally a finite cell model gives
#{\chi(X)r}. Over a field, the even-to-odd block #{B} of
either #{\extD_U} or #{\cov_U} satisfies
##{\dim\ker B-\dim\operatorname{coker}B
=\dim C^{\mathrm{even}}-\dim C^{\mathrm{odd}}.}
This holds for arbitrary represented links.}

\proof{
\p{There are #{|X|\binom np} degree-#{p} cells. Their
alternating sum is #{|X|(1-1)^n}; for a general finite cell
model it is the definition of #{\chi(X)}. Both #{\extd_U} and
#{\extdag_U} reverse degree parity, so their sum and difference
each give a block #{B:C^{\mathrm{even}}\to C^{\mathrm{odd}}}.
Over a field, subtract the equations
#{\dim\ker B=\dim C^{\mathrm{even}}-\operatorname{rank}B}
and
#{\dim\operatorname{coker}B=\dim C^{\mathrm{odd}}-\operatorname{rank}B}.}
}

\p{For finite projective coefficients, the same rank statement
holds after localization at each prime of #{k}; that rank may
vary between components. No freeness of ring kernels or
cokernels follows. This algebraic parity index alone is not a
chiral anomaly or a physical chirality assertion.}
