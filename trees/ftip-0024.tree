\import{macros}
\meta{agent-authored}{true}

\taxon{Definition}
\title{Stopping rule}
\tag{ftip}
\tag{agent}

\p{A \newvocab{stopping rule} is a random time
#{\tau_{\mathrm{stop}}\in\{0,1,\ldots,T_{\max}\}} such that, for each #{t},
the decision whether #{\tau_{\mathrm{stop}}=t} is determined by the public
history #{H_t} and any declared stopping randomness available by time #{t}.
It cannot inspect future observations.}

\p{Stopping can be triggered by a terminal environment observation, an agent
action, a resource limit, or the hard horizon. The trigger and the owner of
the decision are part of the rule.}
