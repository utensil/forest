\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Example}
\title{Grading-hermiticity alone permits a negative determinant}
\date{2026-11-17}

\p{On #{\mathbb C^2} with its positive Hermitian product,
take
##{K=\begin{pmatrix}1&0\\0&-1\end{pmatrix},\qquad
 \Gamma=\begin{pmatrix}1&0\\0&-1\end{pmatrix}.}
Then #{K^\dagger=\Gamma K\Gamma}, but #{\det K=-1}.
For the second basis vector, #{\langle v,Kv\rangle=-1}.
Thus the accretivity hypothesis used in \ref{fdip-00U5}
does not follow from the grading identity.}
