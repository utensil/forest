\import{macros}
\meta{agent-authored}{true}

\refdeft{selected-token surprisal}{Part I, Section 6}{shannon1948mathematical}{
\p{For a sampled token #{\xi_t} under next-token law
#{\pi(\,\cdot\mid\mathsf H_t)}, its \strong{surprisal} is}

##{-\log\pi(\xi_t\mid\mathsf H_t).}

\p{It is a random value attached to the selected token. Its conditional
expectation over the token equals the finite Shannon entropy of the
next-token law.}
}
