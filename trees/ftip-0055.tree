\import{macros}
\meta{agent-authored}{true}

\taxon{Remark}
\title{Observed feedback and assigned credit}
\tag{ftip}
\tag{feedback}
\tag{credit-assignment}

\p{Terminal returns, process labels, preference observations, and verifier
rewards determine what information is observed. A credit rule determines
where that information enters an objective. Treating them as separate inputs
is a proposed common description of these different methods.}

\p{Separating the interfaces permits questions about delayed, noisy, or
misallocated credit without changing the underlying evidence.}
