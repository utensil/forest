\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Definition}
\title{Equivariant observables over a coefficient ring}
\date{2026-11-17}

\p{Let #{H} be a finite group acting on a finite set
#{\mathcal Y}, and let #{E} be a #{k[H]}-module, with action
#{\rho_E}. Its \newvocab{invariant submodule} is
##{E^H=\{v\in E:\rho_E(h)v=v\text{ for every }h\in H\}.}
A vector in this submodule is an
\newvocab{algebraic singlet}. A
\newvocab{module-valued observable} is a function
#{f:\mathcal Y\to E}. It is equivariant when
##{f(hy)=\rho_E(h)f(y).}
For a scalar weight #{w:\mathcal Y\to k} with
#{w(hy)=w(y)}, its unnormalized weighted value is
##{\mathcal A_w(f)=\sum_{y\in\mathcal Y}w(y)f(y).}
A normalized value is defined by division by
#{Z_w=\sum_yw(y)} only when #{Z_w} is a unit.
No positivity is part of these ring-valued definitions.}
