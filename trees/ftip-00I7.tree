\import{macros}
\meta{agent-authored}{true}
\taxon{Theorem}
\title{Independent discovery probability}
\tag{ftip}
\tag{ledger}

\p{For #{B\in\mathbb N} independent discovery events with the probabilities
declared in \ref{ftip-0077}, the identity in \ref{ftip-0078} gives
#{\Pr(D_B)=1-\prod_{i=1}^{B}(1-p_i)}.}
