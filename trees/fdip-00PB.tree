\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Lemma}
\title{Each fibre carries one quadratic form}
\date{2026-11-12}

\p{Keep the operator #{L} of \ref{fdip-00PA}. On the outgoing fibre
at #{x} there is a unique \vocabk{quadratic form}{ca-0004} #{q_x}
such that
##{q_x(e_x\,df)=(L(f^2)-2f\,Lf)(x)}
for every function #{f}. No step divides by #{2}. The associated
bilinear form #{B_x} satisfies #{B_x(v,v)=q_x(v)} and is diagonal
on the edges leaving #{x}, with the weight of each edge as its
entry. The same scalar is the pairing of those weights against
the twist of #{e_x\,df} by #{f}.}

\proof{
\p{Set #{f(x)=0} and #{f(y)=a_y}. Then #{e_x\,df} is the vector
with those coefficients, so the displayed formula fixes #{q_x}
on every vector of the fibre. Define
##{q_x\Bigl(\sum_y a_y e_{xy}\Bigr)=\sum_y L_{xy}\,a_y^2.}
This map satisfies #{q_x(av)=a^2 q_x(v)}. Its companion bilinear
form, in the sense of the definition, sends two coefficient
vectors to twice the sum of the products of their coefficients
with the weights. The map is therefore a quadratic form, and
the preceding choice of #{f} gives
#{q_x(e_x\,df)=(L(f^2)-2f\,Lf)(x)} by \ref{fdip-00PA}.
Let #{B_x} be the symmetric bilinear form that is diagonal on
the same edges with the same entries. Then #{B_x(v,v)=q_x(v)}.
The companion is #{2B_x}, so the two forms agree only after
multiplication by #{2}.
The twist is the vector
##{[e_x\,df,f]=\sum_y(f(y)-f(x))^2 e_{xy}.}
Pairing it with the weights is the same sum of squares.}
}
