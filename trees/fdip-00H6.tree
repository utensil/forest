\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Theorem}
\title{The positive vacuum and polynomial position moments}
\date{2026-11-09}

\p{The ground energy #{E_0} of \ref{fdip-00H3} is simple, with
normalized real eigenfunction #{\psi_0>0} almost everywhere.
For every #{\beta>0},
##{|\psi_0(q)|^2\le \ue^{\beta E_0}K_\beta(q,q)
 \le \ue^{\beta(E_0+b)}K^{\mathrm{osc}}_\beta(q,q),}
where #{\omega=\sqrt{2a}} and
##{K^{\mathrm{osc}}_\beta(q,q)
 =\left(\frac\omega{2\pi\sinh(\omega\beta)}\right)^{s/2}
 \ue^{-\omega\tanh(\omega\beta /2)|q|^2}.}
Every polynomial has absolute moments of all orders in
#{|\psi_0|^2\extd q} and in
#{K_\beta(q,q)\extd q/\trace\ue^{-\beta H}}. For #{t>0},
##{\|M_p\ue^{-tH}\|_{\mathrm{HS}}^2
   =\int|p(q)|^2K_{2t}(q,q)\,\extd q<\infty.}}

\proof{
\p{Compact resolvent supplies a ground eigenvector.
The operator #{\ue^{-tH}} is compact, positive and positivity
improving by \ref{fdip-00H3} and \ref{fdip-00H4}.
The sign argument of \ref{fdip-00GZ}, following
\citet{Theorem 10.12, pp. 272-273}{teschl2014quantum}, makes its
norm eigenvalue simple and its eigenfunction positive. Spectral
calculus identifies that eigenspace with the #{H}-ground space.}

\p{The bridge formula and #{U(q)\ge a|q|^2-b} give the
pointwise comparison #{K_t(x,y)\le \ue^{bt}K_t^{\mathrm{osc}}(x,y)}.
The oscillator kernel is
##{\begin{aligned}
K_t^{\mathrm{osc}}(x,y)
 &=\left(\frac\omega{2\pi\sinh(\omega t)}\right)^{s/2}\\
 &\quad\cdot\exp\left(-\frac{\omega
 ((|x|^2+|y|^2)\cosh(\omega t)-2x\cdot y)}
 {2\sinh(\omega t)}\right).
\end{aligned}}
The scaled Hermite expansion in \ref{fdip-007U} gives this kernel
and its Gaussian diagonal. The eigenvalue identity and
Cauchy–Schwarz give
##{\begin{aligned}
|\psi_0(q)|^2
 &=\ue^{\beta E_0}|(\ue^{-\beta H/2}\psi_0)(q)|^2\\
 &\le \ue^{\beta E_0}\int K_{\beta /2}(q,y)^2\,\extd y
 =\ue^{\beta E_0}K_\beta(q,q).
\end{aligned}}
The continuous Gaussian-bounded kernels justify convolution
pointwise. Their strictly positive integral also chooses a
continuous everywhere positive representative of #{\psi_0}.}

\p{Gaussian integration proves the asserted state moments.
Convolution computes the squared kernel norm of #{M_p\ue^{-tH}}.
This gives the Hilbert–Schmidt identity; hence
#{\ue^{-tH}} maps into the maximal domain of #{M_p}.}
}

\p{For a nonnegative polynomially bounded multiplier #{r}, its
thermal expectation has numerator equal to the trace of
##{(M_{\sqrt r}\ue^{-\beta H/2})^{\dagger}
                 (M_{\sqrt r}\ue^{-\beta H/2}),}
namely #{\int r(q)K_\beta(q,q)\,\extd q}. Complex polynomial
expectations follow by linearity. This specifies the trace-class
meaning of the unbounded insertion.}
