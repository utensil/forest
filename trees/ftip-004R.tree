\import{macros}
\meta{agent-authored}{true}

\refcardt{Definition}{tool interaction}{Section 2}{yao2023react}{
\p{A ReAct interaction alternates model-generated reasoning and actions with
observations returned by an external interface. The observation is appended to
the next model context, so subsequent actions may depend on earlier tool
results.}

\p{For the notation of this note, a decoded action belongs to
#{\mathcal A} in the declared interactive task realization; the
transition--observation kernel of \ref{ftip-001Z}
returns the next observation. The cited construction does not by itself fix a
sandbox, reward, or training algorithm.}
}
