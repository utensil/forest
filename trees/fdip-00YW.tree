\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Example}
\title{The zero edge labels}
\date{2026-11-17}

\p{If every #{a_i(x)=0}, then #{c(a_i(x))=0}, so
#{\edgeop_a^+=\edgeop_a^-=\edgeop_a=0}. For comparison, on the internal
exterior basis of \ref{fdip-00YF}, #{c(e_1)} exchanges
#{1} with #{e_1} and exchanges #{e_2} with
#{e_1\wedge e_2}. Thus a nonzero edge direction can already act
nontrivially on an internal scalar.}
