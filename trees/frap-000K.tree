\import{macros}
\meta{agent-authored}{true}
\tag{frap}

\refcardt{Definition}{The rotation subgroup}{Definition 4}{marchetti2025rubik}{
  \p{Let #{Q} be a [regular](frap-000G) abstract polytope of rank
  #{m\geq2}. Choose a base flag and its
  [distinguished involutions](frap-000I) #{\rho_0,\ldots,\rho_{m-1}}.
  Its \newvocab{rotation subgroup} is}
  ##{\Gamma^+(Q)=\langle\rho_{j-1}\rho_j:1\leq j<m\rangle.}
  \p{The index starts at #{1}: for a polygon, the single adjacent pair
  #{\rho_0\rho_1} generates its rotations. For triangles and squares
  these are the usual cyclic rotation groups.}
  \p{Equivalently, #{\Gamma^+(Q)} consists of the elements represented by
  even-length words in the distinguished involutions. Indeed every pair
  #{\rho_i\rho_j} is a product of adjacent pairs or their inverses,
  by cancellation along the index interval. Conjugating an even word by
  a distinguished involution again gives an even word, so this subgroup
  is normal. A change of base flag conjugates the distinguished generators
  and therefore leaves the subgroup unchanged. We do not require it to
  have index two for every abstract polytope.}
}
