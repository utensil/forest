\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Remark}
\title{The two distances give two dimensions}
\date{2026-11-06}

\p{\ref{fdip-00D8} assigns [Hausdorff dimension](fdip-00D5)
#{1} to arc length on the circle. \ref{fdip-00D7} assigns
[Hausdorff dimension](fdip-00D5) #{2} to the
[increment metric](fdip-00CY) on the same point set.
\ref{fdip-00CT} gives the cycle heat trace a plateau at
#{1}. The two distances above remain the sources of the
dimensions #{1} and #{2}.}
