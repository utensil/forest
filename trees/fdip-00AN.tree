\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Definition}
\title{Cyclic shift and forward difference}
\date{2026-11-03}


\p{Let #{R} be a commutative unital ring, let #{n\ge 1}, and take
#{V=\mathbb Z/n\mathbb Z} and #{E=\{e_i:i\in V\}}, with
#{s(e_i)=i} and #{h(e_i)=i+1}. The edge-label bijection gives an
\vocabk{#{R}-algebra isomorphism}{ca-0015}
##{j:\mathcal F_R(E)\to\mathcal F_R(V),\qquad j(a)(i)=a(e_i).}
Its inverse sends #{f} to the edge field #{e_i\mapsto f(i)}; both
preserve the pointwise operations. With the
\vocabk{ring-valued incidence map}{fdip-00AQ}, the
\newvocab{cyclic shift} and \newvocab{forward difference} are
##{\,(Tf)(i)=f(i+1),\qquad \Delta=jd=T-I.}
The shift is an \vocabk{algebra automorphism}{ca-0015}, with
#{\,(T^{-1}f)(i)=f(i-1)}. Vertex and edge fields are identified only
through the displayed map #{j}.}
