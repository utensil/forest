\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Theorem}
\title{Cycle conductance}
\date{2026-11-06}

\p{Let #{N\ge 3}, and let the cycle be the graph of
\ref{fdip-00CS} with every edge weight equal to #{1}. For an
integer #{\ell} from #{1} through #{N-1}, the
\vocabk{effective conductance}{fdip-00DF} between vertices
#{0} and #{\ell} is
##{\frac{N}{\ell(N-\ell)}.}
This is the reciprocal of the resistance in \ref{fdip-00DB}.}

\proof{
\p{The vertices #{0,1,\ldots,\ell} form a path of #{\ell}
edges. The vertices #{0,N-1,\ldots,\ell} form a path of
#{N-\ell} edges. The two paths meet only at #{0} and #{\ell},
and their edges partition the cycle. \ref{fdip-00DL} gives the
conductances #{\frac{1}{\ell}} and #{\frac{1}{N-\ell}}.
\ref{fdip-00DJ} adds the two minima. Evaluated at voltage
difference #{1}, the sum is
##{\frac{1}{\ell}+\frac{1}{N-\ell}
=\frac{N}{\ell(N-\ell)}.}
\ref{fdip-00DH} identifies that value with the effective
conductance. \ref{fdip-00DB} gives the resistance
#{\frac{\ell(N-\ell)}{N}}, and the displayed conductance is
its reciprocal.}
}
