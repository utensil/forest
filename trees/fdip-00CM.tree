\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Remark}
\title{The bound uses the vertices}
\date{2026-11-06}

\p{The metric in \ref{fdip-00CL} is the edge-count of
\ref{fdip-0096}, divided by #{N}, on the #{N} vertices. A
state of the cycle algebra other than evaluation at a
vertex lies outside that comparison.}
