\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\title{Exact translations and an edge-direction rule}
\date{2026-11-17}

\p{Affine gauge covariance does not determine how a translation
should enter a matter operator. One possible rule uses each edge
translation as an internal Clifford direction. On a fixed 4-site
space, an exact vertex translation gives a direct test of that rule.}

\transclude{fdip-00YT}
\transclude{fdip-00YU}
\transclude{fdip-00YV}
\transclude{fdip-00YW}
\transclude{fdip-00YX}
\transclude{fdip-00YS}
\transclude{fdip-00YY}
\transclude{fdip-00YZ}
