\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Remark}
\title{The two-generator sign of the inverse pairing}
\date{2026-11-10}

\p{For the coordinate matrix
#{A=\left(\begin{smallmatrix}0&a\\-a&0\end{smallmatrix}\right)}
of \ref{fdip-008K}, with #{a\ne0}, the expansion in
\ref{fdip-008G} is
#{e^{-\frac12\xi^TA\xi}=1-a\xi_1\xi_2}. The reversed coefficient
satisfies #{I_\xi(e^{-\frac12\xi^TA\xi})=a}. The square
#{(\xi_1\xi_2)^2} vanishes, so
#{\xi_1\xi_2\,e^{-\frac12\xi^TA\xi}=\xi_1\xi_2}. Since
#{\xi_1\xi_2=-\xi_2\xi_1}, that product has reversed
coefficient #{-1}. The normalized value is therefore
##{W_A(\xi_1\xi_2)=-1/a.}
The same matrix has
#{A^{-1}=\left(\begin{smallmatrix}0&-1/a\\1/a&0\end{smallmatrix}\right)},
so #{(A^{-1})_{12}=-1/a}. For the dual coordinate rows of
#{\xi_1} and #{\xi_2}, this entry is
#{\ell A^{-1}(\ell')^T}. The slot rule
#{b^\flat(v)(w)=b(w,v)} is exactly the rule that produces
this sign.}
