\import{macros}
\import{lean-macros}
\meta{agent-authored}{true}
\tag{frap}

\taxon{Theorem}
\title{The abelianized total orientation}

\p{Let #{I} be finite, let #{K} act faithfully on a nonempty
#{\Omega}, and choose bijective frames #{c_i:\Omega\to X_i}.
For a \vocabk{framed transport}{frap-000Q} #{g=(\pi,a)}, let
#{K_{\mathrm{ab}}=K/[K,K]} be its \newvocab{abelianization}, where
#{[K,K]} is generated by
#{uvu^{-1}v^{-1}}, and write #{[a]} for the class of #{a}.
The \newvocab{total-orientation character}}
##{\chi(g)=\prod_{i\in I}[a_i]\quad\hbox{in }K_{\mathrm{ab}}}
\p{is a homomorphism, independent of replacing the frames by
#{c_i'=c_i t_i} for #{t_i\in K}. This is the canonical character in
\citet{Section 3.1, p. 7}{marchetti2025rubik}; the proof below gives
both assertions directly in source-indexed coordinates.}

\proof{
  \p{For #{h=(\sigma,b)}, the [composition law](frap-000R) and
  commutativity of the target give}
  ##{\chi(hg)=\prod_i[b_{\pi(i)}][a_i]
      =\left(\prod_j[b_j]\right)\left(\prod_i[a_i]\right)
      =\chi(h)\chi(g).}
  \p{The middle equality reindexes using the bijection #{\pi}.
  In the new frames the local map is
  #{a_i'=t_{\pi(i)}^{-1}a_i t_i}. Its abelianized product contains
  each #{[t_i]} and its inverse exactly once, so these cancel and
  leave #{\chi(g)}.}
}

\p{Frame independence here concerns changes within the chosen group of
frames. Reversing a common orientation convention can also change the
identification of the target group. The target and its quotient map are
\leanref{Abelianization} and \leanref{Abelianization.of}; the total
product and its frame independence are the argument above.}
