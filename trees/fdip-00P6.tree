\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Theorem}
\title{The counting form splits off the harmonics}
\date{2026-11-12}

\p{Let #{k} be an ordered field, and keep the counting operator
#{D} of \ref{fdip-00OL}. \ref{fdip-00OP} gives #{D^2=\Delta} and
a kernel of rank #{2^d}: #{(\Delta\alpha)=0} exactly when
#{d\alpha=0} and #{d^\dagger\alpha=0}. If #{D\alpha=0}, then
#{\Delta\alpha=D^2\alpha=0}, so both summands vanish, and the
converse is immediate. This is the kernel of #{D}. The
counting form is positive definite, and the cochain space is the
direct sum of #{\ker D} and its orthogonal complement. The
restriction of #{D} to that complement is an isomorphism. Let
#{H} be the projection onto #{\ker D} along the complement, and
let #{E} vanish on #{\ker D} and invert #{D} on the complement.
Then #{DE=ED=I-H} and #{EH=HE=0}. Both #{H} and #{E} are
self-adjoint.}

\proof{
\p{A finite sum of squares in an ordered field vanishes only when
every square vanishes, and #{x^2=0} forces #{x=0}. Thus
#{\langle\alpha,\alpha\rangle=0} forces #{\alpha=0}. For a
subspace #{W}, the intersection #{W\cap W^\perp} is zero. The
map from the cochain space to the dual of #{W} sending
#{\alpha} to the form #{\beta\mapsto\langle\alpha,\beta\rangle}
has kernel #{W^\perp}. The restriction to #{W} has kernel
#{W\cap W^\perp}, so it is injective. A finite-dimensional
vector space has the same dimension as its dual. An injective
linear map between finite-dimensional spaces of equal
dimension is bijective, so the restriction is bijective onto
that dual.
The image of the map contains this dual, so the map is
surjective. Rank-nullity gives the direct sum of #{W} and
#{W^\perp}. Take #{W=\ker D}.}

\p{If #{\alpha} is orthogonal to #{\ker D} and #{\beta} is
harmonic, then
#{\langle D\alpha,\beta\rangle=\langle\alpha,D\beta\rangle=0},
so #{D} preserves the complement. Its kernel on the complement
is zero, and the complement is finite-dimensional, so #{D} is
an isomorphism there. On that complement both #{DE} and #{ED}
are the identity, and on the kernel both are zero, so
#{DE=ED=I-H}. Since #{E} maps into the complement and vanishes
on the kernel, #{EH=HE=0}.}

\p{For the projection,
#{\langle H\alpha,\beta\rangle=\langle H\alpha,H\beta\rangle},
because #{H\alpha} is orthogonal to #{\beta-H\beta}. The same
value is #{\langle\alpha,H\beta\rangle}. If #{\alpha} and
#{\gamma} lie in the complement, then #{DE\gamma=\gamma} and
#{E\alpha} lies in the complement, so
##{\langle E\alpha,\gamma\rangle=\langle E\alpha,DE\gamma\rangle
=\langle DE\alpha,E\gamma\rangle=\langle\alpha,E\gamma\rangle.}
If either argument lies in #{\ker D}, then #{E} kills the
harmonic argument and the remaining argument of #{E} is
orthogonal to #{\ker D}, so both sides vanish. The direct sum
gives the general case.}
}
