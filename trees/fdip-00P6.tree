\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Theorem}
\title{The counting form splits off the harmonics}
\date{2026-11-12}

\p{Let #{k} be an ordered field, and keep the counting operator
#{\extD} of \ref{fdip-00OL}. \ref{fdip-00OP} gives #{\extD^2=-\covsq} and
a kernel of rank #{2^d}: #{(-\covsq\alpha)=0} exactly when
#{\covwedge\alpha=0} and #{\extdag\alpha=0}. If #{\extD\alpha=0}, then
#{-\covsq\alpha=\extD^2\alpha=0}, so both summands vanish, and the
converse is immediate. This is the kernel of #{\extD}. The
counting form is positive definite, and the cochain space is the
direct sum of #{\ker \extD} and its orthogonal complement. The
restriction of #{\extD} to that complement is an isomorphism. Let
#{H} be the projection onto #{\ker \extD} along the complement, and
let #{E} vanish on #{\ker \extD} and invert #{\extD} on the complement.
Then #{\extD E=E\extD=\bbI -H} and #{EH=HE=0}. Both #{H} and #{E} are
self-adjoint.}

\proof{
\p{A finite sum of squares in an ordered field vanishes only when
every square vanishes, and #{x^2=0} forces #{x=0}. Thus
#{\langle\alpha,\alpha\rangle=0} forces #{\alpha=0}. For a
subspace #{W}, the intersection #{W\cap W^\perp} is zero. The
map from the cochain space to the dual of #{W} sending
#{\alpha} to the form #{\beta\mapsto\langle\alpha,\beta\rangle}
has kernel #{W^\perp}. The restriction to #{W} has kernel
#{W\cap W^\perp}, so it is injective. A finite-dimensional
vector space has the same dimension as its dual. An injective
linear map between finite-dimensional spaces of equal
dimension is bijective, so the restriction is bijective onto
that dual.
The image of the map contains this dual, so the map is
surjective. Rank-nullity gives the direct sum of #{W} and
#{W^\perp}. Take #{W=\ker \extD}.}

\p{If #{\alpha} is orthogonal to #{\ker \extD} and #{\beta} is
harmonic, then
#{\langle \extD\alpha,\beta\rangle=\langle\alpha,\extD\beta\rangle=0},
so #{\extD} preserves the complement. Its kernel on the complement
is zero, and the complement is finite-dimensional, so #{\extD} is
an isomorphism there. On that complement both #{\extD E} and #{E\extD}
are the identity, and on the kernel both are zero, so
#{\extD E=E\extD=\bbI -H}. Since #{E} maps into the complement and vanishes
on the kernel, #{EH=HE=0}.}

\p{For the projection,
#{\langle H\alpha,\beta\rangle=\langle H\alpha,H\beta\rangle},
because #{H\alpha} is orthogonal to #{\beta-H\beta}. The same
value is #{\langle\alpha,H\beta\rangle}. If #{\alpha} and
#{\gamma} lie in the complement, then #{\extD E\gamma=\gamma} and
#{E\alpha} lies in the complement, so
##{\langle E\alpha,\gamma\rangle=\langle E\alpha,\extD E\gamma\rangle
=\langle \extD E\alpha,E\gamma\rangle=\langle\alpha,E\gamma\rangle.}
If either argument lies in #{\ker \extD}, then #{E} kills the
harmonic argument and the remaining argument of #{E} is
orthogonal to #{\ker \extD}, so both sides vanish. The direct sum
gives the general case.}
}
