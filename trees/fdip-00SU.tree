\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Example}
\title{Characteristic two hides nonzero curvature in the squares}
\date{2026-11-17}

\p{On the one-vertex cellular two-torus, let #{k=\mathbb F_2},
#{F=k^2}, and #{b(v,w)=v^{\mathsf t}Jw}, where
##{J=\begin{pmatrix}0&1\\1&0\end{pmatrix}.}
Use #{G=\operatorname{GL}(2,\mathbb F_2)} and the links
##{A=\begin{pmatrix}0&1\\1&1\end{pmatrix},\qquad
B=\begin{pmatrix}0&1\\1&0\end{pmatrix}.}
For a two-by-two matrix #{M}, direct multiplication gives
#{M^{\mathsf t}JM=(\det M)J} in characteristic two. Every
invertible matrix here has determinant #{1}, so the pairing is
invariant and perfect.}

\p{The inverses are
#{A^{-1}=\left(\begin{smallmatrix}1&1\\1&0\end{smallmatrix}\right)}
and #{B^{-1}=B}. Multiplication gives
#{[A^{-1},B^{-1}]=B\ne0}, so \ref{fdip-00SL} proves
#{\extd_U^2\ne0}. Nevertheless #{\extD_U=\cov_U} and
#{-1=1}, whence #{\extD_U^2=-\covsq_U}. This is the
two-torsion obstruction to the converse in \ref{fdip-00ST}.}
