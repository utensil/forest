\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Lemma}
\title{Mixed differences leave the squares}
\date{2026-11-12}

\p{Let #{g} be a vertex function and let #{i<j}. The value of
#{[\extD,f]^2 g} on the square of those directions based at #{x} is
##{\bigl(a_i(x)\,a_j(x+\varepsilon_i)
-a_j(x)\,a_i(x+\varepsilon_j)\bigr)
g(x+\varepsilon_i+\varepsilon_j).}
The coefficient equals
#{a_i(x)\,((\varepsilon_i\cdot\cov)a_j)(x)-a_j(x)\,((\varepsilon_j\cdot\cov)a_i)(x)}.
The two mixed differences agree, so the coefficient is
#{(a_i(x)-a_j(x))\,((\varepsilon_i\cdot\cov)a_j)(x)}. It is zero whenever the
mixed difference is zero.}

\proof{
\p{By \ref{fdip-00PJ}, #{[\extD,f]g} is the edge cochain whose value
on the edge of direction #{j} based at #{z} is
#{a_j(z)\,g(z+\varepsilon_j)}. The coboundary part of the same
lemma, applied to that edge cochain, contributes to the square
#{c_{\{i,j\}}(x)}. Since #{i<j}, one has
#{\sigma(i,\{i,j\})=0} and #{\sigma(j,\{i,j\})=1}. The order
that differentiates in direction #{i} first contributes
#{a_i(x)\,a_j(x+\varepsilon_i)\,g(x+\varepsilon_i+\varepsilon_j)}.
The opposite order contributes the same monomial with a minus.
Adding them gives the displayed coefficient.}

\p{Expand #{a_j(x+\varepsilon_i)=a_j(x)+((\varepsilon_i\cdot\cov)a_j)(x)} and
#{a_i(x+\varepsilon_j)=a_i(x)+((\varepsilon_j\cdot\cov)a_i)(x)}. The products
#{a_i(x)a_j(x)} cancel, and the remainder is the second
display. Both mixed differences equal
#{f(x+\varepsilon_i+\varepsilon_j)-f(x+\varepsilon_i)
-f(x+\varepsilon_j)+f(x)}, so they may be factored as one
coefficient.}
}
