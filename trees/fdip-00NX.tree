\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Example}
\title{A directed triangle has no 2-forms}
\date{2026-11-12}

\p{Let #{X=\{0,1,2\}} and let the edges of \ref{fdip-00NU} be
#{0\to 1}, #{1\to 2}, and #{2\to 0}. The path algebra has three
words of length #{2},
##{e_{01}e_{12},\qquad e_{12}e_{20},\qquad e_{20}e_{01}.}
In the maximal prolongation of \ref{fdip-00NW} each of them is zero.
The calculus has no #{2}-form, so it has no square.}

\p{The reverse edge #{1\to 0} is absent, so
#{\delta_1\,d\delta_0=0} in #{\Omega^1}. Differentiating and using
#{d^2\delta_0=0} gives #{d\delta_1\,d\delta_0=0} in #{\Omega^2}.
On this graph
##{d\delta_1=e_{01}-e_{12},\qquad d\delta_0=e_{20}-e_{01}.}
Their product is
##{(e_{01}-e_{12})(e_{20}-e_{01})=-e_{12}e_{20},}
because #{e_{01}} does not compose with either factor on the right
and #{e_{12}} composes only with #{e_{20}}, taking the minus sign
from the first factor. Thus #{-e_{12}e_{20}=0}, so
#{e_{12}e_{20}=0}. The cyclic permutations give the other two
words.}
