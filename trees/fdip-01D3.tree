\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Definition}
\title{Lines of constant physics}
\date{2026-11-28}

\p{Let #{D_k} be a nonzero family of hierarchical operators forming
a relevant \vocabk{scaling direction}{fdip-01CQ}, with
#{\Phi_{\lambda,k}(D_k)=\varepsilon D_{k-1}} and
#{\varepsilon>1}. A \newvocab{line of constant physics} along this
direction assigns coefficient #{t\varepsilon^{-K}} at fine depth
#{K}, for a fixed #{t}, at the depths where the resulting
precision is positive.}
