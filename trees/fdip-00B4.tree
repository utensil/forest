\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Proposition}
\title{The circle mesh is not preserved}
\date{2026-11-06}

\p{For its mass squared #{\mu>0}, the precision #{Q_n} of the
\vocabk{circle mesh}{fdip-004H} is the operator
#{\mu \bbI+n^2(2\bbI -T_n-T_n^{-1})}, where #{T_n} is the cyclic
shift of that mesh. Its shape is therefore
#{1+(\mu)/(2n^2)}. On the cycle of #{2N} vertices that shape is
#{1+(\mu)/(8N^2)}. Decimation by #{2} sends it to #{T_2} of
\ref{fdip-00B1} applied to that value. The mesh shape on the
cycle of #{N} vertices is #{1+(\mu)/(2N^2)}, and
##{T_2\Bigl(1+\frac{\mu}{8N^2}\Bigr)
 -\Bigl(1+\frac{\mu}{2N^2}\Bigr)
 =\frac{\mu^2}{32N^4}.}
The difference is positive for every #{\mu>0} and every
#{N\ge 3}, so the mesh shape is not invariant under decimation
by #{2}.}

\p{Remark. In the counting basis of site indicators, this operator
has diagonal #{\mu+2n^2} and neighbor coefficient #{n^2}.}

\p{Let #{m>0}, and let #{t_N=\cosh(m/N)} be the preserved shape
of \ref{fdip-00AY}. Define
#{\mu_N=2N^2\bigl(\cosh(m/N)-1\bigr)}. Then
#{t_N=1+\mu_N/(2N^2)} and
##{\mu_N-m^2=\frac{m^4}{12N^2}+O(N^{-4})}
as #{N\to\infty}, with the implied constant depending only on
#{m}. For the circle mesh whose mass squared is #{m^2}, the
shape on #{N} vertices agrees with #{t_N} through order
#{1/N^2}.}

\proof{
\p{The operator #{Q_n} on the circle mesh is
#{\mu \bbI+n^2(2\bbI -T_n-T_n^{-1})}. In the counting basis of site
indicators, the diagonal #{\mu+2n^2}, the neighbor coefficient
#{n^2}, and the shape are immediate. The cycle of #{2N}
vertices has the shape #{1+(\mu)/(8N^2)}. Set
#{\varepsilon=(\mu)/(8N^2)}. Then
#{T_2(1+\varepsilon)=2(1+\varepsilon)^2-1=1+4\varepsilon+2\varepsilon^2},
and #{4\varepsilon=(\mu)/(2N^2)}, while
#{2\varepsilon^2=\mu^2/(32N^4)}. Subtracting
#{1+(\mu)/(2N^2)} leaves the displayed difference, which is
positive.}

\p{The Taylor expansion of #{\cosh} through order #{5}, with
Lagrange remainder, supplies an #{\eta} strictly between #{0}
and #{u=m/N} such that
##{\cosh u=1+\frac{u^2}{2}+\frac{u^4}{24}+\frac{u^6}{720}\cosh\eta.}
Multiplying #{\cosh u-1} by #{2N^2} yields
##{\mu_N=m^2+\frac{m^4}{12N^2}+\frac{m^6}{360N^4}\cosh\eta.}
For #{N\ge 3} one has #{m/N\le m/3}, so
#{\cosh\eta\le\cosh(m/3)} and the last term is at most
#{(m^6\cosh(m/3)/360)\,N^{-4}}. For mass squared #{m^2} the
mesh shape is #{1+m^2/(2N^2)}, while
#{t_N=1+\mu_N/(2N^2)} differs from it by
#{m^4/(24N^4)} plus a term of order #{N^{-6}}.}
}
