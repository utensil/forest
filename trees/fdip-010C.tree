\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Proposition}
\title{Endpoint transport preserves the joint weight}
\date{2026-11-19}

\p{For the \vocabk{orbit gauge–Higgs weight}{fdip-010A}, each vertex
gauge acts bijectively on joint configurations and
##{\Xi(U^g,\phi^g)=\Xi(U,\phi).}
This identity holds over the given commutative ring #{k}.}

\proof{
\p{The inverse transformation uses the pointwise inverse of #{g}.
The two transformed arguments at the head of #{e} are
##{\phi_{h(e)}^g=g_{h(e)}\phi_{h(e)},\qquad
 U_e^g\phi_{s(e)}^g=g_{h(e)}U_e\phi_{s(e)}.}
Diagonal invariance of #{b_e} gives equality of the edge factors.
For a reversed traversal the inverse of #{U_e^g} exchanges the
endpoint gauges. Multiplying successive traversals cancels the
two gauges at each intermediate vertex. Thus around a face based
at #{x} the transport is #{g_xU_f g_x^{-1}}. The class function
has the same value there as at #{U_f}. Invariance of #{c_x}
preserves the remaining factors.}
}
