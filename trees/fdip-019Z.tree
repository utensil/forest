\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Proposition}
\title{Where the bulk integer jumps}
\date{2026-11-27}

\p{On any grid in \ref{fdip-019Y}, the free Wilson \vocabk{bulk integer}{fdip-019W} is constant between consecutive values #{2j} for #{0\le j\le e}. As #{aM} increases across #{2j}, it changes by #{(-1)^j\binom ej}. At equality its value is that on the lower side, and the Wilson block is the zero operator precisely at the #{\binom ej} corners with #{j} components equal to #{\pi}.}

\proof{\p{Every summand in \ref{fdip-019Y} is present exactly when #{2j<aM}. At equality the centered coefficients and shifted mass vanish together at just the indicated corners, and every other block is invertible by \ref{fdip-0141}.}}
