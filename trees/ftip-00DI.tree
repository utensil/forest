\import{macros}
\meta{agent-authored}{true}

\taxon{Definition}
\title{Finite rollout token budget}
\tag{ftip}
\tag{budget}

\p{A rollout has a finite token budget #{T\in\mathbb N_{\geq1}} when its
history contains at most #{T} generated positions after the prompt. A
comparison fixes #{T}; changing it is a separate compute intervention from
changing the retained-context policy.}
