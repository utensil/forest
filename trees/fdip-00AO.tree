\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Remark}
\title{The Leibniz correction}
\date{2026-11-03}


\p{The [cyclic shift](fdip-00AN) #{T} is translation by one site, and
the [forward difference](fdip-00AN)
#{\,(\Delta f)(i)=f(i+1)-f(i)} is the derivative of spacing #{1}. The
Leibniz rule #{\Delta(fg)=(\Delta f)g+f\Delta g} fails by the extra
product #{\,(\Delta f)(\Delta g)}. \ref{fdip-0009} is the corrected
identity, together with the indicator witness #{f^2=f}.}
