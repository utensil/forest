\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Remark}
\title{The Leibniz correction}
\date{2026-11-03}


\p{The [cyclic shift](fdip-00AN) #{T} is translation by one site, and
the [forward difference](fdip-00AN)
#{\,(\varepsilon\cdot\cov f)(i)=f(i+1)-f(i)} is the derivative of spacing #{1}. The
Leibniz rule #{\varepsilon\cdot\cov(fg)=(\varepsilon\cdot\cov f)g+f(\varepsilon\cdot\cov g)} fails by the extra
product #{\,(\varepsilon\cdot\cov f)(\varepsilon\cdot\cov g)}. \ref{fdip-0009} is the corrected
identity, together with the indicator witness #{f^2=f}.}
