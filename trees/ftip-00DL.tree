\import{macros}
\meta{agent-authored}{true}

\taxon{Theorem}
\title{Capped retained context bounds finite exposure work}
\tag{ftip}
\tag{finite-result}

\p{Under the hypotheses of \ref{ftip-00DK}, every rollout with budget #{T}
satisfies}

##{
E_T(\kappa^{p,w})\leq T(p+w).
}

\p{Proof. Apply the pointwise bound in \ref{ftip-00DK} to each of the #{T}
nonnegative summands in \ref{ftip-00DJ}, then sum. This bounds token exposure,
not wall-clock runtime or evaluation quality.}
