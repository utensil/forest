\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Lemma}
\title{A flat torus has commuting seam holonomies}
\date{2026-11-17}

\p{Suppose the \vocabk{coefficient connection}{fdip-00SH} is
represented-flat. There is a vertex frame in which every
positive link inside the coordinate rectangle is the identity,
and every seam link in direction #{i} is a constant
#{H_i\in\rho(G)}. The operators #{H_1,\ldots,H_n} commute.}

\proof{
\p{Work with the represented link maps. Represent each vertex
by #{0\le x_i<N_i}. Let #{P(x)} be forward transport from
#{0} to #{x} along the path taking all steps in direction #{1},
then #{2}, and so on. Choose the frame #{P(x)^{-1}} at #{x}.
If #{x_i<N_i-1}, move an extra step in direction #{i} past the
later-direction steps of this path, one square at a time.
Each swap preserves transport by \ref{fdip-00SL}. Thus
#{P(x+\varepsilon_i)=\rho(U_i(x))P(x)}, and the transformed
interior link is the identity.}

\p{A square crossing the #{i}-seam but not a #{j}-seam has
identity #{j}-links and therefore equates the two neighboring
#{i}-seam links. Moving through the finite rectangle of the
other coordinates shows that all #{i}-seam links have one
value #{H_i}. A square crossing both seams now equates
#{H_jH_i} and #{H_iH_j}. If a period is #{1}, its link is a
seam at every vertex; the same square argument applies, with
no interior steps in that direction. This includes the
one-vertex torus.}
}
