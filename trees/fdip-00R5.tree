\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Notation}
\title{Notation for arithmetic families}
\date{2026-11-13}

\p{The algebraic closure is #{\cl{\mathbb Q}}
(\ref{fdip-0049}, \ref{fdip-00QZ}).}

\p{The prime spectrum is #{\Spec}. The basic open of an element is
#{\basic{g}} (\ref{fdip-000U}, \ref{fdip-00R1}).}

\p{The additive character of #{\mathbb F_p} is #{\zeta_p^{t}}
(\ref{fdip-008O}, \ref{fdip-00QY}).}

\p{Arithmetic brings closures, prime spectra, and basic open sets,
and they take the names algebra gives them without colliding with
earlier symbols: the closure #{\cl{\mathbb Q}} is the overline of
the field, and conjugation is the overline of a scalar, #{\Spec}
of a ring stays apart from #{\spec} of an operator, and a basic
open set is #{\basic{g}} so #{D} stays reserved for operators. A
character of #{\mathbb F_p} is the root of unity #{\zeta_p^{t}},
leaving #{e} with its Part I meaning.}
