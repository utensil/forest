\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Theorem}
\title{The traced weights are a regular harmonic structure}
\date{2026-11-07}

\p{On functions on #{\{p_1,p_2,p_3\}}, let #{H_0} be the
symmetric operator with diagonal entries #{-2} and
off-diagonal entries #{1}. Set #{r_i=\frac{3}{5}} for
#{i=1,2,3}. Then #{(H_0,r)} is a regular harmonic structure
in the sense of \citet{Definition 3.7}{kigami1996kokyuroku},
with the normalization #{\lambda=1}. For the networks built in
\citet{Definition 3.4}{kigami1996kokyuroku}, the energy
#{-(u,H_{m}u)} equals the energy #{E_m} of \ref{fdip-00EL}.}

\proof{
\p{By \citet{Definition 2.1}{kigami1996kokyuroku}, the energy
of #{H_0} is #{-(u,H_0u)}. For the unit triangle
this is the sum of the three squared edge differences, which
is the energy of #{G_0} in \ref{fdip-00EL}. For a word #{w}
of length #{m}, the product #{r_w} equals
#{\bigl(\frac{3}{5}\bigr)^m}. Definition 3.4 places on the
three corners of that cell a copy scaled by #{r_w^{-1}},
hence by #{\bigl(\frac{5}{3}\bigr)^m}. Those three edges are
the edges of the cell in #{G_m}, and every edge of #{G_m}
arises in one cell. The energies agree at level #{m}.}

\p{\citet{Definition 2.3}{kigami1996kokyuroku} compares two
networks by equality of the coarser energy with the minimum
of the finer energy. \ref{fdip-00EL} is that equality for
#{E_m} and #{E_{m+1}}, and the preceding paragraph
identifies those energies with the networks just built. The
case #{m=0} is condition (3.1) of the cited exposition with
#{\lambda=1}. Since #{\frac{3}{5}<1}, Definition 3.7 gives a
regular harmonic structure.}
}
