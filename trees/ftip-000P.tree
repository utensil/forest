\import{macros}
\meta{agent-authored}{true}

\refdeft{Query, key, and value projections}{sec. 3.2.1}{vaswani2017attention}{
\p{Let #{X\in\mathbb R^{T\times d}} use the notation of
\ref{ftip-000L}. For attention head #{h}, choose learned matrices
##{
W_h^Q,W_h^K\in\mathbb R^{d\times d_h},
\qquad
W_h^V\in\mathbb R^{d\times d_v},
}
where #{d_v} is the value width of one head. The \newvocab{query},
\newvocab{key}, and \newvocab{value} matrices are
##{
Q_h=XW_h^Q,\qquad K_h=XW_h^K,\qquad V_h=XW_h^V.
}
Their rows associate a query, key, and value vector with each token position.}
}

\tag{ftip}
\tag{attention}
