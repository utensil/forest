\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Example}
\title{A prime period makes the reference cochain exact}
\date{2026-11-12}

\p{Let #{p} be a prime divisor of the positive integer #{N}, and take
#{d=1}, #{k=\mathbb{F}_p} and #{V=\mathbb{F}_p}. In
#{\mathbb{F}_p} the integer #{N} is #{0}. The invariant cochain of
\ref{fdip-00OF} has value #{1} on every edge of the cycle, so its
period is #{N\cdot 1=0}. Define #{X} on the vertices
#{0,1,\ldots,N-1} by reading the integer label in
#{\mathbb{F}_p}. Then
##{X(i+1)-X(i)=1}
for #{0\le i\le N-2}, and the closing edge from #{N-1} to #{0}
contributes
##{X(0)-X(N-1)=-(N-1)=1,}
because #{N=0} in #{\mathbb{F}_p}. The reference cochain equals
#{\covwedge X}, so it is pure gauge. The column cocycle of label #{1}
has period #{1}, which is not #{0}, so its class is nonzero.}
