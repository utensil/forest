\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Lemma}
\title{The weighted integral meets half a Gaussian}
\date{2026-11-07}

\p{Let #{J(t)} and #{G(t)} be the weighted integral of
\ref{fdip-00G2} and the Gaussian main term of
\ref{fdip-00G3}. For every #{t\ge 1},
##{\lvert J(t)-\frac{G(t)}{2}\rvert\le 19\frac{G(t)}{t}.}}

\proof{
\p{Let #{\varphi(y)=y\ue^{-y}} and #{\psi=t\theta^2}, and write
#{y=t\ell(\theta)}. The function #{\ue^{y/2}-y} has
derivative #{\frac{1}{2}\ue^{y/2}-1} and a minimum at
#{y=2\log 2}. The minimum value is #{2-2\log 2}. From
#{\ue>27/10} in \ref{fdip-00G3} one has #{\ue>2}, so
#{\log 2<1} and the minimum is positive. Thus
#{\varphi(y)\le \ue^{-y/2}} and
#{g(\theta)\le\ue^{-\frac{1}{2}t\ell(\theta)}}. The chord
bound of \ref{fdip-00G3} then gives
#{g(\theta)\le\ue^{-\frac{2t}{\pi^2}\theta^2}}.}

\p{On #{\lvert\theta\rvert\le\delta}, with
#{\delta=t^{-1/4}}, one has
#{\lvert y-\psi\rvert\le\frac{t\theta^4}{12}}. Since
#{\lvert\theta\rvert\le\delta\le 1}, one has #{\theta^2\le 1} and
#{\frac{t\theta^4}{12}\le\frac{\psi}{12}}, so every
value between #{y} and #{\psi} is at least
#{\frac{11}{12}\psi}. The derivative
#{\varphi'(s)=(1-s)\ue^{-s}} satisfies
#{\lvert\varphi'(s)\rvert\le(1+s)\ue^{-s}}, because
#{\lvert 1-s\rvert\le 1+s} for #{s\ge 0}, and #{(1+s)\ue^{-s}}
decreases because its derivative is #{-s\ue^{-s}}. Therefore
##{\lvert\varphi(y)-\varphi(\psi)\rvert
\le\frac{t\theta^4}{12}
\Bigl(1+\frac{11}{12}t\theta^2\Bigr)
\ue^{-\frac{11}{12}t\theta^2}.}
Write #{\beta=\frac{11}{12}t}. Differentiating the fourth
moment of \ref{fdip-00G3} in the quadratic rate produces
#{\int_{-\infty}^{\infty}\theta^6\ue^{-\beta\theta^2}\,\extd\theta
=\frac{15}{8}\sqrt{\pi}\,\beta^{-7/2}}.}

\p{The integral of the first summand against #{1/(2\pi)},
compared with #{G(t)/t} through the fourth-moment factor
#{\frac{3}{8\sqrt{\pi}}} and the coefficient #{t/12}, has
quotient #{\frac{1}{16}(12/11)^{5/2}}. Since
#{(12/11)^2=144/121<6/5} and
#{(21/20)^2=441/400>12/11}, this quotient is less than
#{63/800}. The second summand contributes the factor
#{2\cdot 11\cdot 15/(144\cdot 16)=55/384} times
#{(12/11)^{7/2}}. The bound
#{(12/11)^{7/2}<(63/50)(12/11)=378/275} makes that
quotient less than #{63/320}. The sum of these two
fractions is #{441/1600}, which is less than #{1/3}. The
near piece is therefore at most #{\frac{1}{3}G(t)/t}.}

\p{For the Gaussian moment tail, the derivative of
#{\theta \ue^{-t\theta^2}} gives
##{\int_{\delta}^{\infty}t\theta^2\ue^{-t\theta^2}\,\extd\theta
=\frac{1}{2}\int_{\delta}^{\infty}\ue^{-t\theta^2}\,\extd\theta
+\frac{\delta}{2}\ue^{-t\delta^2}.}
With #{s=\sqrt{t}}, the two quotients against #{G(t)/t}
are #{\frac{s^{3/2}\ue^{-s}}{2\sqrt{\pi}}} and
#{\frac{s^{5/2}\ue^{-s}}{\sqrt{\pi}}}. The bound
#{s^{3/2}\ue^{-s}<1} from \ref{fdip-00G3} makes the first
less than #{1/2}. The quotient #{\ue^s/s^{5/2}} is smallest
at #{s=5/2}. There #{\ue^5>(27/10)^5=14348907/100000} and
#{(5/2)^5=3125/32=9765625/100000}, so
#{s^{5/2}\ue^{-s}<1} and the second quotient is less than
#{1}. The two quotients add to less than #{3/2}, and the
contribution is at most #{2G(t)/t}.}

\p{On #{\delta<\lvert\theta\rvert\le\pi} the bound
#{g(\theta)\le\ue^{-\frac{2t}{\pi^2}\theta^2}} and the
ray estimate give a quotient
#{\frac{\pi^{3/2}}{2}s^{3/2}\ue^{-\frac{2s}{\pi^2}}}
against #{G(t)/t}. From #{\pi<22/7} one has
#{\frac{2}{\pi^2}>49/242} and #{\frac{\pi^{3/2}}{2}<14/5}.
With #{\beta=49/242},
#{\beta^{-3/2}=2662\sqrt{2}/343}, since
#{\sqrt{242/49}=11\sqrt{2}/7} and #{242\cdot 11=2662}.
Since #{(17/12)^2=289/144>2}, replacing #{\sqrt{2}} by
#{17/12} gives
#{2662\cdot 17/(343\cdot 12)=22627/2058}. This is less
than #{11} because #{11\cdot 2058=22638}. Multiplying
#{11/2} by #{14/5}
gives #{77/5}, which is less than #{16}. This piece is at
most #{16G(t)/t}. Adding the near piece, the moment tail
and this piece gives at most
#{\bigl(\frac{1}{3}+2+16\bigr)G(t)/t=\frac{55}{3}G(t)/t},
which is at most #{19G(t)/t}.}
}
