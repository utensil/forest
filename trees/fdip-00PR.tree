\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Theorem}
\title{A long symmetric torus is recovered at every site}
\date{2026-11-12}

\p{On the periodic cubical torus with both directions of every
axis and with every weight equal to #{1}, let #{N\ge 5}. Every
vertex is a \vocabk{recovery site}{fdip-00PQ} of rank #{d}. For #{N=1} every
difference of a function is zero, so the affine functions do
not span a free module of positive rank. For #{N=2} the vertex
#{x-\varepsilon_i} equals #{x+\varepsilon_i}, and a constant
difference on that axis exists only when #{2a_i=0}. For #{N=3}
and for #{N=4}, every edge of an axis cycle meets the star of
#{x}, so a constant difference #{a_i} exists for every value in
#{k} only when #{Na_i=0}. Over #{\mathbb{Z}} the only such
slope is #{0}, and the odd vectors do not span a free module of
rank #{d}. The forward-edge torus has no backward edge, so the
two directions required by the \vocabk{recovery site}{fdip-00PQ}
are not both present. This is the obstruction of \ref{fdip-00PE}.
If one outgoing edge at a vertex #{x} is deleted, the out-degree
at #{x} is one less than the out-degree at a vertex that still
has every edge, so the rank is not constant on any set containing
both vertices.}

\proof{
\p{Let #{U} be the star of #{x}, containing #{x} and every
#{x\pm\varepsilon_i}. Each coordinate displacement from #{x} that
appears on an edge meeting #{U} lies in
#{\{-2,-1,0,1,2\}}. For #{N\ge 5} those 5 integers remain
distinct in #{\mathbb{Z}/N\mathbb{Z}}, so the chart embeds. On
the chart, #{f(x+m)=\sum_i a_i m_i} has difference #{a_i} on
every chart edge, for every prescribed #{a_i\in k}. Every edge
that meets #{U} is a chart edge. The odd vectors of
\ref{fdip-00PO} are therefore hit, and they form a free basis
of rank #{d}. Every weight is #{1}, a unit, so #{\bar q} is
the standard dot form and \ref{fdip-00PC} gives nondegeneracy.
The two directions are present and the weights agree.
\ref{fdip-00PK} supplies the commutator square on the cells
whose vertices and one-step shifts lie in #{U}. Thus every
vertex is a recovery site of rank #{d}.}

\p{For #{N=1} there is one vertex, and #{f(x+\varepsilon_i)-f(x)
=0}. For #{N=2} the two steps #{+\varepsilon_i} and
#{-\varepsilon_i} are the same vertex, so summing the
difference around the axis yields #{2a_i=0}. For #{N=3},
#{x+2\varepsilon_i=x-\varepsilon_i}. For #{N=4},
#{x+2\varepsilon_i=x-2\varepsilon_i}. In both cases every edge
of the axis cycle meets the star, and summing the difference
around the cycle yields #{Na_i=0}. On the forward-edge torus
the backward generator is absent, so no odd vector is defined.
Deleting one outgoing edge lowers the out-degree by one at its
source and leaves some other vertex at out-degree #{2d}, so
the ranks differ.}
}
