\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Definition}
\title{Vacuum observables on a retained subspace}
\date{2026-11-09}

\p{Let #{\mathsf Q} be a finite-dimensional real inner product
space of dimension #{s}, with norm #{|q|} and
\vocabk{canonical Euclidean volume}{fdip-002M} #{\extd q}.
Let #{U:\mathsf Q\to\mathbb R} be continuous with
#{U(q)\ge a|q|^2-b}, #{a>0}, #{b\ge0}.
Use the closed-form realization #{H=-\covsq_{\mathsf Q}/2+M_U}
of \ref{fdip-00H2}, its ground energy #{E_0}, and the positive
normalized ground state #{\psi_0} of \ref{fdip-00H6}.
Here #{\covsq_{\mathsf Q}} is the metric Laplacian and #{M_U}
is multiplication by #{U}. Put
#{\mathcal H=L^2(\mathsf Q,\extd q;\mathbb C)}, with inner product
conjugate-linear in the first argument, and
#{S_t=\ue^{-t(H-E_0)}} for #{t\ge0}.}

\p{Let #{X} be a standard Borel space and
#{P:\mathsf Q\to X} a measurable map. The
\newvocab{vacuum marginal} and its Hilbert space are}

##{\nu_0(\extd q)=\psi_0(q)^2\extd q,\qquad \rho=P_*\nu_0,\qquad \mathcal K=L^2(X,\rho;\mathbb C).}

\p{The \newvocab{retained vacuum embedding} and \newvocab{compressed vacuum operators} are}

##{J:\mathcal K\to\mathcal H,\quad Jf=\psi_0(f\circ P),\qquad A_t=J^{\dagger}S_tJ.}

\p{All multipliers below are bounded Borel measurable functions unless otherwise stated.}

\p{An orthogonal projection onto a subspace #{X\subseteq\mathsf Q}
is a special case, with #{Y=\ker P}. The fiber density and
finite Gaussian elimination below use this linear specialization;
the embedding and compressed operators require only measurable #{P}.}
