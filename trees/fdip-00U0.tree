\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Example}
\title{Power traces can miss a determinant}
\date{2026-11-17}

\p{Over #{\mathbb F_2}, the matrices #{0_2} and #{\bbI_2}
have the same positive-power traces: every one is zero.
Their determinants are respectively zero and one. The
#{j=2} equation in \ref{fdip-00TZ} has left side #{2e_2=0}
and cannot recover #{e_2}. The finite exterior-power
coefficient remains defined and distinguishes the two matrices.}
