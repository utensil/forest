\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Example}
\title{Unchanged labels need not preserve the configuration form}
\date{2026-11-10}

\p{Preservation of the form is essential for the
[half-turn automorphism](fdip-000Q). Compare #{q_{1,1}} and
#{q_{2,1}} while keeping the coordinate labels unchanged. At
#{\delta_0},
##{q_{1,1}(\delta_0)=3,\qquad q_{2,1}(\delta_0)=4.}}

\proof{
\p{The identity linear map is not form-preserving. Write
#{c_i^{(1)},c_i^{(2)}} for the two sets of generators.
A unital real algebra map with
#{c_i^{(1)}\mapsto c_i^{(2)}} would send
#{(c_0^{(1)})^2=3\,1} to #{(c_0^{(2)})^2=3\,1},
but the target square is #{4\,1}. The
[injective scalar map](fdip-000P) rules this out.
This excludes precisely the unchanged-label assignment. It does
not exclude other isometries between the positive forms or an
abstract isomorphism of their Clifford algebras.}
}
