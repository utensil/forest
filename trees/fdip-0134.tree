\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Proposition}
\title{A diagonal entry bounds the Rayleigh value}
\date{2026-11-21}

\p{Let #{A} be a symmetric matrix with entries in an ordered
field, and write #{\langle x,y\rangle} for the standard dot
product on its index space. Suppose #{\lambda} lies in that
field and #{\langle x,Ax\rangle\le\lambda\langle x,x\rangle}
for every vector #{x}. Then #{\lambda} is at least every
diagonal entry of #{A}.}

\proof{
\p{Let #{e} be the vector with a #{1} in one index and a #{0}
in every other index. Then #{\langle e,e\rangle=1}, and
#{\langle e,Ae\rangle} equals the corresponding diagonal
entry. The inequality gives that entry as a lower bound for
#{\lambda}.}
}
