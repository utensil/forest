\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Example}
\title{Two generators fix the integration signs}
\date{2026-11-01}

\p{Take two generators and the alternating matrix
##{A=\begin{pmatrix}0&a\\-a&0\end{pmatrix}.}
Anticommutation gives
##{\tfrac12\xi^TA\xi=a\xi_1\xi_2.}
Since #{(\xi_1\xi_2)^2=0},
##{\ue^{-\frac12\xi^TA\xi}
 =1-a\xi_1\xi_2=1+a\xi_2\xi_1.}
The [reversed coefficient](fdip-008F) therefore gives
#{I_\xi(\ue^{-\xi^TA\xi/2})=a}. Selecting the increasing
word #{\xi_1\xi_2} instead would give #{-a}.}

\p{For one independent complex pair and any #{k\in\mathbb C},
##{\ue^{-k\bar\psi\psi}=1-k\bar\psi\psi
 =1+k\psi\bar\psi,\qquad \int\extd\bar\psi\,\extd\psi\;(\ue^{-k\bar\psi\psi})=k.}
Both calculations use only the finite expansion and the ordered
functionals in [the definition](fdip-008F), including when
#{a=0} or #{k=0}.}
