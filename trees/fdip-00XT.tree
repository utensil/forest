\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Lemma}
\title{Compatibility of the full paired functional}
\date{2026-11-17}

\p{The \vocabk{cellular paired anti-reflection}{fdip-00XQ}
is an \vocabk{algebraic anti-reflection}{fdip-00XF}.
Whenever #{Z\ne0}, its normalized functional satisfies
#{\ell(\Theta a)=\overline{\ell(a)}}. Consequently its
reflection form is Hermitian on the strict positive half
and on its even gauge-invariant part.}

\proof{
\p{The generator images are odd, square to zero and
anticommute, so order reversal extends through the exterior
relations. Since the links are fixed and #{\cellref_U} is
real with square #{\bbI_V}, applying the map twice fixes
every generator and coefficient. It fixes the unit.}

\p{Order reversal sends a barred-first quadratic term to
another barred-first term. Its coefficient operator becomes
#{\cellref_U K_U^{\mathsf t}\cellref_U^{\mathsf t}}.
The real symmetry of #{K_U} and \ref{fdip-00XS} identify this
operator with #{K_U}, so #{\Theta_U\theta_{K_U}=\theta_{K_U}}.
The finite exponential is therefore fixed.}

\p{In the cell basis put #{\theta=\sum_c\psi_c\bar\psi_c}.
Orthogonality gives
##{\Theta_U\theta
 =\sum_{a,b,c}(\cellref_U)_{ac}(\cellref_U)_{bc}
             \psi_a\bar\psi_b
 =\theta.}
Thus the paired top generator #{\Omega_V=\theta^4/4!}
is fixed. The map preserves exterior degree, hence
#{\mathcal I_V(\Theta_U a)=\overline{\mathcal I_V(a)}}.
The finite exponential is even and central, so reversing its
order with #{a} changes nothing. Summing the coefficient
identity over the pointwise fixed connection space and
dividing by the real nonzero #{Z} proves compatibility.
The Hermitian assertion is \ref{fdip-00XH}.}
}
