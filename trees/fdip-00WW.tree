\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Proposition}
\title{Exterior invariants give gauge-invariant insertions}
\date{2026-11-17}

\p{If #{\beta\in\bigwedge^sF_x^*} is invariant under
#{G}, its \vocabk{exterior insertion}{fdip-00WU} is a
\vocabk{gauge-invariant family}{fdip-00TU} constant in #{U}.
The insertion map is injective and commutes with scalar
extension to every commutative #{k}-algebra.}

\proof{
\p{The action #{R_g} on the unbarred summand is the
dual of the inverse fiber action, as in
\ref{fdip-00WF}. Functoriality of exterior powers gives
##{R_gP_{\beta,x}
 =P_{\bigwedge^s(\rho(g(x))^{-1})^*\beta,x}.}
Invariance of #{\beta} makes this #{P_{\beta,x}}.
Since the family is constant, this is exactly
#{P_{\beta,x}(U^g)=R_gP_{\beta,x}(U)}.}

\p{Restriction to the dual slot at #{x}, killing every
other slot and the barred summand, retracts
#{\iota_\psi\circ\pr_x^*}. Its exterior power retracts
the insertion map, proving injectivity.
For finite free modules, increasing-index exterior
basis vectors identify scalar extension with the
exterior power after extension; both maps send every
basis word to the same unbarred word. This proves the
base-change assertion.}
}

\p{For the induced action on exterior powers, compare
the component formalization
\leanref/tauceti{Representation.exteriorPower_apply}.
The insertion and gauge-family assertions use the
native argument above.}
