\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Example}
\title{An exact translation creates a nonzero entry}
\date{2026-11-17}

\p{Start with #{R_i(x)=1} and #{a_i(x)=0} on the 4-site
torus. Take the vertex translation #{\xi_{(1,0)}=e_1}, with
#{\xi_x=0} at the other three sites, and take #{S_x=1}
everywhere. The full edge law gives #{R'_i(x)=1} and
#{a'_i(x)=\xi_{x+\varepsilon_i}-\xi_x}. The 8 positive
labeled edge values are
##{\begin{array}{c|rrrr}
x&(0,0)&(1,0)&(0,1)&(1,1)\\\hline
a'_1(x)&e_1&-e_1&0&0\\
a'_2(x)&0&-e_1&0&e_1
\end{array}.}
Period two retains both positive labeled edges in each coordinate
circle; reversing one of these edges is a separate orientation
operation.}

\p{Let #{f} have cubical degree zero, with internal value #{1}
at #{(1,0)} and zero at the other sites. The coefficient on
#{((0,0),1)} is
##{(\edgeop_{a'}^+f)_{\{1\}}(0,0)=c(e_1)(1-0)=e_1.}
By \ref{fdip-00YX}, #{\edgeop_{a'}^- f=0}. Consequently
#{\edgeop_{a'}f\neq0} over both #{\mathbb Z} and #{\mathbb Q}.}
