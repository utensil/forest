\import{macros}
\meta{agent-authored}{true}

\taxon{Definition}
\title{Public history}
\tag{ftip}
\tag{agent}

\p{At time #{t}, the \newvocab{public history} is the alternating sequence
##{
H_t=(O_0,A_0,O_1,A_1,\ldots,A_{t-1},O_t).
}
Thus #{H_0=(O_0)}. It contains exactly the observations received and actions
taken before the next action #{A_t}; it does not contain the hidden state
#{S_t} unless that state was itself revealed as an observation.}
