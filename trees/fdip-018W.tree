\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Example}
\title{A pair of connected lines and an isolated line}
\date{2026-11-26}

\p{Choose an orthonormal triple #{e_1,e_2,e_3}. Let #{A}
act on it by the distinct values #{1,2,3}, and let #{B-\bbI}
exchange #{e_1,e_2} and kill #{e_3}. Both #{A} and #{B} are
positive semidefinite. Interpolation in #{A} places all three
line projections #{p_i} in the algebra generated by #{A,B}.
Then #{p_1Bp_2} sends #{e_2} to #{e_1} and kills the other
two lines. Its adjoint sends #{e_1} to #{e_2}. Every generator
preserves the plane spanned by these two lines and its
orthogonal third line, so no product connects the plane to
the third line. The classes of \ref{fdip-018V} are the pair
#{\{p_1,p_2\}} and the singleton #{\{p_3\}}.}
