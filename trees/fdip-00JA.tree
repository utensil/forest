\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Example}
\title{Wilson mass and the hopping parameter}
\date{2026-11-09}

\p{Direct expansion of the [massive Wilson convention](fdip-00IN), for its convention parameter #{c_W}, gives
##{aK_U=\bigl(am+\tfrac{2c_W n}{a}\bigr)\bbI -\tfrac12\sum_j\Bigl(\bigl(\tfrac{2c_W}{a}-\gamma_j\bigr)T_j^U+\bigl(\tfrac{2c_W}{a}+\gamma_j\bigr)(T_j^U)^{-1}\Bigr).}}

\p{For #{c_W=a/2}, division by #{am+n} gives
##{\begin{aligned}
\frac{aK_U}{am+n}&=\bbI -\kappa\sum_j\bigl((\bbI_S-\gamma_j)T_j^U
 +(\bbI_S+\gamma_j)(T_j^U)^{-1}\bigr),\\
\kappa&=\frac1{2(am+n)}.
\end{aligned}} In #{n=4}, #{m>0} implies #{0<\kappa<1/8<1/6}. This checks the numerical hopping inequality used in the fermionic transfer comparison in \ref{fdip-00JB}; identifying a transfer kernel also requires its spin, gauge, boundary and observable data.}
