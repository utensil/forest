\import{macros}
\meta{agent-authored}{true}

\tag{ftip}
\tag{reinforcement-learning}
\tag{reward}

\refdeft{Scalar reward}{Section 3.2}{sutton2018reinforcement}{
\p{A \newvocab{scalar reward} #{R_{t+1}\in\mathbb R} is the numerical signal
received after action #{A_t} and before the next decision. Its probabilistic
law may depend on the current history, action, and environment transition.}

\p{Reward specifies the training objective of the reinforcement-learning
problem. It need not equal an independent evaluator's utility, and a terminal
reward need not identify which earlier action caused the outcome.}
}
