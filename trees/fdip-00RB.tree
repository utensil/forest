\tag{fdip}
\taxon{Remark}
\title{The induced action}
\date{2026-11-13}

\p{The induced action is #{\cW}. Mathematical physics writes
#{W}, #{S_{\mathrm{eff}}}, or #{\Gamma}. Geometric calculus has
no separate symbol for this normalization. The edge-weight
operator stays #{W}.}
