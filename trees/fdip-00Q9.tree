\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Theorem}
\title{The hyperbolic algebra is the endomorphism ring}
\date{2026-11-12}

\p{Let #{V} be free of finite rank on a basis
#{e_1,\ldots,e_n} over a commutative ring #{k}, and let
#{e^1,\ldots,e^n} be the dual basis of #{V^*}. On
#{V\oplus V^*} define #{q(v+\alpha)=\alpha(v)}. No step
divides by #{2}. Sending a vector to exterior multiplication
and a covector to contraction, in the sense of
\ref{fdip-0092}, induces
##{\operatorname{Cl}(V\oplus V^*,q)
 \cong\operatorname{End}\bigwedge V.}
The products #{(e\wedge)_S\circ(e\cdot)_T} are the basis named
there.}

\proof{
\p{The form #{q} vanishes on #{V} and on #{V^*}. For the basis
operators of \ref{fdip-0092},
#{(e_i\wedge)^2=(e_i\cdot)^2=0} and
#{(e_i\wedge)(e_j\cdot)+(e_j\cdot)(e_i\wedge)=\delta_{ij}\bbI}.
Write #{(v\wedge)} for exterior multiplication by a vector and
#{(\alpha\cdot)} for contraction by a covector. Linearity gives
#{(v\wedge)^2=(\alpha\cdot)^2=0} and
##{(v\wedge)(\alpha\cdot)+(\alpha\cdot)(v\wedge)=\alpha(v)\,\bbI.}
The scalar #{\alpha(v)} is #{B_q(v,\alpha)} in \ref{fdip-000P}.
The universal property supplies a unital homomorphism into the
endomorphism ring.}

\p{Order the generators as
#{e_1,\ldots,e_n,e^1,\ldots,e^n}. The anticommutator of two
generators is a scalar. Reordering a pair replaces their
product by that scalar minus the swapped word. Induction on
length shows that the ordered monomials #{e_S(e^*)_T} span.
The representation sends that ordered product to
#{(e\wedge)_S\circ(e\cdot)_T}, which is #{M_{S,T}}. Those operators
are a basis, so the monomials are independent and the
homomorphism is an isomorphism.}
}
