\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Remark}
\title{The reversed edge}
\date{2026-11-13}

\p{Reversing an edge writes #{\bar e}, and a connection satisfies
#{U_{\bar e}=U_e^{-1}}. Graph theory also writes #{e^{-1}} for
the reverse. The bar marks an involution, as it does for
conjugation; here the involution reverses edges.}
