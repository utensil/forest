\tag{frap}
\title{Dimension and local rotation groups}

\p{The \vocabk{local corner groups}{frap-000Z} of simplices and cubes are
\vocabk{alternating groups}{frap-0010}. Their \vocabk{commutator subgroups}{frap-0010}
determine the information that survives the
\vocabk{total-orientation character}{frap-000S}
\citet{Sections 4--5}{marchetti2025rubik}.}

\transclude{frap-000Z}
\transclude{frap-0010}
\transclude{frap-0011}
