\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Definition}
\title{The overlap index of a connection}
\date{2026-11-26}

\p{Let #{n\ge 1}, #{a>0} and #{N_j\ge 3}. On the periodic grid #{\Lambda}, let
#{S} be a nonzero finite-dimensional Hermitian Clifford module with a
self-adjoint involution #{\Gamma_S} anticommuting with each #{\varepsilon_j^S}.
Let #{F} be a nonzero finite-dimensional complex Hermitian space with a unitary
connection #{U}. Give #{\mathcal H=\ell^2(\Lambda)\otimes S\otimes F} its counting
inner product, and put #{\Gamma=\Gamma_S\otimes\bbI_F} at each site.
Use the \vocabk{unitary shifts}{fdip-009O} on this module and the
\vocabk{Wilson operator}{fdip-009U} with #{c_W=a/2}. The \newvocab{Wilson kernel} of
#{U} is #{K_U=D_{W,a,U}-a^{-1}\bbI}.}

\p{Call #{U} a \newvocab{regular connection} when #{\Gamma K_U} is invertible.
For a regular connection its \newvocab{overlap index} is
#{\operatorname{ind}(U)=\sdim\ker D_{K_U}}, with the overlap operator of
\ref{fdip-014D}. Write #{\nu_+} and #{\nu_-} for the positive and negative
eigenvalue counts of #{\Gamma K_U}, with multiplicity.}
