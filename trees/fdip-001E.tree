\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\title{Enriched backgrounds and comparison}
\date{2026-10-20}

\p{A [groupoid](fdip-000X) records arrows between backgrounds
together with the data those arrows preserve.
[Scalar invariants](fdip-000Y) descend along some arrows without
classifying all backgrounds. [Quadratic isometry](fdip-000Z) can forget
a reference pairing or retained projection even while transporting a
positive Gaussian law.}

\transclude{fdip-000X}
\transclude{fdip-000Y}
\transclude{fdip-000Z}
