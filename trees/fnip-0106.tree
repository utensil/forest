  \begin{scope}
    \draw[->] (0,0) -- (2.6,0) node[right] {$I_{\mathrm{app}}$};
    \draw[->] (0,0) -- (0,2.1) node[above] {$f$};
    \draw[thick] (0.35,0) .. controls (0.35,0.85) and (1.15,1.45) .. (2.3,1.7);
    \node[below] at (1.3,-0.15) {Class I};
  \end{scope}
  \begin{scope}[xshift=3.5cm]
    \draw[->] (0,0) -- (2.6,0) node[right] {$I_{\mathrm{app}}$};
    \draw[->] (0,0) -- (0,2.1) node[above] {$f$};
    \draw[thick] (0.55,0.7) .. controls (1.2,0.85) and (1.7,1.15) .. (2.3,1.7);
    \node[below] at (1.3,-0.15) {Class II};
  \end{scope}
\end{tikzpicture}}

\texfig{\begin{tikzpicture}[line cap=round,font=\small]
  \node at (1.45,1.55) {bistable};
  \node at (4.55,1.55) {monostable};
  \node[anchor=east] at (-0.15,0.45) {resonator};
  \node[anchor=east] at (-0.15,-1.05) {integrator};
  \node[draw,align=center,text width=2.7cm,minimum height=1.15cm] at (1.45,0.45)
    {subcritical Hopf\\Class 2};
  \node[draw,align=center,text width=2.7cm,minimum height=1.15cm] at (4.55,0.45)
    {supercritical Hopf\\Class 2};
  \node[draw,align=center,text width=2.7cm,minimum height=1.15cm] at (1.45,-1.05)
    {saddle-node\\Class 2};
  \node[draw,align=center,text width=2.7cm,minimum height=1.15cm] at (4.55,-1.05)
