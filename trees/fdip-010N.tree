\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Proposition}
\title{The field and an undressed link at distinct endpoints}
\date{2026-11-19}

\p{Use the \vocabk{orbit gauge–Higgs weight}{fdip-010A} over the
commutative unital ring #{k}. The weighted sum of the field at a
vertex #{x} belongs to the \vocabk{invariant submodule}{fdip-00WK}
#{F^G}. In particular it vanishes when #{F^G=0}.}

\p{Let #{\rho} be a representation of #{G} on a #{k}-module #{V}.
On an edge #{e} with distinct endpoints, the weighted sum
#{\mathcal A_\Xi(\rho(U_e))} of the undressed transport #{\rho(U_e)}
is fixed by the two endpoint actions
##{M\longmapsto\rho(a)M\rho(b)^{-1},
        \qquad (a,b)\in G\times G.}
It vanishes if the invariant submodule of this action on
#{\operatorname{End}_k(V)} is zero. In particular #{V^G=0}
suffices. For both observables the same conclusions hold for
normalized means whenever #{Z} is a unit.}

\proof{
\p{Gauges supported at #{x} make field evaluation equivariant with
value module #{F}. Thus \ref{fdip-00WM} gives the first assertion.
At distinct endpoints the gauge values #{a} at the head and #{b} at
the source can be chosen independently. The transformation of
#{U_e} in \ref{fdip-010C} makes the transport equivariant for the
displayed action. Apply the same invariant-sum result. Taking
#{b=1} shows that the image of #{\mathcal A_\Xi(\rho(U_e))} lies in #{V^G}. Division by
the scalar unit #{Z} preserves fixedness.}

\p{If the action on #{F} or #{V} is through a character #{\chi},
\ref{fdip-00WN} gives zero invariants when some #{1-\chi(a)}
acts injectively on that module.
Over a field a nontrivial simple module has zero fixed subspace by
\ref{fdip-00WO}. These arguments use no division by #{|G|}.}
}
