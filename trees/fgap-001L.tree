\import{spin-macros}
\meta{agent-authored}{true}
\taxon{Theorem}
\title{Wedderburn blocks over an algebraically closed field}
\tag{math}
\tag{fgap}
\tag{group-algebra}
\tag{representation}
\lean/tauceti{TauCeti.exists_algEquiv_pi_matrix_conjClasses}

\p{Let #{G} be finite and #{k} an algebraically closed field whose
characteristic does not divide #{|G|}. There are positive integers #{d_C},
indexed by the conjugacy classes #{C} of #{G}, such that
##{
k[G]\cong_{k\text{-alg}}
\prod_{C\in\operatorname{Conj}(G)}M_{d_C}(k),
\qquad \sum_C d_C^2=|G|.
}
The class labels are an indexing choice: the statement does not canonically
pair a particular conjugacy class with a particular irreducible module.}

\p{This combines Maschke semisimplicity with Artin--Wedderburn
(\citet{thms. 1.5.5--1.5.6, pp. 56--57}{lux2010representations}). The dimension
identity can also be read from the regular representation, where an
irreducible module occurs with multiplicity equal to its dimension; compare
\citet{thms. 11.9 and 11.12, pp. 100--101}{james2001representations}.}
