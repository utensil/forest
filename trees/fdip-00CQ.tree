\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Theorem}
\title{Spectral dimensions of a product add}
\date{2026-11-06}

\p{Let #{G} and #{H} be finite undirected graphs without
loops. Their Cartesian product has a vertex #{(v,w)} for
each vertex #{v} of #{G} and each vertex #{w} of #{H}. Two
pairs are adjacent when they agree in one coordinate and
are adjacent in the other. The
\vocabk{spectral dimension}{fdip-00CO} of the product is the
sum of the spectral dimensions of #{G} and of #{H}.}

\proof{
\p{Write #{L_G}, #{L_H} and #{L} for the three combinatorial
Laplacians. A function #{f} on the product satisfies
##{(Lf)(v,w)
=(L_Gf(\cdot,w))(v)+(L_Hf(v,\cdot))(w).}
If #{L_G\varphi=\lambda\varphi} and #{L_H\psi=\mu\psi}, the
product function #{\varphi(v)\psi(w)} is an eigenfunction
of #{L} with eigenvalue #{\lambda+\mu}. Orthonormal
eigenbases of #{G} and of #{H}, for the counting inner
product, multiply to an orthonormal eigenbasis of the
product. Therefore the heat trace factors,
##{Z_{G\times H}(t)=Z_G(t)Z_H(t).}
The logarithmic derivative of a product is the sum of the
logarithmic derivatives, and the factor #{-2} preserves
the sum.}
}
