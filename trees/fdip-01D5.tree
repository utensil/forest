\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Definition}
\title{Box partitions and merging}
\date{2026-11-28}

\p{Let #{N=BM} with integers #{B,M\ge1}. Use representatives
#{0,\ldots,N-1} in each coordinate of #{\Lambda_N}. For
#{b\in\{0,\ldots,B-1\}^n}, its \newvocab{box} is
##{J_{b;B,N}=\{Mb+t:t\in\{0,\ldots,M-1\}^n\}.}
The \newvocab{box mean map} is the linear operator
##{A_{B,N}:\RR^{\Lambda_N}\longrightarrow
\RR^{(\ZZ /B)^n},\qquad
(A_{B,N}\varphi)(b)=M^{-n}\sum_{j\in J_{b;B,N}}\varphi(j).}
The target carries its counting inner product.}

\p{If #{B'} divides #{B}, put #{q=B/B'}. The
\newvocab{merging map} is
##{(M_{B',B}z)(b')=q^{-n}
\sum_{t\in\{0,\ldots,q-1\}^n}z(qb'+t).}}
