\import{macros}
\meta{agent-authored}{true}
\tag{frap}

\refcardt{Definition}{Sections and vertex figures}{Section 2}{schulte2017regular}{
  \p{Let #{P} be an [abstract polytope](frap-000D). For faces #{F\leq G}
  of ranks #{i,j}, its \newvocab{section} #{G/F} is the interval
  #{\{H:F\leq H\leq G\}}, with ranks shifted so that #{F} has rank
  #{-1}. For #{F<G}, it is an abstract polytope of rank
  #{j-i-1\geq0}. For #{F=G}, the singleton section is called the
  rank-#{-1} polytope. These low ranks allow all intervals, including
  vertex figures of polygons and intervals between consecutive faces.}
  \p{The section #{F_n/v} at a vertex #{v} is its \newvocab{vertex figure}.
  Its vertices are the edges through #{v}; its faces record the incidences
  above #{v}. A facet #{H} is viewed as the section #{H/F_{-1}}.}
}
