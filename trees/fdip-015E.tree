\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Example}
\title{Charged species with one zero mode each}
\date{2026-11-26}

\p{Take copies of the complex operator of \ref{fdip-014M}. Its ordinary
kernel is a positive line of index #{1}. For one copy of charge #{1},
the functional is fixed just when #{u^2=1}, so the stabilizer is
#{\{1,-1\}}. Two copies of charges #{1} and #{-1} have opposite
contributions in \ref{fdip-015D}. Their sum is zero and every nonzero
complex number fixes the functional. For two copies both of charge #{1},
the exponent is #{4} and the stabilizer consists of the fourth roots
of unity.}
