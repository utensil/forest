\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Proposition}
\title{A nontrivial simple module has no invariant vectors}
\date{2026-11-17}
\lean/tauceti{Representation.IsIrreducible.invariants_eq_bot}
\p{Let #{k} be a field, let #{H} be any group, and let
#{E} be a nonzero simple #{k[H]}-module whose action is
not trivial. Then #{E^H=0}.}

\proof{
\p{If #{0\ne v\in E^H}, its line #{kv} is a nonzero
submodule on which every group element acts identically.
Simplicity forces #{E=kv}; the entire action is then
trivial, contrary to the hypothesis. Therefore no such
#{v} exists. No group-order assumption occurs.}
}

\p{By \ref{fdip-00WM}, every invariant average with
values in #{E} therefore vanishes whenever the finite
functional producing it is defined.}
