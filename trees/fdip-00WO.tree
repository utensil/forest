\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Proposition}
\title{A nontrivial simple module has no invariant vectors}
\date{2026-11-17}
\lean/tauceti{Representation.IsIrreducible.invariants_eq_bot}
\p{Let #{k} be a field, let #{H} be any group, and let
#{E} be a nonzero simple #{k[H]}-module whose action is
not trivial. Then #{E^H=0}.}

\proof{
\p{If #{0\ne v\in E^H}, then #{kv} is a nonzero
trivial submodule. Simplicity forces #{E=kv},
contradicting the nontrivial action.
No group-order assumption is needed.}
}

\p{Thus every finite invariant average valued in #{E}
vanishes by \ref{fdip-00WM}.}
