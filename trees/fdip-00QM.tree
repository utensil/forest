\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Remark}
\title{Two comparisons beside the direction algebras}
\date{2026-11-12}

\p{The quotient of the quaternion group algebra by the relation
#{u_{-1}=-1} is the case #{q_i=-1} of \ref{fdip-00QH} in rank
#{2}. \citet{the faithful part of the group of order 8}{wilson2023generalised}
calls that quotient the faithful part of the real group algebra.
The binary tetrahedral group has order #{24}. In #{k[2T]}, when
#{2} is a unit, multiplication by the central idempotent
#{(1-u_z)/2} realizes the quotient by the ideal #{(u_z+1)} on a
free module of rank #{12}. That post calls this quotient the
faithful part and states that its dimension is #{12}. By
\ref{fdip-00QB} that rank lies outside the ranks of Clifford
algebras of finite free modules. No physical assignment is read
from either algebra.}

\p{Clifford algebras of forms of degree #{3} and higher are in
general of infinite rank. That sentence is the abstract of
P. Revoy, Advances in Applied Clifford Algebras #{24} (2014),
pp. 205-212. No theorem number is used, and no rank beyond that
sentence is stated.}
