\import{macros}
\meta{agent-authored}{true}

\taxon{Definition}
\title{Attempt-local replay annotation}
\tag{ftip}
\tag{replay}

\p{Selecting #{R\in\mathcal R_n} under a current policy stamp #{\nu_n}
produces an \strong{attempt-local replay annotation}}

##{a_n(R)=(\nu_n,\rho,\kappa,m,u),}

\p{where #{\rho} is the declared collection of behavior/current likelihood
ratios, #{\kappa} records clipping status, #{m} is the record age, and #{u} is
its prior reuse count. Every component is computed for this attempt and may
change at the next one.}
