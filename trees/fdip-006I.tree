\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Example}
\title{A normalized complex holonomy action on the circle}
\date{2026-11-01}

\p{Use the [supplied unit-circle mesh](fdip-004H), now with complex
fields and total holonomy #{e^{i\theta}}. On #{\mathbb C^n}, take
##{\langle z,w\rangle_n=\frac1n\sum_j\overline{z_j}w_j,
\qquad Q_{n,\theta}=n^2L_\theta+\mu I,\qquad\mu>0.}
Here #{L_\theta} is the unit-weight [twisted cycle](fdip-006G),
#{n\ge3}, and the same factor #{n^2} fixes the circle length scale.
Let #{d\operatorname{vol}_n} be the real volume induced by this
Hermitian pairing. If #{z_j=x_j+iy_j}, then
##{d\operatorname{vol}_n=n^{-n}\prod_jdx_j\,dy_j.}
Indeed #{z\mapsto z/\sqrt n} is an orthonormal coordinate change
in complex dimension #{n}, hence real dimension #{2n}.}

\p{Choose the complex Gaussian convention
##{\begin{aligned}
Z_n(\theta)&=\pi^{-n}\int_{\mathbb C^n}
 e^{-\langle z,Q_{n,\theta}z\rangle_n}
 \,d\operatorname{vol}_n(z),\\
\cW_n(\theta)&=-\log Z_n(\theta).
\end{aligned}}
Unitary diagonalization gives one factor per eigenvalue #{\lambda>0}.
Polar coordinates evaluate it:
##{\begin{aligned}
\pi^{-1}\int_{\mathbb R^2}e^{-\lambda(x^2+y^2)}dx\,dy
 &=2\int_0^\infty e^{-\lambda r^2}r\,dr\\
 &=\lambda^{-1}.
\end{aligned}}
Therefore
##{Z_n(\theta)=(\det_{\mathbb C}Q_{n,\theta})^{-1},
\qquad \cW_n(\theta)=\log\det_{\mathbb C}Q_{n,\theta}.}
This complex convention has no factor #{1/2} in the determinant action;
the earlier [real Gaussian action](fdip-005R) uses a different exponent
and real field dimension.}

\p{Since #{Q_{n,\theta}=n^2(L_\theta+\mu n^{-2}I)}, define the
explicitly subtracted finite action by
##{\widetilde \cW_n(\theta)=\cW_n(\theta)-2n\log n.}
The cycle determinant gives
##{\begin{aligned}
\widetilde \cW_n(\theta)
 &=\log(2\cosh(n\omega_n)-2\cos\theta),\\
2\cosh\omega_n&=2+\mu /n^2,\qquad\omega_n\ge0.
\end{aligned}}
Thus the removed term is independent of holonomy; it is part of the
stated normalization, not a finite determinant omitted from the formula.}

\p{The identity #{\cosh\omega-1=2\sinh^2(\omega /2)} gives
#{\omega_n=2\operatorname{arsinh}(\sqrt{\mu}/(2n))}.
For #{t>0}, integrate the derivative
#{(\operatorname{arsinh}t)'=(1+t^2)^{-1/2}} to obtain
##{\frac1{\sqrt{1+t^2}}
\le\frac{\operatorname{arsinh}t}{t}\le1.}
Consequently #{n\omega_n\to\sqrt\mu}. The positive limiting
argument of the logarithm is at least #{2\cosh\sqrt\mu-2>0}, so
##{\widetilde \cW_n(\theta)\longrightarrow
\cW(\theta)=\log(2\cosh\sqrt\mu-2\cos\theta).}
This is a direct limit of the normalized finite determinants, beyond
the separate [fixed-mode comparison](fdip-004J); no interchange of an
infinite product is used.}

\p{For #{\mu>0}, #{\cW(\theta)} is minimized exactly at trivial
holonomy #{\theta=0} modulo #{2\pi}, since #{\cos\theta\le1}.
Equivalently the integrated matter factor #{e^{-\cW}} is largest there.
At #{\mu=0} and nontrivial holonomy the same finite calculation gives
#{\cW(\theta)=\log(2-2\cos\theta)}. At trivial holonomy there is a
zero mode: the unpinned Gaussian integral diverges and this determinant
action is undefined. Its formal logarithm of zero is not a normalized
Gaussian action. The circle, its scale and the connection remain
supplied data.}
