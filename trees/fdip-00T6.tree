\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Example}
\title{The two edge conventions differ by its link}
\date{2026-11-17}

\p{For a sign link #{U_i(x)=-1} over #{\mathbb Z}, take
#{f(x)=2} and #{f(x+\varepsilon_i)=5}. The
[based difference](fdip-00SH) has value #{-5-2=-7} at
#{x}. Multiplication by the forward link gives #{7} at the
head, which is also #{5-(-1)2}. These are the same edge
comparison expressed in its two coefficient fibers.}
