\import{macros}
\meta{agent-authored}{true}

\taxon{Definition}
\title{Finite probability law}
\tag{ftip}
\tag{probability}

\p{Using the notation of \ref{ftip-000A}, a \newvocab{finite probability law}
on #{X} is an element #{p\in\Delta(X)}. For an event #{A\subseteq X}, its
probability is
##{
p(A)=\sum_{x\in A}p(x).
}
For #{p(A)>0}, the conditional law on #{B\subseteq X} is
#{p(B\mid A)=p(A\cap B)/p(A)}.}
