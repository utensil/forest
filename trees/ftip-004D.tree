\import{macros}
\meta{agent-authored}{true}

\tag{ftip}
\tag{grpo}
\tag{advantage}

\refdeft{Group-relative advantage}{Section 4.1.2}{shao2024deepseekmath}{
\p{When #{S_R>0}, the \newvocab{group-relative advantage} of rollout member
#{i} is}

##{
 \widehat A_i=\frac{R_i-\bar R}{S_R}.
}

\p{The estimator compares responses sampled for the same prompt and does not
require a learned value function. Its members are statistically coupled through
#{\bar R} and #{S_R}; it is not an independent estimate of the population
advantage of each response.}
}
