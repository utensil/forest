\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Proposition}
\title{A nonzero translation is not a linear fiber action}
\date{2026-11-17}

\p{If #{\xi\neq0} in #{V}, the map #{v\mapsto v+\xi} is
not #{k}-linear. With #{R_i(x)=S_x=1}, the affine edge law of
the \vocabk{rotational cochains}{fdip-00YN} becomes
##{a'_i(x)=a_i(x)+\xi_{x+\varepsilon_i}-\xi_x.}
This changes the translation labels on the fixed cells; the law
specifies no permutation of the finite site set.}

\proof{
\p{A linear map sends #{0} to #{0}, whereas the displayed
translation sends #{0} to #{\xi}. For the edge formula,
#{\rho(1)=\bbI_V} and #{R'_i(x)=1}; substitution gives the
claimed difference. Source and head are the same labeled vertices
on both sides of that formula.}
}
