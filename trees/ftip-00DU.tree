\import{macros}
\meta{agent-authored}{true}

\taxon{Definition}
\title{Retained-context evaluation protocol}
\tag{ftip}
\tag{evaluation}

\p{A retained-context evaluation protocol fixes a model #{M}, prompt law
#{\mu}, decoder #{\pi}, budget #{T}, evaluator #{\mathsf E}, and two policies
#{\kappa_1,\kappa_2}. It reports the paired outcomes under the same sampled
prompts and declared randomization coupling, together with exposure counts from
\ref{ftip-00DJ}.}
