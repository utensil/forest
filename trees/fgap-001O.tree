\import{spin-macros}
\meta{agent-authored}{true}
\taxon{Definition}
\title{conjugate constituents and the inertia subgroup}
\tag{math}
\tag{fgap}
\tag{representation}

\p{Let #{N\trianglelefteq G}, let #{V} be a #{G}-representation, and let
#{W\subseteq V|_N} be an irreducible #{N}-subrepresentation. For #{g\in G},
the \newvocab{conjugate representation} #{,{}^gW} has the same vector space
and action
##{
n\cdot_g w=(g^{-1}ng)\cdot w.
}
The \newvocab{inertia subgroup} of #{W} is
##{
I_G(W)=\{g\in G:{}^gW\cong W\}.
}
The isomorphism classes of conjugates form a #{G}-orbit, with stabilizer
#{I_G(W)}. See \citet{sec. 3.6, pp. 222--225}{lux2010representations}.}
