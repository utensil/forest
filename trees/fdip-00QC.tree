\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Proposition}
\title{The derived form and the twisted form}
\date{2026-11-12}

\p{At a vertex where the form #{B_x} of \ref{fdip-00PB} is
defined, its graph embeds #{\operatorname{Cl}(V,q_x)} into the
hyperbolic algebra of \ref{fdip-00Q9}. At a vertex where the
twisted form of \ref{fdip-00Q1} is defined, the bilinear form
#{(v,w)\mapsto B_x(v,\theta w)} determines a second graph in
the same algebra, and the restricted quadratic form is
#{q^\theta}.}

\proof{
\p{Both graphs are instances of \ref{fdip-00QA}, and each
homomorphism is injective by \ref{fdip-00QB}. For the second,
the value of the hyperbolic form on #{v+B_x(v,\theta\cdot)} is
#{B_x(v,\theta v)}, which is the definition of #{q^\theta}.}
}
