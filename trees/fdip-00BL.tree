\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Definition}
\title{Block averages on the circle mesh}
\date{2026-11-06}

\p{Fix integers #{B\ge 1} and #{M\ge 1}, and set #{n=BM}. Let
#{\mu>0}, and let #{f} be a centered Gaussian field on the
\vocabk{circle mesh}{fdip-004H} of #{n} vertices with raw coordinate covariance
#{nQ_n^{-1}}, as in \ref{fdip-004I}. For
#{b=0,\ldots,B-1}, the \newvocab{block average} #{A_b} is
the mean of the #{M} coordinates whose vertices lie in the
half-open interval from #{b/B} to #{(b+1)/B}. The
block-mean law at level #{B} is the joint law of
#{(A_0,\ldots,A_{B-1})}.}
