\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Definition}
\title{Block averages on the circle mesh}
\date{2026-11-06}

\p{Fix integers #{B\ge 1} and #{M\ge 1} such that #{n=BM\ge 3}.
This is the admissibility condition imposed by the
\vocabk{circle mesh}{fdip-004H}. It allows #{B=1} with
#{M\ge 3} and #{B=2} with #{M\ge 2}, and it allows every
larger admissible #{M}, including the families with #{B} fixed
and #{M\to\infty}. No extension to #{n=1} or #{n=2} is
asserted. Let #{\mu>0}, and let #{f} be a centered
Gaussian field on the canonical site function space
#{E_n=\mathbb R^{\mathbb Z/n\mathbb Z}} of that mesh. The
normalized-pairing covariance, relative to #{g_{0,n}} in
\ref{fdip-004H}, is #{Q_n^{-1}}. The counting covariance is
#{nQ_n^{-1}}, the raw coordinate covariance of
\ref{fdip-004I}; the factor #{n} distinguishes the two. For
#{b=0,\ldots,B-1}, the \newvocab{block average} #{A_b} is
the mean, with factor #{\frac{1}{M}}, of the values of #{f}
at the #{M} sites in the half-open interval from #{b/B} to
#{(b+1)/B}. The block-mean law at level #{B} is the joint law
of #{(A_0,\ldots,A_{B-1})}.}
