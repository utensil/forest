\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Proposition}
\title{Normalization and the two levels of coefficients}
\date{2026-11-17}

\p{For the \vocabk{coupled finite coefficient functional}{fdip-00TU},
suppose #{Z} and every #{\det K_U} are units. Put
##{\begin{aligned}
 \omega_U(P_U)&=(\det K_U)^{-1}
   \mathcal I_{\mathcal V}\bigl(P_U\extexp(\theta_{K_U})\bigr),\\
 \nu(U)&=Z^{-1}w(U)\det K_U.
\end{aligned}}
Then #{\omega_U(1)=1}, #{\sum_U\nu(U)=1}, and
##{\langle P\rangle=\sum_U\nu(U)\omega_U(P_U).}
In particular, the normalized unbarred-first two-point
coefficient at fixed #{U} is #{K_U^{-1}}.}

\p{A probability law on connections additionally requires a
declared real interpretation #{b_U} of the weights
#{w(U)\det K_U}, with #{b_U\ge0} and
#{Z_{\mathbb R}=\sum_Ub_U>0}. It is then
#{\nu_{\mathbb R}(U)=b_U/Z_{\mathbb R}}. This real law by
itself neither supplies an inverse singular kernel nor implies
#{Z\in k^\times}. Uniform averaging over the gauge group
#{\mathcal G=G^X} separately requires
#{|\mathcal G|=|G|^{|X|}} to be a unit in #{k}.}

\proof{
\p{The determinant formula \ref{fdip-00TL} gives both unit
normalizations. Substituting the displayed definitions and
cancelling #{\det K_U} proves the finite
sum identity term by term. The insertion statement follows
from \ref{fdip-00TQ} and
#{\adjugate K_U=(\det K_U)K_U^{-1}}.
Nonnegative real weights with positive sum satisfy the
probability axioms by finite addition. A uniform gauge average
has the separate scalar factor #{|\mathcal G|^{-1}}.}
}
