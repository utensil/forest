\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Proposition}
\title{A positive real kernel at sufficiently large mass}
\date{2026-11-19}

\p{Assume the fermion fibre has a positive real invariant inner
product and each #{Y(\phi_x)} is self-adjoint. For the induced
cochain inner product, if
##{m>2n+\|Y_\phi\|,}
then #{K_{U,\phi}} is positive definite and #{\det K_{U,\phi}>0}.
If this bound holds on all backgrounds and the bosonic weights
are nonnegative with at least one positive, their
determinant-weighted sum gives a probability law after normalization.}

\proof{
\p{The onsite operator is self-adjoint on the orthogonal
site and exterior slots. The primary cochain operator is
self-adjoint by \ref{fdip-00SS} and has norm at most #{2n}
by \ref{fdip-00U7}. For every cochain #{v},
##{\langle v,K_{U,\phi}v\rangle
 \ge (m-2n-\|Y_\phi\|)\|v\|^2.}
The right side is positive for nonzero #{v}. The finite
self-adjoint kernel has positive eigenvalues, hence positive
determinant, with empty product one at rank zero. Its
multiplication preserves the signs of the bosonic weights, so
the finite sum is positive and the normalized weights sum to one.}
}

\p{The lower bound makes the kernel a positive operator with
trivial nullspace. Positivity of its determinant under these two
hypotheses is formalized by \leanref/tauceti{LinearMap.IsPositive.det_pos}.}
