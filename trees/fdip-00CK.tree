\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Example}
\title{A cycle on 4 vertices}
\date{2026-11-06}

\p{Take the directed cycle with #{N=4} vertices, labeled
#{0,1,2,3}. \ref{fdip-0096} gives edge-counts #{1} between
neighbors and #{2} between opposite vertices. Dividing by
#{4} yields the distances #{1/4} and #{1/2}. The points
#{0}, #{1/4}, #{1/2} and #{3/4} realize the same arc
lengths on the circle of length #{1}.}

\p{Each open arc between consecutive points has length
#{1/4}. Its midpoint lies at distance #{1/8} from the
nearer endpoint, and every other point of the circle is at
most that far from the set. The
[Hausdorff distance](fdip-00CJ) between these 4 points and
the circle is #{1/8}. The
[Gromov–Hausdorff distance](fdip-00CJ) is therefore at most
#{1/8}.}
