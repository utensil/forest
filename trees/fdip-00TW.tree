\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Theorem}
\title{Gauge invariance of the coupled coefficient}
\date{2026-11-17}

\p{The \vocabk{coupled finite coefficient functional}{fdip-00TU}
satisfies #{\Phi(gP)=\Phi(P)} for every gauge transformation.
Its partition coefficient is gauge invariant, and its
normalized coefficient has the same invariance whenever
#{Z} is a unit.}

\proof{
\p{For any automorphism #{h} of a finite free module, the map
#{(h^{-1})^*\oplus h} preserves the canonical coevaluation.
On the kernel tensor it gives
##{R_h\theta_K=\theta_{hKh^{-1}},\qquad
 R_h\theta_{\bbI}=\theta_{\bbI}.}
By \ref{fdip-00TH}, it fixes #{\Omega} and carries
#{\extexp(\theta_K)} to #{\extexp(\theta_{hKh^{-1}})}.
It preserves exterior degree, so #{\mathcal I\circ R_h=\mathcal I}.
Thus the fixed-background coefficient at #{U^g} of
#{R_gP_U} equals the coefficient at #{U} of #{P_U}.}

\p{The map #{U\mapsto U^g} is a permutation of the finite
configuration set, and #{w(U^g)=w(U)}. Reindexing the finite
sum proves the result. Division by the common unit #{Z}
preserves the equality when that division is defined. No
division by a group order occurs in this proof.}
}
