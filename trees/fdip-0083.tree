\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Theorem}
\title{Gauge projection and periodic-time traces}
\date{2026-11-01}

\p{For a finite truncation #{k_F} of
\vocabk{Spatial link fields and their transfer kernel}{fdip-007Z},
with #{F} nonempty and closed
under dual representations, let #{b} and #{T_F} be the
half-weight and truncated transfer operator of that definition.
For bounded Borel #{f:X\to\mathbb C}, the gauge average is
##{(Pf)(U)=\int_K f(h^{-1}\cdot U)\,dh.}
The matrix coefficients of representations in #{F}, one factor
on each edge, are a finite set #{\mathcal I_F}. For
#{f} bounded and Borel,
##{(T_Ff)(U)=\sum_{I\in\mathcal I_F}\alpha_I
 b(U)\phi_I(U)\int_X b\overline{\phi_I}f\,dU,
 \qquad \alpha_I=\prod_{e\in E_s}a_{\rho_e}>0,}
and #{\sum_{I\in\mathcal I_F}\alpha_I=\kappa_F^{|E_s|}}.
This is a finite sum of integrals. The gauge average preserves
the span of these coefficients. The operator #{S_F}, given by
#{P}, then #{T_F}, then #{P}, has finite rank. Its trace is the
matrix trace on the span of the functions #{P(b\phi_I)}.}

\p{For every integer #{N\ge1}, put #{U_N=U_0} and take
independent variables #{U_j\in X} and #{h_j\in K} for
#{0\le j<N}. Define
##{\begin{aligned}
B_{j,e}&=U_{j,e}h_{j,s(e)}U_{j+1,e}^{-1}h_{j,t(e)}^{-1},\\
\mathcal W_N(F)
 &=\prod_{j=0}^{N-1}e^{-V(U_j)}
 \prod_{j=0}^{N-1}\prod_{e\in E_s}k_F(B_{j,e}).
\end{aligned}}
With normalized product Haar measures,
##{Z_N(F)=\int_{X^N\times K^N}\mathcal W_N(F)\,dU\,dh
 =\operatorname{Tr}(S_F^N).}
This is a finite identity. If #{|E_s|\ge1}, then for every finite
#{F'} properly containing #{F}, with the same dual closure and
##{M=N|E_s|,\qquad
 \varepsilon_{F',F}=\kappa_{F'}-\kappa_F,}
the truncations satisfy
##{|Z_N(F')-Z_N(F)|
 \le\|b\|_\infty^{2N}M\kappa_{F'}^{M-1}\varepsilon_{F',F}.}
If #{E_s} is empty, the kernel product is #{1} and
#{Z_N(F)} does not depend on #{F}.}

\p{For independent gauge changes #{g_j\in K}, with #{g_N=g_0},
the transformations are
##{\begin{aligned}
U_j&\longmapsto g_j\cdot U_j,\\
h_{j,v}&\longmapsto g_{j,v}h_{j,v}g_{j+1,v}^{-1}.
\end{aligned}}
Each #{B_{j,e}} is conjugated by #{g_{j,t(e)}}. Therefore the
truncated weight and the measure are invariant. If
#{f_j:X\to\mathbb C} are bounded measurable gauge-invariant
functions and #{Z_N(F)\ne0}, multiplication by #{f_j} preserves
the gauge-invariant bounded functions, and
##{\mathbb E_N\prod_{j=0}^{N-1}f_j(U_j)
 =\frac{1}{Z_N(F)}
 \int_{X^N\times K^N}
 \prod_{j=0}^{N-1}f_j(U_j)\,\mathcal W_N(F)\,dU\,dh.}
This is a finite periodic-time identity for the specified spatial
observables, with the temporal links integrated as above. For
#{N=1,2}, the formula retains the indexed temporal steps; it
does not identify them with edges of an ordinary simple cycle.}

\proof{
\p{The one-edge identity
##{k_F(UU'^{-1})=\sum_{\rho\in F}\sum_{i,j}
 a_\rho\phi_{\rho ij}(U)\overline{\phi_{\rho ij}(U')}}
is a finite sum: #{\phi_{\rho ij}=\sqrt{d_\rho}\rho(\cdot)_{ij}}
and the matrix-entry sum equals #{d_\rho\chi_\rho(UU'^{-1})}.
The tensor product over the finitely many edges is the displayed
finite sum, and summing #{\alpha_I} factors as
#{\kappa_F^{|E_s|}}. Conjugation by a vertex gauge element stays
inside the matrix coefficients of the same representation, so
#{P} preserves their span.}

\p{Averaging the first variable of the kernel of #{T_F} gives
the bounded Borel kernel of #{S_F}:
##{L_F(U,U')=b(U)b(U')\int_K
 \prod_e k_F(U_eh_{s(e)}U_e'^{-1}h_{t(e)}^{-1})\,dh.}
Centrality moves #{h_{t(e)}^{-1}} from the front of each kernel
argument to its end. The integral pairing
#{\int_X\overline f g\,dU} makes #{P} symmetric on bounded
functions, so #{S_F} expands as the finite sum with vectors
#{P(b\phi_I)}. Because the sum over #{\mathcal I_F} is finite,
the matrix trace is the corresponding finite diagonal sum
##{\operatorname{Tr}S_F
 =\sum_{I\in\mathcal I_F}\alpha_I\int_X|P(b\phi_I)|^2\,dU
 =\int_XL_F(U,U)\,dU.}
For #{N\ge2} the same finite sum, iterated along a cycle of
length #{N}, equals both #{\operatorname{Tr}(S_F^N)} and the
integral of #{\prod_j L_F(U_j,U_{j+1})}. Expanding each
#{L_F} with an independent #{h_j} produces
#{\mathcal W_N(F)}, because the two adjacent factors
#{b(U_j)} combine to #{e^{-V(U_j)}}. Taking every test
function equal to #{1} proves the partition identity.}

\p{For the truncation bound, #{|k_F|\le\kappa_F\le\kappa_{F'}}
and #{|k_{F'}-k_F|\le\varepsilon_{F',F}}. The weight
#{\mathcal W_N} contains #{M} kernel factors and a potential
factor at most #{\|b\|_\infty^{2N}}. Telescoping the product of
#{M} bounded factors gives the displayed majorant. Normalized
Haar measure is a probability, so the integrals obey the same
bound. If #{E_s} is empty there are no kernel factors.}

\p{The gauge transformation conjugates #{B_{j,e}} by direct
cancellation, which proves the invariance assertion. A
gauge-invariant bounded function factors out of the #{h_j}
integrals, and the ratio of integrals is the displayed
expectation.}
}

\texfig{\begin{tikzpicture}[
  flow/.style={-{Stealth[length=2mm]},semithick},
  site/.style={circle,draw,fill=white,minimum size=3mm,inner sep=0pt},
  font=\small]
\node[site,label=above left:{$(j,s)$}] (a) at (0,2) {};
\node[site,label=above right:{$(j,t)$}] (b) at (4,2) {};
\node[site,label=below left:{$(j+1,s)$}] (c) at (0,0) {};
\node[site,label=below right:{$(j+1,t)$}] (d) at (4,0) {};
\draw[flow] (a) -- node[above=3pt] {$U_{j,e}$} (b);
\draw[flow] (c) -- node[below=3pt] {$U_{j+1,e}$} (d);
\draw[flow] (c) -- node[left=3pt] {$h_{j,s}$} (a);
\draw[flow] (d) -- node[right=3pt] {$h_{j,t}$} (b);
\end{tikzpicture}}

\p{The temporal plaquette based at #{(j,t)} is traversed down
the right edge, backwards along the bottom, up the left edge and
then along the top. With the [transport order](fdip-006N), the
first transport acts on the right and the product is exactly
#{B_{j,e}}. Temporal averaging is retained at every step, so no
periodic gauge-fixing assumption removes #{P}.}

\p{Remark. Continuum comparison. The convergent series and the
#{L^2} setting are not the statement above. On the
\vocabk{link Hilbert space}{fdip-007Z}, normalized gauge
averaging is the orthogonal projection onto
##{\mathcal H_{\mathrm{phys}}
 =\{f:R_hf=f\text{ for every }h\in K\}
 =P\mathcal H_{\mathrm{link}},}
the \newvocab{physical Hilbert space}. For a kernel #{k} in the continuum comparison of
[Spatial link fields and their transfer kernel](fdip-007Z),
the restriction
#{T_{\mathrm{phys}}} is positive, injective and trace class, and
##{Z_N=\operatorname{Tr}_{\mathrm{phys}}T_{\mathrm{phys}}^N
 =\operatorname{Tr}_{\mathrm{link}}(PT^N)>0.}
The rank-one expansion of \ref{fdip-0080} writes this operator
as a series over all representation blocks. Its kernel expansion
converges uniformly on finite sets of blocks, and the tail is the
corresponding tail of #{\sum_I\alpha_I=\kappa^{|E_s|}}. The
Hilbert–Schmidt trace identity of \ref{fdip-007V} identifies the
untruncated periodic trace with the lattice integral of the
untruncated weight. The finite identities above are the partial
sums of that comparison.}
