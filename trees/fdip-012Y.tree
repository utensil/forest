\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Example}
\title{The witness block under the spectral hypothesis}
\date{2026-11-21}

\p{The rescaled witness matrix of \ref{fdip-012U} is symmetric
and entrywise positive. Assume the Rayleigh hypothesis of
\ref{fdip-011X}, as \ref{fdip-011Y} records it for a real
symmetric matrix. Then the largest eigenvalue is simple, it is
at least the absolute value of every other eigenvalue, it has
an entrywise positive eigenvector, and every other absolute
value is strictly smaller.}

\proof{
\p{Entrywise positivity gives a connected support graph, and the
first power of the matrix is entrywise positive.
\ref{fdip-011X} supplies the #{4} conclusions from the Rayleigh
hypothesis. The hypothesis is not proved in this example.}
}
