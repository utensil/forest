\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Example}
\title{The first scaled refinement}
\date{2026-11-06}

\p{Every edge of #{H_1} has weight #{\frac{5}{3}}. Multiplying
the factor #{\frac{3}{5}} of \ref{fdip-00DS} by this weight
produces #{1}, the edge weight of #{H_0}. Thus
\ref{fdip-00DT} matches #{H_1}, read on the three vertices of
#{V_0}, with #{H_0}.}
