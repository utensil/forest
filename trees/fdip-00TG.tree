\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Example}
\title{Two pairs in characteristic two}
\date{2026-11-17}

\p{Over #{\mathbb F_2}, take the exterior algebra on
#{\psi_1,\bar\psi_1,\psi_2,\bar\psi_2} and put
#{a=\psi_1\bar\psi_1+\psi_2\bar\psi_2}. Then
##{\begin{aligned}
 a^2&=0,\\
 \extexp(a)&=1+a+\psi_1\bar\psi_1\psi_2\bar\psi_2,\\
 \divcoef{a}{2}&=\psi_1\bar\psi_1\psi_2\bar\psi_2\ne0.
\end{aligned}}
The last term is selected by choosing the nonconstant term in
each of the two factors defining the
[finite exterior exponential](fdip-00TF). The square #{a^2}
counts each choice twice and loses it in this field.}
