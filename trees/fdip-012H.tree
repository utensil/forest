\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Example}
\title{The sign edge}
\date{2026-11-21}

\p{Let #{G=\{1,-1\}} and let #{G^\circ} be trivial, so the two
group elements are the two double cosets. Take the double-coset
kernel #{B(1)=2}, #{B(-1)=1}, and the class-function kernel
#{\mathcal K(1)=2}, #{\mathcal K(-1)=1}. In the basis of
indicators of #{1} and #{-1}, the one-edge operator of
\ref{fdip-012C} has matrix
##{\begin{pmatrix}8&2\\2&2\end{pmatrix}.}
Its characteristic polynomial is #{t^2-10t+12}.}

\proof{
\p{The matrix entry from #{h} to #{g} is
#{B(g)\mathcal K(gh^{-1})B(h)}. The #{4} entries are
##{B(1)\mathcal K(1)B(1)=8,\qquad
 B(1)\mathcal K(-1)B(-1)=2,}
and
##{B(-1)\mathcal K(-1)B(1)=2,\qquad
 B(-1)\mathcal K(1)B(-1)=2.}
The characteristic polynomial is
#{(t-8)(t-2)-4=t^2-10t+12}.}
}
