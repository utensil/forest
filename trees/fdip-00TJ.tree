\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Definition}
\title{The ring paired coefficient}
\date{2026-11-17}

\p{Let #{V} be a finite free #{k}-module of rank #{N}. Form
#{\mathcal A(V)=\Lambda_k(V^*\oplus V)}, with the dual summand
first and all generators odd. Its two inclusions are denoted by
#{\iota_\psi} and #{\iota_{\bar\psi}}. Let #{\theta} be the
wedge image of the canonical coevaluation in #{V^*\otimes V},
and put #{\Omega_V=\divcoef{\theta}{N}} using the
\vocabk{divided coefficients}{fdip-00TF}. The
\newvocab{ring paired coefficient} is the #{k}-linear map
#{\mathcal I_V:\mathcal A(V)\to k} that vanishes below
degree #{2N} and sends #{c\Omega_V} to #{c}. Its top-generator
property is proved in \ref{fdip-00TL}. At rank zero,
#{\mathcal I_0=\bbI_k}.}

\p{The two coevaluation tensors give a universal odd vector
#{\psi\in V\otimes_k\mathcal A(V)} and a universal odd
covector #{\bar\psi\in V^*\otimes_k\mathcal A(V)}.
Bars are labels. For #{K\in\operatorname{End}_k(V)}, set
##{\theta_K=-\bar\psi(K\psi).}
The barred coefficient is multiplied first in the displayed
contraction. Equivalently, #{\theta_K} is the wedge image of
#{(\bbI\otimes K)\operatorname{coev}_V}. For dual bases
#{e_i,e^i}, write #{\psi_i=\iota_\psi(e^i)} and
#{\bar\psi_i=\iota_{\bar\psi}(e_i)}. Thus
##{\theta_K=-\sum_{i,j}\bar\psi_iK_{ij}\psi_j,
 \qquad Ke_j=\sum_i K_{ij}e_i.}}
