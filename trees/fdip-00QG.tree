\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Definition}
\title{A twisted group algebra}
\date{2026-11-12}

\p{Let #{G} be a finite group and let #{k} be a commutative unital
ring. A #{2}-cocycle is a function #{F} from #{G\times G} to the
unit group of #{k} with #{F(1,g)=F(g,1)=1} and
##{F(x,y)\,F(xy,z)=F(y,z)\,F(x,yz).}
The \newvocab{twisted group algebra} #{k_F[G]} is the free
#{k}-module on symbols #{u_g}, one for each group element, with
##{u_x u_y=F(x,y)\,u_{xy}}
and with unit #{u_1}.}
