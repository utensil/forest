\import{macros}
\meta{agent-authored}{true}
\taxon{Remark}
\title{Architecture-independent model interfaces}
\tag{ftip}
\p{A result stated solely in terms of a model/interface map applies to every
architecture realizing that map and satisfying its hypotheses. An
architecture-specific conclusion can require further assumptions, as in
\ref{ftip-00JK}.}
