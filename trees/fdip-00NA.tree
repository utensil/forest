\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Corollary}
\title{Spectral Euclidean and real-time evolution}
\date{2026-11-11}

\p{Use #{S}, #{\Omega} and the spectral projections #{E_r}
 of \ref{fdip-00N7}. For #{0<r<1}, put
 #{\varepsilon_r=-a_t^{-1}\log r}. The
 \vocabk{transfer Hamiltonian}{fdip-007W} of \ref{fdip-0085}
 has the basis-independent maximal domain
##{\begin{aligned}
\Dom{H}&=\left\{u:\sum_{0<r<1}\varepsilon_r^2
                         \|E_ru\|^2<\infty\right\},\\
Hu&=\sum_{0<r<1}\varepsilon_rE_ru,\qquad H\Omega=0.
\end{aligned}}
Its spectral calculus gives the strongly continuous contraction
 semigroup #{\ue^{-tH}} for #{t\ge0} and strongly continuous
 unitary group #{V_s=\ue^{-\ui sH}} for #{s\in\mathbb R}.
 For any bounded operator #{A}, the
 [real-time evolution](fdip-00H8)
 #{\alpha_s(A)=V_s^*AV_s} is strongly continuous in #{s}.
 For a bounded self-adjoint #{O} with #{v=O_c\Omega},
##{\begin{aligned}
\langle v,\ue^{-tH}v\rangle
 &=\sum_{0<r<1}\ue^{-t\varepsilon_r}\|E_rv\|^2,\\
\langle v,\ue^{-\ui sH}v\rangle
 &=\sum_{0<r<1}\ue^{-\ui s\varepsilon_r}\|E_rv\|^2.
\end{aligned}}
Both series are absolutely convergent; the first is the continuous
 Euclidean interpolation of #{C_O(n)} at #{t=na_t}.}

\proof{
\p{The maximal-domain logarithm and its self-adjointness are
 proved in \ref{fdip-0085}. Grouping its eigenvectors by
 eigenvalue gives precisely the displayed projection domain.
 Finite sums of eigenspaces, together with the vacuum line,
 form a core. The scalar multipliers #{\ue^{-t\varepsilon_r}}
 and #{\ue^{-\ui s\varepsilon_r}} prove the semigroup and group
 identities. Dominated convergence against the summable
 quantities #{\|E_ru\|^2} proves strong continuity for every
 vector. Parseval similarly proves both correlation formulas.}

\p{For a fixed vector #{u} and #{s\to s_0},
##{\begin{aligned}
\|\alpha_s(A)u-\alpha_{s_0}(A)u\|
&\le\|A\|\|(V_s-V_{s_0})u\|\\
&\quad+\|(V_s^*-V_{s_0}^*)AV_{s_0}u\|\longrightarrow0.
\end{aligned}}
This proves strong continuity of the Heisenberg family without
 an operator-norm continuity assertion.}
}

\p{TauCeti's
 \leanref/tauceti{IsSelfAdjoint.exists_isUnitary_complexGenerator_eq_I_smul}
 is a general self-adjoint-to-unitary-group theorem with generator
 #{+iA}. The present sign convention uses #{A=-H}.
 Here the group and its continuity were constructed directly
 from the compact spectral decomposition.}

\p{Operator positivity of #{\ue^{-tH}} concerns quadratic forms.
 Preservation of nonnegative spatial functions requires more;
 \ref{fdip-00NB} gives a counterexample at a half time step.
 Likewise, trace class of #{S} does not by itself imply trace
 class of #{S^r} for every #{0<r<1}. The periodic trace limit
 in \ref{fdip-00N7} uses integer powers; an additional thermal
 state at inverse temperature #{\beta} requires the actual
 condition #{\operatorname{Tr}\ue^{-\beta H}<\infty}.}
