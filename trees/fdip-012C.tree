\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Definition}
\title{A class-function kernel and a double-coset kernel}
\date{2026-11-21}

\p{Let #{G} be a finite group and let #{G^\circ} be the stabilizer of
a reference point of a finite #{G}-orbit. A
\newvocab{class-function kernel} is a function
#{\mathcal K:G\to k} with
#{\mathcal K(hgh^{-1})=\mathcal K(g)} for every
#{g,h\in G}. A \newvocab{double-coset kernel} is a function
#{B:G\to k} with #{B(agb)=B(g)} for every #{g\in G} and every
#{a,b\in G^\circ}. The ring #{k} is commutative and unital. On
functions #{f:G\to k}, define
##{(M_Bf)(g)=B(g)f(g),\qquad
 (C_{\mathcal K}f)(g)=\sum_{x\in G}\mathcal K(gx^{-1})f(x),}
and the one-edge operator
#{\transferop=M_B\,C_{\mathcal K}\,M_B}. The empty sum is #{0}.}
