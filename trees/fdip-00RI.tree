\tag{fdip}
\taxon{Remark}
\title{The operator domain and real-time evolution}
\date{2026-11-13}

\p{The domain of the Hamiltonian is #{\Dom{H}}. Functional analysis
writes #{D(H)}. The Kähler–Dirac operator keeps #{\extD}.}

\p{The real-time group generated by a self-adjoint Hamiltonian #{H}
is #{\ue^{-\ui tH}}. Mathematical physics writes #{e^{-itH}}. The
complex scalar is that unitary group.}
