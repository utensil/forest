\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Remark}
\title{Hilbert complexes and cochain projections}
\date{2026-11-15}

\p{For a closed Hilbert complex,
\citet{(15), p. 22}{arnoldfalkwinther2010stability}
gives the Hodge decomposition
##{\operatorname{im}\mathrm d\oplus\mathcal H^p\oplus\operatorname{im}\mathrm d^{\dagger}.}
The first summand is the image of the coboundary entering the
degree, and #{\mathrm d^{\dagger}} is the Hilbert adjoint.}

\p{\citet{Theorem 3.4, p. 27}{arnoldfalkwinther2010stability}
takes a bounded closed Hilbert complex, a Hilbert subcomplex,
and a bounded cochain projection #{\pi_h}. Condition (25)
asks that every nonzero harmonic #{\omega} satisfy
##{\|\omega-\pi_h\omega\|<\|\omega\|}
in the norm of the domain complex, in every degree. Under that
condition the projection induces an isomorphism on cohomology.
Boundedness of the projection, without (25), is not enough.}

\p{The remark after the theorem
(\citet{p. 28}{arnoldfalkwinther2010stability})
separates meshes fine enough for (25) from the finite-element
isomorphism of §5.6, which holds for every mesh size in that
application.
\citet{Theorem 3.5, p. 28}{arnoldfalkwinther2010stability}
bounds the gap between the harmonic space and the discrete
harmonic space.}

\p{\citet{Theorems 3.19 and 3.21, p. 38}{arnoldfalkwinther2010stability}
give eigenvalue convergence. The complex has the compactness
property, the subcomplexes approximate in the sense of
\citet{(8), p. 14}{arnoldfalkwinther2010stability},
as §3.5 (p. 31) uses that condition, and the cochain
projections are uniformly bounded in the norm of the Hilbert
complex. Theorem 3.21 also assumes that the eigenvalue is
simple.}
