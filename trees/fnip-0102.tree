    \fill (1.05,1.05) circle (1.4pt);
    \node[below] at (1.05,-0.08) {$I_{\mathrm{app}}=60$};
  \end{scope}
  \begin{scope}[xshift=2.7cm]
    \draw[->] (0,0) -- (2.15,0);
    \draw[->] (0,0) -- (0,2.15);
    \fill (1.05,1.05) circle (1.4pt);
    \draw[thick,dashed] (1.05,1.05) circle (0.38);
    \draw[thick] (1.05,1.05) circle (0.78);
    \node[below] at (1.05,-0.08) {$I_{\mathrm{app}}=90$};
  \end{scope}
  \begin{scope}[xshift=5.4cm]
    \draw[->] (0,0) -- (2.15,0);
    \draw[->] (0,0) -- (0,2.15);
    \draw (1.05,1.05) circle (1.4pt);
    \draw[thick] (1.05,1.05) circle (0.78);
    \node[below] at (1.05,-0.08) {$I_{\mathrm{app}}=100$};
  \end{scope}
\end{tikzpicture}}

