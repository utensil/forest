\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Theorem}
\title{Concavity and covariance of squared edge differences}
\date{2026-11-01}

\p{On the open set #{\mathcal U_m} of \ref{fdip-005R},
##{\frac{\partial^2\mathcal W}{\partial w_e\partial w_f}
 =-\frac12\langle d_e,Gd_f\rangle^2.}
The induced action is concave, including on the nonnegative
weight orthant. For the corresponding centered Gaussian field,
##{\operatorname{Cov}(\langle d_e,\phi\rangle^2,
 \langle d_f,\phi\rangle^2)
 =2\langle d_e,Gd_f\rangle^2,}
so the Hessian bilinear form on weight directions is minus one
quarter of this covariance. Its matrix in the weight coordinates
is given in \ref{fdip-00LQ}.}

\proof{
\p{Differentiating #{QG=I} in weight #{w_f} gives
#{\partial_fG=-G(d_f\otimes d_f^\flat)G}. Substitute this into
\ref{fdip-005S}; symmetry of #{G} gives the Hessian entry.
For a real weight direction #{a=(a_e)}, set
#{A=\sum_e a_e\,d_e\otimes d_e^\flat}. Its second directional
derivative is
##{D^2\mathcal W[a,a]
 =-\frac12\trace(GAGA)
 =-\frac12\|G^{1/2}AG^{1/2}\|_{\mathrm{HS}}^2\le0.}
The Hilbert-Schmidt norm is #{\|B\|_{\mathrm{HS}}^2=\trace(B^*B)}.
The operator #{G^{1/2}AG^{1/2}} is real self-adjoint, so this
square is nonnegative. Restricting to a line segment in the convex
set #{\mathcal U_m} proves concavity. This is also the Gram-square
form of the Schur-product argument.}

\p{For completeness let #{X=\langle d_e,\phi\rangle},
#{Y=\langle d_f,\phi\rangle},
with variances #{\alpha,\beta} and covariance #{\gamma}.
Their moment-generating function is
##{\mathbb E[e^{sX+tY}]
 =\exp\left(\frac{\alpha s^2+2\gamma st+\beta t^2}{2}\right).}
Differentiation at zero is justified by Gaussian exponential
integrability, also when this pair is degenerate. The coefficient
of #{s^2t^2} is #{\alpha\beta /4+\gamma^2/2}, hence
#{\mathbb E[X^2Y^2]=\alpha\beta+2\gamma^2}. Subtracting
#{\mathbb E[X^2]\mathbb E[Y^2]} proves the covariance identity.}
}

\p{\citet{Exercise 8.3, p. 385}{friedli2017statistical}
states Wick's formula. The last calculation is its four-factor
case and agrees with the [Gaussian contraction rule](fdip-0046). Concavity need
not be strict in the weights: loops or dependent rank-one
operators #{d_e\otimes d_e^\flat} can give zero second derivatives
in nonzero directions.}
