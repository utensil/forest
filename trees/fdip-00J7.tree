\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Proposition}
\title{Gauge averaging and higher source terms}
\date{2026-11-09}

\p{For the \vocabk{source generating polynomial}{fdip-00IS} and \vocabk{coupled coefficient functional}{fdip-00IT}, set #{B_U=\bar\eta(K_U^{-1}\eta)}, an even element of source degree two. Then
##{\mathcal Z(\bar\eta,\eta)=\mathbb E_\nu \ue^{B_U},\qquad
\log\mathcal Z=\mathbb E_\nu B_U+\tfrac12\left(\mathbb E_\nu B_U^2-(\mathbb E_\nu B_U)^2\right)+R_{\geq6},}}

\p{where #{R_{\geq6}} is a polynomial supported in source degrees at least #{6}. The logarithm is the finite nilpotent series around the constant coefficient #{\mathcal Z(0,0)=1}.}

\proof{
\p{The exact source integration in \ref{fdip-00IV} gives the first formula. The even part of the finite exterior algebra is commutative, and its positive-degree ideal is nilpotent. Expanding there gives
##{\mathcal Z=1+z_2+z_4+z_{\geq6},\qquad z_2=\mathbb E_\nu B_U,\quad z_4=\tfrac12\mathbb E_\nu B_U^2.}}

\p{In #{\log(1+w)=w-w^2/2+w^3/3-\cdots}, with #{w=\mathcal Z-1}, every term of #{w^3} or higher has source degree at least #{6}. The degree #{4} part of #{w^2} is #{z_2^2}. Substitution proves the claimed expansion. All sums and coefficient integrals are finite.}
}
