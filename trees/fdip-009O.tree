\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Definition}
\title{Covariant centered differences with an internal fiber}
\date{2026-11-01}

\p{Use the \vocabk{periodic grid and Clifford module}{fdip-000R}:
#{n\ge1}, periods #{N_j\ge3},
#{\Lambda=\prod_j\mathbb Z/N_j\mathbb Z}, and
#{S=(\mathbb C^2)^{\otimes n}} with represented generators
#{\varepsilon_j^{S}}. Each equals the represented generator of
the \vocabk{centered Dirac operator}{fdip-000R}; \ref{fdip-00RP} writes
the equality. Thus
#{\dim_{\mathbb C}S=2^n} and
##{\varepsilon_i^{S}\varepsilon_j^{S}+\varepsilon_j^{S}\varepsilon_i^{S}=2\delta_{ij}\bbI_S.}
This is the Euclidean real form recorded in \ref{fdip-00LZ}. The
substitution #{\varepsilon_j^{S}\mapsto\ui\varepsilon_j^{S}} is not used.
The lattice spacing is one. Choose a nonzero finite-dimensional
complex Hermitian space #{F} and a
unitary representation #{\rho:G\to U(F)} of a finite or compact
group, continuous in the compact case. The invariant metric is
part of the \vocabk{representation datum}{fdip-007H}. The field space is
##{\mathcal H=\ell^2(\Lambda)\otimes S\otimes F,}
identified with maps #{\psi:\Lambda\to S\otimes F}, with
##{\langle\psi,\phi\rangle
=\sum_{x\in\Lambda}\langle\psi(x),\phi(x)\rangle_{S\otimes F}.}
Dimensions are over #{\mathbb C}; adjoints use the declared
Hermitian inner products.}

\p{Assign #{U_j(x)\in G} to the oriented edge
#{x\to x+e_j}, and also write #{U_j(x)} for its unitary action
#{\rho(U_j(x))} on #{F}. The
\vocabk{source-to-head convention}{fdip-006D} means that comparing a
value at #{x+e_j} with one at #{x} uses the inverse transport.
Define
##{\begin{gathered}
(T_j^U\psi)(x)
 = (\bbI_S\otimes U_j(x)^{-1})\psi(x+e_j),\\
((T_j^U)^{-1}\psi)(x)\\
 = (\bbI_S\otimes U_j(x-e_j))\psi(x-e_j).
\end{gathered}}
Substitution verifies that the second operator is the inverse
of the first. Put
##{\cov_j^U=\frac{T_j^U-(T_j^U)^{-1}}2.}
The operator #{\varepsilon_j^{S}\otimes\bbI_F} acts
pointwise on the field, on the spinor factor and on the internal
factor respectively. The
\newvocab{covariant lattice Dirac operator} is
##{D_U=\sum_{j=1}^n\bigl(\varepsilon_j^{S}\otimes\bbI_F\bigr)\cov_j^U.}
This is the centered nearest-neighbor convention in
\citet{Section 9.1, Equations (9.1)–(9.2), p. 19}{wingate2025lattice},
with spacing one and the declared link orientation.}

\p{For #{g:\Lambda\to G}, write #{g_x=\rho(g(x))} in
operator formulas. The transformed links and field are
##{\begin{aligned}
U_j^g(x)&=g_{x+e_j}U_j(x)g_x^{-1},\\
(\mathcal G\psi)(x)&=(\bbI_S\otimes g_x)\psi(x).
\end{aligned}}
This is an internal gauge transformation: it fixes the lattice
and the chosen represented generators. Links and #{\mathcal G}
commute with every #{\varepsilon_j^{S}\otimes\bbI_F},
because they act on the other tensor factor.}
