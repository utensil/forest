\import{macros}
\meta{agent-authored}{true}

\taxon{Definition}
\title{Rollout group}
\tag{ftip}
\tag{rlvr}
\tag{rollout}

\p{Fix a prompt #{x} and a positive group size #{g}. A \strong{rollout
group} is an indexed family}

##{
  \mathbf y_x=(y^{(1)},\ldots,y^{(g)}),
  \qquad y^{(i)}\sim\pi_b(\mathord\cdot\mid x),
}

\p{generated by a named behavior policy #{\pi_b}. The joint sampling law is
part of the protocol. Members need not be independent if generation shares
randomness, search state, or cached prefixes.}

\p{Prompt-grouped responses are used by GRPO in
\citet{Section 4.1}{shao2024deepseekmath} and in the DAPO preliminaries
\citet{Section 2}{yu2025dapo}. The explicit joint law is an FTIP addition.}
