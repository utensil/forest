\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Proposition}
\title{Rotations transport the translation quotient}
\date{2026-11-17}

\p{Let #{(R_\square,t_\square)} be a based plaquette holonomy
of \ref{fdip-00OC}. If #{R'_\square=SR_\square S^{-1}}, then
#{\rho(S)} induces an isomorphism
##{V/(\bbI -\rho(R_\square))V
 \longrightarrow V/(\bbI -\rho(R'_\square))V.}
It sends #{[t_\square]} to #{[\rho(S)t_\square]}. A full
affine gauge #{(S,\xi)} at the base vertex sends the old torsion
class to exactly this class in the new quotient.}

\proof{
\p{The homomorphism law gives the intertwining identity
##{\rho(S)(\bbI -\rho(R_\square))
 =(\bbI -\rho(R'_\square))\rho(S).}
Thus #{\rho(S)} carries the image submodule on the left onto
the image submodule on the right; the inverse is #{\rho(S^{-1})}.
It descends to the stated quotient isomorphism. The full holonomy
law of \ref{fdip-00OC} is
##{t'_\square=\rho(S)t_\square
 +(\bbI -\rho(R'_\square))\xi.}
The last term is zero in the target quotient, proving the class
formula.}
}

\p{When the rotational holonomy changes by conjugation, this is
a transported class between two quotients. It is not an invariant
vector in a single fixed quotient.}
