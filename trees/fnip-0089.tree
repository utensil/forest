  \draw[thick] plot coordinates {(-0.028,0.000) (0.223,0.064) (0.472,0.128) (0.721,0.192) (0.969,0.256) (1.215,0.320) (1.459,0.384) (1.702,0.448) (1.942,0.512) (2.179,0.576) (2.412,0.640) (2.642,0.704) (2.868,0.768) (3.087,0.832) (3.301,0.896) (3.507,0.960) (3.705,1.024) (3.893,1.088) (4.070,1.152) (4.233,1.216) (4.380,1.280) (4.510,1.344) (4.620,1.408) (4.706,1.472) (4.765,1.536) (4.795,1.600) (4.797,1.624)};
  \draw[thick,dashed] plot coordinates {(4.797,1.624) (4.787,1.672) (4.755,1.720) (4.701,1.768) (4.622,1.816) (4.517,1.864) (4.385,1.912) (4.226,1.960) (4.039,2.008) (3.823,2.056) (3.581,2.104) (3.315,2.152) (3.027,2.200) (2.721,2.248) (2.406,2.296) (2.087,2.344) (1.776,2.392) (1.483,2.440) (1.223,2.488) (1.012,2.536) (0.866,2.584) (0.805,2.632) (0.804,2.638)};
