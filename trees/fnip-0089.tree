\import{fnip-macros}
\meta{agent-authored}{true}
\tag{fnip}
\taxon{Example}
\title{Two folds in the SNLC column}
\date{2026-11-27}

\p{In the SNLC column of \ref{fnip-0086}, the equilibrium voltage
drawn against the applied current has two folds. Between them the
lower equilibrium is stable and the other two are not.
\citet{p. 59}{ermentrout2010mathematical} states that fact. The fold met
as the current increases is the one Figure 3.6a on p. 60 labels
#{\mathrm{SN}_{2}}.}

\texfig{\begin{tikzpicture}[line cap=round,font=\small]
