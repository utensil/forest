  \draw[->] (0,0) -- (6.7,0) node[right] {$I_{\mathrm{app}}$};
  \draw[->] (0,0) -- (0,3.25) node[above] {$V$};
  \draw (0,0) -- (0,-0.06) node[below] {$-20$};
  \draw (1.600,0) -- (1.600,-0.06) node[below] {$0$};
