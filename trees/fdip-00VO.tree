\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Example}
\title{A geometric column projector fails on one site}
\date{2026-11-17}

\p{Let #{n=2} and let #{k=\mathbb Q} or an odd prime field.
In the geometric Clifford algebra, the idempotent
#{p=(1+e_1)/2} gives a rank-two right projector.
Indeed the coordinate realization
##{e_1\longmapsto\begin{pmatrix}1&0\\0&-1\end{pmatrix},
 \qquad
 e_2\longmapsto\begin{pmatrix}0&1\\1&0\end{pmatrix}}
satisfies the Clifford relations. The two diagonal
projectors and their products with the second matrix
give all matrix units. Since both algebras have dimension
#{4}, this is an isomorphism with #{M_2(k)}. Right
multiplication by the image of #{p} keeps the first
column and kills the second, proving its rank.}

\p{On the one-site torus with Hurwitz coefficients, choose
#{U_1=\qi} and #{U_2=1}. The operator from
\ref{fdip-00VN} is
##{\extD_U=-(e_1\wedge+e_1\cdot)\otimes\bbI
                -(e_1\wedge-e_1\cdot)\otimes L_{\qi}.}
Here #{(e_1\wedge-e_1\cdot)1=e_1} and
#{(e_1\wedge-e_1\cdot)e_1=-1}. The first summand
commutes with the [geometric right action](fdip-00VK);
for the second,
##{(e_1\wedge-e_1\cdot)p=(e_1-1)/2,\qquad e_1p=p.}
It follows that
##{[\extD_U,R_p^{\mathrm{geom}}]\,(1\otimes1)
                 =1\otimes\qi\ne0.}
The complementary columns of the free geometric module
therefore fail to be preserved by this allowed coupled
background.}
