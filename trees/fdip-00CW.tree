\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Remark}
\title{A heat trace is not an increment}
\date{2026-11-07}

\p{\ref{fdip-00CQ} adds logarithmic derivatives of heat traces,
and \ref{fdip-00CP} falls to #{0} for large time. \ref{fdip-00CT}
gives the cycle heat trace a plateau at #{1}. None of these evaluates
#{\mathbb E\lvert f_x-f_y\rvert^2} for the continuous field of
\ref{fdip-00BG}. The embedding in \ref{fdip-00CL} uses arc length.}
