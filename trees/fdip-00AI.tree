\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Definition}
\title{Multiplication operators}
\date{2026-11-03}


\p{Let #{R} be a commutative unital ring and #{V} a finite set. On the
\vocabk{vertex-field module}{fdip-0010}, each
#{f\in\mathcal F_R(V)} determines a \newvocab{multiplication operator}
##{M_f:\mathcal F_R(V)\to\mathcal F_R(V),\qquad M_f(g)=fg.}
The assignment #{f\mapsto M_f} is an injective #{R}-algebra map,
##{M_{f+g}=M_f+M_g,\quad M_{rf}=rM_f,\quad
   M_{fg}=M_fM_g,\quad M_1=\bbI.}
\ref{fdip-0011} proves these identities from the ring laws.}
