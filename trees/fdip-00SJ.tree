\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Definition}
\title{Transported products have a coefficient target}
\date{2026-11-17}

\p{Use the \vocabk{coefficient connection}{fdip-00SH}. Let
#{F,F'} be coefficient representations and give #{F\otimes_k F'}
the tensor-product representation. For an increasing set
#{I=\{i_1<\cdots<i_p\}}, set
#{T_I^{F'}=T_{i_1}^{F'}\cdots T_{i_p}^{F'}}, with
#{T_\varnothing^{F'}=\bbI}. This is inverse transport along
the path traversing the directions in increasing order.}

\p{For homogeneous cochains
#{\alpha=\sum_{|I|=p}e_I\otimes\alpha_I} and
#{\beta=\sum_{|J|=s}e_J\otimes\beta_J}, their
\newvocab{transported product} is the #{F\otimes_k F'}-valued cochain
##{\alpha\smile_U\beta=
\sum_{I\cap J=\varnothing}(e_I\wedge e_J)\otimes
\bigl(\alpha_I\otimes T_I^{F'}\beta_J\bigr).}
A specified #{G}-equivariant map
#{F\otimes_k F'\to F''} may be composed with this product.
In particular a scalar factor has the trivial representation.
No multiplication of two elements of an arbitrary coefficient
module is presumed. For endomorphism-valued coefficients,
composition or evaluation uses the conjugation representation
and its corresponding equivariant map.}
