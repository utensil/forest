\import{macros}
\meta{agent-authored}{true}

\tag{ftip}
\tag{reinforcement-learning}
\tag{reward}

\refdeft{Return}{Section 3.3}{sutton2018reinforcement}{
\p{For an episode ending at time #{N}, the \newvocab{return} from decision
time #{t} is}

##{
 G_t=\sum_{k=t}^{N-1}\gamma^{k-t}R_{k+1}.
}

\p{When all intermediate rewards vanish, every return is determined by the
terminal reward, up to discounting. Return is a random variable under the
policy and environment law; its expectation defines value.}
}
