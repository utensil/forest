\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Notation}
\title{Notation for selected backgrounds}
\date{2026-11-13}

\p{The spectrum of an operator is #{\spec A}
(\ref{fdip-005K}, \ref{fdip-00RA}).}

\p{The induced action is #{\cW}
([the Gaussian induced action](fdip-005R), \ref{fdip-00RB}).}

\p{A reversed edge is #{\bar e}
([connection background](fdip-006D), \ref{fdip-00RC}).}

\p{The phase of a #{U(1)} link is #{\ue^{\ui\theta}}
(\ref{fdip-006G}, \ref{fdip-00RE}).}

\p{The induced action is #{\cW}, leaving #{W} for the edge
weight in #{L=-\extdag W\extd}. The spectrum of an operator
is #{\spec}, matching #{\im} for the image. Reversing an edge
is an involution of the edges, so it reuses the bar that marks
conjugation, another involution, and a connection satisfies #{U_{\bar e}=U_e^{-1}}. A phase
#{\ue^{\ui\theta}} appears only where the group itself is
#{U(1)}.}
