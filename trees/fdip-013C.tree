\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Example}
\title{The residual edge as the other column}
\date{2026-11-21}

\p{On the group of \ref{fdip-0126}, the free orbit gives
invariant functions whose rank is the order of the group, and
the residual orbit gives a preserved space whose rank is the
number of double cosets. Environment constants scale the
sector sums and leave the one-edge matrix unchanged.}

\proof{
\p{For the free orbit every stabilizer is trivial.
\ref{fdip-0123} identifies the invariant functions with the
functions on the residual quotient of the links. For one edge
and a trivial stabilizer that quotient is the group, so the
rank equals the order of #{G}. \ref{fdip-013G} equates the
number of double cosets with the sum of the squares of the
invariant dimensions, and \ref{fdip-013H} gives a preserved
space of that rank. \ref{fdip-013A} multiplies each sector
sum by its own constant and leaves the one-edge matrix
unchanged.}
}
