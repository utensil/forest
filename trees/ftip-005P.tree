\import{macros}
\meta{agent-authored}{true}

\refdeft{weighted-sum scalarization}{Section 4.7.5}{boyd2004convex}{
\p{For objective vector #{v\in\mathbb R^m} and nonnegative weights
#{w\in\mathbb R_+^m}, the weighted-sum scalarization assigns the score
#{w^\top v}. Optimizing this score selects a point according to the declared
weights.}

\p{Changing #{w} changes the research question. A single weighted score can
hide tradeoffs among evaluation groups or task families.}
}
