\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Remark}
\title{The Dirac symbol}
\date{2026-11-13}

\p{Physics writes the Fourier symbol
#{D(p)=\ui\sum_j\rho(\iota(\varepsilon_j))\sin p_j}
\citet{Section 9.1, Equations (9.6)-(9.7), p. 20}{wingate2025lattice}.
The scalar #{\bigl(\ue^{\ui p_j}-\ue^{-\ui p_j}\bigr)/2} is
#{\ui\sin p_j}. \ref{fdip-000S} keeps the square
#{D(p)^2=-s(p)\bbI_S} and the pairing #{-\mu^2=s(p)}.
The centered operator supplies no unit bivector of a character
plane, and the Clifford pseudoscalar does not replace this scalar.
The operator satisfies #{D^{\dagger}=-D}.}
