\import{fnip-macros}
\meta{agent-authored}{true}
\tag{fnip}
\taxon{Theorem}
\title{Hartman-Grobman}
\date{2026-11-26}

\p{Let #{x_{*}} be a \vocabk{hyperbolic}{fnip-0034}
\vocabk{equilibrium}{fnip-0014} of #{\dot x=f(x)}, with #{f} smooth.
Then there is a homeomorphism #{h},
defined on a neighborhood of #{x_{*}}, that takes orbits of the
nonlinear flow to orbits of the linear flow
#{e^{tDf(x_{*})}}. The homeomorphism preserves the sense of the
orbits, and it can be chosen to preserve the parametrization by time.}

\p{\citet{Theorem 1.3.1, §1.3, p. 13}{guckenheimer1983nonlinear}
is this statement: if #{Df(x)} has no eigenvalue of zero real part,
the homeomorphism is defined on a neighborhood #{U} of #{x} in
#{\mathbb{R}^{n}}. The same page records that a diffeomorphism
between the two flows needs nonresonance conditions among the
eigenvalues, and these notes do not use that smoother statement.
\citet{p. 48}{kuznetsov2004elements} invokes the same theorem to
conclude that, near a hyperbolic equilibrium, the flow is locally
topologically equivalent to its linearization.
\citet{§4.2.4, p. 103}{izhikevich2007dynamical} states the theorem
for the planar neuron models.}
