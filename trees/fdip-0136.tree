\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Example}
\title{The determinant and diagonal bound on the residual edge}
\date{2026-11-21}

\p{On the edge of \ref{fdip-012P}, the indicator matrix is the
update of \ref{fdip-013I}, the rescaling is the one in
\ref{fdip-012U}, and the Rayleigh inequality is the hypothesis
of \ref{fdip-012Y}. The determinant and the diagonal bound are
the quantities given by \ref{fdip-013I}.}

\proof{
\p{The values of #{B} are #{3}, #{5/2}, #{2}, #{3/2} and
#{1}, by adding #{2} to the normalized pairings of
\ref{fdip-012O}. Each is nonzero, so the diagonal matrix of
the squares is invertible. \ref{fdip-012U} takes the rescaling
factors to be the positive square roots of the coset sizes.
\ref{fdip-012Y} assumes the Rayleigh inequality for the
rescaled matrix. \ref{fdip-013I} applies.}
}
