\node[ext=6.4cm] (III) at (6,7.85) {Part III: Backgrounds and symmetry};
\node[box=6.4cm] (a) at (6,6.0) {Finite-group symmetry of Gaussian fields};
\node[box=6.4cm] (b) at (6,4.6) {Equivariant precision and real types};
\node[box=6.4cm] (c) at (6,3.2) {Gaussian laws over symmetry sectors};
\node[ext=6.4cm] (X) at (6,1.6) {Part IX: Induced action};
\draw[arr] (III) -- node[lab,midway,right=1mm] {does symmetry still sort the physics into sectors\\ when the order of exchanges matters?} (a);
