\tag{fdip}
\title{Finite-group symmetry of Gaussian fields}
\date{2026-10-31}

\texfig{\begin{tikzpicture}[x=1cm,y=1cm,font=\sffamily,
  box/.style={draw=black,line width=0.5pt,rounded corners=2pt,align=center,execute at begin node={\hyphenpenalty=10000\exhyphenpenalty=10000},
    font=\sffamily\small,minimum height=7mm,inner sep=2.5pt,text width=#1},
  ext/.style={draw=black,densely dotted,line width=0.4pt,rounded corners=2pt,align=center,execute at begin node={\hyphenpenalty=10000\exhyphenpenalty=10000},
    font=\sffamily\small,text=black!60,minimum height=7mm,inner sep=2.5pt,text width=#1},
