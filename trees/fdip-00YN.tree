\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Definition}
\title{Rotational cochains and affine edge gauges}
\date{2026-11-17}

\p{Use the \vocabk{internal exterior module}{fdip-00YE} with
its \vocabk{exterior rotational action}{fdip-00YI}, retaining
the notation #{k,V,b,E,B,H,A}. Let
#{X=\prod_{i=1}^n\mathbb Z/N_i\mathbb Z}, with #{N_i\geq2},
be the sites of the \vocabk{based cellular torus}{fdip-00SH}.
Write #{\varepsilon_i} for the site increment and #{u_i} for the
standard basis of a separate cubical module #{k^n}.
The \newvocab{rotational cochains} are
##{C^p=\bigoplus_{x\in X}\Lambda^p(k^n)\otimes_k E,
\qquad C=\bigoplus_{p=0}^n C^p.}
A coefficient #{f_I(x)\in E} belongs to the increasing cubical
monomial #{u_I}. Cubical degree #{p} is distinct from internal
exterior degree. The counting pairing is
##{\langle f,h\rangle=\sum_{x\in X}\sum_I B(f_I(x),h_I(x)).}}

\p{An oriented labeled edge #{(x,i)} goes from #{x} to
#{x+\varepsilon_i} and carries an affine pair
#{(R_i(x),a_i(x))\in H\ltimes V} of \ref{fdip-00OB}.
A vertex gauge #{(S_x,\xi_x)\in H\ltimes V} acts by the full
edge law of \ref{fdip-00OC}:
##{\begin{aligned}
R'_i(x)&=S_{x+\varepsilon_i}R_i(x)S_x^{-1},\\
a'_i(x)&=\xi_{x+\varepsilon_i}+\rho(S_{x+\varepsilon_i})a_i(x)
          -\rho(R'_i(x))\xi_x.
\end{aligned}}
Its action on these cochains is
#{(\mathcal G_S f)_I(x)=A(S_x)f_I(x)}; the translation part
acts trivially on this field module. The cell labels remain fixed.}
