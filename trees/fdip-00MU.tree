\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Proposition}
\title{Coarse pullback commutes with Gauss projection}
\date{2026-11-11}

\p{Let #{G} be compact metrizable, let #{\mathcal B} be a
\vocabk{coarse path map}{fdip-00MO}, and let #{\lambda_f} be
any gauge-invariant Borel probability on #{X_f}. Put
#{\lambda_c=\mathcal B_*\lambda_f}. Write #{P_f} and #{P_c}
for the normalized gauge averages of bounded Borel functions
given by \ref{fdip-00L4}. For every bounded Borel
#{F:X_c\to\mathbb C},
##{J_0F=F\circ\mathcal B}
satisfies
##{\int_{X_f}|J_0F|^2\,\extd\lambda_f
 =\int_{X_c}|F|^2\,\extd\lambda_c,}
##{R_g^f(J_0F)=J_0(R_{r(g)}^cF),\qquad
 P_fJ_0F=J_0P_cF.}
The identity is exact at this bounded level. It applies to
#{\lambda_f=\nu_f}, and to #{\lambda_f=Z^{-1}w\nu_f} when
#{w\ge0} is integrable and gauge invariant as an
#{L^1(\nu_f)} class and #{Z=\int w\,\extd\nu_f>0}, as in
\ref{fdip-00MQ}.}

\proof{
\p{Equivariance shows that #{\lambda_c} is gauge invariant.
For bounded Borel #{F}, the pushforward integration identity
gives the displayed equality of integrals. The inverse-pullback
identity follows from
#{\mathcal B(g^{-1}\cdot U)=r(g)^{-1}\cdot\mathcal B(U)}.}

\p{The averaging theorem \ref{fdip-00L4} gives, for this bounded
#{F},
##{P_fJ_0F(U)
 =\int_{K_f}F(r(g)^{-1}\cdot\mathcal BU)\,\extd\mu_{K_f}(g).}
The Haar pushforward under #{r} is #{\mu_{K_c}} by
\ref{fdip-00MP}, so the integral is #{J_0P_cF(U)}.}
}

\p{Remark. Continuum comparison. The #{L^2} extension is not
the statement above. On the complex Hilbert spaces
#{\mathcal H_f=L^2(\lambda_f)} and
#{\mathcal H_c=L^2(\lambda_c)}, the same formula defines an
isometry #{J_0:\mathcal H_c\to\mathcal H_f}. Changing an
#{L^2} representative changes the pullback only on a null set.
For any invariant probability #{\lambda}, Jensen's inequality
and Fubini give #{\|P_KF\|_2\le\|F\|_2}. Inversion invariance
of Haar and invariance of #{\lambda} make this average
self-adjoint; the invariant range and idempotence follow from
\ref{fdip-00L4}. It is therefore the orthogonal projection in
#{L^2(\lambda)}. Bounded functions are dense in #{L^2}, so the
bounded identity extends to every
#{F\in\mathcal H_c}. In particular #{J_0} embeds the coarse
invariant subspace isometrically into the fine invariant
subspace. These Hilbert maps use #{L^2(\lambda_c)} even when
the coarse image is supported on a diagonal as in
\ref{fdip-00MS}. There is no finite character truncation of
this density extension. The normalized conditional functional
in \ref{fdip-00L4} instead acts on the algebra of bounded Borel
functions with pointwise product. The equality of their
averages on bounded representatives does not make all of
#{L^2} an algebra.}
