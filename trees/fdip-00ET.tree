\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Remark}
\title{The two cell diameters set the scale}
\date{2026-11-07}

\p{A planar #{n}-cell has Euclidean diameter #{2^{-n}} by
\ref{fdip-00EO}. The vertices of the same cell have
resistance diameter at most #{4\bigl(\frac{3}{5}\bigr)^n}
by \ref{fdip-00EM}. The comparison of the two completions
uses these two scales.}
