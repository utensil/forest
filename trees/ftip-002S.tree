\import{macros}
\meta{agent-authored}{true}

\tag{ftip}
\tag{reward-model}
\tag{preference}

\card{Remark}{Representability, non-identifiability, and heterogeneous preferences}{
\p{We formulate the preference data law separately from the scalar model
because fitting a Bradley--Terry predictor is an assumption about
representation, not a consequence of observing comparisons. Cyclic choices,
context effects, and mixtures of judges can fail to agree with one shared
scalar ordering.}

\p{Even within the model, scores are not identified absolutely: replacing
#{r_\phi(x,y)} by #{r_\phi(x,y)+c(x)} leaves every pairwise probability and the
loss unchanged. Ouyang et al. give one normalization in
\citet{§3.5; App. C.2}{ouyang2022training}. Other uses must state their own
normalization, judge population, and validation law.}
}
