\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Example}
\title{Four-cycle Clifford signs in the vertex basis}
\date{2026-11-10}

\p{Use the vertex basis #{\delta_0,\delta_1,\delta_2,\delta_3} of the
[configuration form](fdip-000O), and write
#{c_i=\iota_q(\delta_i)}. Let #{Q} be the matrix of #{b_q} in this
basis. The squares and anticommutators are
##{\begin{aligned}
c_i^2&=s1\quad(i=0,1,2,3),\\
\{c_0,c_1\}&=\{c_2,c_3\}=-2\,1,\\
\{c_1,c_2\}&=\{c_3,c_0\}=-2t\,1,\\
\{c_0,c_2\}&=\{c_1,c_3\}=0.
\end{aligned}}
The [opposite-sign convention](fcap-0008) would use #{-q}.}

\proof{
\p{The square relation gives
#{c_i^2=q(\delta_i)1=Q_{ii}1=s1}. The unhalved anticommutator of
[the Clifford relation](fdip-000P) gives
#{\{c_i,c_j\}=B_q(\delta_i,\delta_j)1=2Q_{ij}1}.
The pairs with #{Q_{ij}=-1} contribute #{-2}, the pairs with
#{Q_{ij}=-t} contribute #{-2t}, and the two zero entries of
#{Q} contribute #{0}.}
}
