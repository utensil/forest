\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Definition}
\title{Right multiplicity modules}
\date{2026-11-10}

\p{Let #{G} be a finite group, and let #{W} and #{H} be
finite-dimensional real orthogonal representations of #{G}. Write
#{D=\operatorname{End}_G(W)}, acting on #{W} on the left by
evaluation. The \newvocab{right multiplicity module} is
#{M=\operatorname{Hom}_G(W,H)}, with right #{D}-action
##{(f\cdot d)(w)=f(d(w)).}
Let #{f^*:H\to W} be the adjoint of #{f} for the two invariant inner
products, and define
##{h(f,g)=f^*\circ g.}
Evaluation #{M\otimes_D W\to H}, #{f\otimes w\mapsto f(w)}, is the
bilinear map determined by these actions. No identification of #{D}
with #{\mathbb R}, #{\mathbb C} or #{\mathbb H} is assumed, and
#{h} is not assumed to be scalar-valued. \ref{fdip-004Z}
proves that #{h(f,g)} lies in #{D} and that
#{h(f\cdot d,g\cdot e)=d^*\circ h(f,g)\circ e}.}
