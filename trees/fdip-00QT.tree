\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Remark}
\title{The projection mark}
\date{2026-11-13}

\p{Restriction to one part of a partition is #{\pr_i}. Mathematical
physics writes #{P_i} or #{\pi_i}, and geometric calculus writes #{P}
for a projection. Extension by zero keeps #{\iota_i}. The letter
#{\pi} is not this projection.}
