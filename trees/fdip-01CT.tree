\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Proposition}
\title{The fixed point fixes the rescaling}
\date{2026-11-28}

\p{Keep the hierarchical spaces, class means and lifts of the
\vocabk{blocking step}{fdip-01CJ}. If the field rescaling
#{\sqrt{p\lambda}} is replaced by #{\sqrt{p\mu}} with #{\mu>0},
then on hierarchical operators
##{\Phi_{\mu,k}=\frac{\lambda}{\mu}\Phi_{\lambda,k}.}
Every operator scaling eigenvalue is multiplied by #{\lambda /\mu},
so the ratio of two such eigenvalues is unchanged.}

\p{For #{a>0} and #{\rho>0}, the nonnegative operator family
##{J_k=a\sum_{j<k}\rho^jP_j^{(k)}}
satisfies #{\Phi_{\mu,k}(J_k)=J_{k-1}} at every depth exactly when
#{\mu=\rho}. These operators vanish on constants. A positive
\vocabk{fixed tower}{fdip-01CJ} with these lower coefficients has
precisely the form
##{Q_k=J_k+b\rho^kP_k^{(k)},\qquad b>0,}
and uses the rescaling #{\sqrt{p\rho}}.}

\proof{
\p{The two definitions are #{\mu^{-1}A_kQS_k} and
#{\lambda^{-1}A_kQS_k}, proving the first identity and its effect
on each positive eigenvalue. The projector shift gives
##{\Phi_{\mu,k}(J_k)=\frac{\rho}{\mu}J_{k-1}.}
At #{k=2} the operator #{J_1=aP_0^{(1)}} is nonzero, so equality
at all depths forces #{\rho /\mu=1}. Conversely that condition
gives equality at every depth, including the zero operator at depth
zero. The final assertion is the fixed-tower classification in
\ref{fdip-01CL}, with its ratio set to #{\rho}.}
}
