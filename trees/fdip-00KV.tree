\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Definition}
\title{Normalized conditional functionals}
\date{2026-11-10}

\p{Let #{k} be a commutative ring, and let #{B\subseteq A} be unital associative #{k}-algebras with the same unit. The inclusion may be #{\mathbb{Z}/2}-graded. In the graded case every map in this definition is even, and the ungraded case is the trivial grading. A \newvocab{normalized conditional functional} of #{A} onto #{B} is a #{k}-linear map #{E:A\to B} satisfying
##{E(1)=1,\qquad E(b_1ab_2)=b_1E(a)b_2}
for all #{b_1,b_2\in B} and #{a\in A}. Taking #{a=1} gives #{E(b)=b} for every #{b\in B}, so the map is a retraction onto #{B}.}
