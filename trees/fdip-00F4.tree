\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Remark}
\title{The sign names the generator}
\date{2026-11-07}

\p{The identity in \ref{fdip-00F3} fixes #{H_\mu} on its
domain. No norm bound is proved for a difference between
#{H_\mu} and a Laplacian on #{V_n}.
\citet{Definition 3.10}{kigami1996kokyuroku} normalizes the
discrete operators by the cell integrals of the harmonic
extensions. \citet{Theorem 3.11}{kigami1996kokyuroku} equates
the energy with a boundary sum on #{V_0} minus the integral
against that pointwise operator, and it places the pointwise
domain inside #{F}. The boundary sum vanishes when the test
function vanishes on #{V_0}.}
