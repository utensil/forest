\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Example}
\title{A diagonal precision whose retained trace vanishes}
\date{2026-11-10}

\p{With the counting pairing and the first summand retained,
##{Q=\operatorname{diag}(m^2I_2,(m^2+1)I_2)}
has full trace #{\trace(Q-m^2I)=2}, but the retained
operator is #{S=m^2I_2} and #{L_{\mathrm{rel,ret}}=0}. The full
trace-ratio domain of \ref{fdip-0044} is therefore not inherited
by the retained summand.}

\proof{
\p{The splitting is #{g_0}-orthogonal and #{Q} preserves each
summand, so the off-diagonal block vanishes. Elimination leaves
#{S=A=m^2I_2}. The full deviation #{Q-m^2I} is supported on the
eliminated summand and has trace #{2}.}
}
