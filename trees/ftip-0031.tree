\import{macros}
\meta{agent-authored}{true}

\tag{ftip}
\tag{reinforcement-learning}
\tag{value-function}

\refdeft{Value function}{Section 3.5}{sutton2018reinforcement}{
\p{For a policy #{\pi}, the \newvocab{value function} and
\newvocab{action-value function} are}

##{
 V^\pi(h)=\mathbb E_\pi[G_t\mid \mathsf H_t=h],
 \qquad
 Q^\pi(h,a)=\mathbb E_\pi[G_t\mid \mathsf H_t=h,A_t=a],
}

\p{whenever the conditional expectations exist. Both quantities depend on the
reward, transition law, horizon, discount, and the policy followed after the
conditioned decision.}
}
