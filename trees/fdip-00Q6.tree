\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Lemma}
\title{A reflection is an isometry}
\date{2026-11-12}

\p{Let #{\theta} be a \vocabk{reflection}{fdip-00PX}. Then
#{q_{\theta x}(\theta v)=q_x(v)} for every vector #{v} in the
fibre at #{x}.}

\proof{
\p{By \ref{fdip-00PB}, the value
#{q_x(e_x\,\covwedge f)} equals #{(L(f^2)-2f\,Lf)(x)}, and these
vectors span the fibre. Set #{\phi=f\circ\theta}. Commutation
with #{L} and with #{\covwedge} gives
##{(L(\phi^2)-2\phi\,L\phi)(\theta x)
 =(L(f^2)-2f\,Lf)(x).}
The same identities send #{e_x\,\covwedge f} to
#{e_{\theta x}\,\covwedge\phi}. Therefore the two quadratic
forms agree on every vector of the fibre.}
}
