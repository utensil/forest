\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Example}
\title{An equivariant endomorphism is diagonal}
\date{2026-11-21}

\p{Let #{h} and #{v} be the stabilizer element and the fixed
vector of \ref{fdip-013D}. Let the fermion fiber be
#{\mathbb C^2}, with the homomorphism of \ref{fdip-0126} as
its representation. Equivariance of a [Yukawa map](fdip-011M)
makes #{Y(v)} commute with the matrix of #{h}. In the
eigenbasis of \ref{fdip-013D}, that
endomorphism is diagonal. The eigenvalues of #{m{\bbI}+Y(v)}
are #{m+y_1} and #{m+y_2}.}

\proof{
\p{Equivariance gives
#{Y(hv)=\rho_\psi(h)Y(v)\rho_\psi(h)^{-1}}. \ref{fdip-0126}
shows that #{h} fixes #{v}, so
#{Y(v)=\rho_\psi(h)Y(v)\rho_\psi(h)^{-1}}, and #{Y(v)}
commutes with the matrix of #{h}. Let #{u} be the
#{\mu}-eigenvector of \ref{fdip-013D}. The matrix applied to
#{Y(v)v} equals #{Y(v)} applied to the image of #{v}. That
image is #{v}, so the matrix fixes #{Y(v)v}, and #{Y(v)v}
lies on the line through #{v}. The matrix sends #{u} to
#{\mu u}, so the matrix applied to #{Y(v)u} equals #{Y(v)}
applied to #{\mu u}. Linearity rewrites that value as
#{\mu Y(v)u}, and #{Y(v)u} lies on the line through #{u}.
In this basis #{Y(v)} is diagonal. Write its diagonal
entries as #{y_1} and #{y_2}. Adding #{m{\bbI}} adds #{m}
to each of them, so the eigenvalues are #{m+y_1} and
#{m+y_2}.}
}
