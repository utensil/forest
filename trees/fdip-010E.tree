\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Definition}
\title{Marginal weights and conditional functionals}
\date{2026-11-19}

\p{For an \vocabk{orbit gauge–Higgs weight}{fdip-010A} over #{k},
use unnormalized counting on links and sites. Its \newvocab{connection
marginal weight}, \newvocab{scalar marginal weight} and partition
coefficient are
##{\begin{aligned}
 w_{\rm link}(U)&=\sum_{\phi\in\mathcal O^X}\Xi(U,\phi),\\
 w_{\rm site}(\phi)&=\sum_{U\in G^E}\Xi(U,\phi),\\
 Z&=\sum_{U,\phi}\Xi(U,\phi).
\end{aligned}}
For a #{k}-module-valued observable #{f} the joint weighted value
is #{\sum_{U,\phi}\Xi(U,\phi)f(U,\phi)}. If #{Z} is a unit,
division by #{Z} defines its normalized linear functional
#{\langle f\rangle}.}

\p{At a fixed #{U} for which #{w_{\rm link}(U)} is a unit, the
conditional scalar functional acts by
##{f\longmapsto w_{\rm link}(U)^{-1}
                 \sum_\phi\Xi(U,\phi)f(U,\phi).}
At fixed #{\phi} the conditional link functional is defined by
summing over #{U} and dividing by #{w_{\rm site}(\phi)} when that
coefficient is a unit. Over the reals with #{\Xi\ge0} and #{Z>0}
the normalized joint weight defines a probability law. The
corresponding normalized conditional weights define probabilities
at backgrounds of positive marginal weight.}
