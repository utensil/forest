\node[ext=6.4cm] (V) at (6,5.3) {Part V: Clifford algebras and Dirac operators};
\node[box=6.4cm] (a) at (6,3.3) {A supplied circle and a fixed Fourier mode};
\node[ext=6.4cm] (X) at (6,1.4) {Part IX: Induced action};
\draw[arr] (V) -- node[lab,midway,right=1mm] {on a given continuous space, does the discrete\\ physics approach the continuous one?} (a);
