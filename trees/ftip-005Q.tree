\import{macros}
\meta{agent-authored}{true}

\refdeft{Pareto-optimal objective vector}{Section 4.7.4}{boyd2004convex}{
\p{A feasible vector #{v} is \strong{Pareto optimal} when there is no feasible
#{v'} with #{v'_j\geq v_j} in every coordinate and a strict inequality in at
least one coordinate. The Pareto frontier is the set of such vectors.}

\p{This order preserves visible tradeoffs. It does not choose one point on the
frontier.}
}
