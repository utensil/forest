\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Definition}
\title{A central twist across one periodic cut}
\date{2026-11-17}

\p{Let #{X=\prod_{j=1}^n\mathbb Z/N_j\mathbb Z}
with the labeled positive edges of the
\vocabk{coefficient connection}{fdip-00SH}.
Choose a direction #{i} and a central element
#{z\in Z(G)}. The \newvocab{central cut twist}
#{U\mapsto U^{(z)}} multiplies each positive link
#{U_i(x)} with #{x_i=N_i-1} by #{z}, and leaves
all other positive links unchanged. The inverse
traversal uses the inverse of the new link, and thus
acquires #{z^{-1}}. Twisting by #{z^{-1}} is the
inverse permutation of configurations.}

\p{For a base vertex #{x}, let #{h_i(U;x)} be
the represented transport around the #{N_i} positive
edges in direction #{i}, starting and ending at #{x}.
The \newvocab{Polyakov trace} at that vertex is
##{L_i(U;x)=\trace_F h_i(U;x).}
The path product uses the rightmost-first convention
of the \vocabk{dressed pair}{fdip-00WD}.}
