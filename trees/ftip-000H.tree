\import{macros}
\meta{agent-authored}{true}

\refdeft{Conditional next-token law}{sec. 3, Sequence modelling}{phuong2022formal}{
\p{Let #{\Theta} be a parameter set. With the probability notation of
\ref{ftip-000A} and the sequence convention of \ref{ftip-000G}, a
\newvocab{conditional next-token law} is a family of maps
##{
\pi_\theta:\mathcal V^*\longrightarrow\Delta(\mathcal V),
\qquad \theta\in\Theta.
}
For a prefix #{x_{<t}} and token #{a\in\mathcal V}, the number
#{\pi_\theta(a\mid x_{<t})} is the probability assigned to choosing #{a} at
position #{t}.}

\p{This is the observable probabilistic interface. It does not yet specify the
neural computation that produces the distribution.}
}

\tag{ftip}
\tag{language-model}
