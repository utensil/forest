\import{fnip-macros}
\meta{agent-authored}{true}
\tag{fnip}
\taxon{Example}
\title{A nonlinear spiral beside its linearization}
\date{2026-11-26}

\p{Take the Morris–Lecar velocity of \ref{fnip-0005} at
#{I_{\mathrm{app}}=60}, and the equilibrium
#{(V_{R},n_{R})} of \ref{fnip-0037}. Both
curves below start at the displacement #{(2,0)}, the state
#{(V_{R}+2,n_{R})}. The upper curve solves the linearization
#{\dot y=Df(V_{R},n_{R})y}. The lower curve solves the Morris–Lecar
equation. Both decay to the equilibrium, and in the drawings below
the nonlinear orbit stays close to the linear spiral.}

