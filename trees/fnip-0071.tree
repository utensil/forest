\import{fnip-macros}
\meta{agent-authored}{true}
\tag{fnip}
\taxon{Definition}
\title{The Hodgkin–Huxley system}
\date{2026-11-26}

\p{Let #{V} be the voltage in the \vocabk{membrane equation}{fnip-0066}.
For a variable #{x} with values in the unit interval, the
\newvocab{activation equation} is
##{\dot x=(x_{\infty}(V)-x)/\tau_{x}(V).}
The steady value #{x_{\infty}(V)} and the time constant
#{\tau_{x}(V)} depend only on #{V}.
\citet{(1.34) and (1.35), §1.8, p. 19}{ermentrout2010mathematical}
is this equation for #{m}, and gives the solution when #{V} is
constant,
##{x(t)=x_{\infty}(V)+(x(0)-x_{\infty}(V))e^{-t/\tau_{x}(V)}.}
On p. 23 the variables #{n}, #{m}, and #{h} all satisfy that
equation.
\citet{p. 38}{izhikevich2007dynamical} writes the same form for
each of them.}

\p{The potassium and sodium conductances are
##{g_{\mathrm{K}}=\bar g_{\mathrm{K}} n^{4},\qquad
   g_{\mathrm{Na}}=\bar g_{\mathrm{Na}} m^{3}h,}
as in \citet{(1.41), p. 22}{ermentrout2010mathematical}.
The steady values of #{n} and #{m} increase with #{V}, and the
steady value of #{h} decreases as #{V} increases.
\citet{(1.42), p. 23}{ermentrout2010mathematical} is
##{X_{\infty}(V)=\frac{\alpha_{X}(V)}{\alpha_{X}(V)+\beta_{X}(V)},
   \qquad
   \tau_{X}(V)=\frac{1}{\alpha_{X}(V)+\beta_{X}(V)},}
where #{X} stands for #{n}, #{m}, or #{h}. The rate functions are
the unnumbered list on pp. 23–24:
##{\alpha_{n}(V)=\frac{0.01(V+55)}{1-\exp(-(V+55)/10)},\qquad
   \beta_{n}(V)=0.125\exp(-(V+65)/80),}
##{\alpha_{m}(V)=\frac{0.1(V+40)}{1-\exp(-(V+40)/10)},\qquad
   \beta_{m}(V)=4\exp(-(V+65)/18),}
##{\alpha_{h}(V)=0.07\exp(-(V+65)/20),\qquad
   \beta_{h}(V)=\frac{1}{1+\exp(-(V+35)/10)}.}
The quotient for #{\alpha_{n}} has limit #{0.1} at #{V=-55}, and
the quotient for #{\alpha_{m}} has limit #{1} at #{V=-40}.}

\p{The maximal conductances and the reversal potentials on p. 23 are
##{\bar g_{\mathrm{Na}}=120,\ 
   \bar g_{\mathrm{K}}=36,\ 
   \bar g_{\mathrm{L}}=0.3,}
in #{{\mathrm{mS}}/{\mathrm{cm}}^{2}}, and
##{E_{\mathrm{Na}}=50,\ 
   E_{\mathrm{K}}=-77,\ 
   E_{\mathrm{L}}=-54.4,}
in millivolts. That page prints the maximal conductances in
#{{\mathrm{mS}}/{\mathrm{cm}}^{3}}. The capacitance is
#{C=1\,\mu\mathrm{F}/\mathrm{cm}^{2}}, the value on
\citet{p. 38}{izhikevich2007dynamical}. Equation (1.43) prints
#{c_{\mathrm{M}}} and gives it no value. The same page of
Izhikevich shifts the voltage by about #{65} mV so that rest lies
at #{0}, and then shifts it back so that rest lies near #{-65} mV.
The rate functions above are the voltages on pp. 23–24, not the
shifted rates on pp. 37–38.}

\p{The \newvocab{Hodgkin–Huxley system} is
##{C\dot V=I_{\mathrm{app}}
   -\bar g_{\mathrm{Na}} m^{3}h(V-E_{\mathrm{Na}})
   -\bar g_{\mathrm{K}} n^{4}(V-E_{\mathrm{K}})
   -\bar g_{\mathrm{L}}(V-E_{\mathrm{L}}),}
##{\dot n=\phi(n_{\infty}(V)-n)/\tau_{n}(V),\quad
   \dot m=\phi(m_{\infty}(V)-m)/\tau_{m}(V),\quad
   \dot h=\phi(h_{\infty}(V)-h)/\tau_{h}(V).}
\citet{(1.43), p. 25}{ermentrout2010mathematical} is the
space-clamped system with no applied current. The voltage equation
here adds #{I_{\mathrm{app}}}, and the three equations for
#{n}, #{m}, and #{h} are that system written through (1.42).
The temperature factor is
##{\phi=Q_{10}^{(T-T_{\mathrm{base}})/10}.}
\citet{(1.44), p. 25}{ermentrout2010mathematical} takes
#{Q_{10}=3} and #{T_{\mathrm{base}}=6.3^{\circ}\mathrm{C}} for the
squid axon, so #{\phi=1} at #{6.3^{\circ}\mathrm{C}}. The state in
the order of these equations, and of
\citet{§2.3.1, pp. 37–38}{izhikevich2007dynamical}, is
#{(V,n,m,h)}. \citet{p. 58}{izhikevich2007dynamical} calls the state
the four-dimensional vector #{(V,m,n,h)}.}

