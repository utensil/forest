\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Example}
\title{The double-coset count on the residual orbit}
\date{2026-11-21}

\p{On the residual orbit of \ref{fdip-0126}, the number of
double cosets equals the sum of the squares of the invariant
dimensions in \ref{fdip-013G}. \ref{fdip-013H} gives a
preserved space of that rank.}

\proof{
\p{\ref{fdip-013G} identifies the number of double cosets
with that sum. \ref{fdip-012D} shows that the indicators of
the double cosets form a basis of the preserved space, so
the rank in \ref{fdip-013H} equals the same number.}
}
