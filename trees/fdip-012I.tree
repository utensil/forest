\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Example}
\title{The residual orbit has 12 double cosets}
\date{2026-11-21}

\p{For the stabilizer of order three in \ref{fdip-0126}, the
number of double cosets is #{12}. \ref{fdip-013H} therefore
gives a preserved space of that rank.}

\proof{
\p{\ref{fdip-0126} counts #{6} double cosets in the centralizer
and #{6} among the remaining elements. The total is #{12}.}
}
