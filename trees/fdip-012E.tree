\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Proposition}
\title{A class-function kernel acts by a scalar on an irreducible}
\date{2026-11-21}

\p{Let #{\rho} be an irreducible representation of a finite group
#{G} on a finite-dimensional vector space over #{\mathbb C}, and
let #{\mathcal K} be a class-function kernel with complex values.
The operator
##{\sum_{g\in G}\mathcal K(g)\rho(g)}
commutes with every #{\rho(h)}. Take one complex eigenvalue of
this intertwiner, as in the eigenvalue step of \ref{fdip-008B}.
The intertwiner is then scalar, so the sum equals #{a_\rho\bbI}.
The trace gives
##{a_\rho\dim\rho=\sum_{g\in G}\mathcal K(g)\trace\rho(g).}
The dimension is a positive integer, hence invertible in
#{\mathbb C}.}

\proof{
\p{Substitute #{g=hgh^{-1}} in the sum that defines the composite
of the displayed operator with #{\rho(h)}. The class-function
identity replaces #{\mathcal K(hgh^{-1})} by #{\mathcal K(g)},
and the factors #{\rho(h)} and #{\rho(h)^{-1}} reassemble into
left multiplication by #{\rho(h)}. Thus the displayed operator
commutes with #{\rho(G)}. The eigenvalue step of \ref{fdip-008B}
takes one complex eigenvalue of this intertwiner. Its eigenspace
is invariant under #{\rho(G)}, and irreducibility makes that
eigenspace the whole space, so the operator equals #{a_\rho\bbI}.
Taking the trace produces the displayed formula.}
}
