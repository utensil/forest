\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Lemma}
\title{A finite span of simultaneous word evaluations}
\date{2026-11-26}

\p{Take two ordered pairs of Hermitian endomorphisms
#{(A,B)} on #{E} and #{(A',B')} on #{E'}, with both complex
Hermitian spaces of dimension #{d\ge1}. In
#{\operatorname{End}(E)\oplus\operatorname{End}(E')}
form simultaneous evaluations #{(w(A,B),w(A',B'))},
using the words in \vocabk{ordered Gram pairs}{fdip-018P}.
Those of length at most #{2d^2-1} span the complex unital
algebra generated by #{(A,A')} and #{(B,B')}. This algebra is
closed under the Hermitian adjoint. Equality of the two traces
on these tested words is equivalent to equality of the two
coordinate traces on every element of the algebra.}

\proof{
\p{Let #{L_l} span the evaluations through length #{l}.
The empty word alone spans #{L_0}, of dimension one. With
#{X=(A,A')} and #{Y=(B,B')}, extending a word on the right
gives #{L_{l+1}=L_l+L_l X+L_l Y}. At an equality of
successive spaces this recursion leaves all subsequent spaces
unchanged. If every inclusion up to #{L_{2d^2-1}} is strict,
that space already has dimension at least #{2d^2}, the
dimension of the entire ambient direct sum. In either case
the bounded words span all words. Their span contains the
identity and is closed under multiplication by concatenation.
A word's adjoint is the reversed word since both generators
are self-adjoint. The two coordinate traces are complex-linear,
so agreement on the spanning evaluations gives agreement on
every element. The converse follows by restriction.}
}
