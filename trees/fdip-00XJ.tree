\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Proposition}
\title{Positive sums with one common reflection}
\date{2026-11-17}

\p{Let #{\ell_1,\ldots,\ell_r} be
\vocabk{reflection-compatible functionals}{fdip-00XF}
on the same #{\mathscr A}, with the same #{\Theta} and
#{\mathscr A_+}. Suppose each is reflection positive there.
For #{c_j\in k_0} with #{c_j\ge0}, the functional
#{\ell=\sum_jc_j\ell_j} is reflection compatible and reflection
positive. If #{Z=\ell(1)>0}, so is the normalized functional
#{Z^{-1}\ell}.}

\proof{
\p{Conjugation fixes each #{c_j}, so compatibility is
preserved by the sum. For #{a\in\mathscr A_+},
##{B_\ell(a,a)=\sum_jc_jB_{\ell_j}(a,a)\ge0.}
Division by #{Z>0} preserves the inequality and makes
the value at #{1} equal to one.}
}

\p{For the finite Gram matrices, nonnegative scaling and
summation are the components
\leanref{Matrix.PosSemidef.smul} and
\leanref{Matrix.posSemidef_sum}. The common reflection
and half-space are explicit hypotheses; a result restricted
to reflection-fixed link fields supplies no such assertion
for the other link fields.}
