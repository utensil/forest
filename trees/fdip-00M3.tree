\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Remark}
\title{Coordinate evaluation of the matter Gaussian}
\date{2026-11-10}

\p{For the fixed connection of \ref{fdip-0070}, orthogonal or
unitary diagonalization reduces the integral to positive eigenvalues
#{\lambda_1,\ldots,\lambda_N}. In an ordered orthonormal eigenbasis,
each real coordinate contributes #{\lambda_j^{-1/2}} by the
[real Gaussian integral](fdip-002T); each complex coordinate
contributes #{\lambda_j^{-1}} by the [complex integral](fdip-006I).
The product of these factors is
#{(\det_{\mathbb K}Q_U)^{-\kappa}}. The same basis identifies the
operator #{\phi\phi^{\dagger}} with the rank-one matrix whose entries are
the coordinates of #{\phi} times the conjugate coordinates.}
