\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Discussion}
\title{Which action do exterior coefficients carry?}
\date{2026-11-17}

\p{The affine link group already acts on internal vectors by
#{\rho}. Applying that action to every factor of an exterior
product is a candidate action on #{E}. Does it preserve the
pairing, and what does the scalar Clifford element #{-1} do to
these coefficients?}
