\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Proposition}
\title{The selected shape differs from the finite-range operator}
\date{2026-11-07}

\p{Fix #{m>0} and #{\kappa>0}, and set #{\mu=\kappa m^2}. For
the nearest-neighbor coefficients #{c_1=c_{-1}=\kappa} and
an integer #{N>2}, let the sites be the residues modulo
#{N}. Let #{T} be the cyclic shift #{(Tf)(j)=f(j-1)}. The
offsets #{\pm 1} are distinct because #{N>2}. Define
##{Q_N=(\mu+2\kappa N^2)I-\kappa N^2(T+T^{-1}).}
This is the \vocabk{finite-range circle precision}{fdip-00C8}
for those coefficients. Its shape, the ratio of the diagonal
coefficient to twice the neighbor coefficient, equals
#{1+m^2/(2N^2)}. The shape
selected by \ref{fdip-00AY} equals #{\cosh(m/N)}. The
difference is at least #{(m/N)^4/24}.}

\p{Remark. Declare the counting basis of site indicators. In
that basis #{Q_N} has diagonal #{\mu+2\kappa N^2} and neighbor
entries #{-\kappa N^2}.}

\proof{
\p{The shift formula acts by
##{(Q_Nx)(j)=(\mu+2\kappa N^2)x(j)
-\kappa N^2 x(j-1)-\kappa N^2 x(j+1).}
That is #{Q_N=\mu I+N^2A_N} for the operator #{A_N} of
\ref{fdip-00C8}. The diagonal coefficient is #{\mu+2\kappa N^2}. The
coefficient of #{T+T^{-1}} is #{-\kappa N^2}, so the neighbor
coefficient is #{\kappa N^2} and the shape is
##{\frac{\mu+2\kappa N^2}{2\kappa N^2}
=1+\frac{\mu}{2\kappa N^2}
=1+\frac{m^2}{2N^2}.}
\ref{fdip-00AY} gives the selected shape #{\cosh(m/N)}.}

\p{Set #{\varphi(u)=\cosh u-1-u^2/2}. Then
#{\varphi(0)=\varphi'(0)=\varphi''(0)=0},
#{\varphi'''(u)=\sinh u}, and #{\varphi''''(u)=\cosh u}. The
integral remainder is
##{\varphi(u)
=\int_0^u\frac{(u-t)^3}{6}\cosh t\,dt.}
For #{u>0} the integrand is at least #{(u-t)^3/6}, so
#{\varphi(u)\ge u^4/24}. Taking #{u=m/N} shows that the
selected shape exceeds the shape of #{Q_N} by at least
#{(m/N)^4/24}.}
}
