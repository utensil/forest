\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Example}
\title{Pairing values for the residual orbit}
\date{2026-11-21}

\p{On the group of \ref{fdip-0126}, the normalized real
pairing of \ref{fdip-012N} takes the values #{1}, #{1/2}, #{0},
#{-1/2} and #{-1}, on #{3}, #{24}, #{18}, #{24} and #{3} elements
respectively.}

\proof{
\p{The powers of #{\gamma} have real and imaginary parts
##{(1,0),\;
 \bigl(\tfrac12,\tfrac{\sqrt{3}}{2}\bigr),\;
 \bigl(-\tfrac12,\tfrac{\sqrt{3}}{2}\bigr),\;
 (-1,0),\;
 \bigl(-\tfrac12,-\tfrac{\sqrt{3}}{2}\bigr),\;
 \bigl(\tfrac12,-\tfrac{\sqrt{3}}{2}\bigr)}
in the order #{\gamma^0} through #{\gamma^5}. If the unphased
value is #{x+\ui y}, the phased real part at exponent #{m} is
#{x\operatorname{Re}\gamma^m+y\operatorname{Im}\gamma^m}. The
quotient identifies #{\,[u,m]\,} with #{\,[-u,m+3]\,}, so each
unordered pair #{\{u,-u\}} contributes #{6} classes, one for each
phase of #{u}. There are #{4} such pairs among the Lipschitz units
and #{8} among the half-integer units.}

\p{For #{\{1,-1\}} take #{u=1}. Then #{x=1} and #{y=0}, and the
#{6} real parts are the real parts of the powers:
#{1}, #{1/2}, #{-1/2}, #{-1}, #{-1/2}, #{1/2}. For
#{\{\pm\qi\}}, #{\{\pm\qj\}} and #{\{\pm\qk\}}, one coordinate
among #{b,c,d} equals #{\pm1} and the others vanish, so
#{y=\mp\sqrt{3}/3} and #{x=0}. The representative with
#{y=\sqrt{3}/3} has real parts
#{0}, #{1/2}, #{1/2}, #{0}, #{-1/2}, #{-1/2}, because
#{\tfrac{\sqrt{3}}{2}\cdot\tfrac{\sqrt{3}}{3}=\tfrac12}. The three
pairs contribute #{6} zeros and #{6} copies of each of #{\pm1/2}.}

\p{For a half-integer unit the representative with #{a=-1/2} has
#{x=-1/2} and #{y=-(b+c+d)\sqrt{3}/3}. The sum of three signs
#{\pm1/2} equals #{\pm3/2} for the two units in which #{b,c,d}
share a sign, and equals #{\pm1/2} for the other #{6}. The value
#{y=\sqrt{3}/2} gives the #{6} real parts
#{-1/2}, #{1/2}, #{1}, #{1/2}, #{-1/2}, #{-1}: the third is
##{\bigl(-\tfrac12\bigr)\bigl(-\tfrac12\bigr)
 +\tfrac{\sqrt{3}}{2}\cdot\tfrac{\sqrt{3}}{2}=1,}
and the sixth is
##{\bigl(-\tfrac12\bigr)\bigl(\tfrac12\bigr)
 +\tfrac{\sqrt{3}}{2}\bigl(-\tfrac{\sqrt{3}}{2}\bigr)=-1.}
The value #{y=-\sqrt{3}/2} exchanges the roles of #{\gamma} and
#{\gamma^5} and gives
#{-1/2}, #{-1}, #{-1/2}, #{1/2}, #{1}, #{1/2}. Together these two
pairs contribute two copies of each of #{\pm1} and #{4} copies of
each of #{\pm1/2}. The value #{y=\sqrt{3}/6} gives
#{-1/2}, #{0}, #{1/2}, #{1/2}, #{0}, #{-1/2}, since
##{\bigl(-\tfrac12\bigr)\bigl(\tfrac12\bigr)
 +\tfrac{\sqrt{3}}{2}\cdot\tfrac{\sqrt{3}}{6}=0.}
The value #{y=-\sqrt{3}/6} gives
#{-1/2}, #{-1/2}, #{0}, #{1/2}, #{1/2}, #{0}. Three pairs of each
kind contribute #{12} zeros and #{12} copies of each of #{\pm1/2}.}

\p{Adding these contributions gives #{3} elements of pairing #{1},
#{24} of pairing #{1/2}, #{18} of pairing #{0}, #{24} of pairing
#{-1/2}, and #{3} of pairing #{-1}.}
}
