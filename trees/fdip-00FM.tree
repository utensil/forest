\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Theorem}
\title{Asymptotic coefficients give the same cell laws}
\date{2026-11-07}

\p{Fix an integer #{p\ge 2}, a depth #{k\ge 0}, and real
numbers #{\lambda>0} and #{m>0}. Let the coefficients
#{(c_j)} and the top coefficients #{\tau_K} satisfy the
hypotheses of \ref{fdip-00C6}, and let #{S_K\xi^{(K)}} be the
pushed field of that theorem. Multiplication by
#{(p\lambda)^{k/2}} sends #{S_K\xi^{(K)}} to a random
function on the residues modulo #{p^k}. As #{K\to\infty}, the
law of this function converges to the law of the cell density
#{F_k=(p\lambda)^{k/2}x_k} formed from the
\vocabk{fixed-ratio precision}{fdip-00BY}. Equivalently, the
joint law of the rescaled ball values converges to the joint
law of #{(M_k(r))}. The conclusion places no restriction on
the product #{p\lambda}.}

\proof{
\p{\ref{fdip-00C6} states that the law of #{S_K\xi^{(K)}} on
the fixed finite residue ring converges to #{\nu_k}. A bounded
continuous function of that finite-dimensional vector may be
composed with multiplication by the constant
#{(p\lambda)^{k/2}}. The composite remains bounded and
continuous. Integrals against the pushed laws therefore
converge to the integral against the image of #{\nu_k}. That
image is the law of #{F_k}. Division by #{p^k} is a further
continuous map, and \ref{fdip-00FA} identifies
#{p^{-k}F_k(r)} with #{M_k(r)} for #{k\ge 1}. At depth #{0}
both the cell value and the ball value equal #{x_0}. The
argument uses the coefficient hypotheses of \ref{fdip-00C6}
as stated there, including every #{\lambda>0}.}
}
