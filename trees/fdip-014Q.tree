\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Definition}
\title{Staggered operators and site parity}
\date{2026-11-23}

\p{Let #{n\ge1}, #{a>0}, and let the periodic grid
#{\Lambda=\prod_j\mathbb Z/N_j\mathbb Z} have even periods
#{N_j\ge3}. Use representatives #{0\le x_j<N_j} and write
#{|x|=\sum_j x_j}. On fields with values in a nonzero
finite-dimensional complex Hermitian space #{F}, use the
\vocabk{unitary shifts}{fdip-009O} of a unitary connection #{U}.
Here #{e_j} is the unit site step. The forward shift at #{x}
takes the value at #{x+e_j} back by #{U_j(x)^{-1}}, and its
inverse takes the value at #{x-e_j} forward by #{U_j(x-e_j)}.}

\p{The \newvocab{staggered operator} on
#{\ell^2(\Lambda)\otimes F} is
##{D^{\mathrm{st}}_{a,U}=\frac{1}{2a}\sum_{j=1}^n
(-1)^{x_1+\cdots+x_{j-1}}\bigl(T_j^U-(T_j^U)^{-1}\bigr).}
Each sign multiplies the output at #{x}. An empty sum in the
exponent is zero. The \newvocab{site parity} is multiplication
by #{(-1)^{|x|}}. The preceding-coordinate signs occur in
\citet{Section 9.4, Eqs. (9.22)–(9.23), p. 23}{wingate2025lattice}.}
