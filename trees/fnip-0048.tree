\import{fnip-macros}
\meta{agent-authored}{true}
\tag{fnip}
\taxon{Theorem}
\title{Stable manifold theorem}
\date{2026-11-26}

\p{Let #{x_{*}} be a \vocabk{hyperbolic}{fnip-0034}
\vocabk{equilibrium}{fnip-0014} of #{\dot x=f(x)}, with #{f}
smooth. There is a neighborhood #{U} of #{x_{*}} in which the
\vocabk{local stable manifold}{fnip-0044} and the
\vocabk{local unstable manifold}{fnip-0044} are manifolds of the
same dimensions as the stable and unstable eigenspaces of
#{Df(x_{*})}, tangent to those eigenspaces at #{x_{*}}, and as
smooth as #{f}.}

\p{\citet{Theorem 1.3.2, §1.3, pp. 13–14}{guckenheimer1983nonlinear}
is this statement for a hyperbolic fixed point. In the plane, each
manifold of a saddle is a curve.
\citet{Theorem 2.1, §2.2.1, pp. 46–47}{kuznetsov2004elements}
is the companion: the intersections of the stable and unstable sets
with a small neighborhood contain smooth submanifolds of dimensions
#{n_{-}} and #{n_{+}}, tangent to the generalized eigenspaces of
negative and positive real part.
\citet{§4.3.2, pp. 109–110}{izhikevich2007dynamical} calls the
orbits that converge to a saddle its separatrices. They form the
stable manifold, and locally they are parallel to the eigenvector of
the negative eigenvalue. The two orbits that leave the saddle form
the unstable manifold, and locally they are parallel to the
eigenvector of the positive eigenvalue.}
