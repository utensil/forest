\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Example}
\title{One restriction under a group automorphism}
\date{2026-11-26}

\p{Let #{g} generate the cyclic group of order #{7}, let
#{\zeta} be a primitive seventh root, and take the automorphism
#{\alpha(g)=g^2}. On two complex lines let #{g} act by
#{\zeta} on #{V_+} and by #{\zeta^4} on #{V_-}. Compare this
graded representation with itself using #{\alpha} in
\ref{fdip-018D}. A coordinate identification from #{V_+} to
#{V_-} is a linear intertwiner for this pullback since
#{(\zeta^4)^2=\zeta}. The reverse identification would require
#{\zeta^4=\zeta^2}. These powers differ, and every linear
intertwiner on this second leg vanishes. Thus one restriction
can be invertible while the prescribed pullback prevents a
linear exchange.}
