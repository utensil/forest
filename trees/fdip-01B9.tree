\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Proposition}
\title{Support and variation of the boundary correction}
\date{2026-11-27}

\p{Cut a nearest-neighbor self-adjoint operator into an interior #{I} and a retained region #{J}. Use the compressions #{A,D}, coupling #{C} and reduced operator #{S} of \ref{fdip-01B5}, with #{A} invertible. Let #{\Pi} project onto retained sites adjacent to the interior. Then
##{D-S=\Pi C^\dagger A^{-1}C\Pi.}
For a second invertible interior restriction #{A'} with the same #{C,D}, the corresponding #{S'} satisfies
##{S'-S=C^\dagger (A')^{-1}(A'-A)A^{-1}C.}
If #{S} is invertible and #{\|C\|^2\|(A')^{-1}\|\,\|A'-A\|\,\|A^{-1}\|} is less than the least gain of #{S}, then #{S'} and #{S} have equal sign dimensions.}

\proof{
\p{Locality of each individual hop gives #{C=C\Pi}. Insert this identity on both sides of the interior inverse in the Schur complement of \ref{fdip-01B5}. To compare the two restrictions, use #{A^{-1}-(A')^{-1}=(A')^{-1}(A'-A)A^{-1}}. Taking norms proves the stated bound on the difference of the reduced operators. Their forms retain their signs on both sign subspaces of #{S}, proving equality of dimensions. The total signs also agree when #{A} and #{A'} have equal inertia, by \ref{fdip-01B5}.}
}
