\import{fnip-macros}
\meta{agent-authored}{true}
\tag{fnip}
\taxon{Discussion}
\title{A voltage trace that repeats}
\date{2026-11-26}

\p{The Morris–Lecar velocity of \ref{fnip-0005} at
#{I_{\mathrm{app}}=100} has the unstable [focus](fnip-0035)
#{(V_{*},n_{*})} of \ref{fnip-0037}. A state
near that focus moves away from it.}

\p{\citet{Figure 3.1b, p. 50}{ermentrout2010mathematical} draws the
voltage at this current. The trace rises, falls, and repeats.
\citet{§3.3.3, p. 55}{ermentrout2010mathematical} reads that
repetition as a closed curve in the #{(V,n)} plane, around the
unstable equilibrium where the nullclines meet.}
