\import{macros}
\meta{agent-authored}{true}

\tag{ftip}
\tag{process-supervision}
\tag{reward-model}

\refdeft{Process-supervised reward model}{Section 2.6, ``Process-supervised reward models''}{lightman2023verify}{
\p{Suppose a response is segmented into reasoning steps
#{y=(s_1,\ldots,s_m)}. A \newvocab{process-supervised reward model} produces a
score for each declared prefix,}

##{
 r_{\mathrm{proc},\phi}(x,s_{\leq k})\in\mathbb R,
 \qquad 1\leq k\leq m,
}

\p{and is fitted from step-level labels. The segmentation rule and label
semantics are part of the supervision: a score after step #{k} need not be a
decomposition of an outcome score for the whole response.}
}
