\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Example}
\title{The scalar minus one is a unit rotation}
\date{2026-11-12}

\p{Let #{2\neq 0} in #{k}. The scalar #{-1} is a unit of #{k}, and
#{-1\neq 1}. \ref{fdip-00OB} places this scalar in the Clifford
group and gives #{\rho(-1)=\bbI}. For a plaquette whose
rotational holonomy equals #{-1}, the quotient of \ref{fdip-00OC}
is #{V} itself. The torsion is one vector. The same conclusion
holds for the identity rotation, and the two rotations are
distinct.}
