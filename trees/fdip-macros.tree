\export{macros}
\export{lean-macros}
\tag{macro}

% Operator marks. Each expands inside math.
\def\extd{\mathrm{d}}
\def\extD{\mathbf{D}}
\def\extdag{\mathrm{d}^{\dagger}}
\def\cov{\nabla}
\def\covdot{\nabla\cdot}
\def\covwedge{\nabla\wedge}
\def\covsq{\nabla^{2}}
\def\Wh{\mathrm{Wh}}
\def\Rh{\mathrm{Rh}}

% Named elements and displaced letters. Each expands inside math.
% \ii and \tr are already defined by the imported macros.
\def\bbI{\mathbb{I}}
\def\psI{\boldsymbol{I}}
\def\ui{\mathrm{i}}
\def\ue{\mathrm{e}}
\def\trace{\operatorname{tr}}
\def\sdim{\operatorname{sdim}}
\def\im{\operatorname{im}}
\def\spec{\operatorname{spec}}
\def\Spec{\operatorname{Spec}}
\def\pr{\mathrm{pr}}
\def\cW{\mathcal{W}}
\def\TT{\mathbb{T}}
\def\cl[body]{\overline{\body}}
\def\Dom[body]{\operatorname{Dom}\body}
\def\basic[body]{\operatorname{Open}(\body)}

% Finite exterior coefficients over a commutative ring.
\def\extexp{\operatorname{Exp}_{\Lambda}}
\def\divcoef[body][degree]{\body^{[\degree]}}
\def\adjugate{\operatorname{adj}}
\def\pfaffian{\operatorname{Pf}}

% Hamilton quaternion generators.
\def\qi{\boldsymbol{\mathrm{i}}}
\def\qj{\boldsymbol{\mathrm{j}}}
\def\qk{\boldsymbol{\mathrm{k}}}

% Cellular reflection and a transfer operator (not a translation).
\def\cellref{\mathscr R}
\def\transferop{\mathcal T}

% Normalized single-site blocking of an interaction potential.
\def\blockmap{\mathcal T_{\mathrm{blk}}}

% Proposed edge-direction operator, distinct from the matter Dirac operator.
\def\edgeop{\mathfrak{E}}

% A normalized section of a scalar orbit.
\def\orbitlift{\operatorname{lift}}

% Finite electroweak witness group.
\def\Gew{G_{\mathrm{ew}}}
