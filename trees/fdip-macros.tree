\export{macros}
\export{lean-macros}
\tag{macro}

% Operator marks. Each expands inside math.
\def\extd{\mathrm{d}}
\def\extD{\mathrm{D}}
\def\extdag{\mathrm{d}^{\dagger}}
\def\cov{\nabla}
\def\covdot{\nabla\cdot}
\def\covwedge{\nabla\wedge}
\def\covsq{\nabla^{2}}

% Named elements and displaced letters. Each expands inside math.
% \ii and \tr are already defined by the imported macros.
\def\bbI{\mathbb{I}}
\def\psI{\boldsymbol{I}}
\def\ui{\mathrm{i}}
\def\ue{\mathrm{e}}
\def\trace{\operatorname{tr}}
\def\im{\operatorname{im}}
\def\spec{\operatorname{spec}}
\def\Spec{\operatorname{Spec}}
\def\pr{\mathrm{pr}}
\def\cW{\mathcal{W}}
\def\TT{\mathbb{T}}
\def\cl[body]{\overline{\body}}
\def\Dom[body]{\operatorname{Dom}\body}
\def\basic[body]{\operatorname{Open}(\body)}
