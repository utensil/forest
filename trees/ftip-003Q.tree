\tag{ftip}
\tag{dpo}
\tag{preference}

\refdeft{Policy-ratio preference probability}{Section 4, equation (6)}{rafailov2023direct}{
\p{Substituting the reward--policy reparameterization into the Bradley--Terry
law yields}

##{
 \Pr_\theta(y^+\succ y^-\mid x)
 =\sigma\left(\beta\,
 \Delta_\theta(x,y^+,y^-)
 \right),
}

\p{where #{\Delta_\theta} is defined in \ref{ftip-003M}. The prompt-dependent
normalizer cancels because the two responses share the same prompt.}
}
