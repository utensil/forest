\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Corollary}
\title{The radial measurement on an orbit}
\date{2026-11-19}

\p{Let #{G} act isometrically on a real inner product space.
For a \vocabk{scalar path pairing}{fdip-011B} on the empty path
at #{x}, every configuration has the same value
#{\langle\phi_x,\phi_x\rangle=\|\phi^\circ\|^2}. A function
of the site radii alone is constant on all configurations.}

\proof{
\p{Every site value is a group translate of #{\phi^\circ}, and
the empty path has identity transport. Isometry gives the stated
squared norm and fixes every entry of the tuple of radii.}
}

\p{Allowing the radial coordinate itself to vary, as in the
radial gauge model of \ref{fdip-0118}, changes the scalar configuration
space.}
