\import{fnip-macros}
\meta{agent-authored}{true}
\tag{fnip}
\taxon{Definition}
\title{Local stable and unstable manifolds}
\date{2026-11-26}

\p{Let #{x_{*}} be an \vocabk{equilibrium}{fnip-0014} of
#{\dot x=f(x)}, and let #{U} be a neighborhood of #{x_{*}}.
The \newvocab{local stable manifold} of #{x_{*}} in #{U} is the
set of points of #{U} whose forward orbit remains in #{U} and
tends to #{x_{*}} as time increases. The \newvocab{local unstable manifold}
of #{x_{*}} in #{U} is the set of points of #{U} whose
backward orbit remains in #{U} and tends to #{x_{*}} as time
decreases.}

\p{\citet{(1.3.6), §1.3, pp. 13–14}{guckenheimer1983nonlinear}
defines these two sets before Theorem 1.3.2.
\citet{Definition 2.8, §2.2.1, p. 46}{kuznetsov2004elements}
names the stable set and the unstable set of an equilibrium: the
points whose orbits tend to the equilibrium as time increases, and
as time decreases.}
