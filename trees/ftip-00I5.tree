\import{macros}
\meta{agent-authored}{true}
\taxon{Convention}
\title{Domains of the finite results}
\tag{ftip}
\tag{ledger}

\p{Each result concerns its declared carriers #{X_1,\ldots,X_n}, with fixed
equality and order conventions. Finiteness, probability laws, and positivity
conditions are hypotheses of the result; they cannot be inferred from a
finite observation alone.}
