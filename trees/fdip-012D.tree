\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Proposition}
\title{The one-edge operator preserves double cosets}
\date{2026-11-21}

\p{Let #{\transferop} be the one-edge operator of \ref{fdip-012C}.
It sends functions constant on the double cosets of #{G^\circ} to
functions of the same kind. The indicators of those double cosets
form a basis of this space, so its rank is the number of double
cosets.}

\proof{
\p{Let #{f} satisfy #{f(agb)=f(g)} for #{a,b\in G^\circ}. The same
identity for #{B} gives #{M_Bf} constant on double cosets. Left
multiplication by #{a} is a bijection of #{G}. Substitute #{x=ay}
as #{y} runs through #{G}:
##{(C_{\mathcal K}f)(ag)
 =\sum_y\mathcal K(agy^{-1}a^{-1})f(ay).}
Left invariance gives #{f(ay)=f(y)}. The class-function identity
gives #{\mathcal K(a(gy^{-1})a^{-1})=\mathcal K(gy^{-1})}. Hence
#{(C_{\mathcal K}f)(ag)=(C_{\mathcal K}f)(g)}. Right multiplication
by #{b} is a bijection of #{G}. Substitute #{x=zb} as #{z} runs
through #{G}. Then #{gbx^{-1}=gz^{-1}} and #{f(zb)=f(z)}, so
#{(C_{\mathcal K}f)(gb)=(C_{\mathcal K}f)(g)}. Thus
#{C_{\mathcal K}} preserves the space, and so does
#{\transferop}. Distinct double cosets have disjoint indicators,
and every function constant on double cosets is the sum of its
values times those indicators.}
}
