\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Remark}
\title{The signature is kinematic}
\date{2026-11-12}

\p{The signature in \ref{fdip-00Q1} is read from a reflection
positive law on a finite calculus. Osterwalder and Schrader
\citek{osterwalder1973euclidean} and
\citek{osterwalder1975euclidean} are the analytic precedent
for reflection positivity. The reconstruction discussed in
\ref{fdip-00DY} is not used. Nothing here continues a function
off the lattice, enlarges the transfer data of
\ref{fdip-007L}, or produces a Hamiltonian.}
