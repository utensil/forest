\tag{fcap}
\tag{spin}
\tag{clifford}

\taxon{Remark}
\title{From real recurrences to the residue table}

\p{The mixed #{(1,1)} recurrence removes matched axes but leaves a one-sided
algebra #{\Cl_{r,0}} or #{\Cl_{0,r}}, which it cannot classify. Together with
the signature switch in \ref{fcap-001X} and initial entries in
\ref{fcap-0015}, the two recurrences below complete the calculation.}

\p{The two one-sided recurrences are

##{\begin{aligned}
\Cl_{p,q+2}&\simeq\Cl_{q,p}\otimes_{\mathbb R}\mathbb H,\\
\Cl_{p+8,q}&\simeq\Cl_{p,q}\otimes_{\mathbb R}M_{16}(\mathbb R).
\end{aligned}}

The first line is the actual equivalence
\leanref/tauceti{TauCeti.realCliffordQuaternionRecurrenceEquiv}. For the
second, the formal theorem supplies existence
\leanref/tauceti{TauCeti.nonempty_realCliffordEightPeriodicityEquiv}.}

\p{They yield the residue-indexed mod-eight classification
\leanref/tauceti{TauCeti.realClifford_classification}. The classical table is
\citet{I.4, Theorem 4.3 and Tables I--II, pp. 27--29}{lawson2016spin}.}
