\import{macros}
\meta{agent-authored}{true}

\taxon{Lemma}
\title{Prefix-window exposure is uniformly capped}
\tag{ftip}
\tag{finite-result}

\p{Let #{p,w\in\mathbb N_0} and let #{\kappa^{p,w}} be the prefix-window
policy of \ref{ftip-00DD}. For every history and every #{t},}

##{
\left|\kappa^{p,w}_t(h_t)\right|\leq p+w.
}

\p{Indeed, at most #{p} prefix positions and #{w} recent positions are
retained, with overlap or short histories only reducing the count.}
