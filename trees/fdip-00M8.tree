\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Remark}
\title{The Hilbert–Schmidt sum over every orthonormal basis}
\date{2026-11-10}

\p{Let #{T} be the Gaussian transfer operator of \ref{fdip-007T}.
For every orthonormal basis #{(e_n)} of #{\mathcal H},
##{\|T\|_{\mathrm{HS}}^2=\trace(T^{\dagger}T)
 =\sum_n\|Te_n\|^2.}
The sum does not depend on the chosen basis. It equals
#{\int|K|^2}.}
