\node[ext=5.0cm] (IX) at (6.4,7.9) {Part IX: Induced action};
\node[box=5.0cm] (a) at (6.4,6.2) {Finite gauge fields and an exact torus law};
\node[box=4.0cm] (b) at (2.0,4.8) {Character expansion on a finite surface};
\node[box=4.0cm] (c) at (10.8,4.8) {Gauge actions induced by matter};
\node[box=3.2cm] (e) at (13.6,3.3) {A dynamical connection and its matter law};
\node[box=7.0cm] (d) at (6.4,3.3) {Compact gauge groups and representation data};
\node[ext=4.4cm] (XI) at (3.6,0.6) {Part XI: Euclidean time};
