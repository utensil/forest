\import{macros}
\meta{agent-authored}{true}

\tag{ftip}
\tag{instruction-tuning}
\tag{data}

\card{Definition}{Demonstration record}{
\p{Using the notation of \ref{ftip-002A}, a \newvocab{demonstration record} is
a triple}

##{
 z=(x,y,\omega),
 \qquad x\in\mathcal X_{\mathrm{pr}},\quad y\in\mathcal Y(x),
}

\p{where #{\omega} identifies the declared producer of #{y}, the collection
or generation procedure, and any selection rule applied before the record
entered #{D_{\mathrm{sft}}}. The response is a training target; its presence in
the data does not assert that it is uniquely correct or preferred to every
alternative.}
}
