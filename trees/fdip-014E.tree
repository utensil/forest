\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Proposition}
\title{Ginsparg–Wilson symbols lie on a sphere}
\date{2026-11-23}

\p{Let #{n\ge1}. Take the translation-invariant Clifford blocks
of \ref{fdip-0141} on nonzero spin and internal spaces. Supply a
site-independent self-adjoint grading #{\Gamma} on #{S\otimes F}
anticommuting with every #{\varepsilon_j^S\otimes\bbI_F}. The
volume grading #{C} of \ref{fdip-009X} is one choice in even
dimension. Then #{D} is \vocabk{graded-hermitian}{fdip-0148}.
It is a Ginsparg–Wilson operator at spacing #{a>0} exactly when
##{(m(r)-a^{-1})^2+|f(r)|^2=a^{-2}\qquad(r\in R).}
Under this condition each vertex zero of #{f} has mass #{0}
or #{2a^{-1}}. If every vertex zero is
\vocabk{nondegenerate}{fdip-013Y}, their degrees satisfy
##{\sum_{f(r)=0,\ m(r)=0}\deg_r f+
\sum_{f(r)=0,\ m(r)=2a^{-1}}\deg_r f=-\deg^\circ(f).}}

\proof{
\p{Write #{D(p)=m(r)\bbI+\ui A}, where
#{A=\sum_j f_j(r)(\varepsilon_j^S\otimes\bbI_F)} is self-adjoint
and #{A^2=|f(r)|^2\bbI}. Conjugating by #{\Gamma} negates
#{A}, so #{\Gamma D(p)\Gamma=D(p)^\dagger}. Multiplying the
quadratic relation on the left by #{\Gamma} now gives the
equivalent identity #{D(p)+D(p)^\dagger=aD(p)^\dagger D(p)}.
The left side is #{2m(r)\bbI}. The right side is
#{a(m(r)^2+|f(r)|^2)\bbI} by \ref{fdip-0141}. The carrier is
nonzero, so equality of blocks is equality of these scalars.
Completing the square gives the sphere. Where #{f(r)=0} it
intersects the mass axis in the two stated values. Partitioning
the vertex sum in \ref{fdip-0140} by those values gives the
degree identity.}
}
