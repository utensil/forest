\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Remark}
\title{Counting matrices for Gaussian padding}
\date{2026-11-10}

\p{In the counting basis of \ref{fdip-0066}, let #{\pi_T} be the
coordinate projection onto a vertex subset #{T}. The padding
operator #{\iota_T\Lambda \iota_T^{\dagger}} has matrix #{\pi_T^TM\pi_T}, where
#{M} is the matrix of #{\Lambda}. The quadratic form in the proof
is the coordinate expression of the three marginal energies.}
