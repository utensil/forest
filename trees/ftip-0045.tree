\tag{ftip}
\tag{rlvr}
\tag{methodology}

\card{Remark}{A cross-paper operational family}{
\p{We synthesize an operational family from the PPO-based RLVR construction in
\citet{Section 6}{lambert2024tulu3}, group relative policy optimization (GRPO) in
\citet{Section 4.1}{shao2024deepseekmath}, R1-Zero in
\citet{Section 2.2}{guo2025deepseek}, and Decoupled Clip and Dynamic sAmpling
Policy Optimization (DAPO) in
\citet{Sections 2--3}{yu2025dapo}. No one of these sources defines every member
of the family.}

\p{A method belongs to this family by acquiring policy samples, evaluating a
declared verifiable signal, assigning credit, and updating the policy. A
specific claim must still name its verifier, group sampling, estimator,
clipping, normalization, reference-policy treatment, and length rule.}
}
