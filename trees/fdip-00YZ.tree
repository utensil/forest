\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Corollary}
\title{Failure of linear conjugacy for the proposed rule}
\date{2026-11-17}

\p{The two exactly gauge-related translation assignments in
\ref{fdip-00YY} give edge-direction operators which are not
conjugate by any invertible linear map of the fixed rank-#{64}
field module, over #{\mathbb Z} or #{\mathbb Q}. Over
#{\mathbb Q}, their ranks differ.}

\proof{
\p{The initial operator is zero by \ref{fdip-00YW} and the
translated operator is nonzero by \ref{fdip-00YY}. Every linear
conjugate of the zero map is zero. Over #{\mathbb Q}, the first
operator has rank zero and the second has positive rank.}
}

\p{This rules out covariance by linear conjugation for the
specific \vocabk{edge-direction formula}{fdip-00YV} on its declared field space.
It does not rule out affine representations on enlarged modules,
additional frame data, or other translation-dependent operators.}
