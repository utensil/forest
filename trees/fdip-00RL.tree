\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Notation}
\title{Notation for Euclidean time}
\date{2026-11-13}

\p{The domain of an operator is #{\Dom{H}}
(\ref{fdip-007W}, \ref{fdip-00RI}).}

\p{The transfer Hamiltonian generates the semigroup #{\ue^{-\tau H}}
(\ref{fdip-007W}, \ref{fdip-00RI}).}

\p{The directional derivative #{D_z} is the real form of the
conjugate momentum
([scalar fields, Weyl operators and equilibrium states](fdip-00H8), \ref{fdip-00RJ}).}

\p{Analytic continuation in time is #{t=\ui\tau}
(\ref{fdip-00HB}, \ref{fdip-00RK}).}

\p{The characteristic functional of a real field law is
#{\int \ue^{\ui \phi(f)}\,\extd\mu}
([the continuum half-Dirichlet field and its moment forms](fdip-00I2)).
A circle weight is evaluated on #{\ue^{\ui\theta}}
(\ref{fdip-0081}).}

\p{An operator domain is written #{\Dom{H}}, the convention of
functional analysis, keeping #{\extD} for the operator. The
semigroup, the directional derivative and the continuation
#{t=\ui\tau} are named in the remarks just cited. The circle
character and the characteristic functional keep #{\ui}: each
is a character of the group on which it is evaluated.}
