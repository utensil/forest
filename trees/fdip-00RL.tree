\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Notation}
\title{Notation for Euclidean time}
\date{2026-11-13}

\p{The domain of an operator is #{\Dom{H}}
(\ref{fdip-007W}, \ref{fdip-00RI}).}

\p{Real-time evolution is #{\ue^{-\ui tH}}
(\ref{fdip-007W}, \ref{fdip-00RI}).}

\p{The conjugate momentum is #{\Pi(z)=-\ui D_z}
([scalar fields, Weyl operators and equilibrium states](fdip-00H8), \ref{fdip-00RJ}).}

\p{Analytic continuation in time is #{t=\ui\tau}
(\ref{fdip-00HB}, \ref{fdip-00RK}).}

\p{An operator domain is written #{\Dom{H}}, the convention of
functional analysis, keeping #{\extD} for the operator. The factors
of #{\ui} in this Part have distinct sources (real-time evolution,
canonical commutation, and the continuation #{t=\ui\tau}), and each
is named where it first appears.}
