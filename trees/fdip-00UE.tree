\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Example}
\title{A fourth-root phase on the boundary tetrahedron}
\date{2026-11-17}

\p{The boundary of a #{3}-simplex has
#{c_0=4}, #{c_1=6}, #{c_2=4}, hence #{\chi=2}.
Take a rank-one fiber over #{k=\mathbb Z[\zeta_4]}, where
#{\zeta_4^2=-1}, and choose #{u=\zeta_4}. In the top
paired word, the #{8} even cells supply #{16} factors of
#{u}, and the #{6} odd cells supply #{12} factors of
#{u^{-1}}. The total factor is #{u^4=1}.
The [coefficient pullback](fdip-00UD) therefore has factor
#{u^{-4}=1}, although the Euler characteristic is nonzero.}

\p{The same cell counts over #{\mathbb Q}, with #{u=2},
give factor #{2^{-4}=1/16}. These are different actions on
the full coefficient functional, distinguished by evaluating
it on the top generator. No partition value is needed for
this comparison.}
