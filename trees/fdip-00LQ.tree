\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Remark}
\title{Weight coordinates for the induced Hessian}
\date{2026-11-10}

\p{In an orthonormal basis of the vertex space, the
Hilbert-Schmidt square in \ref{fdip-005T} is the sum of the
squares of the entries of #{G^{1/2}AG^{1/2}}. Relative to the
weight coordinates #{(a_e)}, the Hessian is the symmetric matrix
with entries #{-\frac12\langle d_e,Gd_f\rangle^2}. That matrix is
minus one quarter of the covariance matrix of the squared edge
evaluations #{\langle d_e,\phi\rangle^2}.}
