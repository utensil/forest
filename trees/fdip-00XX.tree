\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Example}
\title{The four-background partition and inverse block}
\date{2026-11-17}

\p{There are two equal-sign backgrounds with determinant
#{525}, and two opposite-sign backgrounds with determinant
#{529}. Hence the [cellular paired functional](fdip-00XQ)
is defined and normalized, with
##{Z=2\cdot525+2\cdot529=2108=4\cdot527.}
The vertex block of its fixed-background inverse is
##{\pr_0K_U^{-1}\iota_0
 =\frac5{529-s^2}
   \begin{pmatrix}23&-s\\-s&23\end{pmatrix},}
where #{\iota_0} includes vertex cochains and #{\pr_0}
projects onto them. Indeed the inverse of the vertex Schur
complement is
#{5(25\bbI_2-\extd_U^{\mathsf t}\extd_U)^{-1}}.
Its diagonal is #{115/(529-s^2)}, and its determinant is
#{25/(529-s^2)}. The paired coefficient signs in
\ref{fdip-00TQ} therefore agree with the polynomial
calculation of \ref{fdip-00XW}.}
