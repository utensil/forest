\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Proposition}
\title{The coordinate changes induced by conjugation}
\date{2026-11-26}

\p{In the \vocabk{lift of the signed coordinate group}{fdip-016P},
ordinary conjugation on the real span of the #{\varepsilon_j}
gives a surjection onto #{B_\Lambda}. The image of #{f_j} reverses
only axis #{j}. The image of #{u_{jk}} takes #{\varepsilon_j}
to #{-\varepsilon_k} and #{\varepsilon_k} to #{\varepsilon_j},
fixing the other directions. Each lift is unitary.
The determinant of the image of a word is #{(-1)^p}, where #{p}
counts its reflection factors, including inverse reflections.}

\proof{
\p{The square of #{\sum_j v_j\varepsilon_j} for real #{v_j} is
#{(\sum_j v_j^2)\bbI_S} by the anticommutators. Since #{S\ne0},
the direction operators are real-linearly independent. The
factors #{f_j} satisfy #{f_j^\dagger=-f_j}, #{f_j^2=-\bbI_S}
and #{f_i f_j=-f_j f_i} for distinct indices. Hence
#{f_j^{-1}=f_j^\dagger}. The operator #{f_j} anticommutes with
#{\varepsilon_j} and commutes with each other direction operator.}

\p{Put #{b=\varepsilon_j\varepsilon_k}. Then
#{b^\dagger=-b}, #{b^2=-\bbI_S}, and
#{u_{jk}^{-1}=u_{jk}^\dagger=(\bbI_S-b)/\sqrt{2}}.
The identities #{b\varepsilon_j=-\varepsilon_k} and
#{b\varepsilon_k=\varepsilon_j} give the stated conjugations on
expanding the products. Each other direction commutes with #{b}.
Coordinate signs and exchanges of any two equal-period axes
generate #{B_\Lambda}. A quarter-turn followed by the sign flip
of its negative output performs the unsigned exchange. Thus all
these changes occur. Each quarter-turn has determinant one and
each single flip has determinant minus one, also for their inverses.
Multiplicativity proves the parity formula.}
}
