\import{macros}
\meta{agent-authored}{true}

\refcardt{Definition}{empirical squared-ratio excess}{Theorem 2}{miao2026when}{
\p{For token-level current-to-behavior ratios #{r_1,\ldots,r_T}, DGG defines}

##{\widehat\chi^2=\frac1T\sum_{i=1}^T(r_i^2-1).}

\p{The source relates this statistic to an upper bound on language-model-head
gradient energy through a batch-dependent constant. In a finite batch
#{\widehat\chi^2} can be negative, so it is not automatically a nonnegative
empirical Pearson divergence. The result also gives no converse from a small
batch gradient to small policy shift.}
}
