\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Remark}
\title{The published top coefficient differs}
\date{2026-11-06}

\p{\ref{fdip-009A} takes coefficients #{\lambda^j} below the top
and top coefficient #{m}. Multiplication by #{\sqrt{p\lambda}}
then produces top coefficient #{m/\lambda}. The
[fixed-ratio precision](fdip-00BY) uses top coefficient
#{m\lambda^k} at depth #{k}. The lower coefficients remain
#{\lambda^j}.}
