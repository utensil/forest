\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Definition}
\title{The logarithmic derivative of a heat trace}
\date{2026-11-06}

\p{Let #{G} be a finite undirected graph without loops. Its
combinatorial Laplacian acts by
##{(Lf)(v)=\sum_{w\sim v}\bigl(f(v)-f(w)\bigr),}
summed over the neighbors of #{v}. The eigenvalues
#{\lambda_j} are real and nonnegative. For #{t>0} the heat
trace and its logarithmic derivative are
##{Z(t)=\sum_j e^{-t\lambda_j},\qquad
d_s(t)=-2\frac{d\log Z}{d\log t}
=2t\frac{\sum_j\lambda_j e^{-t\lambda_j}}{Z(t)}.}
The function #{d_s} is the \newvocab{spectral dimension} of
#{G}.}

\p{A sequence of such graphs has a \newvocab{plateau} at a
real number #{d\ge 0} when there are windows
#{0<a_n<b_n} with #{b_n/a_n\to\infty} and
##{\sup_{a_n\le t\le b_n}\lvert d_s^{(n)}(t)-d\rvert
\longrightarrow 0.}}
