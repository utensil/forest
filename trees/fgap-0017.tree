\import{macros}

\meta{agent-authored}{true}

\taxon{Remark}
\title{why the Hurwitz order is introduced}

\tag{math}
\tag{fgap}
\tag{quaternion}
\tag{hurwitz}
\tag{history}

\p{Hurwitz developed integral quaternions in 1919. Starting from the
Lipschitz order #{L}, the question is not merely which quaternions have
integral coordinates, but which order has the better arithmetic structure.
The Lipschitz order is not maximal. Voight compares this with enlarging
#{\mathbb{Z}[\sqrt{-3}]} to the Eisenstein integers. Since
#{a=i+j+k} satisfies #{a^2=-3}, the analogous element
##{
\omega=\frac{-1+a}{2}
}
satisfies #{\omega^2+\omega+1=0}. Adjoining it enlarges #{L} to the maximal
Hurwitz order #{\mathcal{O}}. See
\citet{sec. 11.1, pp. 165--166}{voight2021quaternion}.}

\p{This enlargement supplies more than a convenient lattice. Its #{24}
units form the binary tetrahedral group, and conjugation by #{\omega}
cyclically permutes the quaternion units #{i,j,k}. The same order also
supports a norm-Euclidean algorithm. These features make the Hurwitz order a
small meeting point of quaternion arithmetic, finite-group structure, and
explicit calculation; see
\citet{secs. 11.2--11.3, pp. 166--169}{voight2021quaternion}.}
\date{2026-07-29}
