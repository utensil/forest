\import{macros}
\meta{agent-authored}{true}

\taxon{Definition}
\title{Attempt-local replay annotations}
\tag{ftip}
\tag{replay}
\tag{off-policy}

\p{Given current parameters #{\theta_n} and replay pool #{\mathcal B_n}, a
selection operator chooses a record and produces \strong{attempt-local
annotations}}

##{
  \operatorname{Select}(\theta_n,\mathcal B_n)
  =(\mathsf R,w^{(n)},a^{(n)},k^{(n)},m^{(n)}).
}

\p{Here #{w^{(n)}} contains current-to-behaviour likelihood ratios,
#{a^{(n)}} is record age, #{k^{(n)}} is its prior reuse count, and #{m^{(n)}}
records clipping or mask decisions for this attempt.}

\p{The likelihood-ratio semantics come from
\citet{Section 3}{schulman2017proximal}. Sections 3 and 5 of
\citef{miao2026when} give the behavior/current-policy setup and the concrete
reuse procedure.}

\p{The annotation tuple is an FTIP synthesis. It is recomputed against the
current policy and is never written back into #{\mathsf R}.}
