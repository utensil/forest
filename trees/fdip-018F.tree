\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Proposition}
\title{The two coefficient identities for a fixed exchange}
\date{2026-11-26}

\p{Let #{u:V\to V'} be a specified linear or conjugate-linear
\vocabk{equivariant sector exchange}{fdip-018A}, with
restrictions #{u_+:V_+\to V'_-}, #{u_-:V_-\to V'_+}.
Suppose the respective even linear endomorphisms are given by
#{A=A_+\oplus A_-} and #{A'=A'_+\oplus A'_-}.
Then #{uA=A'u} if and only if
##{u_+A_+=A'_-u_+,\qquad u_-A_-=A'_+u_-.}
For families of such operators the equations use the coefficient
at the source data on the left and at the prescribed destination
data on the right. At fixed data take #{A'=A}.}

\proof{
\p{On a vector #{v_+} in the first summand one has
#{uAv_+=u_+A_+v_+}, while #{A'uv_+=A'_-u_+v_+}.
Evaluation on the second summand gives the other identity.
Additivity extends the two identities to all vectors.
If #{u} is conjugate-linear it takes a scalar multiple on the
left to the conjugate scalar multiple of the transported vector.}
}
