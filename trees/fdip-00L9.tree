\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Proposition}
\title{The tensor module is reducible}
\date{2026-11-10}

\p{The Clifford module #{S=(\mathbb C^2)^{\otimes d}} of the
[centered Dirac operator](fdip-000R) is reducible. Both
eigenspaces of the last-factor flip have dimension #{2^{d-1}},
and #{\dim S=2^d}. No minimality or faithfulness of this
representation is claimed.}

\proof{
\p{Let #{J} apply the flip to the last factor and the identity to
every earlier factor. The last factor of #{\gamma_j} is either
the identity or the flip, and every earlier factor of #{J} is an
identity, so #{J} commutes with every #{\gamma_j}. Its two
eigenspaces are
##{S_\pm=(\mathbb C^2)^{\otimes(d-1)}
\otimes\mathbb C(1,\pm1),}
the lines spanned by #{e_0\pm e_1}.
Both are nonzero and have dimension #{2^{d-1}}. Commutation with
#{J} makes them invariant under every generator and hence under
the generated Clifford action.}
}
