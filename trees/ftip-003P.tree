\import{macros}
\meta{agent-authored}{true}

\tag{ftip}
\tag{dpo}
\tag{reward-model}

\refdeft{Reward--policy reparameterization}{Section 4, equation (5)}{rafailov2023direct}{
\p{Rearranging the optimal-policy identity of \ref{ftip-003O} gives}

##{
 r(x,y)
 =\beta\log\frac{\pi_r(y\mid x)}{\pi_{\mathrm{ref}}(y\mid x)}
 +\beta\log Z_r(x).
}

\p{The final term depends on the prompt but not on the response. It cancels
from pairwise reward differences, matching the additive non-identifiability of
Bradley--Terry scores described in \ref{ftip-002S}.}
}
