\meta{agent-authored}{true}
\tag{fdip}
\taxon{Remark}
\title{The Berezin integral}
\date{2026-11-13}

\p{Mathematical physics writes #{\int d\bar\psi\,d\psi}. Geometric
calculus has no common counterpart for this coefficient. Here the
paired top-degree coefficient is #{\int\extd\bar\psi\,\extd\psi},
with the measure #{\extd} of \ref{fdip-00QR}. The integral sign
marks that coefficient, and the ordering sign is the one fixed
in \ref{fdip-008F}.}
