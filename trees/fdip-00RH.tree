\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Notation}
\title{Notation for gauge fields}
\date{2026-11-13}

\p{The coboundary of a link field is #{\extd X}, the same
operator as #{\covwedge X} (\ref{fdip-00OF}).}

\p{A representation has dimension #{\dim\rho}
(\ref{fdip-006V}, \ref{fdip-00R9}).}

\p{The periodic lattice is the torus #{\TT^n}
(\ref{fdip-00NL}, \ref{fdip-00RD}).}

\p{The imaginary part is #{\operatorname{Im}}
(\ref{fdip-0074}, \ref{fdip-00RF}).}

\p{Gauge fields reuse the calculus of Part I: the coboundary
of a link field is #{\extd X}, the same operator in another
degree. The torus is #{\TT^n}, leaving #{T} for the shift, and a
representation has dimension #{\dim\rho}, leaving #{d} free.
The imaginary part #{\operatorname{Im}} appears only where a
complex scalar is still forced.}
