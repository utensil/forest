\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Definition}
\title{A common sign on represented directions}
\date{2026-11-26}

\p{Let #{S} be a finite-dimensional complex Hermitian space.
Write #{\varepsilon_j} for the action on #{S} of the #{j}th
positive Euclidean direction, #{1\le j\le n}, #{n\ge1}.
As in \ref{fdip-00LZ}, these operators are self-adjoint and
satisfy #{\varepsilon_i\varepsilon_j+\varepsilon_j\varepsilon_i
=2\delta_{ij}\bbI_S}. For #{\eta\in\{1,-1\}}, a
\newvocab{charge conjugation of sign} #{\eta} on #{S} is a
surjective conjugate-linear isometry #{c_\eta:S\to S} such that
##{c_\eta\varepsilon_jc_\eta^{-1}=\eta\varepsilon_j
\qquad(1\le j\le n).}
Its square is a complex-linear unitary. The sign condition
specifies its action on the directions.}
