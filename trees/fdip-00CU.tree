\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Lemma}
\title{Heat-trace bounds under a uniform spectral gap}
\date{2026-11-06}

\p{Fix an integer #{\Delta\ge 1} and a real number #{c>0}.
Let #{G} be a connected graph on #{N\ge 2} vertices, of
maximum degree at most #{\Delta}, whose smallest positive
eigenvalue of the combinatorial Laplacian is at least
#{c}. Write #{Z} for its heat trace, #{d_s} for its
\vocabk{spectral dimension}{fdip-00CO}, and
#{W(t)=Z(t)-1}. There is a unique #{\tau>0} with
#{W(\tau)=1}, and
##{\frac{1}{2\Delta}\log(N-1)
\le\tau\le\frac{1}{c}\log(N-1).}
Every positive eigenvalue is at most #{2\Delta}. For
#{t>0},
##{2ct\,\frac{W(t)}{1+W(t)}
\le d_s(t)
\le 4\Delta t\,\frac{W(t)}{1+W(t)}.}
For #{0\le s\le t},
##{e^{-2\Delta(t-s)}
\le\frac{W(t)}{W(s)}
\le e^{-c(t-s)}.}
In particular, #{ct\le d_s(t)\le 4\Delta t} whenever
#{t\le\tau}, and
#{d_s(t)\le 4\Delta t\,e^{-c(t-\tau)}} whenever
#{t\ge\tau}.}

\proof{
\p{The quadratic form of the combinatorial Laplacian is the
sum, over the edges, of the squared difference of the
endpoint values. It is nonnegative. It vanishes only when the function is
constant on every edge, hence constant, because #{G} is
connected. The zero eigenvalue is therefore simple. The
identity #{(a-b)^2\le 2a^2+2b^2} bounds the quadratic form
by #{2\sum_v\deg(v)f(v)^2\le 2\Delta\|f\|^2}, so every
eigenvalue is at most #{2\Delta}. Thus #{W} is the sum of
#{e^{-t\lambda}} over the positive eigenvalues. If #{S} is
the same sum weighted by the eigenvalues, then
#{cW\le S\le 2\Delta W}. The formula for #{d_s} is
#{2tS/Z}, which is the two-sided bound.}

\p{Differentiating #{W} gives #{W'=-S}, so the derivative of
#{\log W} lies between #{-2\Delta} and #{-c}. Integrating
from #{s} to #{t} gives the exponential comparison.
#{W(0)=N-1} and #{0<W(t)\le(N-1)e^{-ct}}, so #{W} tends to
#{0}. Since #{W'=-S<0}, the function #{W} is strictly
decreasing, and the time #{\tau} exists and is unique. The
comparison from time
#{0} to time #{\tau} bounds #{\tau}. For #{t\le\tau} one
has #{W(t)\ge 1}, so #{W/(1+W)} lies between #{1/2} and
#{1}, and the bound on #{d_s} simplifies. For #{t\ge\tau},
#{W(t)\le e^{-c(t-\tau)}}, and
#{W/(1+W)\le W} gives the remaining estimate.}
}
