\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Proposition}
\title{The second variation along a circle orbit}
\date{2026-11-19}

\p{Let #{U(1)} act by rotations on the unit circle in the real Euclidean
plane. On a nonempty finite connected graph with positive edge weights
use its \vocabk{hopping weight}{fdip-00ZW}. At a constant configuration
identify each tangent line with #{\mathbb R} by angular displacement
in the positive rotation direction. For real vertex displacements
#{\theta}, the quadratic term of the negative log hopping weight is
##{\tfrac12\langle\theta,-L\theta\rangle,\qquad
 -L=\extdag W\extd .}
Here #{L} is the \vocabk{weighted graph Laplacian}{fdip-0007} for the
counting vertex inner product. The Hessian of the negative log weight
is #{-L}, and that of the log weight is #{L}. Their common kernel is
the line of constant angular displacements.}

\proof{
\p{For arbitrary real vertex functions #{u,v}, rotate the value at
#{x} through angle #{t u_x+\tau v_x}. On edge #{e} the two endpoint
angles differ by #{t(\extd u)(e)+\tau(\extd v)(e)}. Its contribution
to the negative log weight is minus #{w_e} times the cosine of that
difference. At #{t=\tau=0} its first derivatives vanish, and its
mixed derivative equals #{w_e(\extd u)(e)(\extd v)(e)}. Summation
and the counting adjoint give the Hessian pairing
#{\langle u,\extdag W\extd v\rangle}. Its quadratic Taylor term is
half its value on #{(\theta,\theta)}. The associated sum of squares
vanishes exactly when all the edge differences vanish. On a connected
graph these are precisely the constant functions.}
}
