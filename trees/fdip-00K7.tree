\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Proposition}
\title{Minimizing extensions across zero-energy directions}
\date{2026-11-10}

\p{Let #{V} be finite-dimensional over an ordered field #{F}, with
positive symmetric pairing #{h}, and let #{A:V\to V} be
\vocabk{nonnegative and self-adjoint}{fdip-00K1}. For a retained
subspace #{X}, put #{U=X^\perp}. Use the inclusions
#{\iota_X:X\to V}, #{\iota_U:U\to V} and orthogonal projections
#{p_X:V\to X}, #{p_U:V\to U} from \ref{fdip-00K2}.
The \vocabk{split components}{fdip-001T} are
##{\begin{aligned}
a&=p_XA\iota_X:X\to X,& b&=p_XA\iota_U:U\to X,\\
d&=p_UA\iota_X:X\to U,& c&=p_UA\iota_U:U\to U.
\end{aligned}}
Let #{N=\ker c} and let #{W=N^\perp} inside #{U}.
Write #{j:W\to U} and #{p:U\to W} for the orthogonal inclusion
and projection. All pairings below are restrictions of #{h}.}

\p{The maps #{a,c} are self-adjoint, #{c\geq0}, and #{d=b^\dagger}.
The compression and cross maps
##{\begin{aligned}
c_W&=pcj:W\to W,\\
b_W&=bj:W\to X,\qquad d_W=pd:X\to W
\end{aligned}}
satisfy #{jc_W=cj}, #{jd_W=d} and #{d_W=b_W^\dagger}.
The map #{c_W} is positive definite and invertible, including when
#{W=0}. The self-adjoint retained map is
##{S=a-b_Wc_W^{-1}d_W:X\to X.}
For #{x\in X}, put #{r_x=c_W^{-1}d_Wx\in W}.
For #{u=jw+n} with #{w\in W}, #{n\in N},
##{\begin{aligned}
q_A(\iota_Xx+\iota_Uu)
 &=h_X(x,Sx)\\
 &\quad+h_W(w+r_x,\ c_W(w+r_x)).
\end{aligned}}
Consequently #{S\geq0}; the minimum over #{u\in U} is attained
and equals #{h_X(x,Sx)}. The entire set of minimizing extensions is
##{-jc_W^{-1}d_Wx+N\subseteq U.}
For each #{x}, it is a singleton exactly when #{N=0}.}

\proof{
\p{The projection-adjoint identities and \ref{fdip-001P} give
#{a^\dagger=a}, #{c^\dagger=c}, #{d=b^\dagger} and
#{h_U(u,cu)=q_A(\iota_Uu)\geq0}.
For #{n\in N}, #{q_A(\iota_Un)=h_U(n,cn)=0}.
By \ref{fdip-00K3}, #{A\iota_Un=0}; in particular #{bn=0}.}
\p{For #{w\in W} and #{n\in N},
#{h_U(cjw,n)=h_U(jw,cn)=0}, so #{c} preserves #{W} and
#{jc_W=cj}. The compression #{c_W} is self-adjoint.
If #{c_Ww=0}, then #{cjw=0}, so #{jw\in N\cap W=0}.
Finite dimension makes #{c_W} invertible. More strongly,
#{h_W(w,c_Ww)=0} implies #{cjw=0} by \ref{fdip-00K3} applied
to #{c}; hence #{w=0}. Its nonnegative diagonal is therefore
strictly positive at every nonzero #{w}. When #{W=0}, its unique
endomorphism is the invertible identity and the strict condition
is vacuous.}
\p{For #{x\in X} and #{n\in N},
#{h_U(n,dx)=h_X(bn,x)=0}; thus #{d} takes values in #{W} and
#{jd_W=d}. Also
##{h_W(w,d_Wx)=h_U(jw,dx)=h_X(bjw,x),}
which proves #{d_W=b_W^\dagger}. The inverse of #{c_W} is
self-adjoint by \ref{fdip-001P}, so #{S} is self-adjoint.}
\p{Write #{r=c_W^{-1}d_Wx}. Since #{A\iota_Un=0}, expansion gives
##{\begin{aligned}
q_A(\iota_Xx+\iota_U(jw+n))
 &=h_X(x,ax)+2h_X(x,b_Ww)+h_W(w,c_Ww),\\
h_W(w+r,c_W(w+r))
 &=h_W(w,c_Ww)+2h_X(x,b_Ww)\\
 &\quad+h_X(x,b_Wc_W^{-1}d_Wx).
\end{aligned}}
Here #{c_Wr=d_Wx} gives both cross terms, and the adjoint
identity gives the final constant. Subtracting that constant
proves the displayed square completion. Positive definiteness of
#{c_W} makes its remaining term zero exactly when #{w=-r}.
The component #{n} is arbitrary, proving both attainment and the
full coset. Taking #{u=-jr} in #{q_A\geq0} proves #{S\geq0}.}
\p{If #{c=0}, then #{N=U}, #{W=0}, #{b=0}, #{d=0} and #{S=a};
every eliminated vector minimizes. If #{U=0}, the retained map
is #{A} under #{X=V}, with the unique empty extension.
If #{X=0}, the minimizers are #{\ker A} and the retained form is
zero. These statements also include #{A=0} and #{V=0}.}
}

\p{The real symmetric-matrix counterpart of singular square
completion and its range condition is
\citet{Appendix A.5.5, p. 651}{boyd2004convex}, after exchanging
its pivot order. The proof here establishes the stated ordered-field
result directly, using the positive pairing, its algebraic projections
and the radical criterion. It asserts an attained minimum in #{F}.}
