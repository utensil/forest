\import{macros}
\meta{agent-authored}{true}

\taxon{Definition}
\title{Feedback operator}
\tag{ftip}
\tag{feedback}

\p{Let #{\mathcal R} be the set of immutable rollout records and
#{\mathcal F} a typed set of feedback events. A \strong{feedback operator}
is a possibly randomized kernel}

##{\mathsf{Feed}:\mathcal R\rightsquigarrow\mathcal F.}

\p{A feedback event may contain an outcome score, step labels, a preference,
or an abstention. Its type records which observations were available when it
was produced.}
