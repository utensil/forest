\import{macros}
\meta{agent-authored}{true}

\tag{ftip}
\tag{reinforcement-learning}
\tag{advantage}

\refcardt{Remark}{Baselines and estimated credit}{Sections 2--3}{schulman2016gae}{
\p{Subtracting a baseline that does not depend on the sampled action can reduce
the variance of a policy-gradient estimator without changing its expected
gradient under the source conditions. A learned value function, a group mean,
and a leave-one-out mean are different baselines and have different finite-data
dependencies.}

\p{An estimated advantage may use sampled returns, bootstrapped values, or a
mixture of both. Its error enters the update even when the likelihood-ratio
calculation is exact.}
}
