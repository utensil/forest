\import{fdip-macros}
\meta{agent-authored}{true}
\tag{fdip}
\taxon{Definition}
\title{The module induced from one translation block}
\date{2026-11-26}

\p{Let #{\Lambda=\prod_{j=1}^{n}\mathbb Z/N_j\mathbb Z}, with
#{n\ge1} and positive periods, and let a finite group #{G} act on
#{\Lambda} by automorphisms. Put #{G_\Lambda=\Lambda\rtimes G}, with
#{(x,b)(y,c)=(x+b y,bc)}. Let #{k} be a field in which #{|\Lambda|}
is invertible and choose a primitive #{N_j}th root #{\zeta_j} in #{k}
for each #{j}. For the tuple of residues #{r=(r_j)} write
#{\alpha_r(x)=\prod_j\zeta_j^{r_jx_j}}. The action on these
multiplicative characters is #{\alpha_{br}=\alpha_r\circ b^{-1}},
as for the \vocabk{orbit of a momentum label}{fdip-0164}.
Write #{G_r} for the subgroup fixing #{r} and
#{G_{\Lambda,r}=\Lambda\rtimes G_r}.}

\p{In a #{k}-representation #{V} of #{G_\Lambda} write #{T_x}
for the action of #{(x,1)}. The \newvocab{translation block} at #{r} is
##{V_r=\{v\in V:T_xv=\alpha_r(x)v\text{ for every }x\in\Lambda\}.}
For any #{G_r}-module #{F}, denote by #{F(r)} the
#{G_{\Lambda,r}}-module on the same vector space with
#{(x,b)v=\alpha_r(x)b v}. The \newvocab{induced module} from #{F(r)} is
##{\operatorname{Ind}_{G_{\Lambda,r}}^{G_\Lambda}F(r)
 = k[G_\Lambda]\otimes_{k[G_{\Lambda,r}]}F(r).}
Here #{k[G_\Lambda]} is the \vocabk{group algebra}{fgap-001H}.
Left multiplication acts on the first factor. The tensor product
identifies #{ah\otimes v} with #{a\otimes hv} for each
#{h\in G_{\Lambda,r}}.}
